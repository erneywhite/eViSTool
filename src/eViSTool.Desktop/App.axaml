<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="eViSTool.Desktop.App"
             RequestedThemeVariant="Dark">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- лесная палитра: токены Forest.*, кисти элементов Fluent теми же цветами, иконки, шрифты -->
                <ResourceInclude Source="avares://eViSTool/Themes/ForestResources.axaml" />
                <!-- шаблоны кнопок, вкладок, тумблеров, пунктов списков (ControlTheme) -->
                <ResourceInclude Source="avares://eViSTool/Themes/ForestControls.axaml" />
                <!-- кнопки, рамка и тень своей шапки главного окна (WindowDecorationsTheme) -->
                <ResourceInclude Source="avares://eViSTool/Themes/ForestWindowChrome.axaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>
    <Application.Styles>
        <FluentTheme>
            <FluentTheme.Palettes>
                <!-- базовые цвета Fluent → лесные: от них Fluent строит фон, текст, рамки, наведение и акцент всех
                     стандартных элементов. Непрозрачные — токены из ForestResources; полупрозрачные оттенки — от цвета
                     текста и боковой колонки (#E7E9DE и #111913 с прозрачностью), как у Fluent от белого и чёрного:
                     поменялся токен — поменять и их. -->
                <ColorPaletteResources x:Key="Dark"
                                       Accent="{StaticResource Forest.AccentColor}" RegionColor="{StaticResource Forest.BaseColor}"
                                       ErrorText="{StaticResource Forest.DangerColor}"
                                       AltHigh="{StaticResource Forest.SideColor}" AltMediumHigh="#CC111913" AltMedium="#99111913" AltMediumLow="#66111913" AltLow="#33111913"
                                       BaseHigh="{StaticResource Forest.TextColor}" BaseMediumHigh="#CCE7E9DE" BaseMedium="#99E7E9DE" BaseMediumLow="#66E7E9DE" BaseLow="#33E7E9DE"
                                       ChromeAltLow="{StaticResource Forest.TextColor}" ChromeWhite="{StaticResource Forest.TextColor}"
                                       ChromeGray="#8A9786" ChromeHigh="{StaticResource Forest.LineStrongColor}"
                                       ChromeMedium="{StaticResource Forest.BaseColor}" ChromeMediumLow="{StaticResource Forest.SurfaceColor}"
                                       ChromeLow="{StaticResource Forest.SideColor}"
                                       ChromeDisabledHigh="{StaticResource Forest.RaisedColor}" ChromeDisabledLow="{StaticResource Forest.FaintColor}"
                                       ChromeBlackHigh="#0E1410" ChromeBlackMedium="#CC0E1410" ChromeBlackMediumLow="#660E1410" ChromeBlackLow="#330E1410"
                                       ListLow="#19E7E9DE" ListMedium="#33E7E9DE" />
            </FluentTheme.Palettes>
        </FluentTheme>
        <StyleInclude Source="avares://Avalonia.Controls.DataGrid/Themes/Fluent.xaml" />
        <StyleInclude Source="avares://eViSTool/Themes/Forest.axaml" />
    </Application.Styles>
</Application>
