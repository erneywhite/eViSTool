<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:eViSTool.Presentation.ViewModels"
             xmlns:local="using:eViSTool.Desktop"
             x:Class="eViSTool.Desktop.Views.AboutView"
             x:DataType="vm:AboutViewModel">
    <UserControl.Resources>
        <!-- строка-ссылка: иконка «↗» справа, вся строка кликабельна, при наведении текст становится песочным -->
        <ControlTheme x:Key="LinkRow" TargetType="Button">
            <Setter Property="Foreground" Value="{DynamicResource Forest.Text}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <ControlTemplate>
                    <Border Background="Transparent" BorderBrush="{DynamicResource Forest.Line}" BorderThickness="0,0,0,1" Padding="0,9">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Right" Text="↗" Foreground="{DynamicResource Forest.Accent}" />
                            <ContentPresenter x:Name="PART_ContentPresenter" Content="{TemplateBinding Content}"
                                              ContentTemplate="{TemplateBinding ContentTemplate}"
                                              HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}" />
                        </DockPanel>
                    </Border>
                </ControlTemplate>
            </Setter>
            <Style Selector="^:pointerover">
                <Setter Property="Foreground" Value="{DynamicResource Forest.Accent}" />
            </Style>
        </ControlTheme>

        <!-- кнопка без рамки и фона вокруг картинки (Ko-fi): в фокус клавишей не берётся, при наведении чуть бледнее -->
        <ControlTheme x:Key="ImageButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <ControlTemplate>
                    <ContentPresenter x:Name="PART_ContentPresenter" Background="{TemplateBinding Background}"
                                      Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}" />
                </ControlTemplate>
            </Setter>
            <Style Selector="^:pointerover /template/ ContentPresenter#PART_ContentPresenter">
                <Setter Property="Opacity" Value="0.85" />
            </Style>
        </ControlTheme>
    </UserControl.Resources>

    <UserControl.Styles>
        <!-- пояснение мелким приглушённым текстом (Muted в окне на WPF) -->
        <Style Selector="TextBlock.note">
            <Setter Property="Foreground" Value="{DynamicResource Forest.Muted}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <!-- карточка раздела -->
        <Style Selector="Border.about">
            <Setter Property="Padding" Value="20,16" />
        </Style>
    </UserControl.Styles>

    <DockPanel Margin="10,4,10,0">
        <StackPanel DockPanel.Dock="Top">
            <TextBlock Text="{local:Tr nav.about}" Classes="pageTitle" />
            <TextBlock Text="{local:Tr about.tagline}" Foreground="{DynamicResource Forest.Accent}" FontSize="12" Margin="0,4,0,0" />
        </StackPanel>
        <Border DockPanel.Dock="Top" BorderBrush="{DynamicResource Forest.Line}" BorderThickness="0,0,0,1" Margin="0,14,0,14" />

        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="0,0,14,0">
                <!-- ===== программа и обновления ===== -->
                <Border Classes="card about" Padding="20">
                    <DockPanel>
                        <Image DockPanel.Dock="Left" Source="avares://eViSTool.Desktop/Assets/logo256.png" Width="96" Height="96" Margin="0,0,20,0"
                               RenderOptions.BitmapInterpolationMode="HighQuality" />
                        <StackPanel DockPanel.Dock="Right" VerticalAlignment="Center" Margin="20,0,0,0" MinWidth="200">
                            <Button Command="{Binding CheckAppUpdateCommand}" HorizontalAlignment="Right">
                                <StackPanel Orientation="Horizontal">
                                    <Path Classes="icon" Data="{StaticResource Icon.Refresh}" Width="14" Height="14" Margin="0,0,8,0" />
                                    <TextBlock Text="{local:Tr about.checkUpdates}" />
                                </StackPanel>
                            </Button>
                            <TextBlock Classes="note" Text="{Binding UpdateStatus}" TextAlignment="Right" Margin="0,8,0,0" MaxWidth="260"
                                       HorizontalAlignment="Right" IsVisible="{Binding UpdateStatus, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                                       AutomationProperties.AutomationId="UpdateStatus" />
                            <!-- найдена новая версия: поставить и что в ней нового -->
                            <StackPanel HorizontalAlignment="Right" Margin="0,10,0,0" IsVisible="{Binding HasUpdate}">
                                <Button Classes="primary" Command="{Binding InstallUpdateCommand}" HorizontalAlignment="Right"
                                        AutomationProperties.AutomationId="InstallUpdate">
                                    <StackPanel Orientation="Horizontal">
                                        <Path Classes="icon" Data="{StaticResource Icon.Download}" Width="14" Height="14" Margin="0,0,8,0" />
                                        <TextBlock Text="{Binding UpdateButtonText}" />
                                    </StackPanel>
                                </Button>
                                <Button Theme="{StaticResource Forest.LinkButton}" Content="{local:Tr about.updateNotes}" Command="{Binding OpenReleaseNotesCommand}"
                                        HorizontalAlignment="Right" Margin="0,8,0,0" />
                            </StackPanel>
                        </StackPanel>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="eViSTool" FontSize="28" FontWeight="SemiBold" Foreground="{DynamicResource Forest.Text}" />
                            <TextBlock FontSize="13" Foreground="{DynamicResource Forest.Muted}" Margin="0,2,0,0">
                                <Run Text="{local:Tr about.version}" /><Run Text=" " /><Run Text="{Binding AppVersion, Mode=OneWay}" FontWeight="SemiBold" Foreground="{DynamicResource Forest.Accent}" /><Run Text="   ·   Erney White" />
                            </TextBlock>
                            <TextBlock Text="{local:Tr shell.slogan}" Foreground="{DynamicResource Forest.Muted}" FontSize="12" Margin="0,8,0,0" FontStyle="Italic" />
                        </StackPanel>
                    </DockPanel>
                </Border>

                <!-- ===== поддержать ===== -->
                <Border Classes="card about" Margin="0,14,0,0" Background="{DynamicResource Forest.Raised}">
                    <DockPanel>
                        <!-- официальная кнопка Ko-fi (картинка вшита в программу) -->
                        <Button DockPanel.Dock="Right" Theme="{StaticResource ImageButton}" Command="{Binding OpenKofiCommand}" Margin="16,0,0,0"
                                VerticalAlignment="Center" ToolTip.Tip="ko-fi.com/erneywhite" AutomationProperties.Name="Ko-fi">
                            <Image Source="avares://eViSTool.Desktop/Assets/kofi.png" Height="44" RenderOptions.BitmapInterpolationMode="HighQuality" />
                        </Button>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="{local:Tr about.supportTitle}" FontWeight="SemiBold" FontSize="15" Foreground="{DynamicResource Forest.Text}" />
                            <TextBlock Classes="note" Text="{local:Tr about.supportText}" Margin="0,4,0,0" />
                        </StackPanel>
                    </DockPanel>
                </Border>

                <!-- ===== ссылки и благодарности ===== -->
                <Grid ColumnDefinitions="*,14,*" Margin="0,14,0,0">
                    <Border Classes="card about">
                        <StackPanel>
                            <TextBlock Classes="cardTitle" Text="{local:Tr about.links}" Margin="0,0,0,10" />
                            <Button Theme="{StaticResource LinkRow}" Command="{Binding OpenUrlCommand}" CommandParameter="https://github.com/erneywhite/eViSTool">
                                <TextBlock Text="{local:Tr about.github}" FontSize="13" />
                            </Button>
                            <Button Theme="{StaticResource LinkRow}" Command="{Binding OpenUrlCommand}" CommandParameter="https://github.com/erneywhite/eViSTool/issues">
                                <TextBlock Text="{local:Tr about.issues}" FontSize="13" />
                            </Button>
                            <Button Theme="{StaticResource LinkRow}" Command="{Binding OpenUrlCommand}" CommandParameter="https://mods.vintagestory.at/">
                                <TextBlock Text="{local:Tr about.moddb}" FontSize="13" />
                            </Button>
                            <Button Theme="{StaticResource LinkRow}" Command="{Binding OpenKofiCommand}">
                                <TextBlock Text="Ko-fi · erneywhite" FontSize="13" />
                            </Button>
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="2" Classes="card about">
                        <StackPanel>
                            <TextBlock Classes="cardTitle" Text="{local:Tr about.credits}" Margin="0,0,0,10" />
                            <Button Theme="{StaticResource LinkRow}" Command="{Binding OpenUrlCommand}" CommandParameter="https://github.com/Tekunogosu/Rustique">
                                <StackPanel>
                                    <TextBlock Text="Rustique" FontSize="13" />
                                    <TextBlock Classes="note" Text="{local:Tr about.creditRustique}" Margin="0,2,12,0" />
                                </StackPanel>
                            </Button>
                            <Button Theme="{StaticResource LinkRow}" Command="{Binding OpenUrlCommand}" CommandParameter="https://mods.vintagestory.at/show/mod/17652">
                                <StackPanel>
                                    <TextBlock Text="ViSST Server Tool" FontSize="13" />
                                    <TextBlock Classes="note" Text="{local:Tr about.creditVisst}" Margin="0,2,12,0" />
                                </StackPanel>
                            </Button>
                            <TextBlock Classes="note" Text="{local:Tr about.creditGame}" Margin="0,12,0,0" />
                        </StackPanel>
                    </Border>
                </Grid>

                <TextBlock Classes="note" Text="© 2026 Erney White" Margin="2,16,0,16" />
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</UserControl>
