<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:eViSTool.Presentation.ViewModels"
        xmlns:local="using:eViSTool.Desktop"
        xmlns:ctl="using:eViSTool.Desktop.Controls"
        xmlns:views="using:eViSTool.Desktop.Views"
        xmlns:conv="using:eViSTool.Desktop.Converters"
        x:Class="eViSTool.Desktop.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Title="eViSTool" Icon="avares://eViSTool/Assets/eViSTool.ico"
        Width="1400" Height="860" MinWidth="860" MinHeight="480" WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <!-- фон из игры под боковой панелью (docs/design.md, раздел 5): вуалевые токены Forest.*Veil — в
             Themes/ForestResources.axaml вместе с остальными -->
        <!-- заглушка без картинки: «горизонтали» — группы волнистых линий, как на топографической карте; на ширину
             панели с запасом (−12…222) и на высоту до 1500 px, ниже — просто цвет Side -->
        <StreamGeometry x:Key="Backdrop.Contours">M-12,83 C-2,85 27,92 46,92 C66,92 86,88 105,85 C124,82 144,75 164,73 C183,72 212,75 222,76 M-12,100 C-2,102 27,109 46,109 C66,109 86,102 105,99 C124,95 144,87 164,86 C183,85 212,90 222,90 M-12,117 C-2,119 27,126 46,125 C66,124 86,116 105,112 C124,107 144,99 164,98 C183,97 212,105 222,106 M-12,322 C-2,320 27,313 46,309 C66,304 86,297 105,295 C124,294 144,296 164,299 C183,302 212,313 222,315 M-12,336 C-2,333 27,325 46,320 C66,315 86,307 105,306 C124,305 144,308 164,312 C183,317 212,329 222,332 M-12,349 C-2,346 27,336 46,330 C66,325 86,317 105,316 C124,316 144,321 164,327 C183,332 212,345 222,349 M-12,363 C-2,359 27,346 46,341 C66,335 86,327 105,328 C124,328 144,335 164,342 C183,348 212,362 222,366 M-12,590 C-2,589 27,586 46,588 C66,590 86,597 105,599 C124,601 144,602 164,600 C183,598 212,589 222,587 M-12,605 C-2,605 27,603 46,605 C66,607 86,616 105,618 C124,620 144,620 164,617 C183,614 212,604 222,602 M-12,621 C-2,621 27,619 46,621 C66,624 86,634 105,636 C124,638 144,637 164,634 C183,630 212,620 222,617 M-12,877 C-2,876 27,878 46,875 C66,871 86,861 105,856 C124,851 144,845 164,846 C183,846 212,855 222,857 M-12,891 C-2,890 27,891 46,886 C66,882 86,869 105,864 C124,859 144,854 164,855 C183,856 212,868 222,871 M-12,906 C-2,904 27,903 46,897 C66,892 86,877 105,872 C124,867 144,863 164,865 C183,867 212,882 222,886 M-12,920 C-2,918 27,915 46,908 C66,901 86,885 105,880 C124,875 144,872 164,876 C183,879 212,897 222,901 M-12,1154 C-2,1152 27,1144 46,1144 C66,1144 86,1149 105,1152 C124,1156 144,1164 164,1166 C183,1167 212,1162 222,1161 M-12,1169 C-2,1167 27,1159 46,1159 C66,1159 86,1165 105,1170 C124,1174 144,1183 164,1184 C183,1185 212,1177 222,1176 M-12,1184 C-2,1182 27,1173 46,1174 C66,1174 86,1182 105,1187 C124,1192 144,1201 164,1201 C183,1202 212,1193 222,1191 M-12,1416 C-2,1418 27,1421 46,1425 C66,1428 86,1434 105,1435 C124,1437 144,1435 164,1432 C183,1429 212,1420 222,1417 M-12,1428 C-2,1430 27,1435 46,1439 C66,1443 86,1450 105,1451 C124,1452 144,1449 164,1446 C183,1442 212,1432 222,1429 M-12,1440 C-2,1442 27,1449 46,1454 C66,1459 86,1466 105,1467 C124,1468 144,1464 164,1459 C183,1455 212,1444 222,1441</StreamGeometry>

        <!-- булавка в меню «Играть»: сервер по умолчанию -->
        <ControlTheme x:Key="PinToggle" TargetType="ToggleButton">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <ControlTemplate>
                    <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="5" Padding="{TemplateBinding Padding}">
                        <Path x:Name="Ic" Classes="icon" Data="{StaticResource Icon.Pin}" Width="14" Height="14" />
                    </Border>
                </ControlTemplate>
            </Setter>
            <Style Selector="^ /template/ Path#Ic">
                <Setter Property="Stroke" Value="{DynamicResource Forest.Muted}" />
            </Style>
            <Style Selector="^:pointerover /template/ Border#Bd">
                <Setter Property="Background" Value="{DynamicResource Forest.Base}" />
            </Style>
            <Style Selector="^:pointerover /template/ Path#Ic">
                <Setter Property="Stroke" Value="{DynamicResource Forest.Text}" />
            </Style>
            <Style Selector="^:checked /template/ Path#Ic">
                <Setter Property="Stroke" Value="{DynamicResource Forest.Accent}" />
            </Style>
        </ControlTheme>

        <!-- строка меню без своей рамки: фон даёт строка-родитель (или наведение, если задан класс hover) -->
        <ControlTheme x:Key="MenuRowButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <ControlTemplate>
                    <ContentPresenter x:Name="PART_ContentPresenter" Background="{TemplateBinding Background}"
                                      CornerRadius="{TemplateBinding CornerRadius}" Padding="{TemplateBinding Padding}"
                                      Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}"
                                      HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}" />
                </ControlTemplate>
            </Setter>
            <Style Selector="^.hover:pointerover /template/ ContentPresenter#PART_ContentPresenter">
                <Setter Property="Background" Value="{DynamicResource Forest.Raised}" />
            </Style>
        </ControlTheme>

        <!-- строка меню «Играть»: значок, имя и подпись — «сыграть один раз»; булавка — при наведении (и у выбранного) -->
        <DataTemplate x:Key="PlayMenuItem" x:DataType="vm:PlayMenuItemViewModel">
            <Border Classes="playRow" Classes.def="{Binding IsDefault}" CornerRadius="7" Margin="0,1">
                <DockPanel>
                    <ToggleButton Classes="pin" Theme="{StaticResource PinToggle}" DockPanel.Dock="Right" IsChecked="{Binding IsDefault, Mode=OneWay}"
                                  Margin="4,0,6,0" Padding="7" VerticalAlignment="Center" Click="PlayMenuPin_Click"
                                  ToolTip.Tip="{local:Tr play.pinTip}" AutomationProperties.Name="{local:Tr play.pinTip}" />
                    <Button Theme="{StaticResource MenuRowButton}" Click="PlayMenuItem_Click" Padding="12,8,8,8"
                            AutomationProperties.Name="{Binding Name}">
                        <DockPanel>
                            <!-- значок по виду: см. стили Path.kind в Window.Styles -->
                            <Path Classes="icon kind" Classes.none="{Binding IsNone}" Classes.own="{Binding IsOwn}"
                                  Classes.pwd="{Binding HasPassword}" Classes.def="{Binding IsDefault}"
                                  DockPanel.Dock="Left" Width="16" Height="16" Margin="0,1,12,0" VerticalAlignment="Top" />
                            <StackPanel>
                                <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource Forest.Text}"
                                           TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{Binding Detail}" FontSize="11" Foreground="{DynamicResource Forest.Muted}" Margin="0,1,0,0"
                                           TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{Binding VersionNote}" FontSize="11" Foreground="{DynamicResource Forest.Warn}" TextWrapping="Wrap"
                                           IsVisible="{Binding VersionNote, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                            </StackPanel>
                        </DockPanel>
                    </Button>
                </DockPanel>
            </Border>
        </DataTemplate>
    </Window.Resources>

    <Window.Styles>
        <!-- рекомендуемое обновление — тёплым цветом предупреждения, а не обычным акцентом -->
        <Style Selector="Button.warn">
            <Setter Property="Foreground" Value="{DynamicResource Forest.Warn}" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>

        <!-- меню «Играть»: подсветка строки при наведении и у выбранного по умолчанию, булавка видна там же -->
        <Style Selector="Border.playRow">
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <Style Selector="Border.playRow ToggleButton.pin">
            <Setter Property="Opacity" Value="0" />
        </Style>
        <Style Selector="Border.playRow:pointerover, Border.playRow.def">
            <Setter Property="Background" Value="{DynamicResource Forest.Raised}" />
        </Style>
        <Style Selector="Border.playRow:pointerover ToggleButton.pin, Border.playRow.def ToggleButton.pin">
            <Setter Property="Opacity" Value="1" />
        </Style>
        <!-- значок по виду: из избранного — звезда, без сервера — глобус, свой — сервер, с паролем — замок,
             выбранный по умолчанию — зелёная галочка. Порядок стилей = приоритет (последний побеждает). -->
        <Style Selector="Path.kind">
            <Setter Property="Data" Value="{StaticResource Icon.Star}" />
            <Setter Property="Stroke" Value="{DynamicResource Forest.Muted}" />
        </Style>
        <Style Selector="Path.kind.none">
            <Setter Property="Data" Value="{StaticResource Icon.Globe}" />
        </Style>
        <Style Selector="Path.kind.own">
            <Setter Property="Data" Value="{StaticResource Icon.Server}" />
        </Style>
        <Style Selector="Path.kind.pwd">
            <Setter Property="Data" Value="{StaticResource Icon.Lock}" />
        </Style>
        <Style Selector="Path.kind.def">
            <Setter Property="Data" Value="{StaticResource Icon.Check}" />
            <Setter Property="Stroke" Value="{DynamicResource Forest.Good}" />
        </Style>

        <!-- боковая панель: без картинки — цвет Side и «горизонтали»; с картинкой (класс backdrop у Root, ставит
             MainWindow.UpdateBackdrop) — вуаль над ней и вуалевые оттенки пункта меню и карточки профиля -->
        <Style Selector="Border#SideUnderlay">
            <Setter Property="Background" Value="{DynamicResource Forest.Side}" />
        </Style>
        <Style Selector="Border#ProfileCard">
            <Setter Property="Background" Value="{DynamicResource Forest.Surface}" />
        </Style>
        <Style Selector="Grid#Root.backdrop Border#SideUnderlay">
            <Setter Property="Background" Value="{DynamicResource Forest.SideVeil}" />
        </Style>
        <Style Selector="Grid#Root.backdrop Path#Contours">
            <Setter Property="IsVisible" Value="False" />
        </Style>
        <!-- пункты меню над картинкой: вуалевые подложки задаёт сама тема (Forest.NavItem) -->
        <Style Selector="Grid#Root.backdrop Border#ProfileCard">
            <Setter Property="Background" Value="{DynamicResource Forest.SideCardVeil}" />
        </Style>
    </Window.Styles>

    <Grid x:Name="Root" ColumnDefinitions="210,*" Background="{DynamicResource Forest.Base}">

        <!-- фон из игры: размытая заставка на всё окно, ниже всего; видна только под боковой панелью — правую часть
             закрывает непрозрачный фон страниц. Картинку выбирает и грузит MainWindow.UpdateBackdrop -->
        <Image x:Name="Backdrop" Grid.ColumnSpan="2" Stretch="UniformToFill" IsHitTestVisible="False"
               RenderOptions.BitmapInterpolationMode="HighQuality" />
        <!-- подложка боковой панели: над картинкой — вуаль, без картинки — цвет Side и неподвижные «горизонтали» -->
        <Border x:Name="SideUnderlay" ClipToBounds="True" IsHitTestVisible="False">
            <Path x:Name="Contours" Data="{StaticResource Backdrop.Contours}" Stroke="{DynamicResource Forest.Accent}" StrokeThickness="1"
                  Opacity="0.07" Stretch="None" HorizontalAlignment="Left" VerticalAlignment="Top" />
        </Border>

        <!-- ===== боковая колонка ===== -->
        <DockPanel Background="Transparent">
            <Border DockPanel.Dock="Right" Width="1" Background="{DynamicResource Forest.Line}" />

            <!-- лого и слоган; за них, как и за верхнюю полосу, окно можно тащить (своя шапка, см. MainWindow.SetupChrome) -->
            <DockPanel x:Name="LogoArea" DockPanel.Dock="Top" Background="Transparent" Margin="0,0,0,22">
                <Image Source="avares://eViSTool/Assets/logo256.png" Width="36" Height="36" VerticalAlignment="Top" Margin="16,20,0,0"
                       RenderOptions.BitmapInterpolationMode="HighQuality" />
                <StackPanel Margin="10,20,10,0" VerticalAlignment="Center">
                    <TextBlock Text="eViSTool" FontSize="19" FontWeight="SemiBold" Foreground="{DynamicResource Forest.Text}" />
                    <TextBlock Text="{local:Tr shell.slogan}" FontSize="11" Foreground="{DynamicResource Forest.Muted}" TextWrapping="Wrap" />
                </StackPanel>
            </DockPanel>

            <!-- низ: новая версия программы, версия игры профиля, автор -->
            <StackPanel DockPanel.Dock="Bottom" Margin="14,0,14,14">
                <!-- ссылка-кнопка показывает только текст (шаблон — один TextBlock), поэтому без иконки -->
                <Button Theme="{StaticResource Forest.LinkButton}" Classes.warn="{Binding About.IsRecommended}"
                        Command="{Binding ShowAboutCommand}" HorizontalAlignment="Left" Margin="4,0,0,10"
                        Content="{Binding About.UpdateBadgeText}" IsVisible="{Binding About.HasUpdate}"
                        AutomationProperties.AutomationId="UpdateBadge" />
                <!-- eViSTool обновили на диске (например, «Обновить на сервере» с другого компьютера), а перезапуск отложен -->
                <Button Theme="{StaticResource Forest.LinkButton}" Command="{Binding RestartUpdatedCommand}" HorizontalAlignment="Left" Margin="4,0,0,10"
                        Content="{Binding UpdatedOnDiskText}" IsVisible="{Binding HasUpdatedOnDisk}"
                        AutomationProperties.AutomationId="UpdatedOnDisk" />
                <Border x:Name="ProfileCard" CornerRadius="8" Padding="10,8">
                    <DockPanel>
                        <Border Background="{DynamicResource Forest.Raised}" CornerRadius="6" Width="30" Height="30" Margin="0,0,10,0">
                            <Panel>
                                <!-- значок из установленной игры; игры на компьютере нет — буквы -->
                                <Image x:Name="GameIconImage" Source="{Binding IconSearchDirs, Converter={x:Static conv:GameIconConverter.Instance}}" Width="24" Height="24" RenderOptions.BitmapInterpolationMode="HighQuality"
                                       IsVisible="{Binding $self.Source, Converter={x:Static ObjectConverters.IsNotNull}}" />
                                <TextBlock Text="VS" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource Forest.Text}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"
                                           IsVisible="{Binding #GameIconImage.Source, Converter={x:Static ObjectConverters.IsNull}}" />
                            </Panel>
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Vintage Story" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource Forest.Text}" />
                            <TextBlock FontSize="11" Foreground="{DynamicResource Forest.Muted}" TextWrapping="Wrap">
                                <Run Text="{local:Tr shell.profileVersion}" /><Run Text=" · " /><Run Text="{Binding ActiveProfile.GameVersionText, Mode=OneWay}" />
                            </TextBlock>
                        </StackPanel>
                    </DockPanel>
                </Border>
                <Button Theme="{StaticResource Forest.LinkButton}" Foreground="{DynamicResource Forest.Muted}" FontSize="11" Margin="4,10,0,0"
                        HorizontalAlignment="Left" ToolTip.Tip="https://github.com/erneywhite/eViSTool"
                        Command="{Binding About.OpenUrlCommand}" CommandParameter="https://github.com/erneywhite/eViSTool"
                        Content="{local:Tr shell.madeBy}" />
            </StackPanel>

            <!-- навигация: порядок пунктов = порядок разделов -->
            <StackPanel Margin="12,0,12,0">
                <ListBox x:Name="Nav" SelectedIndex="{Binding SelectedTab}" Background="Transparent" BorderThickness="0" Padding="0"
                         ItemContainerTheme="{StaticResource Forest.NavItem}" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBoxItem AutomationProperties.AutomationId="NavMods">
                        <DockPanel>
                            <Border DockPanel.Dock="Right" Background="{DynamicResource Forest.Raised}" CornerRadius="4" Padding="6,1" VerticalAlignment="Center">
                                <TextBlock Text="{Binding Mods.ModCount}" FontSize="11" Foreground="{DynamicResource Forest.Muted}" />
                            </Border>
                            <Path Classes="icon" Data="{StaticResource Icon.Mods}" />
                            <TextBlock Text="{local:Tr nav.mods}" Margin="10,0,0,0" VerticalAlignment="Center" FontSize="13" />
                        </DockPanel>
                    </ListBoxItem>
                    <ListBoxItem>
                        <DockPanel>
                            <Path Classes="icon" Data="{StaticResource Icon.Catalog}" />
                            <TextBlock Text="{local:Tr nav.catalog}" Margin="10,0,0,0" VerticalAlignment="Center" FontSize="13" />
                        </DockPanel>
                    </ListBoxItem>
                    <ListBoxItem>
                        <DockPanel>
                            <Path Classes="icon" Data="{StaticResource Icon.ModConfig}" />
                            <TextBlock Text="{local:Tr nav.modConfig}" Margin="10,0,0,0" VerticalAlignment="Center" FontSize="13" />
                        </DockPanel>
                    </ListBoxItem>
                    <ListBoxItem>
                        <DockPanel>
                            <Path Classes="icon" Data="{StaticResource Icon.Server}" />
                            <TextBlock Text="{local:Tr nav.server}" Margin="10,0,0,0" VerticalAlignment="Center" FontSize="13" />
                        </DockPanel>
                    </ListBoxItem>
                    <ListBoxItem AutomationProperties.AutomationId="NavProfiles">
                        <DockPanel>
                            <Path Classes="icon" Data="{StaticResource Icon.Profiles}" />
                            <TextBlock Text="{local:Tr nav.profiles}" Margin="10,0,0,0" VerticalAlignment="Center" FontSize="13" />
                        </DockPanel>
                    </ListBoxItem>
                    <ListBoxItem AutomationProperties.AutomationId="NavSettings">
                        <DockPanel>
                            <Path Classes="icon" Data="{StaticResource Icon.Settings}" />
                            <TextBlock Text="{local:Tr nav.settings}" Margin="10,0,0,0" VerticalAlignment="Center" FontSize="13" />
                        </DockPanel>
                    </ListBoxItem>
                    <ListBoxItem>
                        <DockPanel>
                            <Path Classes="icon" Data="{StaticResource Icon.About}" />
                            <TextBlock Text="{local:Tr nav.about}" Margin="10,0,0,0" VerticalAlignment="Center" FontSize="13" />
                        </DockPanel>
                    </ListBoxItem>
                </ListBox>
            </StackPanel>
        </DockPanel>

        <!-- ===== основная часть ===== (фон непрозрачный: картинка фона из игры видна только под боковой панелью) -->
        <DockPanel Grid.Column="1" Background="{DynamicResource Forest.Base}">
            <!-- полоса: раздел и активный профиль. Она же шапка окна: тащится за пустое место и подписи, кнопки окна — справа
                 (место под них — CaptionSpace); кнопки и список профилей помечены ролью User, чтобы нажимались -->
            <Border x:Name="TopBar" DockPanel.Dock="Top" Height="60" Background="Transparent" BorderBrush="{DynamicResource Forest.Line}" BorderThickness="0,0,0,1">
                <DockPanel Margin="24,0,20,0">
                    <Border x:Name="CaptionSpace" DockPanel.Dock="Right" Width="0" />
                    <!-- игра с активным клиентским профилем: его папка данных, его моды -->
                    <!-- «Играть ▾»: большая часть — с сервером по умолчанию (или без сервера), стрелка — меню серверов -->
                    <Button x:Name="PlayMenuButton" DockPanel.Dock="Right" Classes="primary splitArrow" Click="PlayMenu_Click" WindowDecorationProperties.ElementRole="User"
                            VerticalAlignment="Center" Height="36" MinHeight="0" Padding="0" Width="34" BorderThickness="0,1,1,1"
                            ToolTip.Tip="{local:Tr play.menuTip}" IsVisible="{Binding CanPlay}"
                            AutomationProperties.AutomationId="PlayMenuButton" AutomationProperties.Name="{local:Tr play.menuTip}">
                        <!-- слева — тонкий разделитель между «Играть» и стрелкой -->
                        <Panel Width="33" Height="34">
                            <Rectangle Width="1" HorizontalAlignment="Left" Margin="0,7" Fill="{DynamicResource Forest.AccentInk}" Opacity="0.25" />
                            <Path Classes="icon" Data="{StaticResource Icon.ChevronDown}" Width="12" Height="12" />
                        </Panel>
                    </Button>
                    <Popup x:Name="PlayMenu" DockPanel.Dock="Right" PlacementTarget="{Binding #PlayMenuButton}" Placement="BottomEdgeAlignedRight"
                           VerticalOffset="6" IsLightDismissEnabled="True">
                        <Border Width="360" Background="{DynamicResource Forest.Surface}" BorderBrush="{DynamicResource Forest.Line}" BorderThickness="1"
                                CornerRadius="12" Padding="8">
                            <StackPanel>
                                <ContentControl Content="{Binding PlayNoServer}" ContentTemplate="{StaticResource PlayMenuItem}" Focusable="False" />

                                <StackPanel IsVisible="{Binding HasPlayOwnServers}">
                                    <Border BorderBrush="{DynamicResource Forest.Line}" BorderThickness="0,1,0,0" Margin="6,6,6,0" />
                                    <TextBlock Text="{local:Tr play.ownServers}" FontSize="11" Foreground="{DynamicResource Forest.Muted}" Margin="12,8,0,2" />
                                    <ItemsControl ItemsSource="{Binding PlayOwnServers}" ItemTemplate="{StaticResource PlayMenuItem}" Focusable="False" />
                                </StackPanel>

                                <StackPanel IsVisible="{Binding HasPlayFavorites}">
                                    <Border BorderBrush="{DynamicResource Forest.Line}" BorderThickness="0,1,0,0" Margin="6,6,6,0" />
                                    <TextBlock Text="{local:Tr play.favorites}" FontSize="11" Foreground="{DynamicResource Forest.Muted}" Margin="12,8,0,2" />
                                    <ItemsControl ItemsSource="{Binding PlayFavorites}" ItemTemplate="{StaticResource PlayMenuItem}" Focusable="False" />
                                    <TextBlock Text="{Binding PlayFavoritesMore}" FontSize="11" Foreground="{DynamicResource Forest.Muted}" Margin="12,2,0,4"
                                               IsVisible="{Binding PlayFavoritesMore, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                                </StackPanel>

                                <Border BorderBrush="{DynamicResource Forest.Line}" BorderThickness="0,1,0,0" Margin="6,6,6,2" />
                                <!-- «Найти сервер…»: общий список и избранное целиком -->
                                <Button Theme="{StaticResource MenuRowButton}" Classes="hover" Click="FindServer_Click" CornerRadius="7" Padding="12,8,8,8"
                                        AutomationProperties.AutomationId="PlayFindServer">
                                    <DockPanel>
                                        <Path Classes="icon" DockPanel.Dock="Left" Data="{StaticResource Icon.Search}" Width="16" Height="16"
                                              Margin="0,1,12,0" VerticalAlignment="Top" Stroke="{DynamicResource Forest.Muted}" />
                                        <StackPanel>
                                            <TextBlock Text="{local:Tr play.findServer}" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource Forest.Text}" />
                                            <TextBlock Text="{local:Tr play.findServerHint}" FontSize="11" Foreground="{DynamicResource Forest.Muted}" Margin="0,1,0,0" />
                                        </StackPanel>
                                    </DockPanel>
                                </Button>

                                <TextBlock Text="{local:Tr play.menuHint}" FontSize="11" Foreground="{DynamicResource Forest.Muted}" TextWrapping="Wrap"
                                           Margin="12,8,12,4" />
                            </StackPanel>
                        </Border>
                    </Popup>
                    <Button DockPanel.Dock="Right" Classes="primary splitMain" Command="{Binding PlayCommand}" WindowDecorationProperties.ElementRole="User"
                            VerticalAlignment="Center" Height="36" MinHeight="0" Padding="13,0" Margin="12,0,0,0" BorderThickness="1,1,0,1"
                            ToolTip.Tip="{Binding PlayTip}" ToolTip.ShowOnDisabled="True"
                            IsVisible="{Binding CanPlay}" AutomationProperties.AutomationId="PlayButton">
                        <StackPanel Orientation="Horizontal">
                            <Path Classes="icon" Data="{StaticResource Icon.Play}" Width="13" Height="13" Margin="0,0,8,0" />
                            <TextBlock Text="{Binding PlayText}" MaxWidth="260" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                    </Button>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                        <!-- моды профиля сыплют ошибками (игра работает, но лог пухнет и бывают фризы) — отчёт по кнопке -->
                        <Button Command="{Binding ShowErrorsCommand}" ToolTip.Tip="{Binding ErrorBadgeTip}" Margin="0,0,10,0" Padding="10,4" MinHeight="0"
                                IsVisible="{Binding HasErrorBadge}" AutomationProperties.AutomationId="ErrorBadge" WindowDecorationProperties.ElementRole="User"
                                Background="{DynamicResource Forest.Warn}" BorderBrush="{DynamicResource Forest.Warn}">
                            <TextBlock Text="!" FontWeight="Bold" FontSize="14" Foreground="{DynamicResource Forest.Base}" />
                        </Button>
                        <TextBlock x:Name="ActiveProfileLabel" Text="{local:Tr shell.activeProfile}" VerticalAlignment="Center" Margin="0,0,10,0"
                                   Foreground="{DynamicResource Forest.Muted}" FontSize="12" />
                        <ComboBox x:Name="ProfileCombo" ItemsSource="{Binding Profiles}" SelectedItem="{Binding ActiveProfile}" MinWidth="240"
                                  AutomationProperties.AutomationId="ProfileCombo" WindowDecorationProperties.ElementRole="User">
                            <ComboBox.ItemTemplate>
                                <DataTemplate x:DataType="vm:ProfileViewModel">
                                    <StackPanel Orientation="Horizontal">
                                        <!-- сервер у хостера — облако перед именем -->
                                        <Path Classes="icon" Data="{StaticResource Icon.Cloud}" Width="13" Height="13" Margin="0,0,7,0" VerticalAlignment="Center"
                                              Stroke="{DynamicResource Forest.Accent}" IsVisible="{Binding IsHosted}" />
                                        <TextBlock>
                                            <Run Text="{Binding Name, Mode=OneWay}" FontWeight="SemiBold" /><Run Text=" · " Foreground="{DynamicResource Forest.Muted}" /><Run Text="{Binding KindText, Mode=OneWay}" Foreground="{DynamicResource Forest.Muted}" />
                                        </TextBlock>
                                    </StackPanel>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                    </StackPanel>
                    <TextBlock Text="{Binding PageTitle}" VerticalAlignment="Center" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource Forest.Text}"
                               TextTrimming="CharacterEllipsis" AutomationProperties.AutomationId="PageTitle" />
                </DockPanel>
            </Border>

            <!-- разделы: все живут всё время (прокрутка и раскрытые блоки не сбрасываются), виден один — по SelectedTab -->
            <Panel x:Name="Pages" Margin="16,12,16,12">
                <views:ModsView DataContext="{Binding Mods}" />
                <views:CatalogView DataContext="{Binding Catalog}" IsVisible="False" />
                <views:ModConfigView DataContext="{Binding ModConfig}" IsVisible="False" />
                <views:ServerView DataContext="{Binding Server}" IsVisible="False" />
                <views:ProfilesView IsVisible="False" />
                <views:SettingsView IsVisible="False" />
                <views:AboutView DataContext="{Binding About}" IsVisible="False" />
            </Panel>
        </DockPanel>
    </Grid>
</Window>
