<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:eViSTool.Presentation.ViewModels"
             xmlns:local="using:eViSTool.Desktop"
             xmlns:ctl="using:eViSTool.Desktop.Controls"
             xmlns:conv="using:eViSTool.Desktop.Converters"
             x:Class="eViSTool.Desktop.Views.ServerScheduleView"
             x:DataType="vm:ServerScheduleViewModel">
    <UserControl.Styles>
        <!-- карточка раздела вкладки -->
        <Style Selector="Border.scheduleCard">
            <Setter Property="Padding" Value="20,16,20,18" />
            <Setter Property="Margin" Value="0,0,0,14" />
        </Style>
        <!-- подпись настройки: здесь крупнее и без отступа сверху (строки разделяет линия Border.row) -->
        <Style Selector="TextBlock.label">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <!-- подсказка в поле папки копий: мельче текста и обрезается, а не переносится -->
        <Style Selector="TextBox.backupDir /template/ TextBlock#PART_Placeholder">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            <Setter Property="TextWrapping" Value="NoWrap" />
        </Style>
        <!-- метка у копии в списке: «вручную», «данные модов» -->
        <Style Selector="Border.badge">
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="Padding" Value="6,1" />
            <Setter Property="Margin" Value="10,0,0,0" />
            <Setter Property="Background" Value="{DynamicResource Forest.Raised}" />
        </Style>
        <Style Selector="Border.badge TextBlock">
            <Setter Property="FontSize" Value="10" />
            <Setter Property="Foreground" Value="{DynamicResource Forest.Muted}" />
        </Style>
    </UserControl.Styles>

    <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,14,0,0">
        <StackPanel Margin="0,0,14,0">
            <!-- ===== расписание копий ===== -->
            <Border Classes="card scheduleCard">
                <StackPanel>
                    <TextBlock Text="{local:Tr sched.backupsTitle}" Classes="cardTitle" />
                    <TextBlock Text="{local:Tr sched.backupsHint}" Classes="hint" />

                    <Border Classes="row">
                        <DockPanel>
                            <CheckBox DockPanel.Dock="Right" Theme="{StaticResource Forest.Switch}" IsChecked="{Binding BackupEnabled}" VerticalAlignment="Center"
                                      AutomationProperties.AutomationId="SchedBackupEnabled" AutomationProperties.Name="{local:Tr sched.enabled}" />
                            <StackPanel Margin="0,0,16,0">
                                <TextBlock Text="{local:Tr sched.enabled}" Classes="label" />
                                <TextBlock Text="{local:Tr sched.enabledHint}" Classes="hint" />
                            </StackPanel>
                        </DockPanel>
                    </Border>

                    <Border Classes="row">
                        <DockPanel>
                            <StackPanel DockPanel.Dock="Right" Width="130">
                                <TextBox Text="{Binding IntervalText}" VerticalContentAlignment="Center"
                                         AutomationProperties.AutomationId="SchedInterval" AutomationProperties.Name="{local:Tr sched.interval}" />
                            </StackPanel>
                            <StackPanel Margin="0,0,16,0">
                                <TextBlock Text="{local:Tr sched.interval}" Classes="label" />
                                <TextBlock Text="{local:Tr sched.intervalHint}" Classes="hint" />
                                <TextBlock Text="{Binding IntervalError}" Classes="error" FontSize="12"
                                           IsVisible="{Binding IntervalError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                            </StackPanel>
                        </DockPanel>
                    </Border>

                    <Border Classes="row">
                        <DockPanel>
                            <StackPanel DockPanel.Dock="Right" Width="130">
                                <TextBox Text="{Binding KeepText}" VerticalContentAlignment="Center"
                                         AutomationProperties.AutomationId="SchedKeep" AutomationProperties.Name="{local:Tr sched.keep}" />
                            </StackPanel>
                            <StackPanel Margin="0,0,16,0">
                                <TextBlock Text="{local:Tr sched.keep}" Classes="label" />
                                <TextBlock Text="{local:Tr sched.keepHint}" Classes="hint" />
                                <TextBlock Text="{Binding KeepError}" Classes="error" FontSize="12"
                                           IsVisible="{Binding KeepError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                            </StackPanel>
                        </DockPanel>
                    </Border>

                    <Border Classes="row">
                        <DockPanel>
                            <CheckBox DockPanel.Dock="Right" Theme="{StaticResource Forest.Switch}" IsChecked="{Binding OnlyWhenPlayed}" VerticalAlignment="Center"
                                      AutomationProperties.AutomationId="SchedOnlyWhenPlayed" AutomationProperties.Name="{local:Tr sched.onlyPlayed}" />
                            <StackPanel Margin="0,0,16,0">
                                <TextBlock Text="{local:Tr sched.onlyPlayed}" Classes="label" />
                                <TextBlock Text="{local:Tr sched.onlyPlayedHint}" Classes="hint" />
                            </StackPanel>
                        </DockPanel>
                    </Border>

                    <Border Classes="row">
                        <DockPanel>
                            <CheckBox DockPanel.Dock="Right" Theme="{StaticResource Forest.Switch}" IsChecked="{Binding Announce}" VerticalAlignment="Center"
                                      AutomationProperties.AutomationId="SchedAnnounce" AutomationProperties.Name="{local:Tr sched.announce}" />
                            <StackPanel Margin="0,0,16,0">
                                <TextBlock Text="{local:Tr sched.announce}" Classes="label" />
                                <TextBlock Text="{local:Tr sched.announceHint}" Classes="hint" />
                            </StackPanel>
                        </DockPanel>
                    </Border>

                    <!-- папка для копий: своя (в том числе сетевая) или Backups сервера -->
                    <Border Classes="row">
                        <StackPanel>
                            <TextBlock Text="{local:Tr backupdir.title}" Classes="label" />
                            <TextBlock Text="{Binding BackupDirHint}" Classes="hint" />
                            <DockPanel Margin="0,10,0,0">
                                <Button DockPanel.Dock="Right" Content="{local:Tr backupdir.default}" Command="{Binding DefaultBackupDirCommand}" Margin="8,0,0,0"
                                        Padding="12,6" AutomationProperties.AutomationId="SchedBackupDirDefault" />
                                <Button DockPanel.Dock="Right" Content="{local:Tr common.browse}" Command="{Binding BrowseBackupDirCommand}" Margin="8,0,0,0"
                                        Padding="12,6" AutomationProperties.AutomationId="SchedBackupDirBrowse" />
                                <!-- применяется, когда поле отпустили (LostFocus) или нажали Enter: на каждую букву проверять путь незачем;
                                     пусто — подсказкой видно, где копии лежат по умолчанию -->
                                <TextBox x:Name="BackupDirBox" Classes="backupDir" Text="{Binding BackupDirText, UpdateSourceTrigger=LostFocus}"
                                         PlaceholderText="{Binding BackupDirDefault}" VerticalContentAlignment="Center" KeyDown="BackupDirBox_KeyDown"
                                         AutomationProperties.AutomationId="SchedBackupDir" AutomationProperties.Name="{local:Tr backupdir.title}" />
                            </DockPanel>
                            <TextBlock Text="{local:Tr backupdir.checking}" FontSize="12" Foreground="{DynamicResource Forest.Muted}" Margin="0,6,0,0"
                                       IsVisible="{Binding BackupDirChecking}" />
                            <TextBlock Text="{Binding BackupDirError}" FontSize="12" Foreground="{DynamicResource Forest.Danger}" Margin="0,6,0,0" TextWrapping="Wrap"
                                       IsVisible="{Binding BackupDirError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                                       AutomationProperties.AutomationId="SchedBackupDirError" />
                            <TextBlock Text="{Binding BackupDirOk}" FontSize="12" Foreground="{DynamicResource Forest.Accent}" Margin="0,6,0,0" TextWrapping="Wrap"
                                       IsVisible="{Binding BackupDirOk, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>

            <!-- ===== перезапуски по расписанию ===== -->
            <Border Classes="card scheduleCard">
                <StackPanel>
                    <TextBlock Text="{local:Tr sched.restartTitle}" Classes="cardTitle" />
                    <TextBlock Text="{local:Tr sched.restartHint}" Classes="hint" />

                    <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                        <RadioButton Theme="{StaticResource Forest.Chip}" GroupName="RestartMode" Content="{local:Tr sched.restartOff}"
                                     IsChecked="{Binding RestartMode, Converter={x:Static conv:EnumEqualsConverter.Instance}, ConverterParameter=Off}"
                                     AutomationProperties.AutomationId="SchedRestartOff" />
                        <RadioButton Theme="{StaticResource Forest.Chip}" GroupName="RestartMode" Content="{local:Tr sched.restartInterval}"
                                     IsChecked="{Binding RestartMode, Converter={x:Static conv:EnumEqualsConverter.Instance}, ConverterParameter=Interval}"
                                     AutomationProperties.AutomationId="SchedRestartInterval" />
                        <RadioButton Theme="{StaticResource Forest.Chip}" GroupName="RestartMode" Content="{local:Tr sched.restartDaily}"
                                     IsChecked="{Binding RestartMode, Converter={x:Static conv:EnumEqualsConverter.Instance}, ConverterParameter=Daily}"
                                     AutomationProperties.AutomationId="SchedRestartDaily" />
                    </StackPanel>

                    <Border Classes="row" IsVisible="{Binding IsRestartInterval}">
                        <DockPanel>
                            <TextBox DockPanel.Dock="Right" Width="130" Text="{Binding RestartIntervalText}"
                                     VerticalContentAlignment="Center" VerticalAlignment="Top"
                                     AutomationProperties.AutomationId="SchedRestartHours" AutomationProperties.Name="{local:Tr sched.restartHours}" />
                            <StackPanel Margin="0,0,16,0">
                                <TextBlock Text="{local:Tr sched.restartHours}" Classes="label" />
                                <TextBlock Text="{local:Tr sched.restartHoursHint}" Classes="hint" />
                            </StackPanel>
                        </DockPanel>
                    </Border>

                    <Border Classes="row" IsVisible="{Binding IsRestartDaily}">
                        <DockPanel>
                            <TextBox DockPanel.Dock="Right" Width="220" Text="{Binding RestartTimesText}"
                                     VerticalContentAlignment="Center" VerticalAlignment="Top"
                                     AutomationProperties.AutomationId="SchedRestartTimes" AutomationProperties.Name="{local:Tr sched.restartTimes}" />
                            <StackPanel Margin="0,0,16,0">
                                <TextBlock Text="{local:Tr sched.restartTimes}" Classes="label" />
                                <TextBlock Text="{local:Tr sched.restartTimesHint}" Classes="hint" />
                                <TextBlock Text="{Binding ServerTimeNote}" FontSize="12" Foreground="{DynamicResource Forest.Warn}" TextWrapping="Wrap"
                                           Margin="0,4,0,0" IsVisible="{Binding ServerTimeNote, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                                           AutomationProperties.AutomationId="SchedServerTime" />
                            </StackPanel>
                        </DockPanel>
                    </Border>

                    <Border Classes="row" IsVisible="{Binding IsRestartOn}">
                        <DockPanel>
                            <TextBox DockPanel.Dock="Right" Width="220" Text="{Binding RestartWarnText}"
                                     VerticalContentAlignment="Center" VerticalAlignment="Top"
                                     AutomationProperties.AutomationId="SchedRestartWarn" AutomationProperties.Name="{local:Tr sched.restartWarn}" />
                            <StackPanel Margin="0,0,16,0">
                                <TextBlock Text="{local:Tr sched.restartWarn}" Classes="label" />
                                <TextBlock Text="{local:Tr sched.restartWarnHint}" Classes="hint" />
                            </StackPanel>
                        </DockPanel>
                    </Border>

                    <Border Classes="row" IsVisible="{Binding IsRestartOn}">
                        <DockPanel>
                            <CheckBox DockPanel.Dock="Right" Theme="{StaticResource Forest.Switch}" IsChecked="{Binding RestartBackup}" VerticalAlignment="Center"
                                      AutomationProperties.AutomationId="SchedRestartBackup" AutomationProperties.Name="{local:Tr sched.restartBackup}" />
                            <StackPanel Margin="0,0,16,0">
                                <TextBlock Text="{local:Tr sched.restartBackup}" Classes="label" />
                                <TextBlock Text="{local:Tr sched.restartBackupHint}" Classes="hint" />
                            </StackPanel>
                        </DockPanel>
                    </Border>

                    <Border Classes="row" IsVisible="{Binding IsRestartOn}">
                        <DockPanel>
                            <CheckBox DockPanel.Dock="Right" Theme="{StaticResource Forest.Switch}" IsChecked="{Binding RestartUpdateMods}" VerticalAlignment="Center"
                                      AutomationProperties.AutomationId="SchedRestartUpdateMods" AutomationProperties.Name="{local:Tr sched.restartUpdateMods}" />
                            <StackPanel Margin="0,0,16,0">
                                <TextBlock Text="{local:Tr sched.restartUpdateMods}" Classes="label" />
                                <TextBlock Text="{local:Tr sched.restartUpdateModsHint}" Classes="hint" />
                            </StackPanel>
                        </DockPanel>
                    </Border>

                    <TextBlock Text="{Binding RestartError}" FontSize="12" Foreground="{DynamicResource Forest.Danger}" Margin="0,10,0,0"
                               IsVisible="{Binding RestartError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                    <TextBlock Text="{Binding NextRestartText}" FontSize="12" Foreground="{DynamicResource Forest.Accent}" Margin="0,12,0,0"
                               IsVisible="{Binding NextRestartText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                               AutomationProperties.AutomationId="SchedRestartNext" />
                </StackPanel>
            </Border>

            <!-- ===== копии на диске ===== -->
            <Border Classes="card scheduleCard">
                <StackPanel>
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top">
                            <Button Command="{Binding OpenFolderCommand}" Padding="10,8" Margin="0,0,8,0" ToolTip.Tip="{local:Tr sched.openFolder}"
                                    IsVisible="{Binding IsLocal}">
                                <Path Classes="icon" Data="{StaticResource Icon.Folder}" Width="16" Height="16" />
                            </Button>
                            <Button Classes="primary" Command="{Binding BackupNowCommand}" ToolTip.Tip="{local:Tr sched.nowTip}"
                                    ToolTip.ShowOnDisabled="True" AutomationProperties.AutomationId="SchedBackupNow">
                                <StackPanel Orientation="Horizontal">
                                    <Path Classes="icon" Data="{StaticResource Icon.Download}" Width="14" Height="14" Margin="0,0,8,0" />
                                    <TextBlock Text="{local:Tr sched.now}" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                        <StackPanel>
                            <TextBlock Text="{local:Tr sched.listTitle}" Classes="cardTitle" />
                            <TextBlock Classes="hint" FontSize="12">
                                <Run Text="{Binding LastBackupText, Mode=OneWay}" /><Run Text="   ·   " /><Run Text="{Binding NextBackupText, Mode=OneWay}" />
                            </TextBlock>
                            <TextBlock Text="{Binding TotalText}" Classes="hint" FontSize="12"
                                       IsVisible="{Binding TotalText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                                       AutomationProperties.AutomationId="SchedTotal" />
                        </StackPanel>
                    </DockPanel>

                    <TextBlock Text="{Binding StatusText}" FontSize="12" Foreground="{DynamicResource Forest.Accent}" TextWrapping="Wrap" Margin="0,10,0,0"
                               IsVisible="{Binding StatusText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                               AutomationProperties.AutomationId="SchedStatus" />

                    <TextBlock Text="{local:Tr sched.empty}" Classes="hint" FontSize="12" Margin="0,14,0,0" IsVisible="{Binding !HasBackups}" />

                    <ItemsControl ItemsSource="{Binding Backups}" Margin="0,6,0,0" Focusable="False">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:BackupRowViewModel">
                                <Border BorderBrush="{DynamicResource Forest.Line}" BorderThickness="0,1,0,0" Padding="0,9" Margin="0,4,0,0">
                                    <DockPanel>
                                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                            <Button Theme="{StaticResource Forest.LinkButton}" Content="{local:Tr sched.restore}" Margin="0,0,14,0"
                                                    ToolTip.Tip="{local:Tr sched.restoreTip}" ToolTip.ShowOnDisabled="True"
                                                    Command="{Binding $parent[UserControl].((vm:ServerScheduleViewModel)DataContext).RestoreCommand}"
                                                    CommandParameter="{Binding}" />
                                            <Button Theme="{StaticResource Forest.LinkButton}" Content="{local:Tr sched.show}" Margin="0,0,14,0"
                                                    IsVisible="{Binding IsLocal}"
                                                    Command="{Binding $parent[UserControl].((vm:ServerScheduleViewModel)DataContext).ShowInFolderCommand}"
                                                    CommandParameter="{Binding}" />
                                            <Button Theme="{StaticResource Forest.LinkButton}" Content="{local:Tr sched.delete}" Foreground="{DynamicResource Forest.Danger}"
                                                    Command="{Binding $parent[UserControl].((vm:ServerScheduleViewModel)DataContext).DeleteCommand}"
                                                    CommandParameter="{Binding}" />
                                        </StackPanel>
                                        <TextBlock DockPanel.Dock="Right" Text="{Binding SizeText}" FontSize="12" Foreground="{DynamicResource Forest.Muted}"
                                                   VerticalAlignment="Center" Margin="16,0,24,0" MinWidth="70" TextAlignment="Right" />
                                        <TextBlock DockPanel.Dock="Right" Text="{Binding TimeText}" FontSize="12" Foreground="{DynamicResource Forest.Text}"
                                                   VerticalAlignment="Center" Margin="16,0,0,0" />
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Name}" Classes="mono" FontSize="12" Foreground="{DynamicResource Forest.Text}"
                                                       TextTrimming="CharacterEllipsis" />
                                            <Border Classes="badge" ToolTip.Tip="{local:Tr sched.manualTip}" IsVisible="{Binding IsManual}">
                                                <TextBlock Text="{local:Tr sched.manual}" />
                                            </Border>
                                            <Border Classes="badge" ToolTip.Tip="{Binding ModDataTip}" IsVisible="{Binding HasModData}">
                                                <TextBlock Text="{local:Tr sched.modData}" />
                                            </Border>
                                        </StackPanel>
                                    </DockPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
