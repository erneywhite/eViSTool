<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:eViSTool.Presentation.ViewModels"
             xmlns:local="using:eViSTool.Desktop"
             xmlns:ctl="using:eViSTool.Desktop.Controls"
             x:Class="eViSTool.Desktop.Views.SettingsView"
             x:DataType="vm:MainViewModel">
    <UserControl.Styles>
        <!-- пояснение под заголовком и полем: здесь с отступом снизу -->
        <Style Selector="TextBlock.hint">
            <Setter Property="Margin" Value="0,2,0,6" />
        </Style>
        <!-- смысловой блок страницы -->
        <Style Selector="Border.settingsCard">
            <Setter Property="Padding" Value="20,16,20,20" />
            <Setter Property="Margin" Value="0,0,0,14" />
        </Style>
        <!-- переключатель с подписью и пояснением -->
        <Style Selector="TextBlock.switchTitle">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Foreground" Value="{DynamicResource Forest.Text}" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <!-- состояние в блоке оповещений: обычное — акцентом, ошибка — красным -->
        <Style Selector="TextBlock.notifyStatus">
            <Setter Property="Foreground" Value="{DynamicResource Forest.Accent}" />
        </Style>
        <Style Selector="TextBlock.notifyStatus.bad">
            <Setter Property="Foreground" Value="{DynamicResource Forest.Danger}" />
        </Style>
    </UserControl.Styles>

    <DockPanel Margin="10,4,10,0">
        <!-- ===== заголовок ===== -->
        <StackPanel DockPanel.Dock="Top">
            <TextBlock Text="{local:Tr nav.settings}" Classes="pageTitle" />
            <TextBlock Text="{local:Tr settings.subtitle}" Foreground="{DynamicResource Forest.Accent}" FontSize="12" Margin="0,4,0,0" />
        </StackPanel>
        <Border DockPanel.Dock="Top" BorderBrush="{DynamicResource Forest.Line}" BorderThickness="0,0,0,1" Margin="0,14,0,14" />

        <!-- общее для всей программы, смысловыми блоками; всё про конкретный профиль — в «Профилях». Колонка на всю
             ширину окна, как на других вкладках -->
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="0,0,14,0">

                <!-- ===== вид ===== -->
                <Border Classes="card settingsCard">
                    <StackPanel>
                        <TextBlock Text="{local:Tr settings.view}" Classes="cardTitle" />

                        <TextBlock Text="{local:Tr settings.language}" Classes="label" />
                        <ComboBox ItemsSource="{Binding Languages}" SelectedItem="{Binding SelectedLanguage}" Width="240"
                                  HorizontalAlignment="Left" Margin="0,6,0,0" ctl:WheelToParent.IsEnabled="True"
                                  AutomationProperties.AutomationId="Language" AutomationProperties.Name="{local:Tr settings.language}" />

                        <!-- размытая заставка игры под боковой панелью; выключено — спокойный узор -->
                        <Border Classes="row" Margin="0,18,0,0">
                            <DockPanel>
                                <CheckBox DockPanel.Dock="Right" Theme="{StaticResource Forest.Switch}" IsChecked="{Binding GameBackground}"
                                          VerticalAlignment="Center" AutomationProperties.AutomationId="GameBackground"
                                          AutomationProperties.Name="{local:Tr settings.gameBackground}" />
                                <StackPanel Margin="0,0,16,0">
                                    <TextBlock Text="{local:Tr settings.gameBackground}" Classes="switchTitle" />
                                    <TextBlock Text="{local:Tr settings.gameBackgroundHint}" Classes="hint" />
                                </StackPanel>
                            </DockPanel>
                        </Border>
                        <Border Classes="row" Margin="0,10,0,0" IsVisible="{Binding CanChooseWindowFrame}">
                            <DockPanel>
                                <CheckBox DockPanel.Dock="Right" Theme="{StaticResource Forest.Switch}" IsChecked="{Binding SystemWindowFrame}"
                                          VerticalAlignment="Center" AutomationProperties.AutomationId="SystemWindowFrame"
                                          AutomationProperties.Name="{local:Tr settings.systemFrame}" />
                                <StackPanel Margin="0,0,16,0">
                                    <TextBlock Text="{local:Tr settings.systemFrame}" Classes="switchTitle" />
                                    <TextBlock Text="{local:Tr settings.systemFrameHint}" Classes="hint" />
                                </StackPanel>
                            </DockPanel>
                        </Border>
                    </StackPanel>
                </Border>

                <!-- ===== обновления ===== -->
                <Border Classes="card settingsCard">
                    <StackPanel>
                        <TextBlock Text="{local:Tr settings.updates}" Classes="cardTitle" />

                        <!-- первая строка блока — без линии сверху: её отделяет заголовок -->
                        <DockPanel Margin="0,14,0,0">
                            <CheckBox DockPanel.Dock="Right" Theme="{StaticResource Forest.Switch}" IsChecked="{Binding AutoCheckUpdates}"
                                      VerticalAlignment="Center" AutomationProperties.AutomationId="AutoCheckUpdates"
                                      AutomationProperties.Name="{local:Tr settings.autoCheck}" />
                            <StackPanel Margin="0,0,16,0">
                                <TextBlock Text="{local:Tr settings.autoCheck}" Classes="switchTitle" />
                                <TextBlock Text="{local:Tr settings.autoCheckHint}" Classes="hint" />
                            </StackPanel>
                        </DockPanel>
                        <Border Classes="row" Margin="0,10,0,0">
                            <DockPanel>
                                <CheckBox DockPanel.Dock="Right" Theme="{StaticResource Forest.Switch}" IsChecked="{Binding AllowUnstable}"
                                          VerticalAlignment="Center" AutomationProperties.AutomationId="AllowUnstable"
                                          AutomationProperties.Name="{local:Tr settings.allowUnstable}" />
                                <StackPanel Margin="0,0,16,0">
                                    <TextBlock Text="{local:Tr settings.allowUnstable}" Classes="switchTitle" />
                                    <TextBlock Text="{local:Tr settings.allowUnstableHint}" Classes="hint" />
                                </StackPanel>
                            </DockPanel>
                        </Border>
                    </StackPanel>
                </Border>

                <!-- ===== моды ===== -->
                <Border Classes="card settingsCard">
                    <StackPanel>
                        <TextBlock Text="{local:Tr settings.mods}" Classes="cardTitle" />

                        <DockPanel Margin="0,14,0,0">
                            <CheckBox DockPanel.Dock="Right" Theme="{StaticResource Forest.Switch}" IsChecked="{Binding AlsoInstallWithoutAsking}"
                                      VerticalAlignment="Center" AutomationProperties.AutomationId="AlsoWithoutAsking"
                                      AutomationProperties.Name="{local:Tr settings.alsoSilent}" />
                            <StackPanel Margin="0,0,16,0">
                                <TextBlock Text="{local:Tr settings.alsoSilent}" Classes="switchTitle" />
                                <TextBlock Text="{local:Tr settings.alsoSilentHint}" Classes="hint" />
                            </StackPanel>
                        </DockPanel>
                        <Border Classes="row" Margin="0,10,0,0">
                            <DockPanel>
                                <CheckBox DockPanel.Dock="Right" Theme="{StaticResource Forest.Switch}" IsChecked="{Binding CopyWorldsBeforeModChanges}"
                                          VerticalAlignment="Center" AutomationProperties.AutomationId="CopyWorlds"
                                          AutomationProperties.Name="{local:Tr settings.copyWorlds}" />
                                <StackPanel Margin="0,0,16,0">
                                    <TextBlock Text="{local:Tr settings.copyWorlds}" Classes="switchTitle" />
                                    <TextBlock Text="{local:Tr settings.copyWorldsHint}" Classes="hint" />
                                </StackPanel>
                            </DockPanel>
                        </Border>
                    </StackPanel>
                </Border>

                <!-- ===== оповещения: каналы настраиваются здесь один раз, у серверов включаются на вкладке «Оповещения» ===== -->
                <ContentControl Content="{Binding Notify}" HorizontalContentAlignment="Stretch">
                    <ContentControl.ContentTemplate>
                        <DataTemplate x:DataType="vm:NotifyChannelsViewModel">
                            <Border Classes="card settingsCard">
                                <StackPanel>
                                    <DockPanel>
                                        <Button DockPanel.Dock="Right" Command="{Binding AddChannelCommand}" VerticalAlignment="Top" Margin="16,0,0,0"
                                                AutomationProperties.AutomationId="NotifyAddChannel">
                                            <StackPanel Orientation="Horizontal">
                                                <Path Classes="icon" Data="{StaticResource Icon.Plus}" Width="12" Height="12" Margin="0,0,7,0" />
                                                <TextBlock Text="{local:Tr notify.add}" />
                                            </StackPanel>
                                        </Button>
                                        <StackPanel>
                                            <TextBlock Text="{local:Tr notify.cardTitle}" Classes="cardTitle" />
                                            <TextBlock Text="{local:Tr notify.cardHint}" Classes="hint" />
                                        </StackPanel>
                                    </DockPanel>
                                    <TextBlock Classes="notifyStatus" Classes.bad="{Binding StatusIsError}" Text="{Binding StatusText}" FontSize="12"
                                               TextWrapping="Wrap" Margin="0,10,0,0" AutomationProperties.AutomationId="NotifyCardStatus"
                                               IsVisible="{Binding StatusText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                                    <TextBlock Text="{local:Tr notify.empty}" Classes="hint" FontSize="12" Margin="0,12,0,0"
                                               IsVisible="{Binding !HasChannels}" />
                                    <ItemsControl ItemsSource="{Binding Channels}" Margin="0,6,0,0" Focusable="False">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="vm:NotifyChannelRowViewModel">
                                                <Border BorderBrush="{DynamicResource Forest.Line}" BorderThickness="0,1,0,0" Padding="0,9" Margin="0,4,0,0">
                                                    <DockPanel>
                                                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                                            <Button Theme="{StaticResource Forest.LinkButton}" Content="{local:Tr notify.test}" Margin="0,0,14,0"
                                                                    Command="{Binding $parent[ItemsControl].((vm:NotifyChannelsViewModel)DataContext).TestChannelCommand}"
                                                                    CommandParameter="{Binding}" />
                                                            <Button Theme="{StaticResource Forest.LinkButton}" Content="{local:Tr notify.edit}" Margin="0,0,14,0"
                                                                    Command="{Binding $parent[ItemsControl].((vm:NotifyChannelsViewModel)DataContext).EditChannelCommand}"
                                                                    CommandParameter="{Binding}" />
                                                            <Button Theme="{StaticResource Forest.LinkButton}" Content="{local:Tr notify.delete}" Foreground="{DynamicResource Forest.Danger}"
                                                                    Command="{Binding $parent[ItemsControl].((vm:NotifyChannelsViewModel)DataContext).DeleteChannelCommand}"
                                                                    CommandParameter="{Binding}" />
                                                        </StackPanel>
                                                        <ctl:ChannelLogo DockPanel.Dock="Left" Kind="{Binding Kind}" VerticalAlignment="Center" Margin="0,0,12,0" />
                                                        <StackPanel>
                                                            <TextBlock Text="{Binding Name}" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource Forest.Text}"
                                                                       TextTrimming="CharacterEllipsis" />
                                                            <TextBlock Text="{Binding Details}" FontSize="11" Foreground="{DynamicResource Forest.Muted}" Margin="0,2,0,0"
                                                                       TextTrimming="CharacterEllipsis" />
                                                        </StackPanel>
                                                    </DockPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ContentControl.ContentTemplate>
                </ContentControl>

                <!-- ===== данные программы: где лежат ===== -->
                <Border Classes="card settingsCard">
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Command="{Binding OpenDataFolderCommand}" VerticalAlignment="Center" Margin="16,0,0,0">
                            <StackPanel Orientation="Horizontal">
                                <Path Classes="icon" Data="{StaticResource Icon.Folder}" Width="14" Height="14" Margin="0,0,8,0" />
                                <TextBlock Text="{local:Tr common.open}" />
                            </StackPanel>
                        </Button>
                        <StackPanel>
                            <TextBlock Text="{local:Tr settings.appData}" Classes="cardTitle" />
                            <TextBlock Text="{local:Tr settings.appDataHint}" Classes="hint" />
                            <TextBlock Classes="mono" Text="{Binding DataLocationText}" FontSize="12" Foreground="{DynamicResource Forest.Text}" TextWrapping="Wrap"
                                       Margin="0,6,0,0" />
                        </StackPanel>
                    </DockPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</UserControl>
