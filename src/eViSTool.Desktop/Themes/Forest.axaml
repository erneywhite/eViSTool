<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ctl="using:eViSTool.Desktop.Controls">
    <!--
        Стили лесной темы для элементов без шаблона — классы вместо стилей по ключу:
        Style="{StaticResource Forest.Card}" → Classes="card", Forest.Icon → Classes="icon" и т.д.
        Общие подписи, чтобы не повторять локальные стили в каждом экране (Hint, Label, CardTitle, Row,
        ErrorText), тоже здесь. Отличие конкретного экрана — локальным значением или локальным стилем.
        Важно: значение, которое меняет класс или состояние, задавать стилем, а не атрибутом — атрибут (локальное
        значение) в Avalonia сильнее любого стиля.
        Типографика (docs/design.md, раздел 4): заголовок страницы 28, окна-диалога 20, карточки 16, основной текст 13,
        подписи 12, мелкие пометки 11; заголовки прямые.
    -->

    <!-- основной текст — 13 (у Fluent по умолчанию 14) -->
    <Style Selector="Window">
        <Setter Property="Background" Value="{DynamicResource Forest.Base}" />
        <Setter Property="Foreground" Value="{DynamicResource Forest.Text}" />
        <Setter Property="FontSize" Value="13" />
    </Style>

    <!-- контурная иконка: Data = геометрия Icon.*, цвет линии — наследуемый цвет текста родителя -->
    <Style Selector="Path.icon">
        <Setter Property="Width" Value="18" />
        <Setter Property="Height" Value="18" />
        <Setter Property="Stretch" Value="Uniform" />
        <Setter Property="StrokeThickness" Value="1.6" />
        <Setter Property="StrokeLineCap" Value="Round" />
        <Setter Property="StrokeJoin" Value="Round" />
        <Setter Property="Stroke" Value="{Binding $self.(TextElement.Foreground)}" />
    </Style>

    <!-- ===== подписи ===== -->
    <Style Selector="TextBlock.muted">
        <Setter Property="Foreground" Value="{DynamicResource Forest.Muted}" />
    </Style>
    <Style Selector="TextBlock.pageTitle">
        <Setter Property="FontSize" Value="28" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource Forest.Text}" />
    </Style>
    <!-- окно программы: заголовок, строка-пояснение под ним и строка кнопок внизу (отступ сверху — у каждого окна свой) -->
    <Style Selector="TextBlock.dialogTitle">
        <Setter Property="FontSize" Value="20" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource Forest.Text}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style Selector="TextBlock.dialogLead">
        <Setter Property="Foreground" Value="{DynamicResource Forest.Muted}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="Margin" Value="0,4,0,0" />
    </Style>
    <Style Selector="StackPanel.dialogButtons">
        <Setter Property="Orientation" Value="Horizontal" />
        <Setter Property="HorizontalAlignment" Value="Right" />
    </Style>
    <!-- пояснение под полем (Hint) -->
    <Style Selector="TextBlock.hint">
        <Setter Property="Foreground" Value="{DynamicResource Forest.Muted}" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="Margin" Value="0,2,0,0" />
    </Style>
    <!-- подпись поля (Label) -->
    <Style Selector="TextBlock.label">
        <Setter Property="Foreground" Value="{DynamicResource Forest.Text}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Margin" Value="0,16,0,0" />
    </Style>
    <!-- заголовок карточки (CardTitle) -->
    <Style Selector="TextBlock.cardTitle">
        <Setter Property="Foreground" Value="{DynamicResource Forest.Text}" />
        <Setter Property="FontSize" Value="16" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <!-- ошибка под полем (ErrorText) -->
    <Style Selector="TextBlock.error">
        <Setter Property="Foreground" Value="{DynamicResource Forest.Danger}" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="Margin" Value="0,4,0,0" />
    </Style>
    <!-- моноширинный текст: версии, код, пути -->
    <Style Selector="TextBlock.mono">
        <Setter Property="FontFamily" Value="{DynamicResource Forest.Mono}" />
    </Style>
    <Style Selector="TextBox.mono">
        <Setter Property="FontFamily" Value="{DynamicResource Forest.Mono}" />
    </Style>

    <!-- текст, который можно выделить и скопировать, но не править (Forest.SelectableText) -->
    <Style Selector="SelectableTextBlock.selectable">
        <Setter Property="Foreground" Value="{DynamicResource Forest.Muted}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="SelectionBrush" Value="{DynamicResource Forest.Selection}" />
    </Style>
    <Style Selector="SelectableTextBlock">
        <Setter Property="SelectionBrush" Value="{DynamicResource Forest.Selection}" />
    </Style>

    <!-- ===== панели (раздел 2: глубина) ===== -->
    <!-- карточка «приподнята»: светлая кромка сверху и короткая тёмная тень снизу. Карточку в карточку не кладём:
         внутренний блок — фон на ступень светлее, без своей рамки -->
    <Style Selector="Border.card">
        <Setter Property="Background" Value="{DynamicResource Forest.Surface}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Forest.Line}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="BoxShadow" Value="{DynamicResource Forest.CardShadow}" />
    </Style>
    <!-- обрезка содержимого карточки по скруглению (таблица, консоль): внутренняя рамка с радиусом 10 − 1 (толщина
         рамки карточки). ClipToBounds на самой карточке нельзя: обрезка срезает и её тень -->
    <Style Selector="Border.cardClip">
        <Setter Property="CornerRadius" Value="9" />
        <Setter Property="ClipToBounds" Value="True" />
    </Style>
    <!-- плашка-предупреждение: тёплый фон, рамка и кромка -->
    <Style Selector="Border.warning">
        <Setter Property="Background" Value="{DynamicResource Forest.WarningBg}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Forest.WarnLine}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="Padding" Value="14,10" />
        <Setter Property="BoxShadow" Value="{DynamicResource Forest.EdgeShadow}" />
    </Style>
    <!-- строка настройки с линией сверху (Row) -->
    <Style Selector="Border.row">
        <Setter Property="BorderBrush" Value="{DynamicResource Forest.Line}" />
        <Setter Property="BorderThickness" Value="0,1,0,0" />
        <Setter Property="Margin" Value="0,14,0,0" />
        <Setter Property="Padding" Value="0,14,0,0" />
    </Style>

    <!-- ===== тон состояния: точка и текст; вариант — класс от EnumClass.Value="{Binding Tone}" ===== -->
    <Style Selector="Ellipse.tone">
        <Setter Property="Width" Value="6" />
        <Setter Property="Height" Value="6" />
        <Setter Property="Margin" Value="0,0,6,0" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Fill" Value="{DynamicResource Forest.Muted}" />
    </Style>
    <Style Selector="Ellipse.tone.good">
        <Setter Property="Fill" Value="{DynamicResource Forest.Good}" />
    </Style>
    <Style Selector="Ellipse.tone.update">
        <Setter Property="Fill" Value="{DynamicResource Forest.Accent}" />
    </Style>
    <Style Selector="Ellipse.tone.warn">
        <Setter Property="Fill" Value="{DynamicResource Forest.Warn}" />
    </Style>
    <Style Selector="Ellipse.tone.danger">
        <Setter Property="Fill" Value="{DynamicResource Forest.Danger}" />
    </Style>
    <Style Selector="TextBlock.tone">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Foreground" Value="{DynamicResource Forest.Muted}" />
    </Style>
    <Style Selector="TextBlock.tone.good">
        <Setter Property="Foreground" Value="{DynamicResource Forest.Good}" />
    </Style>
    <Style Selector="TextBlock.tone.update">
        <Setter Property="Foreground" Value="{DynamicResource Forest.Accent}" />
    </Style>
    <Style Selector="TextBlock.tone.warn">
        <Setter Property="Foreground" Value="{DynamicResource Forest.Warn}" />
    </Style>
    <Style Selector="TextBlock.tone.danger">
        <Setter Property="Foreground" Value="{DynamicResource Forest.Danger}" />
    </Style>

    <!-- ===== «дышащее» кольцо вокруг точки состояния (раздел 3: только «сервер работает») ===== -->
    <!-- кольцо (BreathingRing) — круг размером с точку под ней: раз в 2,6 с расходится от неё и тает, остаток цикла —
         пауза. Только масштаб и прозрачность (RenderTransform и Opacity), без пересчёта раскладки. Анимация держится на
         классе breathing: убрать класс (или перекрыть этот стиль) — кольцо стоит, остаётся одна точка. Стиль — на свой
         тип, а не на любой Ellipse: почему, сказано у BreathingRing. В системе выключены анимации (Motion.Enabled) —
         не дышит -->
    <Style Selector="ctl|BreathingRing.breathing[(ctl|Motion.Enabled)=True]">
        <Style.Animations>
            <Animation Duration="0:0:2.6" IterationCount="Infinite">
                <KeyFrame Cue="0%">
                    <Setter Property="Opacity" Value="0.55" />
                    <Setter Property="ScaleTransform.ScaleX" Value="1" />
                    <Setter Property="ScaleTransform.ScaleY" Value="1" />
                </KeyFrame>
                <KeyFrame Cue="65%" KeySpline="0.2,0.7,0.2,1">
                    <Setter Property="Opacity" Value="0" />
                    <Setter Property="ScaleTransform.ScaleX" Value="2.6" />
                    <Setter Property="ScaleTransform.ScaleY" Value="2.6" />
                </KeyFrame>
                <KeyFrame Cue="100%">
                    <Setter Property="Opacity" Value="0" />
                    <Setter Property="ScaleTransform.ScaleX" Value="2.6" />
                    <Setter Property="ScaleTransform.ScaleY" Value="2.6" />
                </KeyFrame>
            </Animation>
        </Style.Animations>
    </Style>

    <!-- ===== поле поиска: лупа слева (InnerLeftContent), подсказка — PlaceholderText ===== -->
    <Style Selector="TextBox.search">
        <Setter Property="Padding" Value="8,7,10,7" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="TextBox.search Path.searchIcon">
        <Setter Property="Width" Value="14" />
        <Setter Property="Height" Value="14" />
        <Setter Property="Margin" Value="12,0,0,0" />
        <Setter Property="Stroke" Value="{DynamicResource Forest.Muted}" />
        <Setter Property="IsHitTestVisible" Value="False" />
    </Style>

    <!-- ===== разделитель колонок: прозрачная полоса, посередине — короткая ручка; при наведении ручка светлеет ===== -->
    <Style Selector="GridSplitter">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Template">
            <ControlTemplate>
                <Border Background="{TemplateBinding Background}">
                    <Border x:Name="Grip" Width="4" Height="24" CornerRadius="2"
                            HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
            </ControlTemplate>
        </Setter>
    </Style>
    <Style Selector="GridSplitter /template/ Border#Grip">
        <Setter Property="Background" Value="{DynamicResource Forest.Faint}" />
        <Setter Property="Transitions">
            <Transitions>
                <BrushTransition Property="Background" Duration="0:0:0.18" Easing="0.2,0.7,0.2,1" />
            </Transitions>
        </Setter>
    </Style>
    <Style Selector="GridSplitter:pointerover /template/ Border#Grip">
        <Setter Property="Background" Value="{DynamicResource Forest.Muted}" />
    </Style>

    <!-- кнопка поменьше: в предупреждениях, очереди, шапках, списках версий -->
    <Style Selector="Button.small">
        <Setter Property="Padding" Value="12,4" />
        <Setter Property="MinHeight" Value="0" />
        <Setter Property="FontSize" Value="12" />
    </Style>

    <!-- строка «ключ — значение» в карточке мода -->
    <Style Selector="TextBlock.cardKey">
        <Setter Property="Foreground" Value="{DynamicResource Forest.Muted}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Margin" Value="0,4,12,4" />
    </Style>
    <Style Selector="TextBlock.cardValue">
        <Setter Property="Foreground" Value="{DynamicResource Forest.Text}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Margin" Value="0,4,0,4" />
        <Setter Property="HorizontalAlignment" Value="Right" />
        <Setter Property="TextAlignment" Value="Right" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <!-- прокрутка: полоса тонкая, как у Fluent, но место под неё оставлено, а не поверх содержимого -->
    <Style Selector="ScrollViewer /template/ ScrollContentPresenter#PART_ContentPresenter">
        <Setter Property="Grid.ColumnSpan" Value="1" />
        <Setter Property="Grid.RowSpan" Value="1" />
    </Style>

    <!-- галочка: скругление поля (ControlCornerRadius) у неё слишком круглое — свои 4, как было -->
    <Style Selector="CheckBox">
        <Setter Property="CornerRadius" Value="4" />
    </Style>

    <!-- стрелка выпадающего списка — мельче (у Fluent в Avalonia 12×12). Масштабом, а не
         размером: размер задан в самом шаблоне, а значения шаблона сильнее обычного стиля -->
    <Style Selector="ComboBox /template/ PathIcon#DropDownGlyph">
        <Setter Property="RenderTransform" Value="scale(0.7)" />
    </Style>

    <!-- ===== служебные ===== -->
    <!-- невидимый, но место занимает -->
    <Style Selector=":is(Control).hidden">
        <Setter Property="Opacity" Value="0" />
        <Setter Property="IsHitTestVisible" Value="False" />
        <Setter Property="Focusable" Value="False" />
    </Style>
    <!-- приглушённая строка (выключенный мод и т.п.) -->
    <Style Selector=":is(Control).faded">
        <Setter Property="Opacity" Value="0.5" />
    </Style>

    <!-- подсказки: не шире разумного, длинные переносятся -->
    <Style Selector="ToolTip">
        <Setter Property="MaxWidth" Value="420" />
    </Style>
</Styles>
