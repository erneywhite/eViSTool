<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Стили лесной темы для элементов; наполняется на этапе основы (перенос Themes/Forest.xaml окна на WPF). -->
    <Style Selector="Window">
        <Setter Property="Background" Value="{StaticResource Forest.Base}" />
        <Setter Property="Foreground" Value="{StaticResource Forest.Text}" />
    </Style>
</Styles>
