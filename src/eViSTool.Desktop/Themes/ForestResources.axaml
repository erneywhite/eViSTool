<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!--
        Лесная палитра (дизайн eViSTool-forest, Erney White) — те же значения, что в Themes/Forest.xaml окна на WPF.
        1) Токены дизайна: Forest.*.
        2) Кисти элементов Fluent теми же цветами (базовые цвета Fluent меняет палитра в App.axaml, здесь — точечно
           то, что окно на WPF перекрашивало отдельно: поля ввода, списки, галочки, таблица, подсказки).
        3) Иконки и шрифты.
        Ключи кистей Fluent сверены по теме Avalonia.Themes.Fluent 12.1: опечатка в ключе ничего не роняет, элемент
        просто остаётся стандартного цвета, поэтому новые ключи — только после проверки на снимке.
    -->

    <!-- ===== токены ===== -->
    <Color x:Key="Forest.BaseColor">#202822</Color>
    <Color x:Key="Forest.SurfaceColor">#273129</Color>
    <Color x:Key="Forest.RaisedColor">#303D32</Color>
    <Color x:Key="Forest.SideColor">#19231D</Color>
    <Color x:Key="Forest.TextColor">#E7E9DD</Color>
    <Color x:Key="Forest.MutedColor">#A4B1A0</Color>
    <Color x:Key="Forest.LineColor">#3B483B</Color>
    <Color x:Key="Forest.AccentColor">#D4BD83</Color>
    <Color x:Key="Forest.AccentInkColor">#2C2B1C</Color>
    <Color x:Key="Forest.SelectedColor">#394432</Color>
    <Color x:Key="Forest.GoodColor">#B0C898</Color>
    <Color x:Key="Forest.WarnColor">#EDBF82</Color>
    <Color x:Key="Forest.WarningBgColor">#3A3425</Color>
    <Color x:Key="Forest.DangerColor">#E89B96</Color>

    <SolidColorBrush x:Key="Forest.Base" Color="{StaticResource Forest.BaseColor}" />
    <SolidColorBrush x:Key="Forest.Surface" Color="{StaticResource Forest.SurfaceColor}" />
    <SolidColorBrush x:Key="Forest.Raised" Color="{StaticResource Forest.RaisedColor}" />
    <SolidColorBrush x:Key="Forest.Side" Color="{StaticResource Forest.SideColor}" />
    <SolidColorBrush x:Key="Forest.Text" Color="{StaticResource Forest.TextColor}" />
    <SolidColorBrush x:Key="Forest.Muted" Color="{StaticResource Forest.MutedColor}" />
    <SolidColorBrush x:Key="Forest.Line" Color="{StaticResource Forest.LineColor}" />
    <SolidColorBrush x:Key="Forest.Accent" Color="{StaticResource Forest.AccentColor}" />
    <SolidColorBrush x:Key="Forest.AccentInk" Color="{StaticResource Forest.AccentInkColor}" />
    <SolidColorBrush x:Key="Forest.Selected" Color="{StaticResource Forest.SelectedColor}" />
    <SolidColorBrush x:Key="Forest.Good" Color="{StaticResource Forest.GoodColor}" />
    <SolidColorBrush x:Key="Forest.Warn" Color="{StaticResource Forest.WarnColor}" />
    <SolidColorBrush x:Key="Forest.WarningBg" Color="{StaticResource Forest.WarningBgColor}" />
    <SolidColorBrush x:Key="Forest.Danger" Color="{StaticResource Forest.DangerColor}" />

    <!-- оттенки, которые в окне на WPF стояли числом прямо в шаблонах -->
    <SolidColorBrush x:Key="Forest.LineStrong" Color="#46523F" />
    <SolidColorBrush x:Key="Forest.SelectedHover" Color="#414D39" />
    <SolidColorBrush x:Key="Forest.Disabled" Color="#242C25" />
    <SolidColorBrush x:Key="Forest.DisabledText" Color="#6E7A6A" />
    <SolidColorBrush x:Key="Forest.Selection" Color="#6B6044" />

    <!-- ===== шрифты ===== -->
    <!-- основной (Noto Sans) задан шрифтом по умолчанию в Program.cs; здесь — моноширинный для версий, кода, консоли -->
    <FontFamily x:Key="Forest.Mono">avares://eViSTool.Desktop/Assets/Fonts#Cascadia Mono</FontFamily>

    <!-- ===== формы: скругления как у Fluent в окне на WPF ===== -->
    <CornerRadius x:Key="ControlCornerRadius">4</CornerRadius>
    <CornerRadius x:Key="OverlayCornerRadius">8</CornerRadius>

    <!-- ===== поля ввода: рамка-линия, в фокусе — песок ===== -->
    <!-- Заливка — полупрозрачный белый, как её на деле рисует окно на WPF (Fluent ControlFillColor*: подмена в его теме
         до полей не доходила). На карточке поле так чуть светлее её; непрозрачная «поверхность» с карточкой сливалась. -->
    <SolidColorBrush x:Key="TextControlBackground" Color="#0FFFFFFF" />
    <SolidColorBrush x:Key="TextControlBackgroundPointerOver" Color="#15FFFFFF" />
    <StaticResource x:Key="TextControlBackgroundFocused" ResourceKey="Forest.Side" />
    <SolidColorBrush x:Key="TextControlBackgroundDisabled" Color="#0BFFFFFF" />
    <StaticResource x:Key="TextControlBorderBrush" ResourceKey="Forest.Line" />
    <StaticResource x:Key="TextControlBorderBrushPointerOver" ResourceKey="Forest.LineStrong" />
    <StaticResource x:Key="TextControlBorderBrushFocused" ResourceKey="Forest.Accent" />
    <SolidColorBrush x:Key="TextControlBorderBrushDisabled" Color="#12FFFFFF" />
    <!-- отступ текста и подсказка без полупрозрачности — тоже как в окне на WPF -->
    <Thickness x:Key="TextControlThemePadding">11,5,11,6</Thickness>
    <x:Double x:Key="TextControlPlaceholderOpacity">1</x:Double>
    <StaticResource x:Key="TextControlForeground" ResourceKey="Forest.Text" />
    <StaticResource x:Key="TextControlForegroundPointerOver" ResourceKey="Forest.Text" />
    <StaticResource x:Key="TextControlForegroundFocused" ResourceKey="Forest.Text" />
    <StaticResource x:Key="TextControlForegroundDisabled" ResourceKey="Forest.DisabledText" />
    <StaticResource x:Key="TextControlPlaceholderForeground" ResourceKey="Forest.Muted" />
    <StaticResource x:Key="TextControlPlaceholderForegroundPointerOver" ResourceKey="Forest.Muted" />
    <StaticResource x:Key="TextControlPlaceholderForegroundFocused" ResourceKey="Forest.Muted" />
    <StaticResource x:Key="TextControlSelectionHighlightColor" ResourceKey="Forest.Selection" />
    <StaticResource x:Key="TextControlButtonForegroundPointerOver" ResourceKey="Forest.Accent" />
    <StaticResource x:Key="TextControlButtonBackgroundPressed" ResourceKey="Forest.Raised" />

    <!-- ===== выпадающие списки ===== -->
    <SolidColorBrush x:Key="ComboBoxBackground" Color="#0FFFFFFF" />
    <SolidColorBrush x:Key="ComboBoxBackgroundPointerOver" Color="#15FFFFFF" />
    <SolidColorBrush x:Key="ComboBoxBackgroundPressed" Color="#08FFFFFF" />
    <SolidColorBrush x:Key="ComboBoxBackgroundDisabled" Color="#0BFFFFFF" />
    <StaticResource x:Key="ComboBoxBackgroundUnfocused" ResourceKey="Forest.Raised" />
    <StaticResource x:Key="ComboBoxBorderBrush" ResourceKey="Forest.Line" />
    <StaticResource x:Key="ComboBoxBorderBrushPointerOver" ResourceKey="Forest.LineStrong" />
    <StaticResource x:Key="ComboBoxBorderBrushPressed" ResourceKey="Forest.Accent" />
    <SolidColorBrush x:Key="ComboBoxBorderBrushDisabled" Color="#12FFFFFF" />
    <StaticResource x:Key="ComboBoxBackgroundBorderBrushUnfocused" ResourceKey="Forest.Line" />
    <StaticResource x:Key="ComboBoxForeground" ResourceKey="Forest.Text" />
    <StaticResource x:Key="ComboBoxPlaceHolderForeground" ResourceKey="Forest.Muted" />
    <StaticResource x:Key="ComboBoxDropDownGlyphForeground" ResourceKey="Forest.Muted" />
    <StaticResource x:Key="ComboBoxDropDownBackground" ResourceKey="Forest.Surface" />
    <StaticResource x:Key="ComboBoxDropDownBorderBrush" ResourceKey="Forest.LineStrong" />
    <StaticResource x:Key="ComboBoxItemBackgroundSelected" ResourceKey="Forest.Selected" />
    <StaticResource x:Key="ComboBoxItemBackgroundSelectedPointerOver" ResourceKey="Forest.SelectedHover" />
    <StaticResource x:Key="ComboBoxItemBackgroundSelectedPressed" ResourceKey="Forest.SelectedHover" />
    <StaticResource x:Key="ComboBoxItemForegroundSelected" ResourceKey="Forest.Text" />
    <StaticResource x:Key="ComboBoxItemForegroundSelectedPointerOver" ResourceKey="Forest.Text" />
    <StaticResource x:Key="ComboBoxItemForegroundSelectedPressed" ResourceKey="Forest.Text" />

    <!-- ===== выделение в обычных списках: лесной «выбранный», не песочный акцент ===== -->
    <StaticResource x:Key="SystemControlHighlightListAccentLowBrush" ResourceKey="Forest.Selected" />
    <StaticResource x:Key="SystemControlHighlightListAccentMediumBrush" ResourceKey="Forest.SelectedHover" />
    <StaticResource x:Key="SystemControlHighlightListAccentHighBrush" ResourceKey="Forest.SelectedHover" />

    <!-- ===== галочки и радиокнопки: песок, галка — тёмная ===== -->
    <StaticResource x:Key="CheckBoxCheckBackgroundFillChecked" ResourceKey="Forest.Accent" />
    <StaticResource x:Key="CheckBoxCheckBackgroundFillCheckedPointerOver" ResourceKey="Forest.Accent" />
    <StaticResource x:Key="CheckBoxCheckBackgroundFillCheckedPressed" ResourceKey="Forest.Accent" />
    <StaticResource x:Key="CheckBoxCheckBackgroundStrokeChecked" ResourceKey="Forest.Accent" />
    <StaticResource x:Key="CheckBoxCheckBackgroundStrokeCheckedPointerOver" ResourceKey="Forest.Accent" />
    <StaticResource x:Key="CheckBoxCheckBackgroundStrokeCheckedPressed" ResourceKey="Forest.Accent" />
    <StaticResource x:Key="CheckBoxCheckBackgroundFillIndeterminate" ResourceKey="Forest.Accent" />
    <StaticResource x:Key="CheckBoxCheckBackgroundFillIndeterminatePointerOver" ResourceKey="Forest.Accent" />
    <StaticResource x:Key="CheckBoxCheckBackgroundFillIndeterminatePressed" ResourceKey="Forest.Accent" />
    <StaticResource x:Key="CheckBoxCheckBackgroundStrokeIndeterminate" ResourceKey="Forest.Accent" />
    <StaticResource x:Key="CheckBoxCheckBackgroundStrokeIndeterminatePointerOver" ResourceKey="Forest.Accent" />
    <StaticResource x:Key="CheckBoxCheckBackgroundStrokeIndeterminatePressed" ResourceKey="Forest.Accent" />
    <StaticResource x:Key="CheckBoxCheckGlyphForegroundChecked" ResourceKey="Forest.AccentInk" />
    <StaticResource x:Key="CheckBoxCheckGlyphForegroundCheckedPointerOver" ResourceKey="Forest.AccentInk" />
    <StaticResource x:Key="CheckBoxCheckGlyphForegroundCheckedPressed" ResourceKey="Forest.AccentInk" />
    <StaticResource x:Key="CheckBoxCheckGlyphForegroundIndeterminate" ResourceKey="Forest.AccentInk" />
    <StaticResource x:Key="CheckBoxCheckGlyphForegroundIndeterminatePointerOver" ResourceKey="Forest.AccentInk" />
    <StaticResource x:Key="CheckBoxCheckGlyphForegroundIndeterminatePressed" ResourceKey="Forest.AccentInk" />
    <StaticResource x:Key="RadioButtonOuterEllipseCheckedFill" ResourceKey="Forest.Accent" />
    <StaticResource x:Key="RadioButtonOuterEllipseCheckedFillPointerOver" ResourceKey="Forest.Accent" />
    <StaticResource x:Key="RadioButtonOuterEllipseCheckedFillPressed" ResourceKey="Forest.Accent" />
    <StaticResource x:Key="RadioButtonOuterEllipseCheckedStroke" ResourceKey="Forest.Accent" />
    <StaticResource x:Key="RadioButtonOuterEllipseCheckedStrokePointerOver" ResourceKey="Forest.Accent" />
    <StaticResource x:Key="RadioButtonOuterEllipseCheckedStrokePressed" ResourceKey="Forest.Accent" />
    <StaticResource x:Key="RadioButtonCheckGlyphFill" ResourceKey="Forest.AccentInk" />
    <StaticResource x:Key="RadioButtonCheckGlyphFillPointerOver" ResourceKey="Forest.AccentInk" />
    <StaticResource x:Key="RadioButtonCheckGlyphFillPressed" ResourceKey="Forest.AccentInk" />

    <!-- ===== подсказки, меню, всплывающие панели ===== -->
    <StaticResource x:Key="ToolTipBackground" ResourceKey="Forest.Surface" />
    <StaticResource x:Key="ToolTipBorderBrush" ResourceKey="Forest.Line" />
    <StaticResource x:Key="ToolTipForeground" ResourceKey="Forest.Text" />
    <StaticResource x:Key="MenuFlyoutPresenterBackground" ResourceKey="Forest.Surface" />
    <StaticResource x:Key="MenuFlyoutPresenterBorderBrush" ResourceKey="Forest.LineStrong" />
    <StaticResource x:Key="FlyoutPresenterBackground" ResourceKey="Forest.Surface" />

    <!-- ===== ссылки ===== -->
    <StaticResource x:Key="HyperlinkButtonForeground" ResourceKey="Forest.Accent" />
    <StaticResource x:Key="HyperlinkButtonForegroundPointerOver" ResourceKey="Forest.Accent" />
    <StaticResource x:Key="HyperlinkButtonForegroundPressed" ResourceKey="Forest.Accent" />

    <!-- ===== таблица: выделение лесное, без синего акцента и рамки текущей ячейки ===== -->
    <StaticResource x:Key="DataGridRowSelectedBackgroundBrush" ResourceKey="Forest.Selected" />
    <StaticResource x:Key="DataGridRowSelectedHoveredBackgroundBrush" ResourceKey="Forest.SelectedHover" />
    <StaticResource x:Key="DataGridRowSelectedUnfocusedBackgroundBrush" ResourceKey="Forest.Selected" />
    <StaticResource x:Key="DataGridRowSelectedHoveredUnfocusedBackgroundBrush" ResourceKey="Forest.SelectedHover" />
    <x:Double x:Key="DataGridRowSelectedBackgroundOpacity">1</x:Double>
    <x:Double x:Key="DataGridRowSelectedHoveredBackgroundOpacity">1</x:Double>
    <x:Double x:Key="DataGridRowSelectedUnfocusedBackgroundOpacity">1</x:Double>
    <x:Double x:Key="DataGridRowSelectedHoveredUnfocusedBackgroundOpacity">1</x:Double>
    <Color x:Key="DataGridRowHoveredBackgroundColor">#14E7E9DD</Color>
    <StaticResource x:Key="DataGridGridLinesBrush" ResourceKey="Forest.Line" />
    <SolidColorBrush x:Key="DataGridColumnHeaderBackgroundBrush" Color="Transparent" />
    <StaticResource x:Key="DataGridColumnHeaderForegroundBrush" ResourceKey="Forest.Muted" />
    <SolidColorBrush x:Key="DataGridCellFocusVisualPrimaryBrush" Color="Transparent" />
    <SolidColorBrush x:Key="DataGridCellFocusVisualSecondaryBrush" Color="Transparent" />

    <!-- ===== раскрывающийся блок ===== -->
    <StaticResource x:Key="ExpanderHeaderBackground" ResourceKey="Forest.Surface" />
    <StaticResource x:Key="ExpanderHeaderBackgroundPointerOver" ResourceKey="Forest.Raised" />
    <StaticResource x:Key="ExpanderHeaderBackgroundPressed" ResourceKey="Forest.Raised" />
    <StaticResource x:Key="ExpanderHeaderBorderBrush" ResourceKey="Forest.Line" />
    <StaticResource x:Key="ExpanderHeaderBorderBrushPointerOver" ResourceKey="Forest.Line" />
    <StaticResource x:Key="ExpanderHeaderBorderBrushPressed" ResourceKey="Forest.Line" />
    <StaticResource x:Key="ExpanderContentBackground" ResourceKey="Forest.Base" />
    <StaticResource x:Key="ExpanderContentBorderBrush" ResourceKey="Forest.Line" />

    <!-- ===== иконки (контуры из макета, viewBox 24×24); рисуются как Path с классом icon ===== -->
    <StreamGeometry x:Key="Icon.Mods">M3,3 H10 V10 H3 Z M14,3 H21 V10 H14 Z M3,14 H10 V21 H3 Z M14,14 H21 V21 H14 Z</StreamGeometry>
    <StreamGeometry x:Key="Icon.Catalog">M4,10 A6,6 0 1 1 16,10 A6,6 0 1 1 4,10 Z M15,15 L21,21</StreamGeometry>
    <StreamGeometry x:Key="Icon.Check">M5,12.5 L10,17.5 L19.5,7</StreamGeometry>
    <StreamGeometry x:Key="Icon.Star">M12,3.5 L14.6,8.9 L20.5,9.7 L16.2,13.8 L17.3,19.7 L12,16.9 L6.7,19.7 L7.8,13.8 L3.5,9.7 L9.4,8.9 Z</StreamGeometry>
    <StreamGeometry x:Key="Icon.Lock">M6,11 H18 V20 H6 Z M8.5,11 V7.5 A3.5,3.5 0 0 1 15.5,7.5 V11</StreamGeometry>
    <StreamGeometry x:Key="Icon.ChevronDown">M6,9 L12,15 L18,9</StreamGeometry>
    <StreamGeometry x:Key="Icon.Pin">M9,4 H15 M10,4 V10 L7,14 H17 L14,10 V4 M12,14 V21</StreamGeometry>
    <StreamGeometry x:Key="Icon.Globe">M12,3 A9,9 0 1 0 12.01,3 Z M3,12 H21 M12,3 C8,7 8,17 12,21 M12,3 C16,7 16,17 12,21</StreamGeometry>
    <StreamGeometry x:Key="Icon.Server">M3,3 H21 V10 H3 Z M3,14 H21 V21 H3 Z M6,7 H8 M6,18 H8</StreamGeometry>
    <StreamGeometry x:Key="Icon.Settings">M3,7 H6 M12,7 H21 M3,17 H13 M19,17 H21 M6,7 A3,3 0 1 1 12,7 A3,3 0 1 1 6,7 Z M13,17 A3,3 0 1 1 19,17 A3,3 0 1 1 13,17 Z</StreamGeometry>
    <!-- файл настроек мода: лист с загнутым углом и строками -->
    <StreamGeometry x:Key="Icon.ModConfig">M6,3 H14 L19,8 V21 H6 Z M14,3 V8 H19 M9,13 H16 M9,17 H14</StreamGeometry>
    <StreamGeometry x:Key="Icon.About">M3,12 A9,9 0 1 1 21,12 A9,9 0 1 1 3,12 Z M12,11 V17 M12,7 V8</StreamGeometry>
    <StreamGeometry x:Key="Icon.Refresh">M20,7 A9,9 0 1 0 21,14 M20,2 V8 H14</StreamGeometry>
    <StreamGeometry x:Key="Icon.History">M12,8 V12 L14,14 M3.05,11 A9,9 0 1 1 3.55,15 M3,20 V15 H8</StreamGeometry>
    <StreamGeometry x:Key="Icon.Play">M7,4 L20,12 L7,20 Z</StreamGeometry>
    <StreamGeometry x:Key="Icon.Plus">M12,5 V19 M5,12 H19</StreamGeometry>
    <StreamGeometry x:Key="Icon.Download">M12,3 V15 M7,10 L12,15 L17,10 M4,16 V21 H20 V16</StreamGeometry>
    <StreamGeometry x:Key="Icon.Warning">M12,3 L22,21 H2 Z M12,9 V14 M12,17 V18</StreamGeometry>
    <StreamGeometry x:Key="Icon.Client">M3,4 H21 V16 H3 Z M8,20 H16 M12,16 V20</StreamGeometry>
    <StreamGeometry x:Key="Icon.Copy">M8,8 H20 V20 H8 Z M4,16 V4 H16</StreamGeometry>
    <!-- карандаш: «Изменить» -->
    <StreamGeometry x:Key="Icon.Edit">M4,20 L4,16 L15,5 L19,9 L8,20 Z M13,7 L17,11</StreamGeometry>
    <StreamGeometry x:Key="Icon.Search">M4,10 A6,6 0 1 1 16,10 A6,6 0 1 1 4,10 Z M15,15 L20,20</StreamGeometry>
    <StreamGeometry x:Key="Icon.Folder">M3,6 V19 H21 V8 H11 L9,6 Z</StreamGeometry>
    <StreamGeometry x:Key="Icon.Package">M12,3 L20,7 V17 L12,21 L4,17 V7 Z M4,7 L12,11 L20,7 M12,11 V21</StreamGeometry>
    <StreamGeometry x:Key="Icon.Close">M6,6 L18,18 M18,6 L6,18</StreamGeometry>
</ResourceDictionary>
