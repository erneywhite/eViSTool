<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Окно eViSTool на Avalonia — одно на Windows и Linux. Модели — eViSTool.Presentation. Шрифты вшиты (Noto Sans, Cascadia Mono — SIL OFL), чтобы окно выглядело одинаково на любой системе.
  -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>eViSTool.Desktop</RootNamespace>
    <AssemblyName>eViSTool</AssemblyName>
    <ApplicationIcon>Assets\eViSTool.ico</ApplicationIcon>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\eViSTool.Core\eViSTool.Core.csproj" />
    <ProjectReference Include="..\eViSTool.Presentation\eViSTool.Presentation.csproj" />
    <!-- транспорт FTP для серверов у хостера (FluentFTP); только окно, агенту не нужен -->
    <ProjectReference Include="..\eViSTool.Hosting\eViSTool.Hosting.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.2" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.2" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.2" />
    <PackageReference Include="Avalonia.Controls.DataGrid" Version="12.1.2" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
  </ItemGroup>

  <ItemGroup>
    <AvaloniaResource Include="Assets\**" />
  </ItemGroup>

  <ItemGroup>
    <!-- тесты подменяют сеть и папку кэша у RemoteImage -->
    <InternalsVisibleTo Include="eViSTool.Desktop.Tests" />
  </ItemGroup>

</Project>
