<dialogs:DialogWindow xmlns="https://github.com/avaloniaui"
                      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                      xmlns:dialogs="using:eViSTool.Desktop.Dialogs"
                      xmlns:vm="using:eViSTool.Presentation.ViewModels"
                      xmlns:local="using:eViSTool.Desktop"
                      xmlns:ctl="using:eViSTool.Desktop.Controls"
                      x:Class="eViSTool.Desktop.Dialogs.ModCodeWindow"
                      x:DataType="vm:ModCodeViewModel"
                      Width="544" SizeToContent="Height" CanResize="False"
                      Title="{local:Tr modcode.title}">
    <StackPanel Margin="24,20,24,22">
        <TextBlock Text="{local:Tr modcode.title}" FontSize="20" FontWeight="SemiBold" />
        <TextBlock Classes="muted" Text="{local:Tr modcode.hint}" FontSize="12" TextWrapping="Wrap" Margin="0,4,0,0" />

        <TextBlock Classes="label" Text="{local:Tr modcode.code}" />
        <!-- код длинный (≈3 символа на мод) — поле в несколько строк с переносом, Enter не добавляет строку -->
        <DockPanel Margin="0,6,0,0">
            <Button DockPanel.Dock="Right" Content="{local:Tr modcode.paste}" Click="Paste_Click" Margin="8,0,0,0" VerticalAlignment="Top"
                    ToolTip.Tip="{local:Tr modcode.pasteTip}" AutomationProperties.AutomationId="ModCodePaste" />
            <TextBox Classes="mono" Text="{Binding Text}" TextWrapping="Wrap" AcceptsReturn="False" MinHeight="64" MaxHeight="160"
                     VerticalContentAlignment="Top" ctl:Focus.OnOpen="True" AutomationProperties.AutomationId="ModCodeText" />
        </DockPanel>
        <TextBlock Classes="tone" ctl:EnumClass.Value="{Binding StatusTone}" Text="{Binding StatusText}"
                   FontSize="12" TextWrapping="Wrap" Margin="0,6,0,0" AutomationProperties.AutomationId="ModCodeStatus" />

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button Classes="primary" Content="{local:Tr modcode.ok}" IsDefault="True" IsEnabled="{Binding CanAccept}"
                    Click="Ok_Click" Padding="18,8" AutomationProperties.AutomationId="ModCodeOk" />
            <Button Content="{local:Tr common.cancel}" Click="Cancel_Click" Margin="8,0,0,0" Padding="16,8" />
        </StackPanel>
    </StackPanel>
</dialogs:DialogWindow>
