<dialogs:DialogWindow xmlns="https://github.com/avaloniaui"
                      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                      xmlns:dialogs="using:eViSTool.Desktop.Dialogs"
                      xmlns:local="using:eViSTool.Desktop"
                      xmlns:ctl="using:eViSTool.Desktop.Controls"
                      x:Class="eViSTool.Desktop.Dialogs.ServerPasswordWindow"
                      Width="404" SizeToContent="Height" CanResize="False"
                      Title="{local:Tr browse.passwordTitle}">
    <!-- ширина — содержимого окна: в окне на WPF Width="420" считал и рамку (по 8 px с боков), внутри было 404 -->
    <StackPanel Margin="24,20,24,22">
        <!-- текст («Пароль для «…»») ставит код окна: сервер приходит свойством Server -->
        <TextBlock x:Name="Heading" FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap" />
        <TextBlock Classes="muted" Text="{local:Tr browse.passwordHint}" FontSize="12" TextWrapping="Wrap" Margin="0,6,0,12" />
        <!-- пароль — секрет: поле скрытое. Точки — из Cascadia Mono (mono): в Noto Sans нет «●» -->
        <ctl:SecretTextBox x:Name="Box" Classes="mono" PasswordChar="●" Padding="8,6" ctl:Focus.OnOpen="True"
                           AutomationProperties.AutomationId="ServerPassword" AutomationProperties.Name="{local:Tr browse.passwordTitle}" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
            <Button Classes="primary" Content="{local:Tr common.done}" IsDefault="True" Click="Ok_Click" Padding="18,8" />
            <Button Content="{local:Tr common.cancel}" Click="Cancel_Click" Margin="8,0,0,0" Padding="16,8" />
        </StackPanel>
    </StackPanel>
</dialogs:DialogWindow>
