<dialogs:DialogWindow xmlns="https://github.com/avaloniaui"
                      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                      xmlns:dialogs="using:eViSTool.Desktop.Dialogs"
                      xmlns:vm="using:eViSTool.Presentation.ViewModels"
                      xmlns:local="using:eViSTool.Desktop"
                      xmlns:ctl="using:eViSTool.Desktop.Controls"
                      x:Class="eViSTool.Desktop.Dialogs.RemoteFolderWindow"
                      x:DataType="vm:RemoteFolderViewModel"
                      Title="{local:Tr rfolder.title}"
                      Width="544" Height="481" MinWidth="404" MinHeight="321">
    <!-- размеры окна — клиентская область, без рамки и заголовка -->
    <dialogs:DialogWindow.Styles>
        <!-- строка списка папок выше стандартной в Avalonia: шаг строк 49 вместо 45 -->
        <Style Selector="ListBox ListBoxItem">
            <Setter Property="MinHeight" Value="49" />
        </Style>
    </dialogs:DialogWindow.Styles>
    <DockPanel Margin="24,20,24,22">
        <TextBlock DockPanel.Dock="Top" Text="{Binding Heading}" FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap" />
        <TextBlock DockPanel.Dock="Top" Classes="hint" Text="{local:Tr rfolder.hint}" FontSize="12" Margin="0,6,0,12" />

        <!-- путь: можно вписать и нажать Enter; «Вверх»; диски — если их несколько (Windows) -->
        <DockPanel DockPanel.Dock="Top">
            <ComboBox DockPanel.Dock="Right" Width="90" Margin="8,0,0,0" ItemsSource="{Binding Roots}" SelectedItem="{Binding SelectedRoot}"
                      IsVisible="{Binding HasManyRoots}" AutomationProperties.AutomationId="RemoteFolderRoots" />
            <Button DockPanel.Dock="Right" Content="{local:Tr rfolder.up}" Command="{Binding UpCommand}" Margin="8,0,0,0" Padding="12,6"
                    AutomationProperties.AutomationId="RemoteFolderUp" />
            <TextBox x:Name="PathBox" Text="{Binding PathText}" Padding="8,6" VerticalContentAlignment="Center"
                     AutomationProperties.AutomationId="RemoteFolderPath" AutomationProperties.Name="{local:Tr rfolder.title}">
                <TextBox.KeyBindings>
                    <KeyBinding Gesture="Enter" Command="{Binding GoToPathCommand}" />
                </TextBox.KeyBindings>
            </TextBox>
        </DockPanel>

        <StackPanel DockPanel.Dock="Bottom" Margin="0,16,0,0">
            <TextBlock Classes="error" Text="{Binding Error}" IsVisible="{Binding HasError}" FontSize="12" Margin="0,0,0,10" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Classes="primary" Content="{local:Tr rfolder.choose}" IsDefault="True" Command="{Binding ChooseCommand}" Padding="18,8"
                        AutomationProperties.AutomationId="RemoteFolderChoose" />
                <Button Content="{local:Tr common.cancel}" IsCancel="True" Click="Cancel_Click" Margin="8,0,0,0" Padding="16,8" />
            </StackPanel>
        </StackPanel>

        <!-- подпапки: двойной щелчок или Enter — войти -->
        <Border Margin="0,10,0,0" BorderBrush="{DynamicResource Forest.Line}" BorderThickness="1" CornerRadius="6" ClipToBounds="True">
            <ListBox ItemsSource="{Binding Dirs}" SelectedItem="{Binding SelectedDir}" BorderThickness="0" Background="Transparent"
                     ctl:DoubleTap.Command="{Binding OpenCommand}" AutomationProperties.AutomationId="RemoteFolderDirs">
                <ListBox.KeyBindings>
                    <KeyBinding Gesture="Enter" Command="{Binding OpenCommand}" CommandParameter="{Binding SelectedDir}" />
                </ListBox.KeyBindings>
                <ListBox.ItemTemplate>
                    <DataTemplate x:DataType="x:String">
                        <StackPanel Orientation="Horizontal" Margin="2,3">
                            <Path Classes="icon" Data="{StaticResource Icon.Folder}" Width="14" Height="14" Margin="0,0,8,0" />
                            <TextBlock Text="{Binding}" FontSize="13" />
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Border>
    </DockPanel>
</dialogs:DialogWindow>
