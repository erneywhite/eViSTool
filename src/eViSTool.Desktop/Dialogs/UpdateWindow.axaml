<dialogs:DialogWindow xmlns="https://github.com/avaloniaui"
                      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                      xmlns:dialogs="using:eViSTool.Desktop.Dialogs"
                      xmlns:vm="using:eViSTool.Presentation.ViewModels"
                      xmlns:au="using:eViSTool.Core.AppUpdate"
                      xmlns:local="using:eViSTool.Desktop"
                      x:Class="eViSTool.Desktop.Dialogs.UpdateWindow"
                      x:DataType="vm:UpdateWindowViewModel"
                      Title="{local:Tr updwin.title}"
                      Width="764" Height="571" MinWidth="624" MinHeight="481"
                      Background="{DynamicResource Forest.Surface}">
    <!-- Размер — рабочей области, без рамки и заголовка (764×541). Высота здесь на 30 больше: Noto Sans шире Segoe UI, тексты слева переносятся на
         3 строки больше, и у рекомендуемого обновления при 541 кнопка «Позже» уходила за нижний край -->
    <dialogs:DialogWindow.Styles>
        <!-- версии разделены чертой; над первой её нет. Толщина и отступ — стилем:
             локальное значение на Border класс .first не перебил бы -->
        <Style Selector="Border.release">
            <Setter Property="BorderBrush" Value="{DynamicResource Forest.Line}" />
            <Setter Property="BorderThickness" Value="0,1,0,0" />
            <Setter Property="Padding" Value="0,14,0,0" />
            <Setter Property="Margin" Value="0,0,0,14" />
        </Style>
        <Style Selector="Border.release.first">
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
        </Style>
        <!-- номер новой версии: песочный, у рекомендуемого — тёплый -->
        <Style Selector="Run.newVersion">
            <Setter Property="Foreground" Value="{DynamicResource Forest.Accent}" />
        </Style>
        <Style Selector="Run.newVersion.recommended">
            <Setter Property="Foreground" Value="{DynamicResource Forest.Warn}" />
        </Style>
    </dialogs:DialogWindow.Styles>

    <Grid ColumnDefinitions="240,*">
        <!-- ===== слева: что за обновление и что с ним сделать ===== -->
        <Border Background="{DynamicResource Forest.Side}" BorderBrush="{DynamicResource Forest.Line}" BorderThickness="0,0,1,0">
            <Grid Margin="20,26,20,20">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" MinHeight="12" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <StackPanel Grid.Row="2">
                    <TextBlock Text="{Binding Status}" FontSize="12" Foreground="{DynamicResource Forest.Accent}" TextWrapping="Wrap" TextAlignment="Center"
                               Margin="0,0,0,10" IsVisible="{Binding HasStatus}" AutomationProperties.AutomationId="UpdateWindowStatus" />
                    <Button Classes="primary" Command="{Binding InstallCommand}" Padding="14,9" HorizontalAlignment="Stretch" IsDefault="True"
                            AutomationProperties.AutomationId="UpdateWindowInstall">
                        <StackPanel Orientation="Horizontal">
                            <Path Classes="icon" Data="{StaticResource Icon.Download}" Width="14" Height="14" Margin="0,0,8,0" />
                            <TextBlock Text="{local:Tr updwin.install}" />
                        </StackPanel>
                    </Button>
                    <Button Content="{local:Tr updwin.later}" Command="{Binding LaterCommand}" Padding="14,8" Margin="0,8,0,0"
                            HorizontalAlignment="Stretch" AutomationProperties.AutomationId="UpdateWindowLater" />
                    <!-- рекомендуемое не пропускают насовсем — только «Позже», и окно напомнит при следующем запуске -->
                    <Button Theme="{StaticResource Forest.LinkButton}" Content="{local:Tr updwin.skip}" Command="{Binding SkipCommand}"
                            Foreground="{DynamicResource Forest.Muted}" HorizontalAlignment="Center" Margin="0,14,0,0" IsVisible="{Binding CanSkip}"
                            AutomationProperties.AutomationId="UpdateWindowSkip" />
                </StackPanel>
                <StackPanel Grid.Row="0">
                    <Image Source="avares://eViSTool/Assets/logo256.png" Width="96" Height="96" RenderOptions.BitmapInterpolationMode="HighQuality" />
                    <TextBlock Text="{local:Tr updwin.title}" FontSize="17" FontWeight="SemiBold" Foreground="{DynamicResource Forest.Text}"
                               TextAlignment="Center" TextWrapping="Wrap" Margin="0,12,0,0" />
                    <!-- между Run по пробелу -->
                    <TextBlock HorizontalAlignment="Center" Margin="0,12,0,8">
                        <Run Text="{Binding OldVersion, Mode=OneWay}" FontSize="15" Foreground="{DynamicResource Forest.Muted}" /><Run Text=" " /><Run Text="  →  " FontSize="15" Foreground="{DynamicResource Forest.Muted}" /><Run Text=" " /><Run Classes="newVersion" Classes.recommended="{Binding IsRecommended}" Text="{Binding NewVersion, Mode=OneWay}" FontSize="22" FontWeight="SemiBold" />
                    </TextBlock>
                    <!-- рекомендуемое: среди пропущенных версий есть помеченная в тексте релиза -->
                    <Border Background="{DynamicResource Forest.WarningBg}" BorderBrush="{DynamicResource Forest.Warn}" BorderThickness="1" CornerRadius="6"
                            Padding="10,8" Margin="0,0,0,10" IsVisible="{Binding IsRecommended}" AutomationProperties.AutomationId="UpdateWindowRecommended">
                        <StackPanel>
                            <TextBlock Text="{local:Tr updwin.recommended}" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource Forest.Warn}"
                                       TextAlignment="Center" TextWrapping="Wrap" />
                            <TextBlock Text="{local:Tr updwin.recommendedHint}" FontSize="12" Foreground="{DynamicResource Forest.Text}"
                                       TextAlignment="Center" TextWrapping="Wrap" Margin="0,3,0,0" />
                        </StackPanel>
                    </Border>
                    <TextBlock Text="{local:Tr updwin.hint}" FontSize="12" Foreground="{DynamicResource Forest.Muted}" TextWrapping="Wrap" TextAlignment="Center" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- ===== справа: что изменилось за все пропущенные версии ===== -->
        <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <ItemsControl ItemsSource="{Binding Releases}" Margin="22,18" AutomationProperties.AutomationId="UpdateWindowNotes">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:UpdateNotesItem">
                        <Border Classes="release" Classes.first="{Binding IsFirst}">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock VerticalAlignment="Center">
                                        <Run Text="{Binding Version, Mode=OneWay}" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource Forest.Text}" /><Run Text="   " FontSize="12" /><Run Text="{Binding Date, Mode=OneWay}" FontSize="12" Foreground="{DynamicResource Forest.Muted}" />
                                    </TextBlock>
                                    <Border Background="{DynamicResource Forest.WarningBg}" CornerRadius="8" Padding="7,1" Margin="10,0,0,0" VerticalAlignment="Center"
                                            IsVisible="{Binding Recommended}">
                                        <TextBlock Text="{local:Tr updwin.recommendedTag}" FontSize="11" Foreground="{DynamicResource Forest.Warn}" />
                                    </Border>
                                </StackPanel>
                                <TextBlock Text="{Binding Summary}" FontSize="13" Foreground="{DynamicResource Forest.Muted}" FontStyle="Italic" TextWrapping="Wrap"
                                           Margin="0,2,0,0" IsVisible="{Binding Summary, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                                <ItemsControl ItemsSource="{Binding Sections}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="au:ReleaseNotesSection">
                                            <StackPanel Margin="0,8,0,0">
                                                <TextBlock Text="{Binding Heading}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource Forest.Muted}"
                                                           Margin="0,0,0,4" IsVisible="{Binding Heading, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                                                <ItemsControl ItemsSource="{Binding Items}">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate x:DataType="x:String">
                                                            <DockPanel Margin="0,0,0,6">
                                                                <TextBlock DockPanel.Dock="Left" Text="•" Foreground="{DynamicResource Forest.Accent}" Margin="2,0,8,0" />
                                                                <TextBlock Text="{Binding}" FontSize="13" Foreground="{DynamicResource Forest.Text}" TextWrapping="Wrap" />
                                                            </DockPanel>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <!-- у релиза нет текста (лента GitHub без описаний) — ссылка на страницу -->
                                <Button Theme="{StaticResource Forest.LinkButton}" Content="{local:Tr updwin.openPage}"
                                        Command="{Binding $parent[Window].((vm:UpdateWindowViewModel)DataContext).OpenPageCommand}"
                                        CommandParameter="{Binding PageUrl}" HorizontalAlignment="Left" Margin="0,6,0,0" IsVisible="{Binding IsEmpty}" />
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</dialogs:DialogWindow>
