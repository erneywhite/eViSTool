<dialogs:DialogWindow xmlns="https://github.com/avaloniaui"
                      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                      xmlns:dialogs="using:eViSTool.Desktop.Dialogs"
                      xmlns:vm="using:eViSTool.Presentation.ViewModels"
                      xmlns:local="using:eViSTool.Desktop"
                      x:Class="eViSTool.Desktop.Dialogs.ModCodeShareWindow"
                      x:DataType="vm:ModCodeShare"
                      Width="544" SizeToContent="Height" CanResize="False"
                      Title="{local:Tr modcode.shareTitle}">
    <StackPanel Margin="24,20,24,22">
        <TextBlock Classes="dialogTitle" Text="{local:Tr modcode.shareTitle}" />
        <TextBlock Classes="dialogLead" Text="{Binding Summary}" />

        <!-- код блоком: щелчок по нему копирует (на случай, если в буфер он не попал сам). У набора в сотни модов код
             длинный — блок не выше ~9 строк, дальше прокрутка: окно не уходит за край экрана -->
        <Border Classes="card" Margin="0,14,0,0" Padding="14,12" Cursor="Hand" PointerPressed="Code_PointerPressed"
                ToolTip.Tip="{local:Tr modcode.clickToCopy}" AutomationProperties.AutomationId="ModCodeBlock">
            <ScrollViewer MaxHeight="190" HorizontalScrollBarVisibility="Disabled">
                <SelectableTextBlock Text="{Binding ShownCode}" FontFamily="{DynamicResource Forest.Mono}" TextWrapping="Wrap" FontSize="14" Cursor="Hand" />
            </ScrollViewer>
        </Border>
        <TextBlock Classes="tone" Text="{Binding CopiedText}" FontSize="12" Margin="0,6,0,0" Foreground="{DynamicResource Forest.Good}" />

        <TextBlock Classes="dialogLead" Text="{local:Tr modcode.shareHint}" Margin="0,8,0,0" />
        <ScrollViewer MaxHeight="140" HorizontalScrollBarVisibility="Disabled" IsVisible="{Binding HasMissing}" Margin="0,10,0,0">
            <TextBlock Classes="dialogLead" Text="{Binding MissingText}" Margin="0" />
        </ScrollViewer>

        <StackPanel Classes="dialogButtons" Margin="0,20,0,0">
            <Button Content="{local:Tr modcode.copy}" Click="Copy_Click" Padding="16,8" AutomationProperties.AutomationId="ModCodeCopy" />
            <Button Classes="primary" Content="{local:Tr common.close}" IsDefault="True" IsCancel="True" Click="Close_Click" Margin="8,0,0,0" Padding="18,8" />
        </StackPanel>
    </StackPanel>
</dialogs:DialogWindow>
