<dialogs:DialogWindow xmlns="https://github.com/avaloniaui"
                      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                      xmlns:vm="using:eViSTool.Presentation.ViewModels"
                      xmlns:local="using:eViSTool.Desktop"
                      xmlns:ctl="using:eViSTool.Desktop.Controls"
                      xmlns:dialogs="using:eViSTool.Desktop.Dialogs"
                      x:Class="eViSTool.Desktop.Dialogs.AlsoInstallWindow"
                      x:DataType="vm:AlsoInstallViewModel"
                      Width="544" SizeToContent="Height" CanResize="False"
                      Title="{local:Tr also.title}">
    <StackPanel Margin="24,20,24,22">
        <TextBlock Classes="dialogTitle" Text="{local:Tr also.title}" />
        <TextBlock Text="{Binding Hint}" FontSize="12" Foreground="{DynamicResource Forest.Muted}" TextWrapping="Wrap" Margin="0,4,0,0" />

        <!-- профили: текущий отмечен всегда; недоступные — с причиной, без галочки -->
        <ItemsControl ItemsSource="{Binding Rows}" Margin="0,14,0,0">
            <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:AlsoInstallRowViewModel">
                    <!-- 12,12,12,10 вместо 12,8: у CheckBox в Avalonia нет отступа сверху, галочка прижата к верху -->
                    <Border Background="{DynamicResource Forest.Surface}" CornerRadius="6" Padding="12,12,12,10" Margin="0,0,0,6">
                        <CheckBox IsChecked="{Binding IsChecked}" IsEnabled="{Binding IsEnabled}" VerticalContentAlignment="Center"
                                  AutomationProperties.Name="{Binding Name}">
                            <StackPanel Margin="4,0,0,0">
                                <ctl:RunTextBlock FontSize="13" Foreground="{DynamicResource Forest.Text}">
                                    <Run Text="{Binding Name, Mode=OneWay}" FontWeight="SemiBold" /><Run Text=" · " Foreground="{DynamicResource Forest.Muted}" /><Run Text="{Binding KindText, Mode=OneWay}" Foreground="{DynamicResource Forest.Muted}" />
                                </ctl:RunTextBlock>
                                <TextBlock Text="{Binding Detail}" FontSize="11" Foreground="{DynamicResource Forest.Muted}" TextWrapping="Wrap" Margin="0,2,0,0" />
                            </StackPanel>
                        </CheckBox>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <CheckBox IsChecked="{Binding Remember}" Margin="0,8,0,0" AutomationProperties.AutomationId="AlsoRemember">
            <TextBlock Text="{Binding RememberText}" TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource Forest.Text}" />
        </CheckBox>

        <StackPanel Classes="dialogButtons" Margin="0,14,0,0">
            <Button Content="{local:Tr also.install}" Classes="primary" IsDefault="True" Click="Ok_Click" Padding="18,8"
                    ctl:Focus.OnOpen="True" AutomationProperties.AutomationId="AlsoOk" />
            <Button Content="{local:Tr common.cancel}" Click="Cancel_Click" Margin="8,0,0,0" Padding="16,8" />
        </StackPanel>
    </StackPanel>
</dialogs:DialogWindow>
