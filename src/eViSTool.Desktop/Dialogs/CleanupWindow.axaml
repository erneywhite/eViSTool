<dialogs:DialogWindow xmlns="https://github.com/avaloniaui"
                      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                      xmlns:dialogs="using:eViSTool.Desktop.Dialogs"
                      xmlns:vm="using:eViSTool.Presentation.ViewModels"
                      xmlns:local="using:eViSTool.Desktop"
                      x:Class="eViSTool.Desktop.Dialogs.CleanupWindow"
                      x:DataType="vm:CleanupViewModel"
                      Title="{Binding Heading}"
                      Width="744" Height="681" MinWidth="544" MinHeight="381">
    <!-- размеры окна — клиентская область: Width/Height у окна на WPF (760×720, не меньше 560×420) считают и рамку с заголовком -->
    <dialogs:DialogWindow.Styles>
        <!-- пометка вида уборки: «безопасно» — зелёная на тёмно-оливковом, «осторожно» — тёплая на приподнятом
             (в окне на WPF — DataTrigger по IsCareful) -->
        <Style Selector="Border.safety">
            <Setter Property="Background" Value="{DynamicResource Forest.Selected}" />
        </Style>
        <Style Selector="Border.safety.careful">
            <Setter Property="Background" Value="{DynamicResource Forest.Raised}" />
        </Style>
        <Style Selector="Border.safety > TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource Forest.Good}" />
        </Style>
        <Style Selector="Border.safety.careful > TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource Forest.Warn}" />
        </Style>
        <!-- галочка вида «частично» (выбрана часть пунктов): черта, как у Fluent в окне на WPF, а не квадратик Fluent в
             Avalonia. Значок в шаблоне растянут в 1,25 раза: 6×0,8 → черта 7,5×1 пиксель; отступ сверху сдвигает её на
             полпикселя вниз, на целую строку пикселей (иначе черта размазана на две бледные) -->
        <Style Selector="CheckBox:indeterminate /template/ Path#CheckGlyph">
            <Setter Property="Data" Value="M0,0 H6 V0.8 H0 Z" />
            <Setter Property="Width" Value="6" />
            <Setter Property="Margin" Value="0,0.8,0,0" />
        </Style>
    </dialogs:DialogWindow.Styles>

    <DockPanel Margin="24,20,24,20">
        <StackPanel DockPanel.Dock="Top">
            <TextBlock Text="{Binding Heading}" FontSize="20" FontWeight="SemiBold" Foreground="{DynamicResource Forest.Text}" />
            <TextBlock Text="{local:Tr clean.intro}" FontSize="12" Foreground="{DynamicResource Forest.Muted}" TextWrapping="Wrap" Margin="0,4,0,0" />
            <TextBlock Text="{Binding Summary}" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource Forest.Accent}" Margin="0,12,0,0" />
            <!-- игра профиля запущена — убирать нельзя -->
            <TextBlock Text="{Binding RunningText}" FontSize="12" Foreground="{DynamicResource Forest.Warn}" TextWrapping="Wrap" Margin="0,8,0,0"
                       IsVisible="{Binding IsRunning}" />
        </StackPanel>

        <StackPanel DockPanel.Dock="Bottom" Margin="0,12,0,0">
            <TextBlock Text="{Binding Status}" FontSize="12" Foreground="{DynamicResource Forest.Accent}" TextWrapping="Wrap" Margin="0,0,0,10"
                       IsVisible="{Binding Status, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
            <DockPanel>
                <Button DockPanel.Dock="Left" Content="{local:Tr clean.openBin}" Command="{Binding OpenRecycleBinCommand}" Padding="14,8"
                        IsVisible="{Binding HasRecycled}" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="{Binding RemoveText}" Command="{Binding RemoveCommand}" Classes="primary"
                            Padding="16,8" AutomationProperties.AutomationId="CleanRemove" />
                    <Button Content="{local:Tr common.close}" IsCancel="True" Click="Close_Click" Margin="8,0,0,0" Padding="16,8" />
                </StackPanel>
            </DockPanel>
        </StackPanel>

        <TextBlock DockPanel.Dock="Top" Text="{local:Tr clean.nothing}" Foreground="{DynamicResource Forest.Muted}" FontSize="13" Margin="0,20,0,0"
                   IsVisible="{Binding IsEmpty}" />

        <ScrollViewer Margin="0,14,0,0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <ItemsControl ItemsSource="{Binding Groups}" IsEnabled="{Binding !IsBusy}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:CleanupGroupViewModel">
                        <Border Background="{DynamicResource Forest.Surface}" CornerRadius="6" Padding="14,10" Margin="0,0,10,8">
                            <StackPanel>
                                <DockPanel>
                                    <TextBlock DockPanel.Dock="Right" Text="{Binding SizeText}" FontSize="13" FontWeight="SemiBold"
                                               Foreground="{DynamicResource Forest.Text}" VerticalAlignment="Center" Margin="12,0,0,0" />
                                    <Border DockPanel.Dock="Right" Classes="safety" Classes.careful="{Binding IsCareful}" CornerRadius="4" Padding="7,1"
                                            VerticalAlignment="Center" Margin="12,0,0,0">
                                        <TextBlock Text="{Binding SafetyText}" FontSize="11" />
                                    </Border>
                                    <CheckBox IsChecked="{Binding IsChecked}" VerticalAlignment="Center" AutomationProperties.Name="{Binding Title}">
                                        <TextBlock Text="{Binding Title}" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource Forest.Text}"
                                                   TextWrapping="Wrap" />
                                    </CheckBox>
                                </DockPanel>
                                <TextBlock Text="{Binding Hint}" FontSize="12" Foreground="{DynamicResource Forest.Muted}" TextWrapping="Wrap" Margin="0,4,0,4" />
                                <!-- пункты: у папки целиком (распакованные моды, логи) списка нет — галочка группы и есть она -->
                                <ItemsControl ItemsSource="{Binding Items}" Margin="26,2,0,0" IsVisible="{Binding ShowItems}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="vm:CleanupItemViewModel">
                                            <DockPanel Margin="0,3,0,0">
                                                <TextBlock DockPanel.Dock="Right" Text="{Binding Details}" FontSize="12" Foreground="{DynamicResource Forest.Muted}"
                                                           VerticalAlignment="Center" Margin="12,0,0,0" />
                                                <CheckBox IsChecked="{Binding IsChecked}" VerticalAlignment="Center" AutomationProperties.Name="{Binding Title}">
                                                    <TextBlock Text="{Binding Title}" FontSize="12" Foreground="{DynamicResource Forest.Text}"
                                                               TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Title}" />
                                                </CheckBox>
                                            </DockPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </DockPanel>
</dialogs:DialogWindow>
