<dialogs:DialogWindow xmlns="https://github.com/avaloniaui"
                      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                      xmlns:vm="using:eViSTool.Presentation.ViewModels"
                      xmlns:local="using:eViSTool.Desktop"
                      xmlns:ctl="using:eViSTool.Desktop.Controls"
                      xmlns:conv="using:eViSTool.Desktop.Converters"
                      xmlns:dialogs="using:eViSTool.Desktop.Dialogs"
                      x:Class="eViSTool.Desktop.Dialogs.BanWindow"
                      x:DataType="vm:BanViewModel"
                      Title="{local:Tr players.banTitle}" Width="444" SizeToContent="Height" CanResize="False">
    <!-- ширина без рамки: в WPF Width="460" считается вместе с рамкой окна, внутри остаётся 444 -->
    <StackPanel Margin="24,20,24,22">
        <TextBlock Classes="dialogTitle" Text="{Binding Heading}" />

        <TextBlock Classes="label" Text="{local:Tr players.banFor}" />
        <WrapPanel Margin="0,8,0,0">
            <RadioButton Theme="{StaticResource Forest.Chip}" GroupName="BanTerm" Content="{local:Tr players.banHour}"
                         IsChecked="{Binding Term, Converter={x:Static conv:EnumEqualsConverter.Instance}, ConverterParameter=Hour}"
                         AutomationProperties.AutomationId="BanHour" />
            <RadioButton Theme="{StaticResource Forest.Chip}" GroupName="BanTerm" Content="{local:Tr players.banDay}"
                         IsChecked="{Binding Term, Converter={x:Static conv:EnumEqualsConverter.Instance}, ConverterParameter=Day}"
                         AutomationProperties.AutomationId="BanDay" />
            <RadioButton Theme="{StaticResource Forest.Chip}" GroupName="BanTerm" Content="{local:Tr players.banWeek}"
                         IsChecked="{Binding Term, Converter={x:Static conv:EnumEqualsConverter.Instance}, ConverterParameter=Week}"
                         AutomationProperties.AutomationId="BanWeek" />
            <RadioButton Theme="{StaticResource Forest.Chip}" GroupName="BanTerm" Content="{local:Tr players.banMonth}"
                         IsChecked="{Binding Term, Converter={x:Static conv:EnumEqualsConverter.Instance}, ConverterParameter=Month}"
                         AutomationProperties.AutomationId="BanMonth" />
            <RadioButton Theme="{StaticResource Forest.Chip}" GroupName="BanTerm" Content="{local:Tr players.banForever}"
                         IsChecked="{Binding Term, Converter={x:Static conv:EnumEqualsConverter.Instance}, ConverterParameter=Forever}"
                         AutomationProperties.AutomationId="BanForever" />
        </WrapPanel>

        <TextBlock Classes="label" Text="{local:Tr players.banReason}" />
        <TextBox Text="{Binding Reason}" Margin="0,6,0,0" MaxLength="200" ctl:Focus.OnOpen="True"
                 AutomationProperties.AutomationId="BanReason" AutomationProperties.Name="{local:Tr players.banReason}" />

        <StackPanel Classes="dialogButtons" Margin="0,20,0,0">
            <Button Classes="primary" Content="{local:Tr players.banGo}" IsDefault="True" Command="{Binding OkCommand}" Padding="18,8"
                    AutomationProperties.AutomationId="BanOk" />
            <Button Content="{local:Tr common.cancel}" Click="Cancel_Click" Margin="8,0,0,0" Padding="16,8"
                    AutomationProperties.AutomationId="BanCancel" />
        </StackPanel>
    </StackPanel>
</dialogs:DialogWindow>
