<dialogs:DialogWindow xmlns="https://github.com/avaloniaui"
                      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                      xmlns:vm="using:eViSTool.Presentation.ViewModels"
                      xmlns:local="using:eViSTool.Desktop"
                      xmlns:ctl="using:eViSTool.Desktop.Controls"
                      xmlns:dialogs="using:eViSTool.Desktop.Dialogs"
                      x:Class="eViSTool.Desktop.Dialogs.NewProfileWindow"
                      x:DataType="vm:NewProfileViewModel"
                      Title="{Binding Title}" Width="544" SizeToContent="Height" CanResize="False">
    <!-- ширина — содержимого окна, без рамки -->
    <StackPanel Margin="24,20,24,22">
        <TextBlock Classes="dialogTitle" Text="{Binding Title}" />

        <TextBlock Classes="label" Text="{local:Tr newprofile.name}" />
        <TextBox x:Name="NameBox" Classes="clearButton" Text="{Binding Name}" Margin="0,6,0,0" MaxLength="60" ctl:Focus.OnOpen="True" ctl:Focus.SelectAll="True"
                 AutomationProperties.AutomationId="NewProfileName" />

        <!-- серверный профиль: папка данных получает имя профиля -->
        <StackPanel Margin="0,14,0,0" IsVisible="{Binding IsServer}">
            <TextBlock Text="{local:Tr newprofile.folder}" FontSize="12" />
            <TextBlock Classes="mono" Text="{Binding FolderText}" FontSize="12" Foreground="{DynamicResource Forest.Accent}" TextWrapping="Wrap"
                       Margin="0,4,0,0" />
            <TextBlock Classes="hint" Text="{local:Tr newprofile.folderHint}" Margin="0,6,0,0" />
        </StackPanel>

        <!-- серверный профиль: данные сервера уже есть — скопировать их в профиль или взять папку как есть -->
        <Border Classes="card" Padding="16,14" Margin="0,18,0,0" IsVisible="{Binding IsServer}">
            <StackPanel>
                <TextBlock Text="{local:Tr newprofile.existing}" FontSize="13" FontWeight="SemiBold" />
                <TextBlock Classes="hint" Text="{local:Tr newprofile.existingHint}" Margin="0,2,0,8" />
                <DockPanel>
                    <Button DockPanel.Dock="Right" Content="{local:Tr common.browse}" Command="{Binding BrowseCommand}" Margin="8,0,0,0" />
                    <TextBox Classes="clearButton" Text="{Binding ExistingDir}" VerticalContentAlignment="Center" AutomationProperties.AutomationId="NewProfileExisting" />
                </DockPanel>
                <!-- что нашлось в папке: обычное — приглушённым, «не похоже на данные сервера» — красным -->
                <TextBlock Classes="hint" Classes.error="{Binding ExistingInfoIsError}" Text="{Binding ExistingInfo}" Margin="0,6,0,0" />
                <StackPanel Classes="dialogButtons" Margin="0,10,0,0">
                    <Button Content="{local:Tr newprofile.import}" Command="{Binding ImportCommand}" Margin="0,0,8,0"
                            ToolTip.Tip="{local:Tr newprofile.importTip}" AutomationProperties.AutomationId="NewProfileImport" />
                    <Button Content="{local:Tr newprofile.useInPlace}" Command="{Binding UseInPlaceCommand}"
                            ToolTip.Tip="{local:Tr newprofile.useInPlaceTip}" AutomationProperties.AutomationId="NewProfileUseInPlace" />
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- серверный профиль: сервер на другом компьютере — по коду подключения -->
        <Border Classes="card" Padding="16,14" Margin="0,12,0,0" IsVisible="{Binding IsServer}">
            <DockPanel>
                <Button DockPanel.Dock="Right" Content="{local:Tr newprofile.connect}" Command="{Binding ConnectCommand}" VerticalAlignment="Center"
                        Margin="12,0,0,0" AutomationProperties.AutomationId="NewProfileConnect" />
                <StackPanel>
                    <TextBlock Text="{local:Tr newprofile.remote}" FontSize="13" FontWeight="SemiBold" />
                    <TextBlock Classes="hint" Text="{local:Tr newprofile.remoteHint}" />
                </StackPanel>
            </DockPanel>
        </Border>

        <StackPanel Classes="dialogButtons" Margin="0,20,0,0">
            <Button Classes="primary" Content="{local:Tr newprofile.create}" IsDefault="True" Command="{Binding OkCommand}" Padding="18,8"
                    AutomationProperties.AutomationId="NewProfileCreate" />
            <Button Content="{local:Tr common.cancel}" Click="Cancel_Click" Margin="8,0,0,0" Padding="16,8" />
        </StackPanel>
    </StackPanel>
</dialogs:DialogWindow>
