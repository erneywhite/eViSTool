<Window x:Class="eViSTool.App.UpdateWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:eViSTool.App"
        Icon="Assets/eViSTool.ico" Width="780" Height="580" MinWidth="640" MinHeight="520" ResizeMode="CanResize"
        Background="{StaticResource Forest.Surface}" WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <Window.Resources>
        <local:TextToVisibilityConverter x:Key="TextToVis" />
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </Window.Resources>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="240" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- ===== слева: что за обновление и что с ним сделать ===== -->
        <Border Background="{StaticResource Forest.Side}" BorderBrush="{StaticResource Forest.Line}" BorderThickness="0,0,1,0">
            <Grid Margin="20,26,20,20">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" MinHeight="12" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <StackPanel Grid.Row="2">
                    <TextBlock x:Name="Status" FontSize="12" Foreground="{StaticResource Forest.Accent}" TextWrapping="Wrap" TextAlignment="Center"
                               Margin="0,0,0,10" Visibility="Collapsed" AutomationProperties.AutomationId="UpdateWindowStatus" />
                    <Button x:Name="InstallButton" Style="{StaticResource Forest.PrimaryButton}" Click="Install_Click" Padding="14,9"
                            HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" IsDefault="True"
                            AutomationProperties.AutomationId="UpdateWindowInstall">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource Icon.Download}" Style="{StaticResource Forest.Icon}" Width="14" Height="14" Margin="0,0,8,0" />
                            <TextBlock Text="{local:Tr updwin.install}" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="LaterButton" Content="{local:Tr updwin.later}" Click="Later_Click" IsCancel="True" Padding="14,8" Margin="0,8,0,0"
                            HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" AutomationProperties.AutomationId="UpdateWindowLater" />
                    <Button x:Name="SkipButton" Style="{StaticResource Forest.LinkButton}" Content="{local:Tr updwin.skip}" Click="Skip_Click"
                            Foreground="{StaticResource Forest.Muted}" HorizontalAlignment="Center" Margin="0,14,0,0"
                            AutomationProperties.AutomationId="UpdateWindowSkip" />
                </StackPanel>
                <StackPanel Grid.Row="0">
                    <Image Source="Assets/logo256.png" Width="96" Height="96" RenderOptions.BitmapScalingMode="HighQuality" />
                    <TextBlock Text="{local:Tr updwin.title}" FontSize="17" FontWeight="SemiBold" Foreground="{StaticResource Forest.Text}"
                               TextAlignment="Center" TextWrapping="Wrap" Margin="0,12,0,0" />
                    <TextBlock HorizontalAlignment="Center" Margin="0,12,0,8">
                        <Run x:Name="OldVersion" FontSize="15" Foreground="{StaticResource Forest.Muted}" />
                        <Run Text="  →  " FontSize="15" Foreground="{StaticResource Forest.Muted}" />
                        <Run x:Name="NewVersion" FontSize="22" FontWeight="SemiBold" Foreground="{StaticResource Forest.Accent}" />
                    </TextBlock>
                    <!-- рекомендуемое: среди пропущенных версий есть помеченная в тексте релиза -->
                    <Border x:Name="RecommendedBox" Background="{StaticResource Forest.WarningBg}" BorderBrush="{StaticResource Forest.Warn}"
                            BorderThickness="1" CornerRadius="6" Padding="10,8" Margin="0,0,0,10" Visibility="Collapsed"
                            AutomationProperties.AutomationId="UpdateWindowRecommended">
                        <StackPanel>
                            <TextBlock Text="{local:Tr updwin.recommended}" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource Forest.Warn}"
                                       TextAlignment="Center" TextWrapping="Wrap" />
                            <TextBlock Text="{local:Tr updwin.recommendedHint}" FontSize="12" Foreground="{StaticResource Forest.Text}"
                                       TextAlignment="Center" TextWrapping="Wrap" Margin="0,3,0,0" />
                        </StackPanel>
                    </Border>
                    <TextBlock Text="{local:Tr updwin.hint}" FontSize="12" Foreground="{StaticResource Forest.Muted}" TextWrapping="Wrap" TextAlignment="Center" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- ===== справа: что изменилось за все пропущенные версии ===== -->
        <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" Padding="22,18,22,18">
            <StackPanel>
                <ItemsControl x:Name="Versions" AutomationProperties.AutomationId="UpdateWindowNotes">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type local:UpdateNotesItem}">
                            <!-- версии разделены чертой; над первой её нет -->
                            <Border x:Name="Sep" BorderBrush="{StaticResource Forest.Line}" BorderThickness="0,1,0,0" Padding="0,14,0,0" Margin="0,0,0,14">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock VerticalAlignment="Center">
                                        <Run Text="{Binding Version, Mode=OneWay}" FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource Forest.Text}" />
                                        <Run Text="{Binding Date, Mode=OneWay}" FontSize="12" Foreground="{StaticResource Forest.Muted}" />
                                    </TextBlock>
                                    <Border Background="{StaticResource Forest.WarningBg}" CornerRadius="8" Padding="7,1" Margin="10,0,0,0" VerticalAlignment="Center"
                                            Visibility="{Binding Recommended, Converter={StaticResource BoolToVis}}">
                                        <TextBlock Text="{local:Tr updwin.recommendedTag}" FontSize="11" Foreground="{StaticResource Forest.Warn}" />
                                    </Border>
                                </StackPanel>
                                <TextBlock Text="{Binding Summary}" FontSize="13" Foreground="{StaticResource Forest.Muted}" FontStyle="Italic"
                                           TextWrapping="Wrap" Margin="0,2,0,0" Visibility="{Binding Summary, Converter={StaticResource TextToVis}}" />
                                <ItemsControl ItemsSource="{Binding Sections}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Margin="0,8,0,0">
                                                <TextBlock Text="{Binding Heading}" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource Forest.Muted}"
                                                           Margin="0,0,0,4" Visibility="{Binding Heading, Converter={StaticResource TextToVis}}" />
                                                <ItemsControl ItemsSource="{Binding Items}">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <DockPanel Margin="0,0,0,6">
                                                                <TextBlock DockPanel.Dock="Left" Text="•" Foreground="{StaticResource Forest.Accent}" Margin="2,0,8,0" />
                                                                <TextBlock Text="{Binding}" FontSize="13" Foreground="{StaticResource Forest.Text}" TextWrapping="Wrap" />
                                                            </DockPanel>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <!-- у релиза нет текста (лента GitHub без описаний) — ссылка на страницу -->
                                <Button Style="{StaticResource Forest.LinkButton}" Content="{local:Tr updwin.openPage}" Click="OpenPage_Click"
                                        Tag="{Binding PageUrl}" HorizontalAlignment="Left" Margin="0,6,0,0"
                                        Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVis}}" />
                            </StackPanel>
                            </Border>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding IsFirst}" Value="True">
                                    <Setter TargetName="Sep" Property="BorderThickness" Value="0" />
                                    <Setter TargetName="Sep" Property="Padding" Value="0" />
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>
