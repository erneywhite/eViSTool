<UserControl x:Class="eViSTool.App.ServerScheduleView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:eViSTool.App">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <local:InvertBoolToVisibilityConverter x:Key="InvertVis" />
        <local:TextToVisibilityConverter x:Key="TextToVis" />
        <local:EnumEqualsConverter x:Key="EnumEq" />

        <Style x:Key="CardTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{StaticResource Forest.Text}" />
        </Style>
        <Style x:Key="Hint" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Foreground" Value="{StaticResource Forest.Muted}" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="0,2,0,0" />
        </Style>
        <Style x:Key="Label" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Foreground" Value="{StaticResource Forest.Text}" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style x:Key="ScheduleCard" TargetType="Border" BasedOn="{StaticResource Forest.Card}">
            <Setter Property="Padding" Value="20,16,20,18" />
            <Setter Property="Margin" Value="0,0,0,14" />
        </Style>
        <Style x:Key="Row" TargetType="Border">
            <Setter Property="BorderBrush" Value="{StaticResource Forest.Line}" />
            <Setter Property="BorderThickness" Value="0,1,0,0" />
            <Setter Property="Padding" Value="0,14,0,0" />
            <Setter Property="Margin" Value="0,14,0,0" />
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,14,0,0">
        <StackPanel Margin="0,0,14,0">
            <!-- ===== расписание копий ===== -->
            <Border Style="{StaticResource ScheduleCard}">
                <StackPanel>
                    <TextBlock Text="{local:Tr sched.backupsTitle}" Style="{StaticResource CardTitle}" />
                    <TextBlock Text="{local:Tr sched.backupsHint}" Style="{StaticResource Hint}" />

                    <Border Style="{StaticResource Row}">
                        <DockPanel>
                            <CheckBox DockPanel.Dock="Right" Style="{StaticResource Forest.Switch}" IsChecked="{Binding BackupEnabled}" VerticalAlignment="Center"
                                      AutomationProperties.AutomationId="SchedBackupEnabled" AutomationProperties.Name="{local:Tr sched.enabled}" />
                            <StackPanel Margin="0,0,16,0">
                                <TextBlock Text="{local:Tr sched.enabled}" Style="{StaticResource Label}" />
                                <TextBlock Text="{local:Tr sched.enabledHint}" Style="{StaticResource Hint}" />
                            </StackPanel>
                        </DockPanel>
                    </Border>

                    <Border Style="{StaticResource Row}">
                        <DockPanel>
                            <StackPanel DockPanel.Dock="Right" Width="130">
                                <TextBox Text="{Binding IntervalText, UpdateSourceTrigger=PropertyChanged}" VerticalContentAlignment="Center"
                                         AutomationProperties.AutomationId="SchedInterval" AutomationProperties.Name="{local:Tr sched.interval}" />
                            </StackPanel>
                            <StackPanel Margin="0,0,16,0">
                                <TextBlock Text="{local:Tr sched.interval}" Style="{StaticResource Label}" />
                                <TextBlock Text="{local:Tr sched.intervalHint}" Style="{StaticResource Hint}" />
                                <TextBlock Text="{Binding IntervalError}" FontSize="12" Foreground="{StaticResource Forest.Danger}" Margin="0,4,0,0"
                                           Visibility="{Binding IntervalError, Converter={StaticResource TextToVis}}" />
                            </StackPanel>
                        </DockPanel>
                    </Border>

                    <Border Style="{StaticResource Row}">
                        <DockPanel>
                            <StackPanel DockPanel.Dock="Right" Width="130">
                                <TextBox Text="{Binding KeepText, UpdateSourceTrigger=PropertyChanged}" VerticalContentAlignment="Center"
                                         AutomationProperties.AutomationId="SchedKeep" AutomationProperties.Name="{local:Tr sched.keep}" />
                            </StackPanel>
                            <StackPanel Margin="0,0,16,0">
                                <TextBlock Text="{local:Tr sched.keep}" Style="{StaticResource Label}" />
                                <TextBlock Text="{local:Tr sched.keepHint}" Style="{StaticResource Hint}" />
                                <TextBlock Text="{Binding KeepError}" FontSize="12" Foreground="{StaticResource Forest.Danger}" Margin="0,4,0,0"
                                           Visibility="{Binding KeepError, Converter={StaticResource TextToVis}}" />
                            </StackPanel>
                        </DockPanel>
                    </Border>

                    <Border Style="{StaticResource Row}">
                        <DockPanel>
                            <CheckBox DockPanel.Dock="Right" Style="{StaticResource Forest.Switch}" IsChecked="{Binding OnlyWhenPlayed}" VerticalAlignment="Center"
                                      AutomationProperties.AutomationId="SchedOnlyWhenPlayed" AutomationProperties.Name="{local:Tr sched.onlyPlayed}" />
                            <StackPanel Margin="0,0,16,0">
                                <TextBlock Text="{local:Tr sched.onlyPlayed}" Style="{StaticResource Label}" />
                                <TextBlock Text="{local:Tr sched.onlyPlayedHint}" Style="{StaticResource Hint}" />
                            </StackPanel>
                        </DockPanel>
                    </Border>

                    <Border Style="{StaticResource Row}">
                        <DockPanel>
                            <CheckBox DockPanel.Dock="Right" Style="{StaticResource Forest.Switch}" IsChecked="{Binding Announce}" VerticalAlignment="Center"
                                      AutomationProperties.AutomationId="SchedAnnounce" AutomationProperties.Name="{local:Tr sched.announce}" />
                            <StackPanel Margin="0,0,16,0">
                                <TextBlock Text="{local:Tr sched.announce}" Style="{StaticResource Label}" />
                                <TextBlock Text="{local:Tr sched.announceHint}" Style="{StaticResource Hint}" />
                            </StackPanel>
                        </DockPanel>
                    </Border>
                </StackPanel>
            </Border>

            <!-- ===== перезапуски по расписанию ===== -->
            <Border Style="{StaticResource ScheduleCard}">
                <StackPanel>
                    <TextBlock Text="{local:Tr sched.restartTitle}" Style="{StaticResource CardTitle}" />
                    <TextBlock Text="{local:Tr sched.restartHint}" Style="{StaticResource Hint}" />

                    <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                        <RadioButton Style="{StaticResource Forest.Chip}" GroupName="RestartMode" Content="{local:Tr sched.restartOff}"
                                     IsChecked="{Binding RestartMode, Converter={StaticResource EnumEq}, ConverterParameter=Off}"
                                     AutomationProperties.AutomationId="SchedRestartOff" />
                        <RadioButton Style="{StaticResource Forest.Chip}" GroupName="RestartMode" Content="{local:Tr sched.restartInterval}"
                                     IsChecked="{Binding RestartMode, Converter={StaticResource EnumEq}, ConverterParameter=Interval}"
                                     AutomationProperties.AutomationId="SchedRestartInterval" />
                        <RadioButton Style="{StaticResource Forest.Chip}" GroupName="RestartMode" Content="{local:Tr sched.restartDaily}"
                                     IsChecked="{Binding RestartMode, Converter={StaticResource EnumEq}, ConverterParameter=Daily}"
                                     AutomationProperties.AutomationId="SchedRestartDaily" />
                    </StackPanel>

                    <Border Style="{StaticResource Row}" Visibility="{Binding IsRestartInterval, Converter={StaticResource BoolToVis}}">
                        <DockPanel>
                            <TextBox DockPanel.Dock="Right" Width="130" Text="{Binding RestartIntervalText, UpdateSourceTrigger=PropertyChanged}"
                                     VerticalContentAlignment="Center" VerticalAlignment="Top"
                                     AutomationProperties.AutomationId="SchedRestartHours" AutomationProperties.Name="{local:Tr sched.restartHours}" />
                            <StackPanel Margin="0,0,16,0">
                                <TextBlock Text="{local:Tr sched.restartHours}" Style="{StaticResource Label}" />
                                <TextBlock Text="{local:Tr sched.restartHoursHint}" Style="{StaticResource Hint}" />
                            </StackPanel>
                        </DockPanel>
                    </Border>

                    <Border Style="{StaticResource Row}" Visibility="{Binding IsRestartDaily, Converter={StaticResource BoolToVis}}">
                        <DockPanel>
                            <TextBox DockPanel.Dock="Right" Width="220" Text="{Binding RestartTimesText, UpdateSourceTrigger=PropertyChanged}"
                                     VerticalContentAlignment="Center" VerticalAlignment="Top"
                                     AutomationProperties.AutomationId="SchedRestartTimes" AutomationProperties.Name="{local:Tr sched.restartTimes}" />
                            <StackPanel Margin="0,0,16,0">
                                <TextBlock Text="{local:Tr sched.restartTimes}" Style="{StaticResource Label}" />
                                <TextBlock Text="{local:Tr sched.restartTimesHint}" Style="{StaticResource Hint}" />
                            </StackPanel>
                        </DockPanel>
                    </Border>

                    <Border Style="{StaticResource Row}" Visibility="{Binding IsRestartOn, Converter={StaticResource BoolToVis}}">
                        <DockPanel>
                            <TextBox DockPanel.Dock="Right" Width="220" Text="{Binding RestartWarnText, UpdateSourceTrigger=PropertyChanged}"
                                     VerticalContentAlignment="Center" VerticalAlignment="Top"
                                     AutomationProperties.AutomationId="SchedRestartWarn" AutomationProperties.Name="{local:Tr sched.restartWarn}" />
                            <StackPanel Margin="0,0,16,0">
                                <TextBlock Text="{local:Tr sched.restartWarn}" Style="{StaticResource Label}" />
                                <TextBlock Text="{local:Tr sched.restartWarnHint}" Style="{StaticResource Hint}" />
                            </StackPanel>
                        </DockPanel>
                    </Border>

                    <Border Style="{StaticResource Row}" Visibility="{Binding IsRestartOn, Converter={StaticResource BoolToVis}}">
                        <DockPanel>
                            <CheckBox DockPanel.Dock="Right" Style="{StaticResource Forest.Switch}" IsChecked="{Binding RestartBackup}" VerticalAlignment="Center"
                                      AutomationProperties.AutomationId="SchedRestartBackup" AutomationProperties.Name="{local:Tr sched.restartBackup}" />
                            <StackPanel Margin="0,0,16,0">
                                <TextBlock Text="{local:Tr sched.restartBackup}" Style="{StaticResource Label}" />
                                <TextBlock Text="{local:Tr sched.restartBackupHint}" Style="{StaticResource Hint}" />
                            </StackPanel>
                        </DockPanel>
                    </Border>

                    <TextBlock Text="{Binding RestartError}" FontSize="12" Foreground="{StaticResource Forest.Danger}" Margin="0,10,0,0"
                               Visibility="{Binding RestartError, Converter={StaticResource TextToVis}}" />
                    <TextBlock Text="{Binding NextRestartText}" FontSize="12" Foreground="{StaticResource Forest.Accent}" Margin="0,12,0,0"
                               Visibility="{Binding NextRestartText, Converter={StaticResource TextToVis}}" AutomationProperties.AutomationId="SchedRestartNext" />
                </StackPanel>
            </Border>

            <!-- ===== копии на диске ===== -->
            <Border Style="{StaticResource ScheduleCard}">
                <StackPanel>
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top">
                            <Button Command="{Binding OpenFolderCommand}" Padding="10,8" Margin="0,0,8,0" ToolTip="{local:Tr sched.openFolder}"
                                    Visibility="{Binding IsLocal, Converter={StaticResource BoolToVis}}">
                                <Path Data="{StaticResource Icon.Folder}" Style="{StaticResource Forest.Icon}" Width="16" Height="16" />
                            </Button>
                            <Button Style="{StaticResource Forest.PrimaryButton}" Command="{Binding BackupNowCommand}" ToolTip="{local:Tr sched.nowTip}"
                                    ToolTipService.ShowOnDisabled="True" AutomationProperties.AutomationId="SchedBackupNow">
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="{StaticResource Icon.Download}" Style="{StaticResource Forest.Icon}" Width="14" Height="14" Margin="0,0,8,0" />
                                    <TextBlock Text="{local:Tr sched.now}" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                        <StackPanel>
                            <TextBlock Text="{local:Tr sched.listTitle}" Style="{StaticResource CardTitle}" />
                            <TextBlock Style="{StaticResource Hint}" FontSize="12">
                                <Run Text="{Binding LastBackupText, Mode=OneWay}" /><Run Text="   ·   " /><Run Text="{Binding NextBackupText, Mode=OneWay}" />
                            </TextBlock>
                            <TextBlock Text="{Binding TotalText}" Style="{StaticResource Hint}" FontSize="12"
                                       Visibility="{Binding TotalText, Converter={StaticResource TextToVis}}" AutomationProperties.AutomationId="SchedTotal" />
                        </StackPanel>
                    </DockPanel>

                    <TextBlock Text="{Binding StatusText}" FontSize="12" Foreground="{StaticResource Forest.Accent}" TextWrapping="Wrap" Margin="0,10,0,0"
                               Visibility="{Binding StatusText, Converter={StaticResource TextToVis}}" AutomationProperties.AutomationId="SchedStatus" />

                    <TextBlock Text="{local:Tr sched.empty}" Style="{StaticResource Hint}" FontSize="12" Margin="0,14,0,0"
                               Visibility="{Binding HasBackups, Converter={StaticResource InvertVis}}" />

                    <ItemsControl ItemsSource="{Binding Backups}" Margin="0,6,0,0" Focusable="False">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="{StaticResource Forest.Line}" BorderThickness="0,1,0,0" Padding="0,9" Margin="0,4,0,0">
                                    <DockPanel>
                                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                            <Button Style="{StaticResource Forest.LinkButton}" Content="{local:Tr sched.restore}" Margin="0,0,14,0"
                                                    ToolTip="{local:Tr sched.restoreTip}" ToolTipService.ShowOnDisabled="True"
                                                    Command="{Binding DataContext.RestoreCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                    CommandParameter="{Binding}" />
                                            <Button Style="{StaticResource Forest.LinkButton}" Content="{local:Tr sched.show}" Margin="0,0,14,0"
                                                    Visibility="{Binding IsLocal, Converter={StaticResource BoolToVis}}"
                                                    Command="{Binding DataContext.ShowInFolderCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                    CommandParameter="{Binding}" />
                                            <Button Style="{StaticResource Forest.LinkButton}" Content="{local:Tr sched.delete}" Foreground="{StaticResource Forest.Danger}"
                                                    Command="{Binding DataContext.DeleteCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                    CommandParameter="{Binding}" />
                                        </StackPanel>
                                        <TextBlock DockPanel.Dock="Right" Text="{Binding SizeText}" FontSize="12" Foreground="{StaticResource Forest.Muted}"
                                                   VerticalAlignment="Center" Margin="16,0,24,0" MinWidth="70" TextAlignment="Right" />
                                        <TextBlock DockPanel.Dock="Right" Text="{Binding TimeText}" FontSize="12" Foreground="{StaticResource Forest.Text}"
                                                   VerticalAlignment="Center" Margin="16,0,0,0" />
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Name}" FontFamily="Consolas" FontSize="12" Foreground="{StaticResource Forest.Text}"
                                                       TextTrimming="CharacterEllipsis" />
                                            <Border CornerRadius="4" Padding="6,1" Margin="10,0,0,0" Background="{StaticResource Forest.Raised}"
                                                    ToolTip="{local:Tr sched.manualTip}" Visibility="{Binding IsManual, Converter={StaticResource BoolToVis}}">
                                                <TextBlock Text="{local:Tr sched.manual}" FontSize="10" Foreground="{StaticResource Forest.Muted}" />
                                            </Border>
                                            <Border CornerRadius="4" Padding="6,1" Margin="10,0,0,0" Background="{StaticResource Forest.Raised}"
                                                    ToolTip="{Binding ModDataTip}" Visibility="{Binding HasModData, Converter={StaticResource BoolToVis}}">
                                                <TextBlock Text="{local:Tr sched.modData}" FontSize="10" Foreground="{StaticResource Forest.Muted}" />
                                            </Border>
                                        </StackPanel>
                                    </DockPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
