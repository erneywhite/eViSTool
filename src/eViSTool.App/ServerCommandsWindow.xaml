<Window x:Class="eViSTool.App.ServerCommandsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:eViSTool.App"
        Title="{local:Tr cmds.title}" Icon="Assets/eViSTool.ico"
        Width="760" Height="560" MinWidth="520" MinHeight="360"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <DockPanel Margin="16">
        <TextBlock DockPanel.Dock="Top" FontSize="16" FontWeight="SemiBold" Text="{local:Tr cmds.title}" />
        <TextBlock DockPanel.Dock="Top" Margin="0,4,0,12" Opacity="0.7" TextWrapping="Wrap" Text="{local:Tr cmds.hint}" />

        <TextBox x:Name="SearchBox" DockPanel.Dock="Top" Margin="0,0,0,10" Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}"
                 PreviewKeyDown="SearchBox_PreviewKeyDown" AutomationProperties.AutomationId="CmdsSearch"
                 AutomationProperties.Name="{local:Tr cmds.search}" />

        <DockPanel DockPanel.Dock="Bottom" Margin="0,12,0,0">
            <Button DockPanel.Dock="Left" Content="{local:Tr cmds.refresh}" Click="Refresh_Click" Padding="14,6"
                    IsEnabled="{Binding CanRefresh}" ToolTip="{local:Tr cmds.refreshTip}" ToolTipService.ShowOnDisabled="True"
                    AutomationProperties.AutomationId="CmdsRefresh" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="{local:Tr cmds.insert}" IsDefault="True" Click="Insert_Click" Padding="16,6"
                        Style="{DynamicResource AccentButtonStyle}" AutomationProperties.AutomationId="CmdsInsert" />
                <Button Content="{local:Tr common.cancel}" IsCancel="True" Margin="8,0,0,0" Padding="16,6" />
            </StackPanel>
        </DockPanel>

        <TextBlock DockPanel.Dock="Bottom" Text="{Binding Status}" Opacity="0.7" Margin="0,8,0,0" TextWrapping="Wrap"
                   AutomationProperties.AutomationId="CmdsStatus" />

        <ListBox x:Name="List" ItemsSource="{Binding Shown}" SelectionMode="Single" MouseDoubleClick="List_MouseDoubleClick"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled" AutomationProperties.AutomationId="CmdsList">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <StackPanel Margin="2,3">
                        <TextBlock Text="{Binding Usage}" FontFamily="Cascadia Mono, Consolas" FontSize="13" TextWrapping="Wrap" />
                        <TextBlock Text="{Binding Description}" FontSize="12" Opacity="0.7" TextWrapping="Wrap" Margin="0,2,0,0" />
                    </StackPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </DockPanel>
</Window>
