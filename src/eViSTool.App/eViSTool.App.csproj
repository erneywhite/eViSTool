<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <AssemblyName>eViSTool</AssemblyName>
    <RootNamespace>eViSTool.App</RootNamespace>
    <ApplicationIcon>Assets\eViSTool.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\eViSTool.Core\eViSTool.Core.csproj" />
    <!-- агент собирается вместе с окном и кладётся рядом: общая папка data -->
    <ProjectReference Include="..\eViSTool.Agent\eViSTool.Agent.csproj" ReferenceOutputAssembly="false"
                      Condition="'$(_IsPublishing)' != 'true'" />
  </ItemGroup>

  <!-- при публикации агент собирается отдельно (самодостаточным) — см. build/publish.ps1 -->
  <Target Name="CopyAgentNextToApp" AfterTargets="Build" Condition="'$(_IsPublishing)' != 'true'">
    <PropertyGroup>
      <AgentOut>..\eViSTool.Agent\bin\$(Configuration)\net10.0\</AgentOut>
    </PropertyGroup>
    <ItemGroup>
      <!-- без data: там могли остаться чужие настройки -->
      <AgentFiles Include="$(AgentOut)**\*.*" Exclude="$(AgentOut)data\**" />
    </ItemGroup>
    <Copy SourceFiles="@(AgentFiles)" DestinationFiles="@(AgentFiles->'$(OutDir)%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" />
  </Target>

  <ItemGroup>
    <Resource Include="Assets\eViSTool.ico" />
    <Resource Include="Assets\logo256.png" />
    <Resource Include="Assets\kofi.png" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
  </ItemGroup>

</Project>
