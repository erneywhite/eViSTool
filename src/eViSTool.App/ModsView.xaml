<UserControl x:Class="eViSTool.App.ModsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:eViSTool.App"
             xmlns:vm="clr-namespace:eViSTool.App.ViewModels">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <local:InvertBoolConverter x:Key="Invert" />
        <local:CountToVisibilityConverter x:Key="CountToVis" />
        <local:PixelsToGridLengthConverter x:Key="PxToGrid" />
        <local:ScreenshotThumbConverter x:Key="Thumb" />
        <local:EnumEqualsConverter x:Key="EnumEq" />
        <local:TextToVisibilityConverter x:Key="TextToVis" />
        <local:ZeroToVisibleConverter x:Key="ZeroVis" />
        <local:InvertBoolToVisibilityConverter x:Key="InvertVis" />

        <!-- цвет состояния: точка и текст (DataContext — строка мода) -->
        <Style x:Key="ToneDot" TargetType="Ellipse">
            <Setter Property="Width" Value="6" />
            <Setter Property="Height" Value="6" />
            <Setter Property="Margin" Value="0,0,6,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Fill" Value="{StaticResource Forest.Muted}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Tone}" Value="{x:Static vm:RowTone.Good}">
                    <Setter Property="Fill" Value="{StaticResource Forest.Good}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Tone}" Value="{x:Static vm:RowTone.Update}">
                    <Setter Property="Fill" Value="{StaticResource Forest.Accent}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Tone}" Value="{x:Static vm:RowTone.Warn}">
                    <Setter Property="Fill" Value="{StaticResource Forest.Warn}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Tone}" Value="{x:Static vm:RowTone.Danger}">
                    <Setter Property="Fill" Value="{StaticResource Forest.Danger}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="ToneText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Foreground" Value="{StaticResource Forest.Muted}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Tone}" Value="{x:Static vm:RowTone.Good}">
                    <Setter Property="Foreground" Value="{StaticResource Forest.Good}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Tone}" Value="{x:Static vm:RowTone.Update}">
                    <Setter Property="Foreground" Value="{StaticResource Forest.Accent}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Tone}" Value="{x:Static vm:RowTone.Warn}">
                    <Setter Property="Foreground" Value="{StaticResource Forest.Warn}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Tone}" Value="{x:Static vm:RowTone.Danger}">
                    <Setter Property="Foreground" Value="{StaticResource Forest.Danger}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- выключенные моды в таблице — бледнее -->
        <Style x:Key="RowFade" TargetType="FrameworkElement">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsEnabled}" Value="False">
                    <Setter Property="Opacity" Value="0.5" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- строка «ключ — значение» в карточке -->
        <Style x:Key="CardKey" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource Forest.Muted}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Margin" Value="0,4,12,4" />
        </Style>
        <Style x:Key="CardValue" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource Forest.Text}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Margin" Value="0,4,0,4" />
            <Setter Property="HorizontalAlignment" Value="Right" />
            <Setter Property="TextAlignment" Value="Right" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>

        <!-- контекстное меню строки: всё, что умеет вкладка -->
        <ContextMenu x:Key="RowMenu">
            <MenuItem Header="{local:Tr menu.toggle}"
                      Command="{Binding PlacementTarget.DataContext.ToggleEnabledCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                      CommandParameter="{Binding PlacementTarget.SelectedItem, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
            <MenuItem Header="{local:Tr menu.delete}"
                      Command="{Binding PlacementTarget.DataContext.DeleteCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                      CommandParameter="{Binding PlacementTarget.SelectedItem, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
            <Separator />
            <MenuItem Header="{local:Tr menu.update}"
                      Command="{Binding PlacementTarget.DataContext.UpdateOneCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                      CommandParameter="{Binding PlacementTarget.SelectedItem, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
            <MenuItem Header="{local:Tr menu.rollback}"
                      Command="{Binding PlacementTarget.DataContext.RollbackCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                      CommandParameter="{Binding PlacementTarget.SelectedItem, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
            <MenuItem Header="{local:Tr menu.pin}"
                      Command="{Binding PlacementTarget.DataContext.TogglePinCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                      CommandParameter="{Binding PlacementTarget.SelectedItem, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
            <MenuItem Header="{local:Tr menu.skip}"
                      Command="{Binding PlacementTarget.DataContext.SkipVersionCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                      CommandParameter="{Binding PlacementTarget.SelectedItem, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
            <MenuItem Header="{local:Tr menu.unskip}"
                      Command="{Binding PlacementTarget.DataContext.ClearSkippedCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                      CommandParameter="{Binding PlacementTarget.SelectedItem, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
            <Separator />
            <MenuItem Header="{local:Tr menu.showInCatalog}"
                      Command="{Binding PlacementTarget.DataContext.ShowInCatalogCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                      CommandParameter="{Binding PlacementTarget.SelectedItem, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
            <MenuItem Header="{local:Tr menu.openPage}"
                      Command="{Binding PlacementTarget.DataContext.OpenPageCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                      CommandParameter="{Binding PlacementTarget.SelectedItem, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
            <MenuItem Header="{local:Tr menu.showFile}"
                      Visibility="{Binding PlacementTarget.DataContext.IsLocalProfile, RelativeSource={RelativeSource AncestorType=ContextMenu}, Converter={StaticResource BoolToVis}}"
                      Command="{Binding PlacementTarget.DataContext.ShowFileCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                      CommandParameter="{Binding PlacementTarget.SelectedItem, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
        </ContextMenu>
    </UserControl.Resources>

    <DockPanel Margin="10,4,10,0">
        <!-- ===== заголовок страницы и главные действия ===== -->
        <DockPanel DockPanel.Dock="Top">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top">
                <Button Command="{Binding CheckCancelCommand}" Content="{local:Tr common.cancel}" Margin="0,0,8,0"
                        Visibility="{Binding CheckCommand.IsRunning, Converter={StaticResource BoolToVis}}" />
                <Button Command="{Binding CheckCommand}" ToolTip="{local:Tr mods.checkTip}">
                    <StackPanel Orientation="Horizontal">
                        <Path Data="{StaticResource Icon.Refresh}" Style="{StaticResource Forest.Icon}" Width="14" Height="14" Margin="0,0,8,0" />
                        <TextBlock Text="{local:Tr mods.checkShort}" />
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource Forest.PrimaryButton}" Command="{Binding UpdateAllCommand}" Margin="8,0,0,0"
                        IsEnabled="{Binding CanQueue}"
                        Visibility="{Binding UpdateCount, Converter={StaticResource CountToVis}}"
                        ToolTip="{local:Tr mods.updateAllTip}">
                    <StackPanel Orientation="Horizontal">
                        <Path Data="{StaticResource Icon.Download}" Style="{StaticResource Forest.Icon}" Width="14" Height="14" Margin="0,0,8,0" />
                        <TextBlock Text="{Binding UpdateAllText}" />
                    </StackPanel>
                </Button>
            </StackPanel>
            <StackPanel>
                <TextBlock Text="{local:Tr nav.mods}" Style="{StaticResource Forest.PageTitle}" />
                <TextBlock Text="{Binding HeaderSubtitle}" ToolTip="{Binding ProfileInfo}" Foreground="{StaticResource Forest.Accent}"
                           FontSize="12" Margin="0,4,0,0" TextTrimming="CharacterEllipsis" />
            </StackPanel>
        </DockPanel>

        <!-- ===== вкладки-счётчики: число и фильтр таблицы в одном; справа — история изменений ===== -->
        <Border DockPanel.Dock="Top" BorderBrush="{StaticResource Forest.Line}" BorderThickness="0,0,0,1" Padding="0,14,0,0">
            <DockPanel>
            <RadioButton DockPanel.Dock="Right" GroupName="ModFilter" Style="{StaticResource Forest.StatTab}" Margin="12,0,0,0" FontSize="13" VerticalAlignment="Bottom"
                         ToolTip="{local:Tr hist.tabTip}" AutomationProperties.AutomationId="ModsHistoryTab"
                         IsChecked="{Binding Filter, Converter={StaticResource EnumEq}, ConverterParameter=History}">
                <StackPanel Orientation="Horizontal">
                    <Path Data="{StaticResource Icon.History}" Style="{StaticResource Forest.Icon}" Width="16" Height="16" Margin="0,0,8,0"
                          VerticalAlignment="Center" />
                    <TextBlock Text="{local:Tr hist.tab}" VerticalAlignment="Center" />
                </StackPanel>
            </RadioButton>
            <WrapPanel>
                <RadioButton Style="{StaticResource Forest.StatTab}" GroupName="ModFilter"
                             IsChecked="{Binding Filter, Converter={StaticResource EnumEq}, ConverterParameter=All}">
                    <TextBlock><Run Text="{Binding ModCount, Mode=OneWay}" FontSize="24" /><Run Text="  " /><Run Text="{Binding InstalledLabel, Mode=OneWay}" Foreground="{StaticResource Forest.Muted}" FontSize="13" /></TextBlock>
                </RadioButton>
                <RadioButton Style="{StaticResource Forest.StatTab}" GroupName="ModFilter"
                             IsChecked="{Binding Filter, Converter={StaticResource EnumEq}, ConverterParameter=Updates}">
                    <TextBlock><Run Text="{Binding UpdatesAvailable, Mode=OneWay}" FontSize="24" /><Run Text="  " /><Run Text="{Binding UpdatesLabel, Mode=OneWay}" Foreground="{StaticResource Forest.Muted}" FontSize="13" /></TextBlock>
                </RadioButton>
                <RadioButton Style="{StaticResource Forest.StatTab}" GroupName="ModFilter"
                             IsChecked="{Binding Filter, Converter={StaticResource EnumEq}, ConverterParameter=Problems}">
                    <TextBlock><Run Text="{Binding ProblemCount, Mode=OneWay}" FontSize="24" /><Run Text="  " /><Run Text="{Binding ProblemsLabel, Mode=OneWay}" Foreground="{StaticResource Forest.Muted}" FontSize="13" /></TextBlock>
                </RadioButton>
                <RadioButton Style="{StaticResource Forest.StatTab}" GroupName="ModFilter"
                             IsChecked="{Binding Filter, Converter={StaticResource EnumEq}, ConverterParameter=Pinned}">
                    <TextBlock><Run Text="{Binding PinnedCount, Mode=OneWay}" FontSize="24" /><Run Text="  " /><Run Text="{Binding PinnedLabel, Mode=OneWay}" Foreground="{StaticResource Forest.Muted}" FontSize="13" /></TextBlock>
                </RadioButton>
                <RadioButton Style="{StaticResource Forest.StatTab}" GroupName="ModFilter"
                             IsChecked="{Binding Filter, Converter={StaticResource EnumEq}, ConverterParameter=Disabled}">
                    <TextBlock><Run Text="{Binding DisabledCount, Mode=OneWay}" FontSize="24" /><Run Text="  " /><Run Text="{Binding DisabledLabel, Mode=OneWay}" Foreground="{StaticResource Forest.Muted}" FontSize="13" /></TextBlock>
                </RadioButton>
                <RadioButton Style="{StaticResource Forest.StatTab}" GroupName="ModFilter" ToolTip="{local:Tr mods.chipUnneededTip}"
                             Visibility="{Binding HasUnneeded, Converter={StaticResource BoolToVis}}"
                             IsChecked="{Binding Filter, Converter={StaticResource EnumEq}, ConverterParameter=Unneeded}">
                    <TextBlock><Run Text="{Binding UnneededCount, Mode=OneWay}" FontSize="24" /><Run Text="  " /><Run Text="{Binding UnneededLabel, Mode=OneWay}" Foreground="{StaticResource Forest.Muted}" FontSize="13" /></TextBlock>
                </RadioButton>
            </WrapPanel>
            </DockPanel>
        </Border>

        <!-- ===== зависимости ===== -->
        <Border DockPanel.Dock="Top" Style="{StaticResource Forest.Warning}" Margin="0,14,0,0"
                Visibility="{Binding HasDependencyIssues, Converter={StaticResource BoolToVis}}">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
                    <Button Content="{local:Tr mods.showProblems}" Command="{Binding SetFilterCommand}" CommandParameter="{x:Static vm:ModFilter.Problems}"
                            Padding="12,5" MinHeight="0" FontSize="12" />
                    <Button Content="{local:Tr mods.fix}" Command="{Binding FixDependenciesCommand}" Padding="12,5" MinHeight="0" FontSize="12" Margin="8,0,0,0"
                            IsEnabled="{Binding IsBusy, Converter={StaticResource Invert}}" />
                </StackPanel>
                <Path DockPanel.Dock="Left" Data="{StaticResource Icon.Warning}" Style="{StaticResource Forest.Icon}" Stroke="{StaticResource Forest.Warn}"
                      VerticalAlignment="Center" Margin="0,0,12,0" />
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="{local:Tr mods.depTitle}" Foreground="{StaticResource Forest.Warn}" FontSize="13" />
                    <TextBlock Text="{Binding DependencyText}" Foreground="{StaticResource Forest.Muted}" FontSize="12" TextWrapping="Wrap" Margin="0,2,0,0" />
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- ===== очередь установки ===== -->
        <Border DockPanel.Dock="Top" Style="{StaticResource Forest.Card}" Margin="0,14,0,0" Padding="14,12"
                Visibility="{Binding HasQueue, Converter={StaticResource BoolToVis}}">
            <DockPanel>
                <DockPanel DockPanel.Dock="Top">
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                        <Button Content="{local:Tr queue.stop}" Command="{Binding StopQueueCommand}" Padding="12,4" MinHeight="0" FontSize="12"
                                Style="{StaticResource Forest.DangerButton}"
                                Visibility="{Binding IsQueueRunning, Converter={StaticResource BoolToVis}}" />
                        <Button Content="{local:Tr queue.retry}" Command="{Binding RetryQueueCommand}" Padding="12,4" MinHeight="0" FontSize="12"
                                Visibility="{Binding HasQueueRetry, Converter={StaticResource BoolToVis}}" />
                        <Button Content="{local:Tr queue.close}" Command="{Binding CloseQueueCommand}" Padding="12,4" MinHeight="0" FontSize="12"
                                Margin="8,0,0,0" Visibility="{Binding IsQueueRunning, Converter={StaticResource InvertVis}}" />
                    </StackPanel>
                    <TextBlock Text="{Binding QueueTitle}" Foreground="{StaticResource Forest.Text}" FontSize="13" FontWeight="SemiBold"
                               VerticalAlignment="Center" />
                </DockPanel>
                <ProgressBar DockPanel.Dock="Top" Style="{StaticResource Forest.Progress}" Value="{Binding QueueProgress, Mode=OneWay}" Margin="0,10,0,6" />
                <ScrollViewer MaxHeight="150" VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding Queue}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <DockPanel Margin="0,4">
                                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Width="130" Margin="12,0,0,0">
                                        <Ellipse Style="{StaticResource ToneDot}" />
                                        <TextBlock Text="{Binding StateText}" Style="{StaticResource ToneText}" />
                                    </StackPanel>
                                    <TextBlock DockPanel.Dock="Right" Text="{Binding Versions}" FontFamily="Consolas" FontSize="12"
                                               Foreground="{StaticResource Forest.Muted}" VerticalAlignment="Center" Margin="12,0,0,0" />
                                    <!-- в очереди пункты разных профилей — видно, куда ставится каждый -->
                                    <TextBlock DockPanel.Dock="Right" Text="{Binding TargetText}" FontSize="12" Foreground="{StaticResource Forest.Accent}"
                                               VerticalAlignment="Center" Margin="12,0,0,0" MaxWidth="160" TextTrimming="CharacterEllipsis"
                                               Visibility="{Binding ShowTarget, Converter={StaticResource BoolToVis}}" />
                                    <StackPanel>
                                        <TextBlock Text="{Binding Name}" FontSize="12" Foreground="{StaticResource Forest.Text}" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding Message}" FontSize="11" Foreground="{StaticResource Forest.Danger}" TextWrapping="Wrap"
                                                   Visibility="{Binding Message, Converter={StaticResource TextToVis}}" />
                                    </StackPanel>
                                </DockPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </DockPanel>
        </Border>

        <!-- ===== строка статуса ===== -->
        <DockPanel DockPanel.Dock="Bottom" Margin="0,8,0,8">
            <TextBlock DockPanel.Dock="Right" Text="{Binding ShownText}" Foreground="{StaticResource Forest.Muted}" FontSize="12" Margin="16,0,0,0"
                       Visibility="{Binding IsHistory, Converter={StaticResource InvertVis}}" />
            <TextBlock Text="{Binding StatusText}" ToolTip="{Binding StatusText}" Foreground="{StaticResource Forest.Muted}" FontSize="12"
                       TextTrimming="CharacterEllipsis" />
        </DockPanel>

        <Grid Margin="0,14,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MinWidth="440" />
                <ColumnDefinition Width="14" />
                <ColumnDefinition Width="{Binding CardWidth, Mode=TwoWay, Converter={StaticResource PxToGrid}}" MinWidth="340" />
            </Grid.ColumnDefinitions>

            <GridSplitter Grid.Column="1" Width="14" HorizontalAlignment="Stretch" ResizeBehavior="PreviousAndNext"
                          Background="Transparent" Cursor="SizeWE" ToolTip="{local:Tr catalog.splitterTip}"
                          DragCompleted="Splitter_DragCompleted" />

            <!-- ===== левая часть: поиск, чипы, таблица ===== -->
            <DockPanel>
                <DockPanel DockPanel.Dock="Top">
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Margin="8,0,0,0">
<ComboBox ItemsSource="{Binding SortModes}" SelectedIndex="{Binding SortIndex}" MinWidth="160" FontSize="12" Margin="0,0,8,0">
                        <ComboBox.Style>
                            <Style TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsHistory}" Value="True">
                                        <Setter Property="Visibility" Value="Hidden" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ComboBox.Style>
                    </ComboBox>
                        <Button Command="{Binding AddFromFileCommand}" ToolTip="{local:Tr mods.addTip}"
                                IsEnabled="{Binding IsBusy, Converter={StaticResource Invert}}">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource Icon.Plus}" Style="{StaticResource Forest.Icon}" Width="12" Height="12" Margin="0,0,8,0" />
                                <TextBlock Text="{local:Tr mods.addShort}" />
                            </StackPanel>
                        </Button>
                        <!-- у удалённого сервера — только импорт: сборка пака читает файлы модов на месте -->
                        <Button Margin="8,0,0,0" Click="PackMenu_Click" ToolTip="{local:Tr pack.menuTip}"
                                IsEnabled="{Binding IsBusy, Converter={StaticResource Invert}}">
                            <Button.ContextMenu>
                                <ContextMenu>
                                    <MenuItem Header="{local:Tr pack.export}" Command="{Binding ExportPackCommand}"
                                              Visibility="{Binding IsLocalProfile, Converter={StaticResource BoolToVis}}" />
                                    <MenuItem Header="{local:Tr pack.import}" Command="{Binding ImportPackCommand}" />
                                </ContextMenu>
                            </Button.ContextMenu>
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource Icon.Package}" Style="{StaticResource Forest.Icon}" Width="14" Height="14" Margin="0,0,8,0" />
                                <TextBlock Text="{local:Tr pack.menu}" />
                            </StackPanel>
                        </Button>
                        <Button Margin="8,0,0,0" Command="{Binding OpenModsFolderCommand}" ToolTip="{local:Tr mods.openFolder}" Padding="10,8"
                                Visibility="{Binding IsLocalProfile, Converter={StaticResource BoolToVis}}">
                            <Path Data="{StaticResource Icon.Folder}" Style="{StaticResource Forest.Icon}" Width="16" Height="16" />
                        </Button>
                    </StackPanel>
                    <!-- поле поиска с иконкой и подсказкой -->
                    <Grid>
                        <TextBox x:Name="SearchBox" Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}" Padding="34,7,10,7"
                                 VerticalContentAlignment="Center" ToolTip="{local:Tr mods.searchTip}" />
                        <Path Data="{StaticResource Icon.Search}" Style="{StaticResource Forest.Icon}" Stroke="{StaticResource Forest.Muted}"
                              Width="14" Height="14" HorizontalAlignment="Left" Margin="12,0,0,0" IsHitTestVisible="False" />
                        <TextBlock Text="{local:Tr mods.searchPlaceholder}" Foreground="{StaticResource Forest.Muted}" Margin="35,0,0,0"
                                   VerticalAlignment="Center" IsHitTestVisible="False">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Search}" Value="">
                                            <Setter Property="Opacity" Value="1" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                    <Setter Property="Opacity" Value="0" />
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>
                </DockPanel>

                <Grid Margin="0,12,0,0">
                <!-- история: сеансы изменений модов -->
                <Border Style="{StaticResource Forest.Card}" ClipToBounds="True" DataContext="{Binding History}"
                        Visibility="{Binding DataContext.IsHistory, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BoolToVis}}">
                    <Grid>
                        <TextBlock Text="{Binding Status}" Foreground="{StaticResource Forest.Muted}" FontSize="13" TextWrapping="Wrap" TextAlignment="Center"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" Margin="24" MaxWidth="420"
                                   Visibility="{Binding Status, Converter={StaticResource TextToVis}}" />
                        <ListBox ItemsSource="{Binding Sessions}" SelectedItem="{Binding Selected}" Background="Transparent" BorderThickness="0"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled" AutomationProperties.AutomationId="ModsHistoryList">
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                                    <Setter Property="Padding" Value="0" />
                                    <Setter Property="Margin" Value="0" />
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="{StaticResource Forest.Line}" BorderThickness="0,0,0,1" Padding="14,10">
                                        <StackPanel>
                                            <DockPanel>
                                                <TextBlock DockPanel.Dock="Right" Text="{Binding When}" FontSize="11" Foreground="{StaticResource Forest.Muted}"
                                                           VerticalAlignment="Center" Margin="12,0,0,0" />
                                                <TextBlock Text="{Binding Title}" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource Forest.Text}"
                                                           TextTrimming="CharacterEllipsis" />
                                            </DockPanel>
                                            <TextBlock Text="{Binding Summary}" FontSize="11" Foreground="{StaticResource Forest.Muted}" TextWrapping="Wrap"
                                                       MaxHeight="32" TextTrimming="CharacterEllipsis" Margin="0,3,0,0" />
                                            <TextBlock FontSize="11" Foreground="{StaticResource Forest.Accent}" Margin="0,3,0,0" TextTrimming="CharacterEllipsis">
                                                <Run Text="{Binding Sources, Mode=OneWay}" /><Run Text=" · " Foreground="{StaticResource Forest.Muted}" /><Run Text="{Binding Closed, Mode=OneWay}" Foreground="{StaticResource Forest.Muted}" />
                                            </TextBlock>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>
                </Border>

                <!-- таблица -->
                <Border Style="{StaticResource Forest.Card}" ClipToBounds="True"
                        Visibility="{Binding IsHistory, Converter={StaticResource InvertVis}}">
                    <DataGrid x:Name="Grid" ItemsSource="{Binding View}" SelectedItem="{Binding Selected}" AutoGenerateColumns="False" IsReadOnly="True"
                              HeadersVisibility="Column" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="{StaticResource Forest.Line}"
                              SelectionMode="Single" CanUserResizeRows="False" RowHeight="54"
                              Background="Transparent" RowBackground="Transparent" BorderThickness="0"
                              ColumnHeaderStyle="{StaticResource Forest.ColumnHeader}" ContextMenu="{StaticResource RowMenu}"
                              AllowDrop="True" DragOver="Grid_DragOver" Drop="Grid_Drop">
                        <DataGrid.Resources>
                            <!-- выделение строки — лесной «выбранный», без рамки текущей ячейки -->
                            <SolidColorBrush x:Key="DataGridRowSelectedBackgroundThemeBrush" Color="#394432" />
                            <SolidColorBrush x:Key="DataGridRowSelectedForegroundThemeBrush" Color="#E7E9DD" />
                            <SolidColorBrush x:Key="{x:Static DataGrid.FocusBorderBrushKey}" Color="Transparent" />
                            <!-- таблица не в фокусе — выделение того же цвета, а не системное белое -->
                            <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightBrushKey}" Color="#394432" />
                            <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightTextBrushKey}" Color="#E7E9DD" />
                            <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="#394432" />
                            <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}" Color="#E7E9DD" />
                            <!-- ячейка без рамки фокуса: выделяется вся строка -->
                            <Style TargetType="DataGridCell" BasedOn="{StaticResource {x:Type DataGridCell}}">
                                <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                                <Setter Property="BorderThickness" Value="0" />
                            </Style>
                        </DataGrid.Resources>
                        <DataGrid.InputBindings>
                            <MouseBinding Gesture="LeftDoubleClick" Command="{Binding OpenPageCommand}"
                                          CommandParameter="{Binding SelectedItem, RelativeSource={RelativeSource AncestorType=DataGrid}}" />
                        </DataGrid.InputBindings>
                        <DataGrid.Columns>
                            <!-- переключатель пишет в настройки игры: disabledMods клиента или WorldConfig.DisabledMods сервера -->
                            <DataGridTemplateColumn Header="{local:Tr col.on}" Width="58" SortMemberPath="IsEnabled">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <CheckBox Style="{StaticResource Forest.Switch}" IsChecked="{Binding IsEnabled, Mode=OneWay}" Focusable="False"
                                                  Command="{Binding DataContext.ToggleEnabledCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                  CommandParameter="{Binding}" ToolTip="{local:Tr col.onTip}"
                                                  HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="{local:Tr col.modAndId}" Width="*" SortMemberPath="Name">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <DockPanel VerticalAlignment="Center" Style="{StaticResource RowFade}">
                                            <Border DockPanel.Dock="Left" Width="30" Height="30" CornerRadius="6" Margin="0,0,12,0"
                                                    Background="{StaticResource Forest.Raised}" BorderBrush="{StaticResource Forest.Line}" BorderThickness="1">
                                                <TextBlock Text="{Binding Initials}" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource Forest.Text}"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Border>
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="13" TextTrimming="CharacterEllipsis"
                                                           Foreground="{StaticResource Forest.Text}" ToolTip="{Binding FileName}" />
                                                <TextBlock FontSize="11" Foreground="{StaticResource Forest.Muted}" TextTrimming="CharacterEllipsis">
                                                    <Run Text="{Binding ModId, Mode=OneWay}" /><Run Text="{Binding SideNote, Mode=OneWay}">
                                                        <Run.Style>
                                                            <Style TargetType="Run">
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsUnneeded}" Value="True">
                                                                        <Setter Property="Foreground" Value="{StaticResource Forest.Warn}" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Run.Style>
                                                    </Run>
                                                </TextBlock>
                                            </StackPanel>
                                        </DockPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="{local:Tr col.version}" Width="120" SortMemberPath="Installed">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel VerticalAlignment="Center" Style="{StaticResource RowFade}" Margin="10,0,0,0">
                                            <TextBlock Text="{Binding Installed}" FontFamily="Consolas" FontSize="12" Foreground="{StaticResource Forest.Text}"
                                                       TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding LatestArrow}" FontFamily="Consolas" FontSize="11" Foreground="{StaticResource Forest.Accent}"
                                                       Visibility="{Binding LatestArrow, Converter={StaticResource TextToVis}}" TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="{local:Tr col.status}" Width="170" SortMemberPath="Importance">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <!-- при наведении — что изменилось в обновлении / в чём проблема -->
                                        <StackPanel VerticalAlignment="Center" Margin="10,0,6,0" Background="Transparent"
                                                    ToolTip="{Binding Note}" ToolTipService.ShowDuration="60000">
                                            <StackPanel Orientation="Horizontal">
                                                <Ellipse Style="{StaticResource ToneDot}" />
                                                <TextBlock Text="{Binding StatusText}" Style="{StaticResource ToneText}" TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                            <TextBlock Text="{Binding SubState}" FontSize="11" Foreground="{StaticResource Forest.Muted}" Margin="12,1,0,0"
                                                       Visibility="{Binding SubState, Converter={StaticResource TextToVis}}" />
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Border>
                </Grid>
            </DockPanel>

            <!-- ===== история: выбранный сеанс ===== -->
            <Border Grid.Column="2" Style="{StaticResource Forest.Card}" DataContext="{Binding History}"
                    Visibility="{Binding DataContext.IsHistory, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BoolToVis}}">
                <Grid>
                    <TextBlock Text="{local:Tr hist.pick}" Foreground="{StaticResource Forest.Muted}" HorizontalAlignment="Center" VerticalAlignment="Center"
                               Visibility="{Binding HasSelected, Converter={StaticResource InvertVis}}" />
                    <ScrollViewer DataContext="{Binding Selected}" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                                  Visibility="{Binding DataContext.HasSelected, RelativeSource={RelativeSource AncestorType=Grid}, Converter={StaticResource BoolToVis}}">
                        <StackPanel Margin="18,16,18,16">
                            <TextBlock Text="{Binding Title}" FontSize="18" FontWeight="SemiBold" Foreground="{StaticResource Forest.Text}" TextWrapping="Wrap" />
                            <TextBlock Text="{Binding WhenLine}" FontSize="12" Foreground="{StaticResource Forest.Muted}" Margin="0,4,0,0" TextWrapping="Wrap" />
                            <TextBlock Text="{Binding Sources}" FontSize="12" Foreground="{StaticResource Forest.Accent}" Margin="0,2,0,0" TextWrapping="Wrap" />

                            <!-- откат сеанса целиком: моды — к версиям до него -->
                            <Button Style="{StaticResource Forest.PrimaryButton}" Margin="0,14,0,0" HorizontalAlignment="Stretch"
                                    Command="{Binding DataContext.RollbackSessionCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                    CommandParameter="{Binding}" IsEnabled="{Binding CanRevert}" ToolTip="{local:Tr hist.revertSessionTip}"
                                    AutomationProperties.AutomationId="HistoryRevertSession">
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="{StaticResource Icon.History}" Style="{StaticResource Forest.Icon}" Width="14" Height="14" Margin="0,0,8,0" />
                                    <TextBlock Text="{local:Tr hist.revertSession}" />
                                </StackPanel>
                            </Button>

                            <TextBlock Text="{local:Tr hist.mods}" FontSize="12" Foreground="{StaticResource Forest.Muted}" Margin="0,16,0,4" />
                            <ItemsControl ItemsSource="{Binding Changes}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border BorderBrush="{StaticResource Forest.Line}" BorderThickness="0,1,0,0" Padding="0,8">
                                            <DockPanel>
                                            <Button DockPanel.Dock="Right" Content="{Binding RevertText}" Padding="10,4" MinHeight="0" FontSize="12"
                                                    VerticalAlignment="Center" Margin="10,0,0,0"
                                                    Command="{Binding DataContext.RevertChangeCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}"
                                                    Visibility="{Binding CanRevert, Converter={StaticResource BoolToVis}}" />
                                            <StackPanel>
                                                <TextBlock Text="{Binding Title}" FontSize="13" Foreground="{StaticResource Forest.Text}" TextTrimming="CharacterEllipsis"
                                                           ToolTip="{Binding ModId}" />
                                                <TextBlock FontSize="12" Margin="0,2,0,0" TextWrapping="Wrap">
                                                    <Run Text="{Binding Versions, Mode=OneWay}" FontFamily="Consolas" Foreground="{StaticResource Forest.Muted}" />
                                                    <Run Text="{Binding Later, Mode=OneWay}" Foreground="{StaticResource Forest.Warn}" />
                                                </TextBlock>
                                            </StackPanel>
                                            </DockPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <TextBlock Text="{local:Tr hist.steps}" FontSize="12" Foreground="{StaticResource Forest.Muted}" Margin="0,16,0,4" />
                            <Border Background="{StaticResource Forest.Base}" CornerRadius="6" Padding="10,8">
                                <ItemsControl ItemsSource="{Binding Steps}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding}" FontSize="11" Foreground="{StaticResource Forest.Muted}" TextWrapping="Wrap" Margin="0,2" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>

            <!-- ===== карточка выбранного мода ===== -->
            <Border Grid.Column="2" Style="{StaticResource Forest.Card}"
                    Visibility="{Binding IsHistory, Converter={StaticResource InvertVis}}">
                <Grid>
                    <TextBlock Text="{local:Tr mcard.pick}" Foreground="{StaticResource Forest.Muted}" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Card}" Value="{x:Null}">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>

                    <ScrollViewer DataContext="{Binding Card}" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <ScrollViewer.Style>
                            <Style TargetType="ScrollViewer">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding}" Value="{x:Null}">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ScrollViewer.Style>
                        <StackPanel>
                            <!-- шапка: логотип с модбазы или буквы -->
                            <Border Background="{StaticResource Forest.Raised}" CornerRadius="8,8,0,0" Height="150">
                                <Grid>
                                    <!-- буквы всегда под картинкой: логотип не загрузился или его нет — видно их -->
                                    <TextBlock Visibility="{Binding ActualWidth, ElementName=Logo1, Converter={StaticResource ZeroVis}}" Text="{Binding Row.Initials}" FontSize="40" FontWeight="Bold" Foreground="{StaticResource Forest.Accent}"
                                               Margin="20,0,0,0" VerticalAlignment="Center" Opacity="0.85" />
                                    <!-- логотип целиком, по краям — он же, размытый -->
                                    <Image Source="{Binding Logo, TargetNullValue={x:Null}}" Stretch="UniformToFill" Opacity="0.35">
                                        <Image.Effect>
                                            <BlurEffect Radius="24" />
                                        </Image.Effect>
                                    </Image>
                                    <Image x:Name="Logo1" Source="{Binding Logo, TargetNullValue={x:Null}}" Stretch="Uniform"
                                           RenderOptions.BitmapScalingMode="HighQuality" />
                                    <Border HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,12,12,0" Padding="8,2" CornerRadius="4"
                                            Background="#CC19231D" Visibility="{Binding Tag, Converter={StaticResource TextToVis}}">
                                        <TextBlock Text="{Binding Tag}" FontSize="11" Foreground="{StaticResource Forest.Accent}" />
                                    </Border>
                                </Grid>
                            </Border>

                            <StackPanel Margin="18,14,18,16">
                                <TextBlock Text="{Binding Name}" FontSize="20" FontWeight="SemiBold" Foreground="{StaticResource Forest.Text}" TextWrapping="Wrap" />
                                <TextBlock Text="{Binding ByLine}" FontSize="12" Foreground="{StaticResource Forest.Muted}" Margin="0,2,0,0" TextWrapping="Wrap" />

                                <Border BorderBrush="{StaticResource Forest.Line}" BorderThickness="0,0,0,1" Margin="0,14,0,0">
                                    <StackPanel Orientation="Horizontal">
                                        <RadioButton Style="{StaticResource Forest.TabHeader}" GroupName="CardTab" Content="{local:Tr mcard.tabOverview}"
                                                     IsChecked="{Binding IsVersionsTab, Converter={StaticResource Invert}}" />
                                        <RadioButton Style="{StaticResource Forest.TabHeader}" GroupName="CardTab" Content="{local:Tr mcard.tabVersions}"
                                                     IsChecked="{Binding IsVersionsTab}" />
                                    </StackPanel>
                                </Border>

                                <!-- ===== вкладка «Обзор» ===== -->
                                <StackPanel Visibility="{Binding IsVersionsTab, Converter={StaticResource InvertVis}}">

                                <TextBlock Text="{Binding Summary}" TextWrapping="Wrap" Foreground="{StaticResource Forest.Text}" FontSize="13" Margin="0,14,0,0"
                                           Visibility="{Binding Summary, Converter={StaticResource TextToVis}}" />

                                <!-- ключевые сведения -->
                                <Grid Margin="0,12,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition />
                                    </Grid.RowDefinitions>
                                    <TextBlock Grid.Row="0" Text="{local:Tr mcard.compat}" Style="{StaticResource CardKey}" />
                                    <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding Compatibility}" Style="{StaticResource CardValue}" />
                                    <TextBlock Grid.Row="1" Text="{local:Tr mcard.installed}" Style="{StaticResource CardKey}" />
                                    <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding Row.Installed}" Style="{StaticResource CardValue}" FontFamily="Consolas" />
                                    <TextBlock Grid.Row="2" Text="{local:Tr mcard.available}" Style="{StaticResource CardKey}"
                                               Visibility="{Binding Row.CanSkip, Converter={StaticResource BoolToVis}}" />
                                    <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding Row.Latest}" Style="{StaticResource CardValue}" FontFamily="Consolas"
                                               Foreground="{StaticResource Forest.Accent}" Visibility="{Binding Row.CanSkip, Converter={StaticResource BoolToVis}}" />
                                    <TextBlock Grid.Row="3" Text="{local:Tr mcard.state}" Style="{StaticResource CardKey}" />
                                    <StackPanel Grid.Row="3" Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" DataContext="{Binding Row}"
                                                Margin="0,4" ToolTip="{Binding Note}">
                                        <Ellipse Style="{StaticResource ToneDot}" />
                                        <TextBlock Text="{Binding StatusText}" Style="{StaticResource ToneText}" />
                                    </StackPanel>
                                    <TextBlock Grid.Row="4" Text="{local:Tr mcard.side}" Style="{StaticResource CardKey}" />
                                    <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding Side}" Style="{StaticResource CardValue}" />
                                    <TextBlock Grid.Row="5" Text="{local:Tr mcard.file}" Style="{StaticResource CardKey}" />
                                    <TextBlock Grid.Row="5" Grid.Column="1" Text="{Binding Row.FileName}" Style="{StaticResource CardValue}" ToolTip="{Binding Row.FilePath}"
                                               TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
                                </Grid>

                                <!-- проблема с зависимостями — текстом -->
                                <TextBlock Text="{Binding Row.Note}" TextWrapping="Wrap" FontSize="12" Foreground="{StaticResource Forest.Warn}" Margin="0,8,0,0"
                                           Visibility="{Binding Row.IsProblem, Converter={StaticResource BoolToVis}}" />

                                <!-- включён ли мод в этом профиле -->
                                <Border BorderBrush="{StaticResource Forest.Line}" BorderThickness="0,1,0,1" Padding="0,12" Margin="0,14,0,0">
                                    <DockPanel>
                                        <CheckBox DockPanel.Dock="Right" Style="{StaticResource Forest.Switch}" VerticalAlignment="Center"
                                                  IsChecked="{Binding Row.IsEnabled, Mode=OneWay}"
                                                  Command="{Binding Owner.ToggleEnabledCommand}" CommandParameter="{Binding Row}" />
                                        <StackPanel>
                                            <TextBlock Text="{local:Tr mcard.enabledIn}" Foreground="{StaticResource Forest.Text}" FontSize="13" />
                                            <TextBlock Text="{Binding ProfileName}" Foreground="{StaticResource Forest.Muted}" FontSize="11" />
                                        </StackPanel>
                                    </DockPanel>
                                </Border>

                                <!-- действия -->
                                <Button Style="{StaticResource Forest.PrimaryButton}" Margin="0,14,0,0" HorizontalAlignment="Stretch"
                                        Command="{Binding Owner.UpdateOneCommand}" CommandParameter="{Binding Row}"
                                        IsEnabled="{Binding Owner.CanQueue}"
                                        Visibility="{Binding Row.CanUpdate, Converter={StaticResource BoolToVis}}">
                                    <StackPanel Orientation="Horizontal">
                                        <Path Data="{StaticResource Icon.Download}" Style="{StaticResource Forest.Icon}" Width="14" Height="14" Margin="0,0,8,0" />
                                        <TextBlock Text="{Binding UpdateText}" />
                                    </StackPanel>
                                </Button>
                                <Grid Margin="0,8,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="8" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Button Content="{Binding PinText}" Command="{Binding Owner.TogglePinCommand}" CommandParameter="{Binding Row}"
                                            ToolTip="{local:Tr mcard.pinTip}" />
                                    <Button Grid.Column="2" Content="{local:Tr mcard.skip}" Command="{Binding Owner.SkipVersionCommand}" CommandParameter="{Binding Row}"
                                            IsEnabled="{Binding Row.CanSkip}" ToolTip="{local:Tr mcard.skipTip}" />
                                </Grid>
                                <Button Content="{local:Tr mcard.chooseVersion}" Margin="0,8,0,0" HorizontalAlignment="Stretch"
                                        Command="{Binding Owner.RollbackCommand}" CommandParameter="{Binding Row}"
                                        IsEnabled="{Binding Owner.CanQueue}" />

                                <WrapPanel Margin="0,14,0,0">
                                    <Button Style="{StaticResource Forest.LinkButton}" Content="{local:Tr mcard.modDb}" Margin="0,0,14,4"
                                            Command="{Binding Owner.OpenPageCommand}" CommandParameter="{Binding Row}"
                                            Visibility="{Binding Row.PageUrl, Converter={StaticResource TextToVis}}" />
                                    <Button Style="{StaticResource Forest.LinkButton}" Content="{local:Tr mcard.inCatalog}" Margin="0,0,14,4"
                                            Command="{Binding Owner.ShowInCatalogCommand}" CommandParameter="{Binding Row}" />
                                    <Button Style="{StaticResource Forest.LinkButton}" Content="{Binding ConfigText}" Margin="0,0,14,4"
                                            Visibility="{Binding HasConfigs, Converter={StaticResource BoolToVis}}"
                                            Command="{Binding Owner.OpenModConfigCommand}" CommandParameter="{Binding Row}"
                                            AutomationProperties.AutomationId="CardModConfig" />
                                    <Button Style="{StaticResource Forest.LinkButton}" Content="{local:Tr mcard.showFile}" Margin="0,0,14,4"
                                            Visibility="{Binding Owner.IsLocalProfile, Converter={StaticResource BoolToVis}}"
                                            Command="{Binding Owner.ShowFileCommand}" CommandParameter="{Binding Row}" />
                                    <Button Style="{StaticResource Forest.LinkButton}" Content="{local:Tr menu.delete}" Margin="0,0,14,4"
                                            Foreground="{StaticResource Forest.Danger}"
                                            Command="{Binding Owner.DeleteCommand}" CommandParameter="{Binding Row}" />
                                </WrapPanel>

                                <!-- что нового в предлагаемой версии -->
                                <StackPanel Margin="0,16,0,0" Visibility="{Binding HasChangelog, Converter={StaticResource BoolToVis}}">
                                    <TextBlock Text="{Binding ChangelogTitle}" FontWeight="SemiBold" Foreground="{StaticResource Forest.Text}" FontSize="13" />
                                    <Border Background="{StaticResource Forest.Base}" CornerRadius="6" Padding="10,8" Margin="0,6,0,0">
                                        <TextBlock Text="{Binding Row.Changelog}" TextWrapping="Wrap" FontSize="12" Foreground="{StaticResource Forest.Muted}" />
                                    </Border>
                                </StackPanel>

                                <!-- скриншоты и полное описание с модбазы -->
                                <ItemsControl ItemsSource="{Binding Screenshots}" Margin="0,16,0,0">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Button Padding="0" Margin="0,0,6,6" Cursor="Hand" ToolTip="{local:Tr card.screenshotTip}" MinHeight="0"
                                                    Command="{Binding DataContext.OpenScreenshotCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                    CommandParameter="{Binding}">
                                                <Image Source="{Binding}" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality"
                                                       Width="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=ItemsControl}, Converter={StaticResource Thumb}, ConverterParameter=w}"
                                                       Height="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=ItemsControl}, Converter={StaticResource Thumb}, ConverterParameter=h}" />
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <StackPanel Visibility="{Binding FullText, Converter={StaticResource TextToVis}}" Margin="0,10,0,0">
                                    <TextBlock Text="{local:Tr mcard.about}" FontWeight="SemiBold" Foreground="{StaticResource Forest.Text}" FontSize="13" />
                                    <TextBlock Text="{Binding FullText}" TextWrapping="Wrap" FontSize="12" Foreground="{StaticResource Forest.Muted}" Margin="0,6,0,0" />
                                </StackPanel>
                                </StackPanel>

                                <!-- ===== вкладка «Версии» ===== -->
                                <StackPanel Visibility="{Binding IsVersionsTab, Converter={StaticResource BoolToVis}}" Margin="0,12,0,0">
                                    <!-- что с модом делали: последние изменения из истории -->
                                    <StackPanel Visibility="{Binding HasHistory, Converter={StaticResource BoolToVis}}" Margin="0,0,0,14">
                                        <TextBlock Text="{local:Tr mcard.historyTitle}" FontSize="12" Foreground="{StaticResource Forest.Muted}" Margin="0,0,0,4" />
                                        <!-- видно около пяти строк, остальное — прокруткой: за день действий бывает много -->
                                        <Border Background="{StaticResource Forest.Base}" CornerRadius="6" Padding="10,8">
                                            <ScrollViewer MaxHeight="96" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                            <ItemsControl ItemsSource="{Binding HistoryLines}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <TextBlock Text="{Binding}" FontSize="11" Foreground="{StaticResource Forest.Muted}" TextWrapping="Wrap" Margin="0,2" />
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                            </ScrollViewer>
                                        </Border>
                                    </StackPanel>
                                    <TextBlock Text="{Binding VersionsStatus}" FontSize="12" Foreground="{StaticResource Forest.Muted}" TextWrapping="Wrap"
                                               Margin="0,0,0,8" />
                                    <ItemsControl ItemsSource="{Binding Versions}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border BorderBrush="{StaticResource Forest.Line}" BorderThickness="0,0,0,1" Padding="0,9">
                                                    <DockPanel>
                                                        <Button DockPanel.Dock="Right" Content="{local:Tr mcard.installThis}" Padding="12,4" MinHeight="0" FontSize="12"
                                                                VerticalAlignment="Center"
                                                                Command="{Binding DataContext.InstallVersionCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                                CommandParameter="{Binding}"
                                                                IsEnabled="{Binding DataContext.Owner.CanQueue, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                                Visibility="{Binding IsInstalled, Converter={StaticResource InvertVis}}" />
                                                        <Border DockPanel.Dock="Right" CornerRadius="4" Padding="8,2" VerticalAlignment="Center"
                                                                Background="{StaticResource Forest.Selected}"
                                                                Visibility="{Binding IsInstalled, Converter={StaticResource BoolToVis}}">
                                                            <TextBlock Text="{local:Tr mcard.installedBadge}" FontSize="11" Foreground="{StaticResource Forest.Good}" />
                                                        </Border>
                                                        <StackPanel VerticalAlignment="Center">
                                                            <TextBlock>
                                                                <Run Text="{Binding Version, Mode=OneWay}" FontFamily="Consolas" FontSize="13" Foreground="{StaticResource Forest.Text}" />
                                                                <Run Text="{Binding PreText, Mode=OneWay}" FontSize="11" Foreground="{StaticResource Forest.Warn}" />
                                                            </TextBlock>
                                                            <TextBlock Text="{Binding Meta}" FontSize="11" Foreground="{StaticResource Forest.Muted}" TextWrapping="Wrap" Margin="0,2,8,0" />
                                                        </StackPanel>
                                                    </DockPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>
    </DockPanel>
</UserControl>
