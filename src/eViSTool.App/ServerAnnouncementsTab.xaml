<UserControl x:Class="eViSTool.App.ServerAnnouncementsTab"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:eViSTool.App">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <local:InvertBoolToVisibilityConverter x:Key="InvertVis" />
        <local:TextToVisibilityConverter x:Key="TextToVis" />

        <Style x:Key="CardTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{StaticResource Forest.Text}" />
        </Style>
        <Style x:Key="Hint" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Foreground" Value="{StaticResource Forest.Muted}" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="0,2,0,0" />
        </Style>
        <Style x:Key="Label" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Foreground" Value="{StaticResource Forest.Text}" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style x:Key="AnnCard" TargetType="Border" BasedOn="{StaticResource Forest.Card}">
            <Setter Property="Padding" Value="20,16,20,18" />
            <Setter Property="Margin" Value="0,0,0,14" />
        </Style>
        <Style x:Key="Row" TargetType="Border">
            <Setter Property="BorderBrush" Value="{StaticResource Forest.Line}" />
            <Setter Property="BorderThickness" Value="0,1,0,0" />
            <Setter Property="Padding" Value="0,14,0,0" />
            <Setter Property="Margin" Value="0,14,0,0" />
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,14,0,0">
        <StackPanel Margin="0,0,14,0">
            <TextBlock Text="{Binding StatusText}" FontSize="12" Foreground="{StaticResource Forest.Accent}" TextWrapping="Wrap" Margin="2,0,0,10"
                       Visibility="{Binding StatusText, Converter={StaticResource TextToVis}}" AutomationProperties.AutomationId="AnnStatus" />
            <TextBlock Text="{Binding ErrorText}" FontSize="12" Foreground="{StaticResource Forest.Danger}" TextWrapping="Wrap" Margin="2,0,0,10"
                       Visibility="{Binding ErrorText, Converter={StaticResource TextToVis}}" AutomationProperties.AutomationId="AnnError" />

            <!-- ===== сказать сейчас ===== -->
            <Border Style="{StaticResource AnnCard}">
                <StackPanel>
                    <TextBlock Text="{local:Tr ann.sayTitle}" Style="{StaticResource CardTitle}" />
                    <TextBlock Text="{local:Tr ann.sayHint}" Style="{StaticResource Hint}" />
                    <DockPanel Margin="0,12,0,0">
                        <Button DockPanel.Dock="Right" Style="{StaticResource Forest.PrimaryButton}" Content="{local:Tr ann.say}" Command="{Binding SayCommand}"
                                Margin="8,0,0,0" Padding="16,6" ToolTip="{local:Tr ann.sayTip}" ToolTipService.ShowOnDisabled="True"
                                AutomationProperties.AutomationId="AnnSay" />
                        <TextBox Text="{Binding SayText, UpdateSourceTrigger=PropertyChanged}" VerticalContentAlignment="Center" MaxLength="400"
                                 IsEnabled="{Binding CanSay}" AutomationProperties.AutomationId="AnnSayText" AutomationProperties.Name="{local:Tr ann.sayTitle}">
                            <TextBox.InputBindings>
                                <KeyBinding Key="Enter" Command="{Binding SayCommand}" />
                            </TextBox.InputBindings>
                        </TextBox>
                    </DockPanel>
                </StackPanel>
            </Border>

            <!-- ===== по расписанию ===== -->
            <Border Style="{StaticResource AnnCard}">
                <StackPanel>
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Command="{Binding AddCommand}" IsEnabled="{Binding Loaded}" Padding="12,6" VerticalAlignment="Top"
                                AutomationProperties.AutomationId="AnnAdd">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource Icon.Plus}" Style="{StaticResource Forest.Icon}" Width="12" Height="12" Margin="0,0,7,0" />
                                <TextBlock Text="{local:Tr ann.add}" />
                            </StackPanel>
                        </Button>
                        <StackPanel Margin="0,0,16,0">
                            <TextBlock Text="{local:Tr ann.listTitle}" Style="{StaticResource CardTitle}" />
                            <TextBlock Text="{local:Tr ann.listHint}" Style="{StaticResource Hint}" />
                            <TextBlock Text="{Binding TimeNote}" FontSize="12" Foreground="{StaticResource Forest.Warn}" TextWrapping="Wrap" Margin="0,4,0,0">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding TimeNote}" Value="">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                    </DockPanel>

                    <Border Style="{StaticResource Row}">
                        <DockPanel>
                            <CheckBox DockPanel.Dock="Right" Style="{StaticResource Forest.Switch}" IsChecked="{Binding OnlyWithPlayers}" VerticalAlignment="Center"
                                      IsEnabled="{Binding Loaded}" AutomationProperties.AutomationId="AnnOnlyWithPlayers"
                                      AutomationProperties.Name="{local:Tr ann.onlyWithPlayers}" />
                            <StackPanel Margin="0,0,16,0">
                                <TextBlock Text="{local:Tr ann.onlyWithPlayers}" Style="{StaticResource Label}" />
                                <TextBlock Text="{local:Tr ann.onlyWithPlayersHint}" Style="{StaticResource Hint}" />
                            </StackPanel>
                        </DockPanel>
                    </Border>

                    <TextBlock Text="{local:Tr ann.empty}" Style="{StaticResource Hint}" FontSize="12" Margin="0,14,0,0"
                               Visibility="{Binding HasItems, Converter={StaticResource InvertVis}}" />

                    <ItemsControl x:Name="AnnList" ItemsSource="{Binding Items}" Margin="0,6,0,0" Focusable="False">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="{StaticResource Forest.Line}" BorderThickness="0,1,0,0" Padding="0,10" Margin="0,4,0,0">
                                    <DockPanel>
                                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">
                                            <!-- «каждые N мин» или «в 12:00, 18:00» -->
                                            <ComboBox SelectedIndex="{Binding ModeIndex}" FontSize="12" MinWidth="96" VerticalAlignment="Center"
                                                      AutomationProperties.Name="{local:Tr ann.mode}">
                                                <ComboBoxItem Content="{local:Tr ann.every}" />
                                                <ComboBoxItem Content="{local:Tr ann.at}" />
                                            </ComboBox>
                                            <TextBox Width="150" Margin="8,0,0,0" Text="{Binding TimesText, UpdateSourceTrigger=PropertyChanged}"
                                                     VerticalContentAlignment="Center" MaxLength="60" ToolTip="{local:Tr ann.timesTip}"
                                                     AutomationProperties.Name="{local:Tr ann.at}"
                                                     Visibility="{Binding IsTimed, Converter={StaticResource BoolToVis}}">
                                                <TextBox.Style>
                                                    <Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IntervalBad}" Value="True">
                                                                <Setter Property="BorderBrush" Value="{StaticResource Forest.Danger}" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBox.Style>
                                            </TextBox>
                                            <StackPanel Orientation="Horizontal" Visibility="{Binding IsTimed, Converter={StaticResource InvertVis}}">
                                            <TextBox Width="96" Margin="8,0,0,0" Text="{Binding IntervalText, UpdateSourceTrigger=PropertyChanged}"
                                                     VerticalContentAlignment="Center" HorizontalContentAlignment="Center" MaxLength="4"
                                                     AutomationProperties.Name="{local:Tr ann.every}">
                                                <TextBox.Style>
                                                    <Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IntervalBad}" Value="True">
                                                                <Setter Property="BorderBrush" Value="{StaticResource Forest.Danger}" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBox.Style>
                                            </TextBox>
                                            <TextBlock Text="{local:Tr ann.minutes}" FontSize="12" Foreground="{StaticResource Forest.Muted}" VerticalAlignment="Center"
                                                       Margin="8,0,0,0" />
                                            </StackPanel>
                                            <CheckBox Style="{StaticResource Forest.Switch}" IsChecked="{Binding Enabled}" VerticalAlignment="Center" Margin="22,0,0,0"
                                                      ToolTip="{local:Tr ann.enabled}" AutomationProperties.Name="{local:Tr ann.enabled}" />
                                            <Button Style="{StaticResource Forest.LinkButton}" Content="{local:Tr ann.delete}" Foreground="{StaticResource Forest.Danger}"
                                                    Margin="22,0,0,0" VerticalAlignment="Center"
                                                    Command="{Binding DataContext.DeleteCommand, ElementName=AnnList}" CommandParameter="{Binding}" />
                                        </StackPanel>
                                        <TextBox Text="{Binding Text, UpdateSourceTrigger=PropertyChanged}" VerticalContentAlignment="Center" MaxLength="400"
                                                 AutomationProperties.Name="{local:Tr ann.text}" />
                                    </DockPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
