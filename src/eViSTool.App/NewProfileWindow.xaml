<Window x:Class="eViSTool.App.NewProfileWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:eViSTool.App"
        Icon="Assets/eViSTool.ico" Width="560" SizeToContent="Height" ResizeMode="NoResize"
        Background="{StaticResource Forest.Base}" WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <StackPanel Margin="24,20,24,22">
        <TextBlock x:Name="Heading" FontSize="20" FontWeight="SemiBold" Foreground="{StaticResource Forest.Text}" />

        <TextBlock Text="{local:Tr newprofile.name}" FontSize="12" Foreground="{StaticResource Forest.Text}" Margin="0,16,0,0" />
        <TextBox x:Name="NameBox" Margin="0,6,0,0" MaxLength="60" TextChanged="NameBox_TextChanged"
                 AutomationProperties.AutomationId="NewProfileName" />

        <!-- серверный профиль: папка данных получает имя профиля -->
        <StackPanel x:Name="FolderPanel" Margin="0,14,0,0" Visibility="Collapsed">
            <TextBlock Text="{local:Tr newprofile.folder}" FontSize="12" Foreground="{StaticResource Forest.Text}" />
            <TextBlock x:Name="FolderText" FontFamily="Consolas" FontSize="12" Foreground="{StaticResource Forest.Accent}" TextWrapping="Wrap"
                       Margin="0,4,0,0" />
            <TextBlock Text="{local:Tr newprofile.folderHint}" FontSize="11" Foreground="{StaticResource Forest.Muted}" TextWrapping="Wrap"
                       Margin="0,6,0,0" />
        </StackPanel>

        <!-- серверный профиль: данные сервера уже есть — скопировать их в профиль или взять папку как есть -->
        <Border x:Name="ExistingPanel" Style="{StaticResource Forest.Card}" Padding="16,14" Margin="0,18,0,0" Visibility="Collapsed">
            <StackPanel>
                <TextBlock Text="{local:Tr newprofile.existing}" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource Forest.Text}" />
                <TextBlock Text="{local:Tr newprofile.existingHint}" FontSize="11" Foreground="{StaticResource Forest.Muted}" TextWrapping="Wrap" Margin="0,2,0,8" />
                <DockPanel>
                    <Button DockPanel.Dock="Right" Content="{local:Tr common.browse}" Click="BrowseExisting_Click" Margin="8,0,0,0" />
                    <TextBox x:Name="ExistingBox" VerticalContentAlignment="Center" TextChanged="ExistingBox_TextChanged"
                             AutomationProperties.AutomationId="NewProfileExisting" />
                </DockPanel>
                <TextBlock x:Name="ExistingInfo" FontSize="11" TextWrapping="Wrap" Margin="0,6,0,0" Foreground="{StaticResource Forest.Muted}" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
                    <Button x:Name="ImportButton" Content="{local:Tr newprofile.import}" Click="Import_Click" Margin="0,0,8,0"
                            ToolTip="{local:Tr newprofile.importTip}" AutomationProperties.AutomationId="NewProfileImport" />
                    <Button x:Name="UseButton" Content="{local:Tr newprofile.useInPlace}" Click="UseInPlace_Click"
                            ToolTip="{local:Tr newprofile.useInPlaceTip}" AutomationProperties.AutomationId="NewProfileUseInPlace" />
                </StackPanel>
            </StackPanel>
        </Border>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button x:Name="OkButton" Content="{local:Tr newprofile.create}" IsDefault="True" Click="Ok_Click" Padding="18,8"
                    Style="{StaticResource Forest.PrimaryButton}" AutomationProperties.AutomationId="NewProfileCreate" />
            <Button Content="{local:Tr common.cancel}" IsCancel="True" Margin="8,0,0,0" Padding="16,8" />
        </StackPanel>
    </StackPanel>
</Window>
