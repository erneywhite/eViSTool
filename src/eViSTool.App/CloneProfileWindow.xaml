<Window x:Class="eViSTool.App.CloneProfileWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:eViSTool.App"
        Title="{local:Tr clone.title}" Icon="Assets/eViSTool.ico"
        Width="640" SizeToContent="Height" ResizeMode="NoResize" Background="{StaticResource Forest.Base}"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" Closing="Window_Closing">
    <Window.Resources>
        <Style x:Key="Label" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{StaticResource Forest.Text}" />
            <Setter Property="Margin" Value="0,16,0,0" />
        </Style>
        <Style x:Key="Hint" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Foreground" Value="{StaticResource Forest.Muted}" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="0,2,0,0" />
        </Style>
    </Window.Resources>

    <StackPanel Margin="24,20,24,22">
        <TextBlock x:Name="Heading" FontSize="20" FontWeight="SemiBold" Foreground="{StaticResource Forest.Text}" TextWrapping="Wrap" />
        <TextBlock Text="{local:Tr clone.intro}" Style="{StaticResource Hint}" FontSize="12" Margin="0,4,0,0" />

        <!-- сервер профиля запущен — копия мира может получиться битой -->
        <Border x:Name="RunningBox" Style="{StaticResource Forest.Warning}" Margin="0,14,0,0" Visibility="Collapsed">
            <DockPanel>
                <Path DockPanel.Dock="Left" Data="{StaticResource Icon.Warning}" Style="{StaticResource Forest.Icon}" Stroke="{StaticResource Forest.Warn}"
                      VerticalAlignment="Center" Margin="0,0,12,0" />
                <TextBlock Text="{local:Tr clone.running}" Foreground="{StaticResource Forest.Warn}" TextWrapping="Wrap" FontSize="12" />
            </DockPanel>
        </Border>

        <StackPanel x:Name="Form">
            <TextBlock Text="{local:Tr clone.name}" Style="{StaticResource Label}" />
            <TextBox x:Name="NameBox" Margin="0,6,0,0" MaxLength="60" TextChanged="NameBox_TextChanged" />

            <TextBlock Text="{local:Tr clone.target}" Style="{StaticResource Label}" />
            <TextBlock Text="{local:Tr clone.targetHint}" Style="{StaticResource Hint}" Margin="0,2,0,6" />
            <DockPanel>
                <Button DockPanel.Dock="Right" Content="{local:Tr common.browse}" Click="Browse_Click" Margin="8,0,0,0" />
                <TextBox x:Name="TargetBox" VerticalContentAlignment="Center" TextChanged="TargetBox_TextChanged" />
            </DockPanel>

            <!-- несколько serverconfig*.json в одной папке — выбрать мир -->
            <StackPanel x:Name="ConfigPanel" Visibility="Collapsed">
                <TextBlock Text="{local:Tr clone.config}" Style="{StaticResource Label}" />
                <TextBlock Text="{local:Tr clone.configHint}" Style="{StaticResource Hint}" Margin="0,2,0,6" />
                <ComboBox x:Name="ConfigBox" HorizontalAlignment="Stretch" SelectionChanged="Option_Changed" />
            </StackPanel>

            <TextBlock Text="{local:Tr clone.world}" Style="{StaticResource Label}" />
            <Border Style="{StaticResource Forest.Card}" Padding="14,12" Margin="0,6,0,0">
                <StackPanel>
                    <RadioButton x:Name="SameWorld" GroupName="World" IsChecked="True" Checked="Option_Changed">
                        <StackPanel>
                            <TextBlock Text="{local:Tr clone.sameWorld}" FontSize="13" Foreground="{StaticResource Forest.Text}" />
                            <TextBlock Text="{local:Tr clone.sameWorldHint}" Style="{StaticResource Hint}" />
                        </StackPanel>
                    </RadioButton>
                    <CheckBox x:Name="BackupsBox" Margin="28,8,0,0" Checked="Option_Changed" Unchecked="Option_Changed" Visibility="Collapsed" />

                    <Border BorderBrush="{StaticResource Forest.Line}" BorderThickness="0,1,0,0" Margin="0,12,0,0" Padding="0,12,0,0">
                        <RadioButton x:Name="NewWorld" GroupName="World" Checked="Option_Changed">
                            <StackPanel>
                                <TextBlock Text="{local:Tr clone.newWorld}" FontSize="13" Foreground="{StaticResource Forest.Text}" />
                                <TextBlock Text="{local:Tr clone.newWorldHint}" Style="{StaticResource Hint}" />
                            </StackPanel>
                        </RadioButton>
                    </Border>
                    <StackPanel x:Name="WorldNamePanel" Margin="28,8,0,0" Visibility="Collapsed">
                        <TextBlock Text="{local:Tr clone.worldName}" FontSize="12" Foreground="{StaticResource Forest.Text}" />
                        <TextBox x:Name="WorldNameBox" Margin="0,6,0,0" MaxLength="60" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </StackPanel>

        <!-- что получится / почему нельзя -->
        <TextBlock x:Name="Summary" Style="{StaticResource Hint}" FontSize="12" Margin="0,16,0,0" />
        <TextBlock x:Name="ErrorText" Foreground="{StaticResource Forest.Danger}" TextWrapping="Wrap" FontSize="12" Margin="0,8,0,0" Visibility="Collapsed" />

        <!-- ход копирования -->
        <StackPanel x:Name="ProgressPanel" Margin="0,14,0,0" Visibility="Collapsed">
            <ProgressBar x:Name="Progress" Style="{StaticResource Forest.Progress}" />
            <TextBlock x:Name="ProgressText" Style="{StaticResource Hint}" Margin="0,6,0,0" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
        </StackPanel>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button x:Name="GoButton" Content="{local:Tr clone.go}" IsDefault="True" Click="Go_Click" Padding="18,8"
                    Style="{StaticResource Forest.PrimaryButton}" />
            <Button Content="{local:Tr common.cancel}" IsCancel="True" Click="Cancel_Click" Margin="8,0,0,0" Padding="16,8" />
        </StackPanel>
    </StackPanel>
</Window>
