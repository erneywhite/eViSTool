    <!-- контурная иконка: Tag = геометрия, цвет — от родителя -->
    <Style x:Key="Forest.Icon" TargetType="Path">
        <Setter Property="Width" Value="18" />
        <Setter Property="Height" Value="18" />
        <Setter Property="Stretch" Value="Uniform" />
        <Setter Property="StrokeThickness" Value="1.6" />
        <Setter Property="StrokeStartLineCap" Value="Round" />
        <Setter Property="StrokeEndLineCap" Value="Round" />
        <Setter Property="StrokeLineJoin" Value="Round" />
        <Setter Property="Stroke" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Control}}" />
    </Style>

    <!-- ===== кнопки ===== -->
    <!-- обычная: поверхность + линия; primary — песочная; danger — розоватый текст -->
    <Style x:Key="Forest.Button" TargetType="Button">
        <Setter Property="Foreground" Value="{StaticResource Forest.Text}" />
        <Setter Property="Background" Value="{StaticResource Forest.Surface}" />
        <Setter Property="BorderBrush" Value="{StaticResource Forest.Line}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="13,8" />
        <Setter Property="MinHeight" Value="34" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6" Padding="{TemplateBinding Padding}"
                            SnapsToDevicePixels="True">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource Forest.Raised}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Forest.Accent}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Opacity" Value="0.85" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Bd" Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- все кнопки по умолчанию — лесные; старые ссылки на AccentButtonStyle ведут на песочную -->
    <Style TargetType="Button" BasedOn="{StaticResource Forest.Button}" />

    <!-- Fluent-шаблон выпадающего списка вешает на него меню текстового поля («Копировать / Вырезать / Вставить»),
         хотя вводить туда нечего — у выпадашек без ввода текста его нет -->
    <Style x:Key="Forest.ComboBox" TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}">
        <Setter Property="ContextMenuService.IsEnabled" Value="False" />
    </Style>
    <Style TargetType="ComboBox" BasedOn="{StaticResource Forest.ComboBox}" />

    <Style x:Key="Forest.PrimaryButton" TargetType="Button" BasedOn="{StaticResource Forest.Button}">
        <Setter Property="Background" Value="{StaticResource Forest.Accent}" />
        <Setter Property="BorderBrush" Value="{StaticResource Forest.Accent}" />
        <Setter Property="Foreground" Value="{StaticResource Forest.AccentInk}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="1" CornerRadius="6" Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="#DFCB96" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="#C8B177" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Bd" Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="AccentButtonStyle" TargetType="Button" BasedOn="{StaticResource Forest.PrimaryButton}" />

    <!-- основная кнопка с выпадающей частью справа («Играть ▾»): правые углы прямые -->
    <Style x:Key="Forest.SplitMain" TargetType="Button" BasedOn="{StaticResource Forest.PrimaryButton}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6,0,0,6" Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="#DFCB96" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="#C8B177" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Bd" Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <!-- стрелка такой кнопки: левые углы прямые, слева тонкий разделитель -->
    <Style x:Key="Forest.SplitArrow" TargetType="Button" BasedOn="{StaticResource Forest.PrimaryButton}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="0,6,6,0" Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="#DFCB96" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="#C8B177" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Bd" Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>


    <Style x:Key="Forest.DangerButton" TargetType="Button" BasedOn="{StaticResource Forest.Button}">
        <Setter Property="Foreground" Value="{StaticResource Forest.Danger}" />
    </Style>

    <!-- кнопка-ссылка: подчёркнутый текст без рамки («Модбаза ↗», «Удалить») -->
    <Style x:Key="Forest.LinkButton" TargetType="Button">
        <Setter Property="Foreground" Value="{StaticResource Forest.Accent}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <TextBlock x:Name="T" Text="{TemplateBinding Content}" TextDecorations="Underline" Background="Transparent" />
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="T" Property="Opacity" Value="0.8" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="T" Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- переключатель вкл/выкл (CheckBox): песочная дорожка, тёмная ручка -->
    <Style x:Key="Forest.Switch" TargetType="CheckBox">
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <Border x:Name="Track" Width="30" Height="17" CornerRadius="8.5" Background="{StaticResource Forest.Raised}"
                            BorderBrush="{StaticResource Forest.Line}" BorderThickness="1" SnapsToDevicePixels="True">
                        <Ellipse x:Name="Knob" Width="11" Height="11" Margin="2,0" HorizontalAlignment="Left" Fill="{StaticResource Forest.Muted}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Track" Property="Background" Value="{StaticResource Forest.Accent}" />
                            <Setter TargetName="Track" Property="BorderBrush" Value="{StaticResource Forest.Accent}" />
                            <Setter TargetName="Knob" Property="HorizontalAlignment" Value="Right" />
                            <Setter TargetName="Knob" Property="Fill" Value="{StaticResource Forest.AccentInk}" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Track" Property="Opacity" Value="0.85" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Track" Property="Opacity" Value="0.4" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- чип-фильтр (RadioButton): выбранный — приподнятый фон и светлый текст -->
    <Style x:Key="Forest.Chip" TargetType="RadioButton">
        <Setter Property="Foreground" Value="{StaticResource Forest.Muted}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Margin" Value="0,0,6,0" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Border x:Name="Bd" CornerRadius="6" Padding="10,5" Background="Transparent" BorderThickness="1" BorderBrush="Transparent">
                        <ContentPresenter />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Foreground" Value="{StaticResource Forest.Text}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource Forest.Raised}" />
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Forest.Line}" />
                            <Setter Property="Foreground" Value="{StaticResource Forest.Text}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- вкладка внутри карточки (RadioButton): выбранная — песочный текст и подчёркивание -->
    <Style x:Key="Forest.TabHeader" TargetType="RadioButton">
        <Setter Property="Foreground" Value="{StaticResource Forest.Muted}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Margin" Value="0,0,18,0" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Border x:Name="Bd" Background="Transparent" BorderBrush="Transparent" BorderThickness="0,0,0,2" Padding="0,0,0,7">
                        <ContentPresenter />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Foreground" Value="{StaticResource Forest.Text}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Forest.Accent}" />
                            <Setter Property="Foreground" Value="{StaticResource Forest.Accent}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- плитка-карточка в списке (ListBoxItem): поверхность и линия; выбранная — песочная рамка -->
    <Style x:Key="Forest.CardItem" TargetType="ListBoxItem">
        <Setter Property="Foreground" Value="{StaticResource Forest.Text}" />
        <Setter Property="Margin" Value="0,0,0,8" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Border x:Name="Bd" Background="{StaticResource Forest.Surface}" BorderBrush="{StaticResource Forest.Line}"
                            BorderThickness="1" CornerRadius="7" Padding="14,12" SnapsToDevicePixels="True">
                        <ContentPresenter />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="#2C372E" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Forest.Accent}" />
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource Forest.Raised}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- тонкая полоска прогресса -->
    <Style x:Key="Forest.Progress" TargetType="ProgressBar">
        <Setter Property="Height" Value="4" />
        <Setter Property="Minimum" Value="0" />
        <Setter Property="Maximum" Value="1" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ProgressBar">
                    <Border CornerRadius="2" Background="{StaticResource Forest.Raised}" ClipToBounds="True">
                        <Grid>
                            <Border x:Name="PART_Track" />
                            <Border x:Name="PART_Indicator" HorizontalAlignment="Left" CornerRadius="2" Background="{StaticResource Forest.Accent}" />
                        </Grid>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- большое число-счётчик над таблицей (кликабельное: включает фильтр) -->
    <Style x:Key="Forest.StatButton" TargetType="Button">
        <Setter Property="Foreground" Value="{StaticResource Forest.Text}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Margin" Value="0,0,28,0" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="C" Background="Transparent">
                        <ContentPresenter />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="C" Property="Opacity" Value="0.8" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- вкладка-счётчик «Моих модов» (RadioButton): число и подпись; выбранная — песочное подчёркивание на линии ряда -->
    <Style x:Key="Forest.StatTab" TargetType="RadioButton">
        <Setter Property="Foreground" Value="{StaticResource Forest.Text}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Margin" Value="0,0,26,0" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Border x:Name="C" Background="Transparent" BorderThickness="0,0,0,2" BorderBrush="Transparent" Padding="0,0,0,12">
                        <ContentPresenter />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="C" Property="Opacity" Value="0.8" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="C" Property="BorderBrush" Value="{StaticResource Forest.Accent}" />
                            <Setter TargetName="C" Property="Opacity" Value="1" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- заголовок колонки таблицы: мелкий приглушённый текст, стрелка сортировки -->
    <Style x:Key="Forest.ColumnHeader" TargetType="DataGridColumnHeader">
        <Setter Property="Foreground" Value="{StaticResource Forest.Muted}" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="DataGridColumnHeader">
                    <Border Background="Transparent" BorderBrush="{StaticResource Forest.Line}" BorderThickness="0,0,0,1" Padding="10,10">
                        <StackPanel Orientation="Horizontal">
                            <ContentPresenter VerticalAlignment="Center" />
                            <TextBlock x:Name="Arrow" Margin="4,0,0,0" FontSize="9" VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="SortDirection" Value="Ascending">
                            <Setter TargetName="Arrow" Property="Text" Value="▲" />
                        </Trigger>
                        <Trigger Property="SortDirection" Value="Descending">
                            <Setter TargetName="Arrow" Property="Text" Value="▼" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Foreground" Value="{StaticResource Forest.Text}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- пункт боковой навигации: RadioButton в ListBox не нужен — ListBoxItem со своим видом -->
    <Style x:Key="Forest.NavItem" TargetType="ListBoxItem">
        <Setter Property="Foreground" Value="{StaticResource Forest.Muted}" />
        <Setter Property="Padding" Value="12,10" />
        <Setter Property="Margin" Value="0,0,0,4" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Border x:Name="Bd" Background="Transparent" CornerRadius="8" Padding="{TemplateBinding Padding}">
                        <ContentPresenter />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="#22303D32" />
                            <Setter Property="Foreground" Value="{StaticResource Forest.Text}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource Forest.Selected}" />
                            <Setter Property="Foreground" Value="{StaticResource Forest.Accent}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- вкладки без заголовков: переключает боковая навигация -->
    <Style x:Key="Forest.PagesHost" TargetType="TabControl">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TabControl">
                    <!-- Для автоматизации (UIA, экранные дикторы): вкладки создаются панелью заголовков — она есть, но скрыта
                         и нулевой высоты; содержимое TabItem отдаёт через presenter с именем PART_SelectedContentHost. -->
                    <Grid>
                        <TabPanel IsItemsHost="True" Height="0" Visibility="Hidden" VerticalAlignment="Top" />
                        <ContentPresenter x:Name="PART_SelectedContentHost" ContentSource="SelectedContent" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- подписи -->
    <Style x:Key="Forest.MutedText" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource Forest.Muted}" />
    </Style>
    <Style x:Key="Forest.PageTitle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="26" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource Forest.Text}" />
    </Style>

    <!-- текст, который можно выделить и скопировать, но не править (TextBox без рамки и фона) -->
    <Style x:Key="Forest.SelectableText" TargetType="TextBox">
        <Setter Property="IsReadOnly" Value="True" />
        <Setter Property="Foreground" Value="{StaticResource Forest.Muted}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="SelectionBrush" Value="#6B6044" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <ScrollViewer x:Name="PART_ContentHost" Focusable="False" Background="Transparent"
                                  HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- панель/карточка -->
    <Style x:Key="Forest.Card" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource Forest.Surface}" />
        <Setter Property="BorderBrush" Value="{StaticResource Forest.Line}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="8" />
    </Style>
    <Style x:Key="Forest.Warning" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource Forest.WarningBg}" />
        <Setter Property="BorderBrush" Value="#5A4C33" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Padding" Value="14,10" />
    </Style>
</ResourceDictionary>
