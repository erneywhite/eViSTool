<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!--
        Лесная палитра (дизайн eViSTool-forest, Erney White).
        1) Токены дизайна: Forest.*.
        2) Подмена кистей Fluent-темы теми же цветами: шаблоны Fluent берут их через DynamicResource,
           поэтому стандартные контролы (выпадающие списки, галочки, прокрутка, меню) перекрашиваются сами.
    -->

    <!-- ===== токены ===== -->
    <Color x:Key="Forest.BaseColor">#202822</Color>
    <Color x:Key="Forest.SurfaceColor">#273129</Color>
    <Color x:Key="Forest.RaisedColor">#303D32</Color>
    <Color x:Key="Forest.SideColor">#19231D</Color>
    <Color x:Key="Forest.TextColor">#E7E9DD</Color>
    <Color x:Key="Forest.MutedColor">#A4B1A0</Color>
    <Color x:Key="Forest.LineColor">#3B483B</Color>
    <Color x:Key="Forest.AccentColor">#D4BD83</Color>
    <Color x:Key="Forest.AccentInkColor">#2C2B1C</Color>
    <Color x:Key="Forest.SelectedColor">#394432</Color>
    <Color x:Key="Forest.GoodColor">#B0C898</Color>
    <Color x:Key="Forest.WarnColor">#EDBF82</Color>
    <Color x:Key="Forest.WarningBgColor">#3A3425</Color>
    <Color x:Key="Forest.DangerColor">#E89B96</Color>

    <SolidColorBrush x:Key="Forest.Base" Color="{StaticResource Forest.BaseColor}" />
    <SolidColorBrush x:Key="Forest.Surface" Color="{StaticResource Forest.SurfaceColor}" />
    <SolidColorBrush x:Key="Forest.Raised" Color="{StaticResource Forest.RaisedColor}" />
    <SolidColorBrush x:Key="Forest.Side" Color="{StaticResource Forest.SideColor}" />
    <SolidColorBrush x:Key="Forest.Text" Color="{StaticResource Forest.TextColor}" />
    <SolidColorBrush x:Key="Forest.Muted" Color="{StaticResource Forest.MutedColor}" />
    <SolidColorBrush x:Key="Forest.Line" Color="{StaticResource Forest.LineColor}" />
    <SolidColorBrush x:Key="Forest.Accent" Color="{StaticResource Forest.AccentColor}" />
    <SolidColorBrush x:Key="Forest.AccentInk" Color="{StaticResource Forest.AccentInkColor}" />
    <SolidColorBrush x:Key="Forest.Selected" Color="{StaticResource Forest.SelectedColor}" />
    <SolidColorBrush x:Key="Forest.Good" Color="{StaticResource Forest.GoodColor}" />
    <SolidColorBrush x:Key="Forest.Warn" Color="{StaticResource Forest.WarnColor}" />
    <SolidColorBrush x:Key="Forest.WarningBg" Color="{StaticResource Forest.WarningBgColor}" />
    <SolidColorBrush x:Key="Forest.Danger" Color="{StaticResource Forest.DangerColor}" />

    <!-- ===== кисти Fluent → лесные ===== -->
    <SolidColorBrush x:Key="ApplicationBackgroundBrush" Color="{StaticResource Forest.BaseColor}" />
    <SolidColorBrush x:Key="WindowBackground" Color="{StaticResource Forest.BaseColor}" />
    <SolidColorBrush x:Key="SolidBackgroundFillColorBaseBrush" Color="{StaticResource Forest.BaseColor}" />
    <SolidColorBrush x:Key="SolidBackgroundFillColorSecondaryBrush" Color="{StaticResource Forest.SurfaceColor}" />
    <SolidColorBrush x:Key="SolidBackgroundFillColorTertiaryBrush" Color="{StaticResource Forest.RaisedColor}" />
    <SolidColorBrush x:Key="SolidBackgroundFillColorQuarternaryBrush" Color="{StaticResource Forest.RaisedColor}" />

    <SolidColorBrush x:Key="TextFillColorPrimaryBrush" Color="{StaticResource Forest.TextColor}" />
    <SolidColorBrush x:Key="TextFillColorSecondaryBrush" Color="{StaticResource Forest.MutedColor}" />
    <SolidColorBrush x:Key="TextFillColorTertiaryBrush" Color="#8A9786" />
    <SolidColorBrush x:Key="TextFillColorDisabledBrush" Color="#6E7A6A" />

    <SolidColorBrush x:Key="ControlFillColorDefaultBrush" Color="{StaticResource Forest.SurfaceColor}" />
    <SolidColorBrush x:Key="ControlFillColorSecondaryBrush" Color="{StaticResource Forest.RaisedColor}" />
    <SolidColorBrush x:Key="ControlFillColorTertiaryBrush" Color="#2B352D" />
    <SolidColorBrush x:Key="ControlFillColorDisabledBrush" Color="#242C25" />
    <SolidColorBrush x:Key="ControlFillColorInputActiveBrush" Color="{StaticResource Forest.SideColor}" />
    <SolidColorBrush x:Key="ControlStrokeColorDefaultBrush" Color="{StaticResource Forest.LineColor}" />
    <SolidColorBrush x:Key="ControlStrokeColorSecondaryBrush" Color="#46523F" />
    <SolidColorBrush x:Key="ControlElevationBorderBrush" Color="{StaticResource Forest.LineColor}" />
    <SolidColorBrush x:Key="CircleElevationBorderBrush" Color="{StaticResource Forest.LineColor}" />
    <SolidColorBrush x:Key="TextControlElevationBorderBrush" Color="{StaticResource Forest.LineColor}" />
    <SolidColorBrush x:Key="TextControlElevationBorderFocusedBrush" Color="{StaticResource Forest.AccentColor}" />
    <!-- поле в фокусе и выделенный текст: песок вместо системного акцента -->
    <SolidColorBrush x:Key="TextControlFocusedBorderBrush" Color="{StaticResource Forest.AccentColor}" />
    <SolidColorBrush x:Key="TextControlBorderBrushFocused" Color="{StaticResource Forest.AccentColor}" />
    <SolidColorBrush x:Key="TextControlSelectionHighlightColor" Color="#6B6044" />
    <SolidColorBrush x:Key="ComboBoxBorderBrushFocused" Color="{StaticResource Forest.AccentColor}" />

    <SolidColorBrush x:Key="CardBackgroundFillColorDefaultBrush" Color="{StaticResource Forest.SurfaceColor}" />
    <SolidColorBrush x:Key="CardBackgroundFillColorSecondaryBrush" Color="{StaticResource Forest.RaisedColor}" />
    <SolidColorBrush x:Key="CardStrokeColorDefaultBrush" Color="{StaticResource Forest.LineColor}" />
    <SolidColorBrush x:Key="SubtleFillColorSecondaryBrush" Color="#1FE7E9DD" />
    <SolidColorBrush x:Key="SubtleFillColorTertiaryBrush" Color="#14E7E9DD" />
    <SolidColorBrush x:Key="DividerStrokeColorDefaultBrush" Color="{StaticResource Forest.LineColor}" />
    <SolidColorBrush x:Key="SurfaceStrokeColorFlyoutBrush" Color="#46523F" />
    <SolidColorBrush x:Key="AcrylicBackgroundFillColorDefaultBrush" Color="{StaticResource Forest.SurfaceColor}" />
    <SolidColorBrush x:Key="FlyoutBackground" Color="{StaticResource Forest.SurfaceColor}" />
    <SolidColorBrush x:Key="ComboBoxDropDownBackground" Color="{StaticResource Forest.SurfaceColor}" />
    <SolidColorBrush x:Key="ContextMenuBackground" Color="{StaticResource Forest.SurfaceColor}" />

    <!-- акцент: песочный вместо системного -->
    <SolidColorBrush x:Key="AccentFillColorDefaultBrush" Color="{StaticResource Forest.AccentColor}" />
    <SolidColorBrush x:Key="AccentFillColorSecondaryBrush" Color="#DCC794" />
    <SolidColorBrush x:Key="AccentFillColorTertiaryBrush" Color="#C8B177" />
    <SolidColorBrush x:Key="AccentFillColorSelectedTextBackgroundBrush" Color="#6B6044" />
    <SolidColorBrush x:Key="AccentTextFillColorPrimaryBrush" Color="{StaticResource Forest.AccentColor}" />
    <SolidColorBrush x:Key="AccentTextFillColorSecondaryBrush" Color="{StaticResource Forest.AccentColor}" />
    <SolidColorBrush x:Key="AccentTextFillColorTertiaryBrush" Color="#C8B177" />
    <SolidColorBrush x:Key="TextOnAccentFillColorPrimaryBrush" Color="{StaticResource Forest.AccentInkColor}" />
    <SolidColorBrush x:Key="TextOnAccentFillColorSecondaryBrush" Color="{StaticResource Forest.AccentInkColor}" />
    <SolidColorBrush x:Key="HyperlinkForeground" Color="{StaticResource Forest.AccentColor}" />
    <SolidColorBrush x:Key="SystemFillColorAttentionBrush" Color="{StaticResource Forest.AccentColor}" />

    <!-- выделение в обычных списках (профили и т.п.): лесной «выбранный», не системный акцент -->
    <SolidColorBrush x:Key="ListBoxItemSelectedBackgroundThemeBrush" Color="#394432" />
    <SolidColorBrush x:Key="ListBoxItemSelectedBackgroundPointerOverThemeBrush" Color="#414D39" />
    <SolidColorBrush x:Key="ListBoxItemSelectedBackgroundPressedThemeBrush" Color="#414D39" />
    <SolidColorBrush x:Key="ListBoxItemSelectedForegroundThemeBrush" Color="{StaticResource Forest.TextColor}" />

    <!-- галочки, переключатели и радиокнопки: песок вместо системного акцента -->
    <SolidColorBrush x:Key="CheckBoxCheckBackgroundFillChecked" Color="{StaticResource Forest.AccentColor}" />
    <SolidColorBrush x:Key="CheckBoxCheckBackgroundStrokeChecked" Color="{StaticResource Forest.AccentColor}" />
    <SolidColorBrush x:Key="CheckBoxCheckBackgroundFillIndeterminate" Color="{StaticResource Forest.AccentColor}" />
    <SolidColorBrush x:Key="CheckBoxCheckBackgroundStrokeIndeterminate" Color="{StaticResource Forest.AccentColor}" />
    <SolidColorBrush x:Key="CheckBoxCheckGlyphForegroundChecked" Color="{StaticResource Forest.AccentInkColor}" />
    <SolidColorBrush x:Key="CheckBoxCheckGlyphForegroundIndeterminate" Color="{StaticResource Forest.AccentInkColor}" />
    <SolidColorBrush x:Key="RadioButtonOuterEllipseCheckedFill" Color="{StaticResource Forest.AccentColor}" />
    <SolidColorBrush x:Key="RadioButtonOuterEllipseCheckedStroke" Color="{StaticResource Forest.AccentColor}" />
    <SolidColorBrush x:Key="ToggleSwitchFillOn" Color="{StaticResource Forest.AccentColor}" />
    <SolidColorBrush x:Key="ToggleSwitchStrokeOn" Color="{StaticResource Forest.AccentColor}" />
    <SolidColorBrush x:Key="ToggleSwitchKnobFillOn" Color="{StaticResource Forest.AccentInkColor}" />
    <SolidColorBrush x:Key="CheckBoxCheckBackgroundFillCheckedPointerOver" Color="{StaticResource Forest.AccentColor}" />
    <SolidColorBrush x:Key="CheckBoxCheckBackgroundStrokeCheckedPointerOver" Color="{StaticResource Forest.AccentColor}" />
    <SolidColorBrush x:Key="CheckBoxCheckBackgroundFillIndeterminatePointerOver" Color="{StaticResource Forest.AccentColor}" />
    <SolidColorBrush x:Key="CheckBoxCheckBackgroundStrokeIndeterminatePointerOver" Color="{StaticResource Forest.AccentColor}" />
    <SolidColorBrush x:Key="CheckBoxCheckGlyphForegroundCheckedPointerOver" Color="{StaticResource Forest.AccentInkColor}" />
    <SolidColorBrush x:Key="CheckBoxCheckGlyphForegroundIndeterminatePointerOver" Color="{StaticResource Forest.AccentInkColor}" />
    <SolidColorBrush x:Key="RadioButtonOuterEllipseCheckedFillPointerOver" Color="{StaticResource Forest.AccentColor}" />
    <SolidColorBrush x:Key="RadioButtonOuterEllipseCheckedStrokePointerOver" Color="{StaticResource Forest.AccentColor}" />
    <SolidColorBrush x:Key="ToggleSwitchFillOnPointerOver" Color="{StaticResource Forest.AccentColor}" />
    <SolidColorBrush x:Key="ToggleSwitchStrokeOnPointerOver" Color="{StaticResource Forest.AccentColor}" />
    <SolidColorBrush x:Key="ToggleSwitchKnobFillOnPointerOver" Color="{StaticResource Forest.AccentInkColor}" />
    <SolidColorBrush x:Key="CheckBoxCheckBackgroundFillCheckedPressed" Color="{StaticResource Forest.AccentColor}" />
    <SolidColorBrush x:Key="CheckBoxCheckBackgroundStrokeCheckedPressed" Color="{StaticResource Forest.AccentColor}" />
    <SolidColorBrush x:Key="CheckBoxCheckBackgroundFillIndeterminatePressed" Color="{StaticResource Forest.AccentColor}" />
    <SolidColorBrush x:Key="CheckBoxCheckBackgroundStrokeIndeterminatePressed" Color="{StaticResource Forest.AccentColor}" />
    <SolidColorBrush x:Key="CheckBoxCheckGlyphForegroundCheckedPressed" Color="{StaticResource Forest.AccentInkColor}" />
    <SolidColorBrush x:Key="CheckBoxCheckGlyphForegroundIndeterminatePressed" Color="{StaticResource Forest.AccentInkColor}" />
    <SolidColorBrush x:Key="RadioButtonOuterEllipseCheckedFillPressed" Color="{StaticResource Forest.AccentColor}" />
    <SolidColorBrush x:Key="RadioButtonOuterEllipseCheckedStrokePressed" Color="{StaticResource Forest.AccentColor}" />
    <SolidColorBrush x:Key="ToggleSwitchFillOnPressed" Color="{StaticResource Forest.AccentColor}" />
    <SolidColorBrush x:Key="ToggleSwitchStrokeOnPressed" Color="{StaticResource Forest.AccentColor}" />
    <SolidColorBrush x:Key="ToggleSwitchKnobFillOnPressed" Color="{StaticResource Forest.AccentInkColor}" />

    <!-- ===== иконки навигации (контуры из макета, viewBox 24×24) ===== -->
    <Geometry x:Key="Icon.Mods">M3,3 H10 V10 H3 Z M14,3 H21 V10 H14 Z M3,14 H10 V21 H3 Z M14,14 H21 V21 H14 Z</Geometry>
    <Geometry x:Key="Icon.Catalog">M4,10 A6,6 0 1 1 16,10 A6,6 0 1 1 4,10 Z M15,15 L21,21</Geometry>
    <Geometry x:Key="Icon.Server">M3,3 H21 V10 H3 Z M3,14 H21 V21 H3 Z M6,7 H8 M6,18 H8</Geometry>
    <Geometry x:Key="Icon.Settings">M3,7 H6 M12,7 H21 M3,17 H13 M19,17 H21 M6,7 A3,3 0 1 1 12,7 A3,3 0 1 1 6,7 Z M13,17 A3,3 0 1 1 19,17 A3,3 0 1 1 13,17 Z</Geometry>
    <Geometry x:Key="Icon.About">M3,12 A9,9 0 1 1 21,12 A9,9 0 1 1 3,12 Z M12,11 V17 M12,7 V8</Geometry>
    <Geometry x:Key="Icon.Refresh">M20,7 A9,9 0 1 0 21,14 M20,2 V8 H14</Geometry>
    <Geometry x:Key="Icon.Plus">M12,5 V19 M5,12 H19</Geometry>
    <Geometry x:Key="Icon.Download">M12,3 V15 M7,10 L12,15 L17,10 M4,16 V21 H20 V16</Geometry>
    <Geometry x:Key="Icon.Warning">M12,3 L22,21 H2 Z M12,9 V14 M12,17 V18</Geometry>
    <Geometry x:Key="Icon.Client">M3,4 H21 V16 H3 Z M8,20 H16 M12,16 V20</Geometry>
    <Geometry x:Key="Icon.Copy">M8,8 H20 V20 H8 Z M4,16 V4 H16</Geometry>
    <Geometry x:Key="Icon.Search">M4,10 A6,6 0 1 1 16,10 A6,6 0 1 1 4,10 Z M15,15 L20,20</Geometry>
    <Geometry x:Key="Icon.Folder">M3,6 V19 H21 V8 H11 L9,6 Z</Geometry>
    <Geometry x:Key="Icon.Package">M12,3 L20,7 V17 L12,21 L4,17 V7 Z M4,7 L12,11 L20,7 M12,11 V21</Geometry>
    <Geometry x:Key="Icon.Close">M6,6 L18,18 M18,6 L6,18</Geometry>

    <!-- контурная иконка: Tag = геометрия, цвет — от родителя -->
    <Style x:Key="Forest.Icon" TargetType="Path">
        <Setter Property="Width" Value="18" />
        <Setter Property="Height" Value="18" />
        <Setter Property="Stretch" Value="Uniform" />
        <Setter Property="StrokeThickness" Value="1.6" />
        <Setter Property="StrokeStartLineCap" Value="Round" />
        <Setter Property="StrokeEndLineCap" Value="Round" />
        <Setter Property="StrokeLineJoin" Value="Round" />
        <Setter Property="Stroke" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Control}}" />
    </Style>

    <!-- ===== кнопки ===== -->
    <!-- обычная: поверхность + линия; primary — песочная; danger — розоватый текст -->
    <Style x:Key="Forest.Button" TargetType="Button">
        <Setter Property="Foreground" Value="{StaticResource Forest.Text}" />
        <Setter Property="Background" Value="{StaticResource Forest.Surface}" />
        <Setter Property="BorderBrush" Value="{StaticResource Forest.Line}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="13,8" />
        <Setter Property="MinHeight" Value="34" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6" Padding="{TemplateBinding Padding}"
                            SnapsToDevicePixels="True">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource Forest.Raised}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Forest.Accent}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Opacity" Value="0.85" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Bd" Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- все кнопки по умолчанию — лесные; старые ссылки на AccentButtonStyle ведут на песочную -->
    <Style TargetType="Button" BasedOn="{StaticResource Forest.Button}" />

    <Style x:Key="Forest.PrimaryButton" TargetType="Button" BasedOn="{StaticResource Forest.Button}">
        <Setter Property="Background" Value="{StaticResource Forest.Accent}" />
        <Setter Property="BorderBrush" Value="{StaticResource Forest.Accent}" />
        <Setter Property="Foreground" Value="{StaticResource Forest.AccentInk}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="1" CornerRadius="6" Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="#DFCB96" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="#C8B177" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Bd" Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="AccentButtonStyle" TargetType="Button" BasedOn="{StaticResource Forest.PrimaryButton}" />

    <Style x:Key="Forest.DangerButton" TargetType="Button" BasedOn="{StaticResource Forest.Button}">
        <Setter Property="Foreground" Value="{StaticResource Forest.Danger}" />
    </Style>

    <!-- кнопка-ссылка: подчёркнутый текст без рамки («Модбаза ↗», «Удалить») -->
    <Style x:Key="Forest.LinkButton" TargetType="Button">
        <Setter Property="Foreground" Value="{StaticResource Forest.Accent}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <TextBlock x:Name="T" Text="{TemplateBinding Content}" TextDecorations="Underline" Background="Transparent" />
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="T" Property="Opacity" Value="0.8" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="T" Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- переключатель вкл/выкл (CheckBox): песочная дорожка, тёмная ручка -->
    <Style x:Key="Forest.Switch" TargetType="CheckBox">
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <Border x:Name="Track" Width="30" Height="17" CornerRadius="8.5" Background="{StaticResource Forest.Raised}"
                            BorderBrush="{StaticResource Forest.Line}" BorderThickness="1" SnapsToDevicePixels="True">
                        <Ellipse x:Name="Knob" Width="11" Height="11" Margin="2,0" HorizontalAlignment="Left" Fill="{StaticResource Forest.Muted}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Track" Property="Background" Value="{StaticResource Forest.Accent}" />
                            <Setter TargetName="Track" Property="BorderBrush" Value="{StaticResource Forest.Accent}" />
                            <Setter TargetName="Knob" Property="HorizontalAlignment" Value="Right" />
                            <Setter TargetName="Knob" Property="Fill" Value="{StaticResource Forest.AccentInk}" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Track" Property="Opacity" Value="0.85" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Track" Property="Opacity" Value="0.4" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- чип-фильтр (RadioButton): выбранный — приподнятый фон и светлый текст -->
    <Style x:Key="Forest.Chip" TargetType="RadioButton">
        <Setter Property="Foreground" Value="{StaticResource Forest.Muted}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Margin" Value="0,0,6,0" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Border x:Name="Bd" CornerRadius="6" Padding="10,5" Background="Transparent" BorderThickness="1" BorderBrush="Transparent">
                        <ContentPresenter />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Foreground" Value="{StaticResource Forest.Text}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource Forest.Raised}" />
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Forest.Line}" />
                            <Setter Property="Foreground" Value="{StaticResource Forest.Text}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- вкладка внутри карточки (RadioButton): выбранная — песочный текст и подчёркивание -->
    <Style x:Key="Forest.TabHeader" TargetType="RadioButton">
        <Setter Property="Foreground" Value="{StaticResource Forest.Muted}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Margin" Value="0,0,18,0" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Border x:Name="Bd" Background="Transparent" BorderBrush="Transparent" BorderThickness="0,0,0,2" Padding="0,0,0,7">
                        <ContentPresenter />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Foreground" Value="{StaticResource Forest.Text}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Forest.Accent}" />
                            <Setter Property="Foreground" Value="{StaticResource Forest.Accent}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- плитка-карточка в списке (ListBoxItem): поверхность и линия; выбранная — песочная рамка -->
    <Style x:Key="Forest.CardItem" TargetType="ListBoxItem">
        <Setter Property="Foreground" Value="{StaticResource Forest.Text}" />
        <Setter Property="Margin" Value="0,0,0,8" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Border x:Name="Bd" Background="{StaticResource Forest.Surface}" BorderBrush="{StaticResource Forest.Line}"
                            BorderThickness="1" CornerRadius="7" Padding="14,12" SnapsToDevicePixels="True">
                        <ContentPresenter />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="#2C372E" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Forest.Accent}" />
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource Forest.Raised}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- тонкая полоска прогресса -->
    <Style x:Key="Forest.Progress" TargetType="ProgressBar">
        <Setter Property="Height" Value="4" />
        <Setter Property="Minimum" Value="0" />
        <Setter Property="Maximum" Value="1" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ProgressBar">
                    <Border CornerRadius="2" Background="{StaticResource Forest.Raised}" ClipToBounds="True">
                        <Grid>
                            <Border x:Name="PART_Track" />
                            <Border x:Name="PART_Indicator" HorizontalAlignment="Left" CornerRadius="2" Background="{StaticResource Forest.Accent}" />
                        </Grid>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- большое число-счётчик над таблицей (кликабельное: включает фильтр) -->
    <Style x:Key="Forest.StatButton" TargetType="Button">
        <Setter Property="Foreground" Value="{StaticResource Forest.Text}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Margin" Value="0,0,28,0" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="C" Background="Transparent">
                        <ContentPresenter />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="C" Property="Opacity" Value="0.8" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- заголовок колонки таблицы: мелкий приглушённый текст, стрелка сортировки -->
    <Style x:Key="Forest.ColumnHeader" TargetType="DataGridColumnHeader">
        <Setter Property="Foreground" Value="{StaticResource Forest.Muted}" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="DataGridColumnHeader">
                    <Border Background="Transparent" BorderBrush="{StaticResource Forest.Line}" BorderThickness="0,0,0,1" Padding="10,10">
                        <StackPanel Orientation="Horizontal">
                            <ContentPresenter VerticalAlignment="Center" />
                            <TextBlock x:Name="Arrow" Margin="4,0,0,0" FontSize="9" VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="SortDirection" Value="Ascending">
                            <Setter TargetName="Arrow" Property="Text" Value="▲" />
                        </Trigger>
                        <Trigger Property="SortDirection" Value="Descending">
                            <Setter TargetName="Arrow" Property="Text" Value="▼" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Foreground" Value="{StaticResource Forest.Text}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- пункт боковой навигации: RadioButton в ListBox не нужен — ListBoxItem со своим видом -->
    <Style x:Key="Forest.NavItem" TargetType="ListBoxItem">
        <Setter Property="Foreground" Value="{StaticResource Forest.Muted}" />
        <Setter Property="Padding" Value="12,10" />
        <Setter Property="Margin" Value="0,0,0,4" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Border x:Name="Bd" Background="Transparent" CornerRadius="8" Padding="{TemplateBinding Padding}">
                        <ContentPresenter />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="#22303D32" />
                            <Setter Property="Foreground" Value="{StaticResource Forest.Text}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource Forest.Selected}" />
                            <Setter Property="Foreground" Value="{StaticResource Forest.Accent}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- вкладки без заголовков: переключает боковая навигация -->
    <Style x:Key="Forest.PagesHost" TargetType="TabControl">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TabControl">
                    <!-- Для автоматизации (UIA, экранные дикторы): вкладки создаются панелью заголовков — она есть, но скрыта
                         и нулевой высоты; содержимое TabItem отдаёт через presenter с именем PART_SelectedContentHost. -->
                    <Grid>
                        <TabPanel IsItemsHost="True" Height="0" Visibility="Hidden" VerticalAlignment="Top" />
                        <ContentPresenter x:Name="PART_SelectedContentHost" ContentSource="SelectedContent" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- подписи -->
    <Style x:Key="Forest.MutedText" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource Forest.Muted}" />
    </Style>
    <Style x:Key="Forest.PageTitle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="26" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource Forest.Text}" />
    </Style>

    <!-- текст, который можно выделить и скопировать, но не править (TextBox без рамки и фона) -->
    <Style x:Key="Forest.SelectableText" TargetType="TextBox">
        <Setter Property="IsReadOnly" Value="True" />
        <Setter Property="Foreground" Value="{StaticResource Forest.Muted}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="SelectionBrush" Value="#6B6044" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <ScrollViewer x:Name="PART_ContentHost" Focusable="False" Background="Transparent"
                                  HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- панель/карточка -->
    <Style x:Key="Forest.Card" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource Forest.Surface}" />
        <Setter Property="BorderBrush" Value="{StaticResource Forest.Line}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="8" />
    </Style>
    <Style x:Key="Forest.Warning" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource Forest.WarningBg}" />
        <Setter Property="BorderBrush" Value="#5A4C33" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Padding" Value="14,10" />
    </Style>
</ResourceDictionary>
