<UserControl x:Class="eViSTool.App.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:eViSTool.App">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <local:InvertBoolConverter x:Key="Invert" />

        <!-- заголовок карточки и пояснение к нему -->
        <Style x:Key="CardTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{StaticResource Forest.Text}" />
        </Style>
        <!-- подпись поля -->
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{StaticResource Forest.Text}" />
            <Setter Property="Margin" Value="0,16,0,0" />
        </Style>
        <Style x:Key="Hint" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Foreground" Value="{StaticResource Forest.Muted}" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="0,2,0,6" />
        </Style>
        <Style x:Key="SettingsCard" TargetType="Border" BasedOn="{StaticResource Forest.Card}">
            <Setter Property="Padding" Value="20,16,20,20" />
            <Setter Property="Margin" Value="0,0,0,14" />
        </Style>
        <Style x:Key="InfoKey" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{StaticResource Forest.Muted}" />
            <Setter Property="Margin" Value="0,0,14,6" />
        </Style>
        <Style x:Key="InfoValue" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{StaticResource Forest.Text}" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="0,0,0,6" />
        </Style>
    </UserControl.Resources>

    <DockPanel Margin="10,4,10,0">
        <!-- ===== заголовок ===== -->
        <StackPanel DockPanel.Dock="Top">
            <TextBlock Text="{local:Tr nav.settings}" Style="{StaticResource Forest.PageTitle}" />
            <TextBlock Text="{local:Tr settings.subtitle}" Foreground="{StaticResource Forest.Accent}" FontSize="12" Margin="0,4,0,0" />
        </StackPanel>
        <Border DockPanel.Dock="Top" BorderBrush="{StaticResource Forest.Line}" BorderThickness="0,0,0,1" Margin="0,14,0,14" />

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="280" />
                <ColumnDefinition Width="18" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- ===== профили ===== -->
            <Border Style="{StaticResource Forest.Card}" Padding="12" Margin="0,0,0,14">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top" Margin="6,2,6,10">
                        <TextBlock Text="{local:Tr settings.profiles}" Style="{StaticResource CardTitle}" />
                        <TextBlock Text="{local:Tr settings.profilesHint}" Style="{StaticResource Hint}" />
                    </StackPanel>
                    <StackPanel DockPanel.Dock="Bottom" Margin="0,10,0,0">
                        <UniformGrid Columns="2" Margin="0,0,0,8">
                            <Button Command="{Binding AddClientProfileCommand}" Margin="0,0,4,0">
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="{StaticResource Icon.Plus}" Style="{StaticResource Forest.Icon}" Width="11" Height="11" Margin="0,0,7,0" />
                                    <TextBlock Text="{local:Tr settings.kindClient}" />
                                </StackPanel>
                            </Button>
                            <Button Command="{Binding AddServerProfileCommand}" Margin="4,0,0,0">
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="{StaticResource Icon.Plus}" Style="{StaticResource Forest.Icon}" Width="11" Height="11" Margin="0,0,7,0" />
                                    <TextBlock Text="{local:Tr tab.server}" />
                                </StackPanel>
                            </Button>
                        </UniformGrid>
                        <Button Command="{Binding CloneProfileCommand}" CommandParameter="{Binding EditedProfile}" HorizontalAlignment="Stretch"
                                Margin="0,0,0,8" ToolTip="{local:Tr settings.cloneTip}">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource Icon.Copy}" Style="{StaticResource Forest.Icon}" Width="13" Height="13" Margin="0,0,8,0" />
                                <TextBlock Text="{local:Tr settings.clone}" />
                            </StackPanel>
                        </Button>
                        <Button Content="{local:Tr settings.removeProfile}" Command="{Binding RemoveProfileCommand}" CommandParameter="{Binding EditedProfile}"
                                Style="{StaticResource Forest.DangerButton}" HorizontalAlignment="Stretch" />
                    </StackPanel>
                    <ListBox ItemsSource="{Binding Profiles}" SelectedItem="{Binding EditedProfile}" Background="Transparent" BorderThickness="0"
                             ItemContainerStyle="{StaticResource Forest.NavItem}" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <DockPanel>
                                    <Path DockPanel.Dock="Left" VerticalAlignment="Center" Margin="0,0,12,0">
                                        <Path.Style>
                                            <Style TargetType="Path" BasedOn="{StaticResource Forest.Icon}">
                                                <Setter Property="Data" Value="{StaticResource Icon.Client}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsServer}" Value="True">
                                                        <Setter Property="Data" Value="{StaticResource Icon.Server}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Path.Style>
                                    </Path>
                                    <StackPanel>
                                        <TextBlock Text="{Binding Name}" FontSize="13" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                        <TextBlock FontSize="11" Foreground="{StaticResource Forest.Muted}" TextTrimming="CharacterEllipsis">
                                            <Run Text="{Binding KindText, Mode=OneWay}" /><Run Text="{local:Tr settings.gameShort}" /><Run Text="{Binding GameVersionText, Mode=OneWay}" />
                                        </TextBlock>
                                    </StackPanel>
                                </DockPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>

            <!-- ===== правая часть ===== -->
            <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="0,0,14,0">
                    <!-- выбранный профиль -->
                    <Border Style="{StaticResource SettingsCard}" DataContext="{Binding EditedProfile}">
                        <StackPanel>
                            <TextBlock Text="{local:Tr settings.profileCard}" Style="{StaticResource CardTitle}" />
                            <TextBlock Text="{local:Tr settings.profileCardHint}" Style="{StaticResource Hint}" />

                            <TextBlock Text="{local:Tr settings.name}" Style="{StaticResource FieldLabel}" />
                            <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" Margin="0,6,0,0" MaxLength="60" />

                            <TextBlock Text="{local:Tr settings.type}" Style="{StaticResource FieldLabel}" />
                            <!-- тип задаётся при создании профиля и не меняется: у клиента и сервера разные папки и файлы -->
                            <TextBlock Text="{Binding KindText}" FontSize="13" Foreground="{StaticResource Forest.Text}" Margin="0,6,0,0"
                                       AutomationProperties.AutomationId="ProfileKind" />

                            <TextBlock Text="{local:Tr settings.gameDir}" Style="{StaticResource FieldLabel}" />
                            <TextBlock Style="{StaticResource Hint}" Text="{local:Tr settings.gameDirHint}" />
                            <DockPanel>
                                <Button DockPanel.Dock="Right" Content="{local:Tr common.browse}" Command="{Binding BrowseGameDirCommand}" Margin="8,0,0,0" />
                                <TextBox Text="{Binding GameDir, UpdateSourceTrigger=LostFocus}" VerticalContentAlignment="Center" />
                            </DockPanel>

                            <TextBlock Text="{local:Tr settings.dataDir}" Style="{StaticResource FieldLabel}" />
                            <TextBlock Style="{StaticResource Hint}" Text="{local:Tr settings.dataDirHint}" />
                            <DockPanel>
                                <Button DockPanel.Dock="Right" Command="{Binding OpenDataDirCommand}" Margin="8,0,0,0" Padding="10,8" ToolTip="{local:Tr common.open}">
                                    <Path Data="{StaticResource Icon.Folder}" Style="{StaticResource Forest.Icon}" Width="16" Height="16" />
                                </Button>
                                <Button DockPanel.Dock="Right" Content="{local:Tr common.browse}" Command="{Binding BrowseDataDirCommand}" Margin="8,0,0,0" />
                                <TextBox Text="{Binding DataDir, UpdateSourceTrigger=LostFocus}" VerticalContentAlignment="Center" />
                            </DockPanel>

                            <!-- что удалось прочитать из файлов игры -->
                            <Border Margin="0,18,0,0" Padding="14,12" CornerRadius="6" Background="{StaticResource Forest.Base}"
                                    BorderBrush="{StaticResource Forest.Line}" BorderThickness="1">
                                <DockPanel>
                                    <Button DockPanel.Dock="Right" Command="{Binding RereadCommand}" VerticalAlignment="Top" Margin="12,0,0,0"
                                            Padding="10,6" MinHeight="0" ToolTip="{local:Tr settings.reread}">
                                        <StackPanel Orientation="Horizontal">
                                            <Path Data="{StaticResource Icon.Refresh}" Style="{StaticResource Forest.Icon}" Width="13" Height="13" Margin="0,0,7,0" />
                                            <TextBlock Text="{local:Tr settings.reread}" FontSize="12" />
                                        </StackPanel>
                                    </Button>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <TextBlock Text="{local:Tr settings.gameVersion}" Style="{StaticResource InfoKey}" />
                                        <TextBlock Grid.Column="1" Text="{Binding GameVersionText}" Style="{StaticResource InfoValue}" FontWeight="SemiBold" />
                                        <TextBlock Grid.Row="1" Text="{local:Tr settings.configFile}" Style="{StaticResource InfoKey}" />
                                        <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding ConfigText}" Style="{StaticResource InfoValue}" />
                                        <TextBlock Grid.Row="2" Text="{local:Tr settings.modDirs}" Style="{StaticResource InfoKey}" />
                                        <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding ModDirsText}" Style="{StaticResource InfoValue}" />
                                        <TextBlock Grid.Row="3" Grid.ColumnSpan="2" Text="{Binding WarningsText}" Foreground="{StaticResource Forest.Warn}" FontSize="12"
                                                   TextWrapping="Wrap" Visibility="{Binding HasWarnings, Converter={StaticResource BoolToVis}}" />
                                    </Grid>
                                </DockPanel>
                            </Border>
                        </StackPanel>
                    </Border>

                    <!-- поведение программы -->
                    <Border Style="{StaticResource SettingsCard}">
                        <StackPanel>
                            <TextBlock Text="{local:Tr settings.behavior}" Style="{StaticResource CardTitle}" />
                            <TextBlock Text="{local:Tr settings.behaviorHint}" Style="{StaticResource Hint}" />

                            <TextBlock Text="{local:Tr settings.language}" Style="{StaticResource FieldLabel}" />
                            <ComboBox ItemsSource="{Binding Languages}" SelectedItem="{Binding SelectedLanguage}" Width="240"
                                      HorizontalAlignment="Left" Margin="0,6,0,0" />

                            <Border BorderBrush="{StaticResource Forest.Line}" BorderThickness="0,1,0,0" Margin="0,18,0,0" Padding="0,14,0,0">
                                <DockPanel>
                                    <CheckBox DockPanel.Dock="Right" Style="{StaticResource Forest.Switch}" IsChecked="{Binding AutoCheckUpdates}" VerticalAlignment="Center" />
                                    <StackPanel Margin="0,0,16,0">
                                        <TextBlock Text="{local:Tr settings.autoCheck}" FontSize="13" Foreground="{StaticResource Forest.Text}" TextWrapping="Wrap" />
                                        <TextBlock Text="{local:Tr settings.autoCheckHint}" Style="{StaticResource Hint}" />
                                    </StackPanel>
                                </DockPanel>
                            </Border>
                            <Border BorderBrush="{StaticResource Forest.Line}" BorderThickness="0,1,0,0" Margin="0,10,0,0" Padding="0,14,0,0">
                                <DockPanel>
                                    <CheckBox DockPanel.Dock="Right" Style="{StaticResource Forest.Switch}" IsChecked="{Binding AllowUnstable}" VerticalAlignment="Center" />
                                    <StackPanel Margin="0,0,16,0">
                                        <TextBlock Text="{local:Tr settings.allowUnstable}" FontSize="13" Foreground="{StaticResource Forest.Text}" TextWrapping="Wrap" />
                                        <TextBlock Text="{local:Tr settings.allowUnstableHint}" Style="{StaticResource Hint}" />
                                    </StackPanel>
                                </DockPanel>
                            </Border>
                        </StackPanel>
                    </Border>

                    <!-- где лежат данные программы -->
                    <Border Style="{StaticResource SettingsCard}">
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Command="{Binding OpenDataFolderCommand}" VerticalAlignment="Center" Margin="16,0,0,0">
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="{StaticResource Icon.Folder}" Style="{StaticResource Forest.Icon}" Width="14" Height="14" Margin="0,0,8,0" />
                                    <TextBlock Text="{local:Tr common.open}" />
                                </StackPanel>
                            </Button>
                            <StackPanel>
                                <TextBlock Text="{local:Tr settings.appData}" Style="{StaticResource CardTitle}" />
                                <TextBlock Text="{local:Tr settings.appDataHint}" Style="{StaticResource Hint}" />
                                <TextBlock Text="{Binding DataLocationText}" FontSize="12" Foreground="{StaticResource Forest.Text}" TextWrapping="Wrap"
                                           FontFamily="Consolas" Margin="0,6,0,0" />
                            </StackPanel>
                        </DockPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </DockPanel>
</UserControl>
