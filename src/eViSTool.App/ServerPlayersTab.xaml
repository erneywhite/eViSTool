<UserControl x:Class="eViSTool.App.ServerPlayersTab"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:eViSTool.App">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <local:InvertBoolToVisibilityConverter x:Key="InvertVis" />
        <local:TextToVisibilityConverter x:Key="TextToVis" />

        <Style x:Key="CardTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{StaticResource Forest.Text}" />
        </Style>
        <Style x:Key="Hint" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Foreground" Value="{StaticResource Forest.Muted}" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="0,2,0,0" />
        </Style>
        <Style x:Key="Label" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Foreground" Value="{StaticResource Forest.Text}" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style x:Key="PlayersCard" TargetType="Border" BasedOn="{StaticResource Forest.Card}">
            <Setter Property="Padding" Value="20,16,20,18" />
            <Setter Property="Margin" Value="0,0,0,14" />
        </Style>
        <Style x:Key="Row" TargetType="Border">
            <Setter Property="BorderBrush" Value="{StaticResource Forest.Line}" />
            <Setter Property="BorderThickness" Value="0,1,0,0" />
            <Setter Property="Padding" Value="0,14,0,0" />
            <Setter Property="Margin" Value="0,14,0,0" />
        </Style>
        <Style x:Key="Action" TargetType="Button" BasedOn="{StaticResource Forest.LinkButton}">
            <Setter Property="Margin" Value="14,0,0,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="ToolTipService.ShowOnDisabled" Value="True" />
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,14,0,0">
        <StackPanel Margin="0,0,14,0">
            <!-- ===== как применяются изменения, ответ сервера, ошибки ===== -->
            <TextBlock Text="{Binding ModeText}" FontSize="12" Foreground="{StaticResource Forest.Muted}" TextWrapping="Wrap" Margin="2,0,0,10"
                       AutomationProperties.AutomationId="PlayersMode" />
            <TextBlock Text="{Binding StatusText}" FontSize="12" Foreground="{StaticResource Forest.Accent}" TextWrapping="Wrap" Margin="2,0,0,10"
                       Visibility="{Binding StatusText, Converter={StaticResource TextToVis}}" AutomationProperties.AutomationId="PlayersStatus" />
            <TextBlock Text="{Binding ErrorText}" FontSize="12" Foreground="{StaticResource Forest.Danger}" TextWrapping="Wrap" Margin="2,0,0,10"
                       Visibility="{Binding ErrorText, Converter={StaticResource TextToVis}}" AutomationProperties.AutomationId="PlayersError" />

            <!-- ===== доступ: белый список и «добавить по имени» ===== -->
            <Border Style="{StaticResource PlayersCard}">
                <StackPanel>
                    <TextBlock Text="{local:Tr players.accessTitle}" Style="{StaticResource CardTitle}" />

                    <Border Style="{StaticResource Row}">
                        <DockPanel>
                            <CheckBox DockPanel.Dock="Right" Style="{StaticResource Forest.Switch}" IsChecked="{Binding WhitelistOn}" VerticalAlignment="Center"
                                      IsEnabled="{Binding CanEdit}" AutomationProperties.AutomationId="PlayersWhitelistMode"
                                      AutomationProperties.Name="{local:Tr players.whitelistMode}" />
                            <StackPanel Margin="0,0,16,0">
                                <TextBlock Text="{local:Tr players.whitelistMode}" Style="{StaticResource Label}" />
                                <TextBlock Text="{local:Tr players.whitelistModeHint}" Style="{StaticResource Hint}" />
                            </StackPanel>
                        </DockPanel>
                    </Border>

                    <Border Style="{StaticResource Row}">
                        <StackPanel>
                            <DockPanel>
                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top">
                                    <TextBox Width="200" Text="{Binding AddName, UpdateSourceTrigger=PropertyChanged}" VerticalContentAlignment="Center"
                                             IsEnabled="{Binding CanCommand}" AutomationProperties.AutomationId="PlayersAddName"
                                             AutomationProperties.Name="{local:Tr players.addName}" />
                                    <Button Content="{local:Tr players.addWhitelist}" Command="{Binding AddToWhitelistCommand}" IsEnabled="{Binding CanCommand}"
                                            Margin="8,0,0,0" Padding="12,6" AutomationProperties.AutomationId="PlayersAddWhitelist" />
                                    <Button Content="{local:Tr players.addBan}" Command="{Binding BanNameCommand}" IsEnabled="{Binding CanCommand}"
                                            Margin="8,0,0,0" Padding="12,6" AutomationProperties.AutomationId="PlayersAddBan" />
                                </StackPanel>
                                <StackPanel Margin="0,0,16,0">
                                    <TextBlock Text="{local:Tr players.addName}" Style="{StaticResource Label}" />
                                    <TextBlock Text="{local:Tr players.addNameHint}" Style="{StaticResource Hint}" />
                                </StackPanel>
                            </DockPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>

            <!-- ===== кто заходил ===== -->
            <Border Style="{StaticResource PlayersCard}">
                <StackPanel>
                    <DockPanel>
                        <Grid DockPanel.Dock="Right" Width="240">
                            <TextBox Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}" Padding="34,6,10,6" VerticalContentAlignment="Center"
                                     AutomationProperties.AutomationId="PlayersSearch" />
                            <Path Data="{StaticResource Icon.Search}" Style="{StaticResource Forest.Icon}" Stroke="{StaticResource Forest.Muted}"
                                  Width="14" Height="14" HorizontalAlignment="Left" Margin="12,0,0,0" IsHitTestVisible="False" />
                            <TextBlock Text="{local:Tr players.search}" Foreground="{StaticResource Forest.Muted}" Margin="35,0,0,0"
                                       VerticalAlignment="Center" IsHitTestVisible="False">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Opacity" Value="0" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Search}" Value="">
                                                <Setter Property="Opacity" Value="1" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>
                        <StackPanel Margin="0,0,16,0">
                            <TextBlock Text="{local:Tr players.listTitle}" Style="{StaticResource CardTitle}" />
                            <TextBlock Text="{local:Tr players.listHint}" Style="{StaticResource Hint}" />
                        </StackPanel>
                    </DockPanel>

                    <TextBlock Text="{local:Tr players.empty}" Style="{StaticResource Hint}" FontSize="12" Margin="0,14,0,0"
                               Visibility="{Binding HasPlayers, Converter={StaticResource InvertVis}}" />

                    <ItemsControl x:Name="PlayersList" ItemsSource="{Binding PlayersView}" Margin="0,6,0,0" Focusable="False">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="{StaticResource Forest.Line}" BorderThickness="0,1,0,0" Padding="0,10" Margin="0,4,0,0">
                                    <DockPanel>
                                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                            <ComboBox Style="{StaticResource Forest.ComboBox}" Width="170" ItemsSource="{Binding Roles}" SelectedItem="{Binding Role}"
                                                      DisplayMemberPath="Name" ToolTip="{local:Tr players.role}" VerticalAlignment="Center"
                                                      IsEnabled="{Binding DataContext.CanEdit, ElementName=PlayersList}"
                                                      AutomationProperties.Name="{local:Tr players.role}" />
                                            <CheckBox Style="{StaticResource Forest.Switch}" IsChecked="{Binding Whitelisted}" VerticalAlignment="Center" Margin="18,0,0,0"
                                                      ToolTip="{local:Tr players.inWhitelist}" IsEnabled="{Binding DataContext.CanEdit, ElementName=PlayersList}"
                                                      AutomationProperties.Name="{local:Tr players.inWhitelist}" />
                                            <TextBlock Text="{local:Tr players.whitelistShort}" FontSize="12" Foreground="{StaticResource Forest.Muted}"
                                                       VerticalAlignment="Center" Margin="8,0,0,0" />
                                            <Button Style="{StaticResource Action}" Content="{local:Tr players.charsel}" ToolTip="{local:Tr players.charselTip}"
                                                    Command="{Binding DataContext.AllowCharSelCommand, ElementName=PlayersList}" CommandParameter="{Binding}"
                                                    IsEnabled="{Binding DataContext.CanCommand, ElementName=PlayersList}" Margin="22,0,0,0" />
                                            <Button Style="{StaticResource Action}" Content="{local:Tr players.kick}"
                                                    Command="{Binding DataContext.KickCommand, ElementName=PlayersList}" CommandParameter="{Binding}"
                                                    Visibility="{Binding IsOnline, Converter={StaticResource BoolToVis}}"
                                                    IsEnabled="{Binding DataContext.CanCommand, ElementName=PlayersList}" />
                                            <Button Style="{StaticResource Action}" Content="{local:Tr players.ban}" Foreground="{StaticResource Forest.Danger}"
                                                    ToolTip="{local:Tr players.banTip}"
                                                    Command="{Binding DataContext.BanCommand, ElementName=PlayersList}" CommandParameter="{Binding}"
                                                    Visibility="{Binding IsBanned, Converter={StaticResource InvertVis}}"
                                                    IsEnabled="{Binding DataContext.CanCommand, ElementName=PlayersList}" />
                                            <Button Style="{StaticResource Action}" Content="{local:Tr players.unban}"
                                                    Command="{Binding DataContext.UnbanCommand, ElementName=PlayersList}" CommandParameter="{Binding}"
                                                    Visibility="{Binding IsBanned, Converter={StaticResource BoolToVis}}"
                                                    IsEnabled="{Binding DataContext.CanEdit, ElementName=PlayersList}" />
                                        </StackPanel>
                                        <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                                            <StackPanel Orientation="Horizontal">
                                                <Ellipse Width="8" Height="8" Margin="0,1,8,0" Fill="{StaticResource Forest.Good}" VerticalAlignment="Center"
                                                         Visibility="{Binding IsOnline, Converter={StaticResource BoolToVis}}" />
                                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="13" Foreground="{StaticResource Forest.Text}"
                                                           TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                            <TextBlock Text="{Binding SeenText}" FontSize="11" Foreground="{StaticResource Forest.Muted}" Margin="0,2,0,0"
                                                       TextTrimming="CharacterEllipsis" Visibility="{Binding SeenText, Converter={StaticResource TextToVis}}" />
                                            <TextBlock Text="{Binding BanText}" FontSize="11" Foreground="{StaticResource Forest.Danger}" Margin="0,2,0,0"
                                                       TextWrapping="Wrap" Visibility="{Binding IsBanned, Converter={StaticResource BoolToVis}}" />
                                        </StackPanel>
                                    </DockPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <!-- ===== белый список и баны целиком (и те, кто ещё не заходил) ===== -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition />
                    <ColumnDefinition Width="14" />
                    <ColumnDefinition />
                </Grid.ColumnDefinitions>
                <Border Style="{StaticResource PlayersCard}">
                    <StackPanel>
                        <TextBlock Text="{Binding WhitelistTitle}" Style="{StaticResource CardTitle}" />
                        <TextBlock Text="{local:Tr players.whitelistEmpty}" Style="{StaticResource Hint}" FontSize="12" Margin="0,10,0,0"
                                   Visibility="{Binding HasWhitelist, Converter={StaticResource InvertVis}}" />
                        <ItemsControl x:Name="WhitelistList" ItemsSource="{Binding Whitelist}" Margin="0,6,0,0" Focusable="False">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="{StaticResource Forest.Line}" BorderThickness="0,1,0,0" Padding="0,8" Margin="0,4,0,0">
                                        <DockPanel>
                                            <Button DockPanel.Dock="Right" Style="{StaticResource Action}" Content="{local:Tr players.remove}"
                                                    Command="{Binding DataContext.RemoveEntryCommand, ElementName=WhitelistList}" CommandParameter="{Binding}"
                                                    IsEnabled="{Binding DataContext.CanEdit, ElementName=WhitelistList}" />
                                            <StackPanel>
                                                <TextBlock Text="{Binding Name}" FontSize="13" Foreground="{StaticResource Forest.Text}" TextTrimming="CharacterEllipsis" />
                                                <TextBlock Text="{Binding Details}" FontSize="11" Foreground="{StaticResource Forest.Muted}" TextWrapping="Wrap" Margin="0,2,0,0" />
                                            </StackPanel>
                                        </DockPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
                <Border Grid.Column="2" Style="{StaticResource PlayersCard}">
                    <StackPanel>
                        <TextBlock Text="{Binding BansTitle}" Style="{StaticResource CardTitle}" />
                        <TextBlock Text="{local:Tr players.bansEmpty}" Style="{StaticResource Hint}" FontSize="12" Margin="0,10,0,0"
                                   Visibility="{Binding HasBans, Converter={StaticResource InvertVis}}" />
                        <ItemsControl x:Name="BansList" ItemsSource="{Binding Bans}" Margin="0,6,0,0" Focusable="False">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="{StaticResource Forest.Line}" BorderThickness="0,1,0,0" Padding="0,8" Margin="0,4,0,0">
                                        <DockPanel>
                                            <Button DockPanel.Dock="Right" Style="{StaticResource Action}" Content="{local:Tr players.unban}"
                                                    Command="{Binding DataContext.RemoveEntryCommand, ElementName=BansList}" CommandParameter="{Binding}"
                                                    IsEnabled="{Binding DataContext.CanEdit, ElementName=BansList}" />
                                            <StackPanel>
                                                <TextBlock Text="{Binding Name}" FontSize="13" Foreground="{StaticResource Forest.Text}" TextTrimming="CharacterEllipsis" />
                                                <TextBlock Text="{Binding Details}" FontSize="11" Foreground="{StaticResource Forest.Muted}" TextWrapping="Wrap" Margin="0,2,0,0" />
                                            </StackPanel>
                                        </DockPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
