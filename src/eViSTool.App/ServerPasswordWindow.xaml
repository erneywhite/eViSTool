<Window x:Class="eViSTool.App.ServerPasswordWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:eViSTool.App"
        Title="{local:Tr browse.passwordTitle}" Icon="Assets/eViSTool.ico"
        Width="420" SizeToContent="Height" ResizeMode="NoResize" Background="{StaticResource Forest.Base}"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <StackPanel Margin="24,20,24,22">
        <TextBlock x:Name="Heading" FontSize="18" FontWeight="SemiBold" Foreground="{StaticResource Forest.Text}" TextWrapping="Wrap" />
        <TextBlock Text="{local:Tr browse.passwordHint}" FontSize="12" Foreground="{StaticResource Forest.Muted}" TextWrapping="Wrap" Margin="0,6,0,12" />
        <PasswordBox x:Name="Box" Padding="8,6" AutomationProperties.AutomationId="ServerPassword" AutomationProperties.Name="{local:Tr browse.passwordTitle}" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
            <Button Content="{local:Tr common.done}" IsDefault="True" Click="Ok_Click" Padding="18,8" Style="{StaticResource Forest.PrimaryButton}" />
            <Button Content="{local:Tr common.cancel}" IsCancel="True" Margin="8,0,0,0" Padding="16,8" />
        </StackPanel>
    </StackPanel>
</Window>
