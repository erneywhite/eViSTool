<UserControl x:Class="eViSTool.App.ServerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:eViSTool.App"
             xmlns:vm="clr-namespace:eViSTool.App.ViewModels">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <local:EnumEqualsConverter x:Key="EnumEq" />
        <local:InvertBoolConverter x:Key="Invert" />
        <local:InvertBoolToVisibilityConverter x:Key="InvertVis" />
        <local:TextToVisibilityConverter x:Key="TextToVis" />

        <!-- плитка-показатель -->
        <Style x:Key="Tile" TargetType="Border" BasedOn="{StaticResource Forest.Card}">
            <Setter Property="Padding" Value="16,12" />
            <Setter Property="Margin" Value="0,0,12,0" />
        </Style>
        <Style x:Key="TileLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Foreground" Value="{StaticResource Forest.Muted}" />
        </Style>
        <Style x:Key="TileValue" TargetType="TextBlock">
            <Setter Property="FontSize" Value="20" />
            <Setter Property="Foreground" Value="{StaticResource Forest.Text}" />
            <Setter Property="Margin" Value="0,4,0,0" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>

        <!-- точка состояния сервера -->
        <Style x:Key="StateDot" TargetType="Ellipse">
            <Setter Property="Width" Value="9" />
            <Setter Property="Height" Value="9" />
            <Setter Property="Margin" Value="0,0,9,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Fill" Value="{StaticResource Forest.Muted}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding StateTone}" Value="{x:Static vm:RowTone.Good}">
                    <Setter Property="Fill" Value="{StaticResource Forest.Good}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding StateTone}" Value="{x:Static vm:RowTone.Update}">
                    <Setter Property="Fill" Value="{StaticResource Forest.Accent}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding StateTone}" Value="{x:Static vm:RowTone.Warn}">
                    <Setter Property="Fill" Value="{StaticResource Forest.Warn}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid Margin="10,4,10,0">
        <!-- ===== не серверный профиль ===== -->
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="520"
                    Visibility="{Binding IsServerProfile, Converter={StaticResource InvertVis}}">
            <Border Width="64" Height="64" CornerRadius="14" Background="{StaticResource Forest.Surface}" BorderBrush="{StaticResource Forest.Line}"
                    BorderThickness="1" HorizontalAlignment="Center" Margin="0,0,0,16">
                <Path Data="{StaticResource Icon.Server}" Style="{StaticResource Forest.Icon}" Stroke="{StaticResource Forest.Accent}" Width="28" Height="28" />
            </Border>
            <TextBlock Text="{local:Tr server.notServerTitle}" FontSize="18" FontWeight="SemiBold" TextAlignment="Center" Foreground="{StaticResource Forest.Text}" />
            <TextBlock Text="{local:Tr server.notServerHint}" Foreground="{StaticResource Forest.Muted}" TextWrapping="Wrap" TextAlignment="Center" Margin="0,8,0,0" />
            <Button Content="{local:Tr server.openSettings}" Command="{Binding OpenSettingsCommand}" HorizontalAlignment="Center" Margin="0,16,0,0" />
        </StackPanel>

        <DockPanel Visibility="{Binding IsServerProfile, Converter={StaticResource BoolToVis}}">
            <!-- ===== заголовок и управление ===== -->
            <DockPanel DockPanel.Dock="Top">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top">
                    <Button Command="{Binding OpenServerModsCommand}" Margin="0,0,8,0" ToolTip="{local:Tr server.serverMods}">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource Icon.Mods}" Style="{StaticResource Forest.Icon}" Width="14" Height="14" Margin="0,0,8,0" />
                            <TextBlock Text="{local:Tr server.serverMods}" />
                        </StackPanel>
                    </Button>
                    <Button Command="{Binding OpenLogsCommand}" Padding="10,8" Margin="0,0,16,0" ToolTip="{local:Tr server.logs}"
                            Visibility="{Binding IsRemoteProfile, Converter={StaticResource InvertVis}}">
                        <Path Data="{StaticResource Icon.Folder}" Style="{StaticResource Forest.Icon}" Width="16" Height="16" />
                    </Button>
                    <Button Content="{local:Tr server.start}" Command="{Binding StartCommand}" IsEnabled="{Binding CanStart}"
                            Style="{StaticResource Forest.PrimaryButton}" Padding="18,8" />
                    <Button Content="{local:Tr server.stop}" Command="{Binding StopCommand}" IsEnabled="{Binding CanStop}" Margin="8,0,0,0" />
                    <Button Content="{local:Tr server.restart}" Command="{Binding RestartCommand}" IsEnabled="{Binding CanStop}" Margin="8,0,0,0" />
                    <Button Content="{local:Tr server.kill}" Command="{Binding KillCommand}" IsEnabled="{Binding CanStop}" Margin="8,0,0,0"
                            Style="{StaticResource Forest.DangerButton}" ToolTip="{local:Tr server.killTip}" />
                </StackPanel>
                <StackPanel>
                    <TextBlock Text="{local:Tr nav.server}" Style="{StaticResource Forest.PageTitle}" />
                    <TextBlock Text="{Binding HeaderSubtitle}" ToolTip="{Binding DataDir}" Foreground="{StaticResource Forest.Accent}" FontSize="12"
                               Margin="0,4,0,0" TextTrimming="CharacterEllipsis" />
                </StackPanel>
            </DockPanel>

            <!-- ===== два вида раздела: консоль и редактор serverconfig.json ===== -->
            <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,16,0,0">
                <RadioButton Style="{StaticResource Forest.TabHeader}" GroupName="SrvMode" FontSize="15" Content="{local:Tr srvcfg.modeConsole}"
                             IsChecked="{Binding Tab, Converter={StaticResource EnumEq}, ConverterParameter=Console}"
                             AutomationProperties.AutomationId="SrvTabConsole" />
                <RadioButton Style="{StaticResource Forest.TabHeader}" GroupName="SrvMode" FontSize="15" Content="{local:Tr players.tab}"
                             IsChecked="{Binding Tab, Converter={StaticResource EnumEq}, ConverterParameter=Players}"
                             AutomationProperties.AutomationId="SrvTabPlayers" />
                <RadioButton Style="{StaticResource Forest.TabHeader}" GroupName="SrvMode" FontSize="15" Content="{local:Tr ann.tab}"
                             IsChecked="{Binding Tab, Converter={StaticResource EnumEq}, ConverterParameter=Announcements}"
                             AutomationProperties.AutomationId="SrvTabAnnouncements" />
                <RadioButton Style="{StaticResource Forest.TabHeader}" GroupName="SrvMode" FontSize="15"
                             IsChecked="{Binding Tab, Converter={StaticResource EnumEq}, ConverterParameter=Config}"
                             AutomationProperties.Name="{local:Tr srvcfg.modeConfig}" AutomationProperties.AutomationId="SrvTabConfig">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{local:Tr srvcfg.modeConfig}" />
                        <!-- в конфигурации есть несохранённые правки -->
                        <Ellipse Width="7" Height="7" Margin="7,2,0,0" VerticalAlignment="Center" Fill="{StaticResource Forest.Accent}"
                                 ToolTip="{local:Tr srvcfg.modified}"
                                 Visibility="{Binding Config.IsDirty, Converter={StaticResource BoolToVis}}" />
                    </StackPanel>
                </RadioButton>
                <RadioButton Style="{StaticResource Forest.TabHeader}" GroupName="SrvMode" FontSize="15" Content="{local:Tr sched.tab}"
                             IsChecked="{Binding Tab, Converter={StaticResource EnumEq}, ConverterParameter=Schedule}"
                             AutomationProperties.AutomationId="SrvTabSchedule" />
                <RadioButton Style="{StaticResource Forest.TabHeader}" GroupName="SrvMode" FontSize="15" Content="{local:Tr remote.tab}"
                             Visibility="{Binding IsRemoteProfile, Converter={StaticResource InvertVis}}"
                             IsChecked="{Binding Tab, Converter={StaticResource EnumEq}, ConverterParameter=Remote}"
                             AutomationProperties.AutomationId="SrvTabRemote" />
            </StackPanel>

            <!-- ===== показатели ===== -->
            <Grid DockPanel.Dock="Top" Margin="0,18,-12,0" Visibility="{Binding IsConsoleTab, Converter={StaticResource BoolToVis}}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.3*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Style="{StaticResource Tile}">
                    <StackPanel>
                        <TextBlock Text="{local:Tr server.tileState}" Style="{StaticResource TileLabel}" />
                        <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                            <Ellipse Style="{StaticResource StateDot}" />
                            <TextBlock Text="{Binding StateText}" Style="{StaticResource TileValue}" Margin="0" />
                        </StackPanel>
                        <TextBlock Text="{Binding StateNote}" FontSize="11" Foreground="{StaticResource Forest.Muted}" Margin="0,2,0,0"
                                   Visibility="{Binding StateNote, Converter={StaticResource TextToVis}}" />
                    </StackPanel>
                </Border>
                <Border Grid.Column="1" Style="{StaticResource Tile}">
                    <StackPanel>
                        <TextBlock Text="{local:Tr server.tileUptime}" Style="{StaticResource TileLabel}" />
                        <TextBlock Text="{Binding UptimeText}" Style="{StaticResource TileValue}" />
                    </StackPanel>
                </Border>
                <Border Grid.Column="2" Style="{StaticResource Tile}">
                    <StackPanel>
                        <TextBlock Text="{local:Tr server.tileMemory}" Style="{StaticResource TileLabel}" />
                        <TextBlock Text="{Binding MemoryText}" Style="{StaticResource TileValue}" />
                        <!-- номер процесса сервера — мелко: нужен редко (диспетчер задач) -->
                        <TextBlock FontSize="11" Foreground="{StaticResource Forest.Muted}" Margin="0,2,0,0">
                            <Run Text="PID" /><Run Text=" " /><Run Text="{Binding PidText, Mode=OneWay}" />
                        </TextBlock>
                    </StackPanel>
                </Border>
                <!-- кто на сервере: число, имена; подсказка — кто с какого времени -->
                <Border Grid.Column="3" Style="{StaticResource Tile}" ToolTip="{Binding PlayersTip}" ToolTipService.ShowDuration="60000"
                        AutomationProperties.AutomationId="SrvPlayers">
                    <StackPanel>
                        <TextBlock Text="{local:Tr server.tilePlayers}" Style="{StaticResource TileLabel}" />
                        <TextBlock Text="{Binding PlayersText}" Style="{StaticResource TileValue}" />
                        <TextBlock Text="{Binding PlayerNames}" FontSize="11" Foreground="{StaticResource Forest.Muted}" Margin="0,2,0,0"
                                   TextTrimming="CharacterEllipsis" Visibility="{Binding PlayerNames, Converter={StaticResource TextToVis}}" />
                    </StackPanel>
                </Border>
            </Grid>

            <!-- ===== сервер, запущенный не нами ===== -->
            <Border DockPanel.Dock="Top" Style="{StaticResource Forest.Warning}" Margin="0,14,0,0"
                    Visibility="{Binding HasForeign, Converter={StaticResource BoolToVis}}">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Margin="12,0,0,0" VerticalAlignment="Center">
                        <Button Content="{local:Tr server.stopForeign}" Command="{Binding StopForeignCommand}" Padding="12,5" MinHeight="0" FontSize="12"
                                ToolTip="{local:Tr server.stopForeignTip}" />
                        <Button Content="{local:Tr server.kill}" Command="{Binding KillForeignCommand}" Padding="12,5" MinHeight="0" FontSize="12" Margin="8,0,0,0"
                                Style="{StaticResource Forest.DangerButton}" />
                    </StackPanel>
                    <Path DockPanel.Dock="Left" Data="{StaticResource Icon.Warning}" Style="{StaticResource Forest.Icon}" Stroke="{StaticResource Forest.Warn}"
                          VerticalAlignment="Center" Margin="0,0,12,0" />
                    <TextBlock Text="{Binding ForeignText}" TextWrapping="Wrap" VerticalAlignment="Center" Foreground="{StaticResource Forest.Warn}" FontSize="13" />
                </DockPanel>
            </Border>

            <!-- ===== ошибка последнего действия ===== -->
            <TextBlock DockPanel.Dock="Top" Text="{Binding ErrorText}" Foreground="{StaticResource Forest.Danger}" TextWrapping="Wrap" Margin="0,12,0,0"
                       Visibility="{Binding ErrorText, Converter={StaticResource TextToVis}}" />
            <TextBlock DockPanel.Dock="Top" Text="{Binding AgentNote}" Foreground="{StaticResource Forest.Warn}" TextWrapping="Wrap" Margin="0,12,0,0"
                       Visibility="{Binding AgentNote, Converter={StaticResource TextToVis}}" AutomationProperties.AutomationId="AgentNote" />

            <!-- остаток места: консоль или редактор конфигурации -->
            <Grid>
            <!-- ===== конфигурация (вместо плиток и консоли) ===== -->
            <Grid Visibility="{Binding IsConfigTab, Converter={StaticResource BoolToVis}}">
                <local:ServerConfigView DataContext="{Binding Config}" />
            </Grid>

            <!-- ===== игроки ===== -->
            <Grid Visibility="{Binding IsPlayersTab, Converter={StaticResource BoolToVis}}">
                <local:ServerPlayersTab DataContext="{Binding Players}" />
            </Grid>

            <!-- ===== объявления ===== -->
            <Grid Visibility="{Binding IsAnnouncementsTab, Converter={StaticResource BoolToVis}}">
                <local:ServerAnnouncementsTab DataContext="{Binding Announcements}" />
            </Grid>

            <!-- ===== удалённый доступ ===== -->
            <Grid Visibility="{Binding IsRemoteTab, Converter={StaticResource BoolToVis}}">
                <local:ServerRemoteView DataContext="{Binding Remote}" />
            </Grid>

            <!-- ===== расписание: резервные копии ===== -->
            <Grid Visibility="{Binding IsScheduleTab, Converter={StaticResource BoolToVis}}">
                <local:ServerScheduleView DataContext="{Binding Schedule}" />
            </Grid>

            <!-- ===== консоль ===== -->
            <Border Style="{StaticResource Forest.Card}" Margin="0,14,0,12" ClipToBounds="True"
                    Visibility="{Binding IsConsoleTab, Converter={StaticResource BoolToVis}}">
                <DockPanel>
                    <DockPanel DockPanel.Dock="Top" Margin="16,10,10,8">
                        <Button DockPanel.Dock="Right" Content="{local:Tr server.clear}" Command="{Binding ClearConsoleCommand}" Padding="12,4" MinHeight="0" FontSize="12" />
                        <Button DockPanel.Dock="Right" Content="{local:Tr cmds.button}" Command="{Binding ShowCommandsCommand}" Padding="12,4" MinHeight="0" FontSize="12"
                                Margin="0,0,8,0" ToolTip="{local:Tr cmds.buttonTip}" AutomationProperties.AutomationId="SrvCommands" />
                        <!-- копия мира сейчас — та же команда, что на вкладке «Расписание» -->
                        <Button DockPanel.Dock="Right" Command="{Binding Schedule.BackupNowCommand}" Padding="12,4" MinHeight="0" FontSize="12" Margin="0,0,8,0"
                                ToolTip="{local:Tr sched.nowTip}" ToolTipService.ShowOnDisabled="True" AutomationProperties.AutomationId="SrvBackupNow">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource Icon.Download}" Style="{StaticResource Forest.Icon}" Width="12" Height="12" Margin="0,0,7,0" />
                                <TextBlock Text="{local:Tr server.backupNow}" />
                            </StackPanel>
                        </Button>
                        <TextBlock DockPanel.Dock="Left" Text="{local:Tr server.console}" Foreground="{StaticResource Forest.Text}" FontWeight="SemiBold" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding Schedule.StatusText}" FontSize="12" Foreground="{StaticResource Forest.Accent}" VerticalAlignment="Center"
                                   Margin="16,0,16,0" TextTrimming="CharacterEllipsis" ToolTip="{Binding Schedule.StatusText}" />
                    </DockPanel>

                    <!-- ввод команды: Enter — отправить, ↑/↓ — история (или подсказки, если они открыты), Tab — дописать команду -->
                    <Border DockPanel.Dock="Bottom" BorderBrush="{StaticResource Forest.Line}" BorderThickness="0,1,0,0" Padding="10">
                        <DockPanel>
                            <!-- что ждёт набранная команда: «/tp <source> <target> — Teleport…» -->
                            <TextBlock DockPanel.Dock="Bottom" Text="{Binding ArgsHint}" FontFamily="Cascadia Mono, Consolas" FontSize="11"
                                       Foreground="{StaticResource Forest.Muted}" Margin="29,6,0,0" TextTrimming="CharacterEllipsis"
                                       ToolTip="{Binding ArgsHint}" Visibility="{Binding ArgsHint, Converter={StaticResource TextToVis}}"
                                       AutomationProperties.AutomationId="SrvArgsHint" />
                            <Button DockPanel.Dock="Right" Content="{local:Tr server.send}" Command="{Binding SendCommandCommand}" IsEnabled="{Binding CanCommand}"
                                    Style="{StaticResource Forest.PrimaryButton}" Margin="8,0,0,0" />
                            <Grid>
                                <TextBox x:Name="CommandBox" Text="{Binding CommandText, UpdateSourceTrigger=PropertyChanged}" FontFamily="Cascadia Mono, Consolas"
                                         IsEnabled="{Binding CanCommand}" PreviewKeyDown="CommandBox_PreviewKeyDown" VerticalContentAlignment="Center"
                                         LostKeyboardFocus="CommandBox_LostKeyboardFocus"
                                         Padding="28,7,10,7" ToolTip="{local:Tr server.commandTip}" AutomationProperties.AutomationId="SrvCommandBox" />
                                <!-- подсказки команд — над полем: оно внизу окна -->
                                <Popup x:Name="SuggestionPopup" IsOpen="{Binding ShowSuggestions}" PlacementTarget="{Binding ElementName=CommandBox}" Placement="Top"
                                       AllowsTransparency="True" StaysOpen="True" Focusable="False" VerticalOffset="-4">
                                    <Border Background="{StaticResource Forest.Surface}" BorderBrush="{StaticResource Forest.Line}" BorderThickness="1"
                                            CornerRadius="6" Padding="4" MinWidth="{Binding ActualWidth, ElementName=CommandBox}" MaxWidth="900">
                                        <ListBox x:Name="SuggestionList" ItemsSource="{Binding Suggestions}" SelectedItem="{Binding SelectedSuggestion}"
                                                 Background="Transparent" BorderThickness="0" Focusable="False"
                                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled" PreviewMouseLeftButtonUp="SuggestionList_Click"
                                                 AutomationProperties.AutomationId="SrvSuggestions">
                                            <ListBox.ItemContainerStyle>
                                                <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                                                    <Setter Property="Focusable" Value="False" />
                                                    <Setter Property="Padding" Value="8,3" />
                                                </Style>
                                            </ListBox.ItemContainerStyle>
                                            <ListBox.ItemTemplate>
                                                <DataTemplate>
                                                    <DockPanel>
                                                        <TextBlock DockPanel.Dock="Left" Text="{Binding Usage}" FontFamily="Cascadia Mono, Consolas" FontSize="12"
                                                                   Foreground="{StaticResource Forest.Text}" />
                                                        <TextBlock Text="{Binding Description}" FontSize="11" Foreground="{StaticResource Forest.Muted}"
                                                                   Margin="14,0,0,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                                    </DockPanel>
                                                </DataTemplate>
                                            </ListBox.ItemTemplate>
                                        </ListBox>
                                    </Border>
                                </Popup>
                                <TextBlock Text="›" FontSize="16" Foreground="{StaticResource Forest.Accent}" Margin="12,0,0,1" VerticalAlignment="Center"
                                           IsHitTestVisible="False" />
                                <TextBlock Text="{local:Tr server.commandPlaceholder}" Foreground="{StaticResource Forest.Muted}" Margin="29,0,0,0"
                                           VerticalAlignment="Center" IsHitTestVisible="False" FontFamily="Cascadia Mono, Consolas" FontSize="12">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Opacity" Value="0" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding CommandText}" Value="">
                                                    <Setter Property="Opacity" Value="0.8" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Grid>
                        </DockPanel>
                    </Border>

                    <Border Background="#151C17" BorderBrush="{StaticResource Forest.Line}" BorderThickness="0,1,0,0" Padding="6,4">
                        <ListBox x:Name="ConsoleList" ItemsSource="{Binding Lines}" Background="Transparent" BorderThickness="0"
                                 FontFamily="Cascadia Mono, Consolas" FontSize="12.5"
                                 VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled" SelectionMode="Extended">
                            <ListBox.Resources>
                                <Thickness x:Key="ListBoxItemPadding">6,1</Thickness>
                                <SolidColorBrush x:Key="ListBoxItemSelectedBackgroundThemeBrush" Color="#394432" />
                                <SolidColorBrush x:Key="ListBoxItemSelectedBackgroundPointerOverThemeBrush" Color="#414D39" />
                                <SolidColorBrush x:Key="ListBoxItemSelectedForegroundThemeBrush" Color="#E7E9DD" />
                            </ListBox.Resources>
                            <ListBox.ContextMenu>
                                <ContextMenu>
                                    <MenuItem Header="{local:Tr server.copy}" Click="CopyLines_Click" />
                                </ContextMenu>
                            </ListBox.ContextMenu>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Text}" TextWrapping="Wrap" Opacity="{Binding Opacity}">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="#D8DCCF" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Foreground, Converter={x:Static local:IsNotNullConverter.Instance}}" Value="True">
                                                        <Setter Property="Foreground" Value="{Binding Foreground}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Border>
                </DockPanel>
            </Border>
            </Grid>
        </DockPanel>
    </Grid>
</UserControl>
