<Window x:Class="eViSTool.App.DuplicateRoleWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:eViSTool.App"
        Title="{local:Tr roles.dupTitle}" Icon="Assets/eViSTool.ico"
        Width="460" SizeToContent="Height" ResizeMode="NoResize" Background="{StaticResource Forest.Base}"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <Window.Resources>
        <Style x:Key="Label" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{StaticResource Forest.Text}" />
            <Setter Property="Margin" Value="0,16,0,0" />
        </Style>
        <Style x:Key="Hint" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Foreground" Value="{StaticResource Forest.Muted}" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="0,2,0,0" />
        </Style>
    </Window.Resources>

    <StackPanel Margin="24,20,24,22">
        <TextBlock x:Name="Heading" FontSize="20" FontWeight="SemiBold" Foreground="{StaticResource Forest.Text}" TextWrapping="Wrap" />
        <TextBlock Text="{local:Tr roles.dupIntro}" Style="{StaticResource Hint}" FontSize="12" Margin="0,4,0,0" />

        <TextBlock Text="{local:Tr roles.dupCode}" Style="{StaticResource Label}" />
        <TextBlock Text="{local:Tr roles.dupCodeHint}" Style="{StaticResource Hint}" Margin="0,2,0,6" />
        <TextBox x:Name="CodeBox" FontFamily="Consolas" MaxLength="60" TextChanged="CodeBox_TextChanged"
                 AutomationProperties.AutomationId="DuplicateCode" AutomationProperties.Name="{local:Tr roles.dupCode}" />
        <TextBlock x:Name="ErrorText" Foreground="{StaticResource Forest.Danger}" TextWrapping="Wrap" FontSize="11" Margin="0,4,0,0"
                   Visibility="Collapsed" />

        <TextBlock Text="{local:Tr roles.dupName}" Style="{StaticResource Label}" />
        <TextBox x:Name="NameBox" Margin="0,6,0,0" MaxLength="80"
                 AutomationProperties.AutomationId="DuplicateName" AutomationProperties.Name="{local:Tr roles.dupName}" />

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button x:Name="GoButton" Content="{local:Tr roles.dupGo}" IsDefault="True" Click="Go_Click" Padding="18,8"
                    Style="{StaticResource Forest.PrimaryButton}" AutomationProperties.AutomationId="DuplicateOk" />
            <Button Content="{local:Tr common.cancel}" IsCancel="True" Margin="8,0,0,0" Padding="16,8"
                    AutomationProperties.AutomationId="DuplicateCancel" />
        </StackPanel>
    </StackPanel>
</Window>
