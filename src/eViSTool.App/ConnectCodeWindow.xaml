<Window x:Class="eViSTool.App.ConnectCodeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:eViSTool.App"
        Icon="Assets/eViSTool.ico" Width="560" SizeToContent="Height" ResizeMode="NoResize"
        Background="{StaticResource Forest.Base}" WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Title="{local:Tr connect.title}">
    <StackPanel Margin="24,20,24,22">
        <TextBlock Text="{local:Tr connect.title}" FontSize="20" FontWeight="SemiBold" Foreground="{StaticResource Forest.Text}" />
        <TextBlock Text="{local:Tr connect.hint}" FontSize="12" Foreground="{StaticResource Forest.Muted}" TextWrapping="Wrap" Margin="0,4,0,0" />

        <TextBlock Text="{local:Tr connect.code}" FontSize="12" Foreground="{StaticResource Forest.Text}" Margin="0,16,0,0" />
        <!-- код — секрет: поле скрытое, как для пароля -->
        <DockPanel Margin="0,6,0,0">
            <Button DockPanel.Dock="Right" Content="{local:Tr connect.paste}" Click="Paste_Click" Margin="8,0,0,0"
                    ToolTip="{local:Tr connect.pasteTip}" AutomationProperties.AutomationId="ConnectPaste" />
            <PasswordBox x:Name="CodeBox" PasswordChanged="CodeBox_PasswordChanged" VerticalContentAlignment="Center"
                         AutomationProperties.AutomationId="ConnectCode" />
        </DockPanel>
        <TextBlock x:Name="ParsedText" FontSize="11" Foreground="{StaticResource Forest.Muted}" TextWrapping="Wrap" Margin="0,6,0,0" />

        <DockPanel Margin="0,12,0,0">
            <Button x:Name="CheckButton" DockPanel.Dock="Left" Content="{local:Tr connect.check}" Click="Check_Click" IsEnabled="False"
                    AutomationProperties.AutomationId="ConnectCheck" />
            <TextBlock x:Name="CheckText" FontSize="12" TextWrapping="Wrap" VerticalAlignment="Center" Margin="12,0,0,0"
                       AutomationProperties.AutomationId="ConnectResult" />
        </DockPanel>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button x:Name="OkButton" IsDefault="True" Click="Ok_Click" Padding="18,8" IsEnabled="False"
                    Style="{StaticResource Forest.PrimaryButton}" AutomationProperties.AutomationId="ConnectOk" />
            <Button Content="{local:Tr common.cancel}" IsCancel="True" Margin="8,0,0,0" Padding="16,8" />
        </StackPanel>
    </StackPanel>
</Window>
