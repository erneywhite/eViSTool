<Window x:Class="eViSTool.App.BanWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:eViSTool.App"
        Title="{local:Tr players.banTitle}" Icon="Assets/eViSTool.ico"
        Width="460" SizeToContent="Height" ResizeMode="NoResize" Background="{StaticResource Forest.Base}"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <Window.Resources>
        <Style x:Key="Label" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{StaticResource Forest.Text}" />
            <Setter Property="Margin" Value="0,16,0,0" />
        </Style>
    </Window.Resources>

    <StackPanel Margin="24,20,24,22">
        <TextBlock x:Name="Heading" FontSize="20" FontWeight="SemiBold" Foreground="{StaticResource Forest.Text}" TextWrapping="Wrap" />

        <TextBlock Text="{local:Tr players.banFor}" Style="{StaticResource Label}" />
        <WrapPanel Margin="0,8,0,0">
            <RadioButton x:Name="Hour" Style="{StaticResource Forest.Chip}" GroupName="BanTerm" Content="{local:Tr players.banHour}"
                         AutomationProperties.AutomationId="BanHour" />
            <RadioButton x:Name="Day" Style="{StaticResource Forest.Chip}" GroupName="BanTerm" Content="{local:Tr players.banDay}" IsChecked="True"
                         AutomationProperties.AutomationId="BanDay" />
            <RadioButton x:Name="Week" Style="{StaticResource Forest.Chip}" GroupName="BanTerm" Content="{local:Tr players.banWeek}"
                         AutomationProperties.AutomationId="BanWeek" />
            <RadioButton x:Name="Month" Style="{StaticResource Forest.Chip}" GroupName="BanTerm" Content="{local:Tr players.banMonth}"
                         AutomationProperties.AutomationId="BanMonth" />
            <RadioButton x:Name="Forever" Style="{StaticResource Forest.Chip}" GroupName="BanTerm" Content="{local:Tr players.banForever}"
                         AutomationProperties.AutomationId="BanForever" />
        </WrapPanel>

        <TextBlock Text="{local:Tr players.banReason}" Style="{StaticResource Label}" />
        <TextBox x:Name="ReasonBox" Margin="0,6,0,0" MaxLength="200"
                 AutomationProperties.AutomationId="BanReason" AutomationProperties.Name="{local:Tr players.banReason}" />

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button Content="{local:Tr players.banGo}" IsDefault="True" Click="Go_Click" Padding="18,8"
                    Style="{StaticResource Forest.PrimaryButton}" AutomationProperties.AutomationId="BanOk" />
            <Button Content="{local:Tr common.cancel}" IsCancel="True" Margin="8,0,0,0" Padding="16,8"
                    AutomationProperties.AutomationId="BanCancel" />
        </StackPanel>
    </StackPanel>
</Window>
