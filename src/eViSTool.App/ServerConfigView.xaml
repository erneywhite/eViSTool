<UserControl x:Class="eViSTool.App.ServerConfigView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:eViSTool.App"
             xmlns:vm="clr-namespace:eViSTool.App.ViewModels">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <local:InvertBoolToVisibilityConverter x:Key="InvertVis" />
        <local:TextToVisibilityConverter x:Key="TextToVis" />
        <local:EnumEqualsConverter x:Key="EnumEq" />
        <local:EnumToVisibilityConverter x:Key="EnumVis" />

        <!-- карточка группы полей -->
        <Style x:Key="CardBox" TargetType="Border" BasedOn="{StaticResource Forest.Card}">
            <Setter Property="Padding" Value="20,16,20,6" />
            <Setter Property="Margin" Value="0,0,0,14" />
        </Style>
        <Style x:Key="CardTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{StaticResource Forest.Text}" />
        </Style>
        <Style x:Key="Hint" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Foreground" Value="{StaticResource Forest.Muted}" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <!-- имя поля в JSON: мелко и моноширинно -->
        <Style x:Key="JsonName" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Cascadia Mono, Consolas" />
            <Setter Property="FontSize" Value="10.5" />
            <Setter Property="Foreground" Value="#8A9786" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <!-- точка «изменено, но не сохранено»: стоит в левом поле карточки (отступ −14 + ширина 7 + 7 = 0), подпись не сдвигает -->
        <Style x:Key="ModifiedDot" TargetType="Ellipse">
            <Setter Property="Width" Value="7" />
            <Setter Property="Height" Value="7" />
            <Setter Property="Margin" Value="-14,6,7,0" />
            <Setter Property="VerticalAlignment" Value="Top" />
            <Setter Property="Fill" Value="{StaticResource Forest.Accent}" />
        </Style>
        <!-- пометка у поля: «только при создании мира», «устарело» -->
        <Style x:Key="Badge" TargetType="Border">
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="Padding" Value="6,1" />
            <Setter Property="Margin" Value="0,5,6,0" />
            <Setter Property="Background" Value="{StaticResource Forest.Raised}" />
        </Style>

        <!-- статус в нижней полосе: цвет по тону -->
        <Style x:Key="StatusDot" TargetType="Ellipse">
            <Setter Property="Width" Value="8" />
            <Setter Property="Height" Value="8" />
            <Setter Property="Margin" Value="0,0,8,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Fill" Value="{StaticResource Forest.Muted}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding StatusTone}" Value="{x:Static vm:RowTone.Good}">
                    <Setter Property="Fill" Value="{StaticResource Forest.Good}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding StatusTone}" Value="{x:Static vm:RowTone.Update}">
                    <Setter Property="Fill" Value="{StaticResource Forest.Accent}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding StatusTone}" Value="{x:Static vm:RowTone.Danger}">
                    <Setter Property="Fill" Value="{StaticResource Forest.Danger}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="StatusLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            <Setter Property="Foreground" Value="{StaticResource Forest.Muted}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding StatusTone}" Value="{x:Static vm:RowTone.Good}">
                    <Setter Property="Foreground" Value="{StaticResource Forest.Good}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding StatusTone}" Value="{x:Static vm:RowTone.Update}">
                    <Setter Property="Foreground" Value="{StaticResource Forest.Accent}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding StatusTone}" Value="{x:Static vm:RowTone.Danger}">
                    <Setter Property="Foreground" Value="{StaticResource Forest.Danger}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- ===== редакторы значений: шаблон выбирается по типу модели поля ===== -->

        <!-- строка -->
        <DataTemplate DataType="{x:Type vm:ConfigTextFieldViewModel}">
            <TextBox x:Name="Box" Text="{Binding Text, UpdateSourceTrigger=PropertyChanged}" IsReadOnly="{Binding IsReadOnly}"
                     VerticalContentAlignment="Center"
                     AutomationProperties.Name="{Binding Label}" AutomationProperties.AutomationId="{Binding Path}" />
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsReadOnly}" Value="True">
                    <Setter TargetName="Box" Property="Opacity" Value="0.7" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!-- число: то же поле, но узкое -->
        <DataTemplate DataType="{x:Type vm:ConfigNumberFieldViewModel}">
            <TextBox x:Name="Box" Text="{Binding Text, UpdateSourceTrigger=PropertyChanged}" IsReadOnly="{Binding IsReadOnly}"
                     Width="200" HorizontalAlignment="Left" VerticalContentAlignment="Center"
                     AutomationProperties.Name="{Binding Label}" AutomationProperties.AutomationId="{Binding Path}" />
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsReadOnly}" Value="True">
                    <Setter TargetName="Box" Property="Opacity" Value="0.7" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!-- несколько строк; список — по одной записи в строке; сырой JSON — моноширинный, без переноса -->
        <DataTemplate DataType="{x:Type vm:ConfigMultilineFieldViewModel}">
            <TextBox x:Name="Box" Text="{Binding Text, UpdateSourceTrigger=PropertyChanged}" IsReadOnly="{Binding IsReadOnly}"
                     AcceptsReturn="True" TextWrapping="Wrap" MinLines="3" MaxLines="12" VerticalScrollBarVisibility="Auto"
                     VerticalContentAlignment="Top"
                     AutomationProperties.Name="{Binding Label}" AutomationProperties.AutomationId="{Binding Path}" />
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsList}" Value="True">
                    <Setter TargetName="Box" Property="MinLines" Value="2" />
                    <Setter TargetName="Box" Property="TextWrapping" Value="NoWrap" />
                    <Setter TargetName="Box" Property="HorizontalScrollBarVisibility" Value="Auto" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsJson}" Value="True">
                    <Setter TargetName="Box" Property="MinLines" Value="1" />
                    <Setter TargetName="Box" Property="TextWrapping" Value="NoWrap" />
                    <Setter TargetName="Box" Property="HorizontalScrollBarVisibility" Value="Auto" />
                    <Setter TargetName="Box" Property="FontFamily" Value="Cascadia Mono, Consolas" />
                    <Setter TargetName="Box" Property="FontSize" Value="12.5" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsReadOnly}" Value="True">
                    <Setter TargetName="Box" Property="Opacity" Value="0.7" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!-- путь к файлу -->
        <DataTemplate DataType="{x:Type vm:ConfigPathFieldViewModel}">
            <DockPanel>
                <Button DockPanel.Dock="Right" Content="{local:Tr common.browse}" Command="{Binding BrowseCommand}" IsEnabled="{Binding IsEditable}"
                        Margin="8,0,0,0" VerticalAlignment="Top" />
                <!-- длинный путь в поле не помещается — целиком он в подсказке -->
                <TextBox x:Name="Box" Text="{Binding Text, UpdateSourceTrigger=PropertyChanged}" IsReadOnly="{Binding IsReadOnly}"
                         VerticalContentAlignment="Center" ToolTip="{Binding Text}"
                         AutomationProperties.Name="{Binding Label}" AutomationProperties.AutomationId="{Binding Path}" />
            </DockPanel>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsReadOnly}" Value="True">
                    <Setter TargetName="Box" Property="Opacity" Value="0.7" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!-- переключатель -->
        <DataTemplate DataType="{x:Type vm:ConfigBoolFieldViewModel}">
            <CheckBox Style="{StaticResource Forest.Switch}" IsChecked="{Binding Value}" IsEnabled="{Binding IsEditable}"
                      HorizontalAlignment="Left" Margin="0,2,0,0"
                      AutomationProperties.Name="{Binding Label}" AutomationProperties.AutomationId="{Binding Path}" />
        </DataTemplate>

        <!-- выбор: подпись и (если отличается) то, что запишется в файл -->
        <DataTemplate DataType="{x:Type vm:ConfigChoiceFieldViewModel}">
            <ComboBox ItemsSource="{Binding Options}" SelectedItem="{Binding Selected}" IsEnabled="{Binding IsEditable}"
                      HorizontalAlignment="Stretch"
                      AutomationProperties.Name="{Binding Label}" AutomationProperties.AutomationId="{Binding Path}">
                <ComboBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock TextTrimming="CharacterEllipsis">
                            <Run Text="{Binding Label, Mode=OneWay}" /><Run Text="   " /><Run Text="{Binding Code, Mode=OneWay}" FontFamily="Cascadia Mono, Consolas" FontSize="11" Foreground="{StaticResource Forest.Muted}" />
                        </TextBlock>
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>
        </DataTemplate>

        <!-- служебное: только посмотреть и скопировать -->
        <DataTemplate DataType="{x:Type vm:ConfigReadOnlyFieldViewModel}">
            <TextBox Style="{StaticResource Forest.SelectableText}" Text="{Binding Text, Mode=OneWay}" FontFamily="Cascadia Mono, Consolas"
                     Margin="0,2,0,0"
                     AutomationProperties.Name="{Binding Label}" AutomationProperties.AutomationId="{Binding Path}" />
        </DataTemplate>

        <!-- ===== строка поля: слева подпись, имя в JSON, пометки и подсказка; справа редактор и ошибка ===== -->
        <DataTemplate x:Key="FieldRow">
            <Border BorderBrush="{StaticResource Forest.Line}" BorderThickness="0,1,0,0" Padding="0,12"
                    Visibility="{Binding IsVisible, Converter={StaticResource BoolToVis}}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="42*" />
                        <ColumnDefinition Width="58*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Margin="0,0,24,0">
                        <DockPanel>
                            <Ellipse DockPanel.Dock="Left" Style="{StaticResource ModifiedDot}" ToolTip="{local:Tr srvcfg.modified}"
                                     Visibility="{Binding IsModified, Converter={StaticResource BoolToVis}}" />
                            <TextBlock Text="{Binding Label}" FontSize="13" Foreground="{StaticResource Forest.Text}" TextWrapping="Wrap" />
                        </DockPanel>
                        <TextBlock Text="{Binding Path}" Style="{StaticResource JsonName}" Margin="0,2,0,0"
                                   Visibility="{Binding ShowPath, Converter={StaticResource BoolToVis}}" />
                        <WrapPanel>
                            <Border Style="{StaticResource Badge}" ToolTip="{local:Tr srvcfg.badgeWorldCreationTip}"
                                    Visibility="{Binding IsWorldCreationOnly, Converter={StaticResource BoolToVis}}">
                                <TextBlock Text="{local:Tr srvcfg.badgeWorldCreation}" FontSize="10.5" Foreground="{StaticResource Forest.Warn}" />
                            </Border>
                            <Border Style="{StaticResource Badge}" ToolTip="{local:Tr srvcfg.badgeLegacyTip}"
                                    Visibility="{Binding IsLegacy, Converter={StaticResource BoolToVis}}">
                                <TextBlock Text="{local:Tr srvcfg.badgeLegacy}" FontSize="10.5" Foreground="{StaticResource Forest.Muted}" />
                            </Border>
                        </WrapPanel>
                        <TextBlock Text="{Binding Hint}" Style="{StaticResource Hint}" Margin="0,5,0,0"
                                   Visibility="{Binding Hint, Converter={StaticResource TextToVis}}" />
                    </StackPanel>
                    <StackPanel Grid.Column="1">
                        <ContentPresenter Content="{Binding}" />
                        <TextBlock Text="{Binding Error}" Foreground="{StaticResource Forest.Danger}" FontSize="12" TextWrapping="Wrap" Margin="0,5,0,0"
                                   Visibility="{Binding Error, Converter={StaticResource TextToVis}}" />
                    </StackPanel>
                </Grid>
            </Border>
        </DataTemplate>

        <!-- ===== группа полей — карточка с заголовком ===== -->
        <DataTemplate x:Key="GroupTemplate">
            <Border Style="{StaticResource CardBox}" Visibility="{Binding IsVisible, Converter={StaticResource BoolToVis}}">
                <StackPanel>
                    <TextBlock Text="{Binding Title}" Style="{StaticResource CardTitle}" Margin="0,0,0,12" />
                    <ItemsControl ItemsSource="{Binding Fields}" ItemTemplate="{StaticResource FieldRow}" Focusable="False" />
                </StackPanel>
            </Border>
        </DataTemplate>

        <!-- ===== строка таблицы «Настройки мира» ===== -->
        <DataTemplate x:Key="WorldSettingRow">
            <Border BorderBrush="{StaticResource Forest.Line}" BorderThickness="0,1,0,0" Padding="0,12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="42*" />
                        <ColumnDefinition Width="58*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- ключ: известные игре — из списка (по категориям), любой другой — вписать руками -->
                    <DockPanel Margin="0,0,24,0">
                        <Ellipse DockPanel.Dock="Left" Style="{StaticResource ModifiedDot}" Margin="-14,13,7,0" ToolTip="{local:Tr srvcfg.modified}"
                                 Visibility="{Binding IsModified, Converter={StaticResource BoolToVis}}" />
                        <ComboBox IsEditable="True" IsSynchronizedWithCurrentItem="False" ItemsSource="{Binding KeyOptions}"
                                  TextSearch.TextPath="Key" Text="{Binding Key, UpdateSourceTrigger=PropertyChanged}"
                                  IsEnabled="{Binding IsEditable}" HorizontalAlignment="Stretch" MaxDropDownHeight="420"
                                  ToolTip="{local:Tr srvcfg.wsKeyTip}"
                                  AutomationProperties.Name="{local:Tr srvcfg.wsKey}" AutomationProperties.AutomationId="{Binding KeyAutomationId}">
                            <ComboBox.GroupStyle>
                                <GroupStyle>
                                    <GroupStyle.HeaderTemplate>
                                        <DataTemplate>
                                            <!-- подпись категории берём у первого ключа группы: она меняется с языком, а сама группа — по коду -->
                                            <TextBlock Text="{Binding Items[0].CategoryLabel}" FontSize="11" FontWeight="SemiBold"
                                                       Foreground="{StaticResource Forest.Accent}" Margin="12,10,12,4" />
                                        </DataTemplate>
                                    </GroupStyle.HeaderTemplate>
                                </GroupStyle>
                            </ComboBox.GroupStyle>
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock>
                                        <Run Text="{Binding Label, Mode=OneWay}" /><Run Text="   " /><Run Text="{Binding KeyNote, Mode=OneWay}" FontFamily="Cascadia Mono, Consolas" FontSize="11" Foreground="{StaticResource Forest.Muted}" />
                                    </TextBlock>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                    </DockPanel>

                    <!-- значение: для известных Choice/Bool — список, иначе текст -->
                    <DockPanel Grid.Column="1">
                        <Button DockPanel.Dock="Right" Command="{Binding RemoveCommand}" IsEnabled="{Binding IsEditable}" Padding="10,8" Margin="8,0,0,0"
                                VerticalAlignment="Top" ToolTip="{local:Tr srvcfg.wsRemove}"
                                AutomationProperties.Name="{local:Tr srvcfg.wsRemove}" AutomationProperties.AutomationId="{Binding RemoveAutomationId}">
                            <Path Data="{StaticResource Icon.Close}" Style="{StaticResource Forest.Icon}" Width="12" Height="12" />
                        </Button>
                        <Grid>
                            <ComboBox ItemsSource="{Binding ValueOptions}" SelectedItem="{Binding SelectedOption}" IsEnabled="{Binding IsEditable}"
                                      HorizontalAlignment="Stretch"
                                      Visibility="{Binding HasValueOptions, Converter={StaticResource BoolToVis}}"
                                      AutomationProperties.Name="{local:Tr srvcfg.wsValue}" AutomationProperties.AutomationId="{Binding ValueAutomationId}">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock>
                                            <Run Text="{Binding Label, Mode=OneWay}" /><Run Text="   " /><Run Text="{Binding ValueNote, Mode=OneWay}" FontFamily="Cascadia Mono, Consolas" FontSize="11" Foreground="{StaticResource Forest.Muted}" />
                                        </TextBlock>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                            <TextBox x:Name="ValueBox" Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}" IsReadOnly="{Binding IsReadOnly}"
                                     VerticalContentAlignment="Center"
                                     Visibility="{Binding HasValueOptions, Converter={StaticResource InvertVis}}"
                                     AutomationProperties.Name="{local:Tr srvcfg.wsValue}" AutomationProperties.AutomationId="{Binding ValueAutomationId}" />
                        </Grid>
                    </DockPanel>

                    <!-- что это за настройка -->
                    <StackPanel Grid.Row="1" Grid.ColumnSpan="2" Margin="0,6,0,0">
                        <TextBlock Text="{Binding Title}" FontSize="12" Foreground="{StaticResource Forest.Text}" TextWrapping="Wrap"
                                   Visibility="{Binding Title, Converter={StaticResource TextToVis}}" />
                        <TextBlock Text="{Binding Hint}" Style="{StaticResource Hint}" Margin="0,2,0,0"
                                   Visibility="{Binding Hint, Converter={StaticResource TextToVis}}" />
                        <TextBlock Text="{Binding DefaultText}" Style="{StaticResource Hint}" Margin="0,2,0,0"
                                   Visibility="{Binding DefaultText, Converter={StaticResource TextToVis}}" />
                        <TextBlock Text="{local:Tr srvcfg.wsUnknown}" FontSize="11" Foreground="{StaticResource Forest.Warn}" TextWrapping="Wrap" Margin="0,2,0,0"
                                   Visibility="{Binding IsUnknown, Converter={StaticResource BoolToVis}}" />
                        <TextBlock Text="{Binding Error}" FontSize="12" Foreground="{StaticResource Forest.Danger}" TextWrapping="Wrap" Margin="0,2,0,0"
                                   Visibility="{Binding Error, Converter={StaticResource TextToVis}}" />
                    </StackPanel>
                </Grid>
            </Border>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsReadOnly}" Value="True">
                    <Setter TargetName="ValueBox" Property="Opacity" Value="0.7" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </UserControl.Resources>

    <DockPanel>
        <!-- ===== сервер работает — только чтение ===== -->
        <Border DockPanel.Dock="Top" Style="{StaticResource Forest.Warning}" Margin="0,14,0,0"
                Visibility="{Binding IsServerRunning, Converter={StaticResource BoolToVis}}">
            <DockPanel>
                <Path DockPanel.Dock="Left" Data="{StaticResource Icon.Warning}" Style="{StaticResource Forest.Icon}" Stroke="{StaticResource Forest.Warn}"
                      VerticalAlignment="Center" Margin="0,0,12,0" />
                <TextBlock Text="{local:Tr srvcfg.runningReadOnly}" TextWrapping="Wrap" VerticalAlignment="Center"
                           Foreground="{StaticResource Forest.Warn}" FontSize="13" />
            </DockPanel>
        </Border>

        <!-- ===== вкладки редактора и действия с файлом ===== -->
        <Border DockPanel.Dock="Top" BorderBrush="{StaticResource Forest.Line}" BorderThickness="0,0,0,1" Margin="0,14,0,0">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Margin="12,0,0,8">
                    <Button Command="{Binding ShowFileCommand}" Padding="11,5" MinHeight="0" ToolTip="{Binding FilePath}"
                            AutomationProperties.AutomationId="CfgShowFile">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource Icon.Folder}" Style="{StaticResource Forest.Icon}" Width="13" Height="13" Margin="0,0,7,0" />
                            <TextBlock Text="{local:Tr srvcfg.showFile}" FontSize="12" />
                        </StackPanel>
                    </Button>
                    <Button Command="{Binding ReloadCommand}" Padding="11,5" MinHeight="0" Margin="8,0,0,0" ToolTip="{local:Tr srvcfg.reloadTip}"
                            AutomationProperties.AutomationId="CfgReload">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource Icon.Refresh}" Style="{StaticResource Forest.Icon}" Width="13" Height="13" Margin="0,0,7,0" />
                            <TextBlock Text="{local:Tr srvcfg.reload}" FontSize="12" />
                        </StackPanel>
                    </Button>
                </StackPanel>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom"
                            Visibility="{Binding State, Converter={StaticResource EnumVis}, ConverterParameter=Loaded}">
                    <RadioButton Style="{StaticResource Forest.TabHeader}" GroupName="CfgTab" Content="{local:Tr srvcfg.tabGeneral}"
                                 IsChecked="{Binding Tab, Converter={StaticResource EnumEq}, ConverterParameter=General}"
                                 AutomationProperties.AutomationId="CfgTabGeneral" />
                    <RadioButton Style="{StaticResource Forest.TabHeader}" GroupName="CfgTab" Content="{local:Tr srvcfg.tabWorld}"
                                 IsChecked="{Binding Tab, Converter={StaticResource EnumEq}, ConverterParameter=World}"
                                 AutomationProperties.AutomationId="CfgTabWorld" />
                    <RadioButton Style="{StaticResource Forest.TabHeader}" GroupName="CfgTab" Content="{local:Tr srvcfg.tabRoles}"
                                 IsChecked="{Binding Tab, Converter={StaticResource EnumEq}, ConverterParameter=Roles}"
                                 AutomationProperties.AutomationId="CfgTabRoles" />
                    <RadioButton Style="{StaticResource Forest.TabHeader}" GroupName="CfgTab" Content="{local:Tr srvcfg.tabAdvanced}"
                                 IsChecked="{Binding Tab, Converter={StaticResource EnumEq}, ConverterParameter=Advanced}"
                                 AutomationProperties.AutomationId="CfgTabAdvanced" />
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- ===== нижняя полоса: статус, «Отменить изменения», «Сохранить» (не прокручивается) ===== -->
        <Border DockPanel.Dock="Bottom" BorderBrush="{StaticResource Forest.Line}" BorderThickness="0,1,0,0" Padding="0,10,0,12"
                Visibility="{Binding State, Converter={StaticResource EnumVis}, ConverterParameter=Loaded}">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Margin="16,0,0,0">
                    <Button Content="{local:Tr srvcfg.revert}" Command="{Binding RevertCommand}" AutomationProperties.AutomationId="CfgRevert" />
                    <Button Content="{local:Tr srvcfg.save}" Command="{Binding SaveCommand}" Style="{StaticResource Forest.PrimaryButton}"
                            Padding="22,8" Margin="8,0,0,0" AutomationProperties.AutomationId="CfgSave" />
                </StackPanel>
                <!-- при ошибках в подсказке — их перечень -->
                <DockPanel VerticalAlignment="Center" Background="Transparent" ToolTip="{Binding StatusTip}" ToolTipService.ShowDuration="60000">
                    <Ellipse DockPanel.Dock="Left" Style="{StaticResource StatusDot}" />
                    <TextBlock Text="{Binding StatusText}" Style="{StaticResource StatusLabel}" AutomationProperties.AutomationId="CfgStatus" />
                </DockPanel>
            </DockPanel>
        </Border>

        <Grid>
            <!-- ===== файла ещё нет ===== -->
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="560"
                        Visibility="{Binding State, Converter={StaticResource EnumVis}, ConverterParameter=Missing}">
                <Border Width="64" Height="64" CornerRadius="14" Background="{StaticResource Forest.Surface}" BorderBrush="{StaticResource Forest.Line}"
                        BorderThickness="1" HorizontalAlignment="Center" Margin="0,0,0,16">
                    <Path Data="{StaticResource Icon.Settings}" Style="{StaticResource Forest.Icon}" Stroke="{StaticResource Forest.Accent}" Width="28" Height="28" />
                </Border>
                <TextBlock Text="{local:Tr srvcfg.missingTitle}" FontSize="18" FontWeight="SemiBold" TextAlignment="Center" TextWrapping="Wrap"
                           Foreground="{StaticResource Forest.Text}" />
                <TextBlock Text="{local:Tr srvcfg.missingHint}" Foreground="{StaticResource Forest.Muted}" TextWrapping="Wrap" TextAlignment="Center" Margin="0,8,0,0" />
                <TextBlock Text="{Binding FilePath}" Style="{StaticResource JsonName}" FontSize="11" TextAlignment="Center" Margin="0,10,0,0" />
            </StackPanel>

            <!-- ===== файл не читается: ничего не перезаписываем ===== -->
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="620"
                        Visibility="{Binding State, Converter={StaticResource EnumVis}, ConverterParameter=Failed}">
                <Border Width="64" Height="64" CornerRadius="14" Background="{StaticResource Forest.Surface}" BorderBrush="{StaticResource Forest.Line}"
                        BorderThickness="1" HorizontalAlignment="Center" Margin="0,0,0,16">
                    <Path Data="{StaticResource Icon.Warning}" Style="{StaticResource Forest.Icon}" Stroke="{StaticResource Forest.Danger}" Width="28" Height="28" />
                </Border>
                <TextBlock Text="{local:Tr srvcfg.failedTitle}" FontSize="18" FontWeight="SemiBold" TextAlignment="Center" TextWrapping="Wrap"
                           Foreground="{StaticResource Forest.Text}" />
                <TextBlock Text="{Binding LoadError}" Foreground="{StaticResource Forest.Danger}" TextWrapping="Wrap" TextAlignment="Center" Margin="0,8,0,0"
                           AutomationProperties.AutomationId="CfgLoadError" />
                <TextBlock Text="{local:Tr srvcfg.failedHint}" Foreground="{StaticResource Forest.Muted}" TextWrapping="Wrap" TextAlignment="Center" Margin="0,8,0,0" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,16,0,0">
                    <Button Content="{local:Tr srvcfg.showFile}" Command="{Binding ShowFileCommand}" />
                    <Button Content="{local:Tr srvcfg.reload}" Command="{Binding ReloadCommand}" Margin="8,0,0,0" />
                </StackPanel>
            </StackPanel>

            <!-- ===== редактор ===== -->
            <Grid Visibility="{Binding State, Converter={StaticResource EnumVis}, ConverterParameter=Loaded}">
                <!-- «Основное» -->
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False"
                              PreviewMouseWheel="Scroll_PreviewMouseWheel"
                              Visibility="{Binding Tab, Converter={StaticResource EnumVis}, ConverterParameter=General}">
                    <ItemsControl ItemsSource="{Binding GeneralGroups}" ItemTemplate="{StaticResource GroupTemplate}" Margin="0,14,14,0" Focusable="False" />
                </ScrollViewer>

                <!-- «Мир» -->
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False"
                              PreviewMouseWheel="Scroll_PreviewMouseWheel"
                              Visibility="{Binding Tab, Converter={StaticResource EnumVis}, ConverterParameter=World}">
                    <StackPanel Margin="0,14,14,0">
                        <!-- мир уже создан: часть параметров больше ни на что не влияет -->
                        <Border Style="{StaticResource Forest.Warning}" Margin="0,0,0,14"
                                Visibility="{Binding WorldExists, Converter={StaticResource BoolToVis}}">
                            <DockPanel>
                                <Path DockPanel.Dock="Left" Data="{StaticResource Icon.About}" Style="{StaticResource Forest.Icon}" Stroke="{StaticResource Forest.Warn}"
                                      VerticalAlignment="Center" Margin="0,0,12,0" />
                                <TextBlock Text="{local:Tr srvcfg.worldExists}" TextWrapping="Wrap" VerticalAlignment="Center"
                                           Foreground="{StaticResource Forest.Warn}" FontSize="13" />
                            </DockPanel>
                        </Border>

                        <ItemsControl ItemsSource="{Binding WorldGroups}" ItemTemplate="{StaticResource GroupTemplate}" Focusable="False" />

                        <!-- настройки мира: словарь «ключ → значение» -->
                        <Border Style="{StaticResource CardBox}">
                            <StackPanel>
                                <DockPanel Margin="0,0,0,12">
                                    <Button DockPanel.Dock="Right" Command="{Binding AddWorldSettingCommand}" VerticalAlignment="Top" Padding="12,5" MinHeight="0"
                                            Margin="16,0,0,0" AutomationProperties.AutomationId="CfgAddWorldSetting">
                                        <StackPanel Orientation="Horizontal">
                                            <Path Data="{StaticResource Icon.Plus}" Style="{StaticResource Forest.Icon}" Width="11" Height="11" Margin="0,0,7,0" />
                                            <TextBlock Text="{local:Tr srvcfg.wsAdd}" FontSize="12" />
                                        </StackPanel>
                                    </Button>
                                    <StackPanel>
                                        <TextBlock Text="{local:Tr srvcfg.wsTitle}" Style="{StaticResource CardTitle}" />
                                        <TextBlock Text="WorldConfig.WorldConfiguration" Style="{StaticResource JsonName}" Margin="0,2,0,0" />
                                        <WrapPanel>
                                            <Border Style="{StaticResource Badge}" ToolTip="{local:Tr srvcfg.badgeWorldCreationTip}">
                                                <TextBlock Text="{local:Tr srvcfg.badgeWorldCreation}" FontSize="10.5" Foreground="{StaticResource Forest.Warn}" />
                                            </Border>
                                        </WrapPanel>
                                        <TextBlock Text="{local:Tr srvcfg.wsHint}" Style="{StaticResource Hint}" Margin="0,5,0,0" />
                                    </StackPanel>
                                </DockPanel>
                                <Border BorderBrush="{StaticResource Forest.Line}" BorderThickness="0,1,0,0" Padding="0,12"
                                        Visibility="{Binding HasWorldSettings, Converter={StaticResource InvertVis}}">
                                    <TextBlock Text="{local:Tr srvcfg.wsEmpty}" Style="{StaticResource Hint}" FontSize="12" />
                                </Border>
                                <ItemsControl ItemsSource="{Binding WorldSettings}" ItemTemplate="{StaticResource WorldSettingRow}" Focusable="False" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <!-- «Роли»: вёрстка и прокрутка — свои -->
                <Grid Margin="0,14,0,0" Visibility="{Binding Tab, Converter={StaticResource EnumVis}, ConverterParameter=Roles}">
                    <local:RolesView DataContext="{Binding Roles}" />
                </Grid>

                <!-- «Дополнительно»: полей много — сверху поиск -->
                <DockPanel Visibility="{Binding Tab, Converter={StaticResource EnumVis}, ConverterParameter=Advanced}">
                    <Grid DockPanel.Dock="Top" Margin="0,14,14,0">
                        <TextBox Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}" Padding="34,7,10,7" VerticalContentAlignment="Center"
                                 AutomationProperties.Name="{local:Tr srvcfg.searchPlaceholder}" AutomationProperties.AutomationId="CfgSearch" />
                        <Path Data="{StaticResource Icon.Search}" Style="{StaticResource Forest.Icon}" Stroke="{StaticResource Forest.Muted}"
                              Width="14" Height="14" HorizontalAlignment="Left" Margin="12,0,0,0" IsHitTestVisible="False" />
                        <TextBlock Text="{local:Tr srvcfg.searchPlaceholder}" Foreground="{StaticResource Forest.Muted}" Margin="35,0,0,0"
                                   VerticalAlignment="Center" IsHitTestVisible="False">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Opacity" Value="0" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Search}" Value="">
                                            <Setter Property="Opacity" Value="1" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>
                    <TextBlock DockPanel.Dock="Top" Text="{local:Tr srvcfg.searchEmpty}" Foreground="{StaticResource Forest.Muted}" Margin="2,16,0,0"
                               Visibility="{Binding SearchEmpty, Converter={StaticResource BoolToVis}}" />
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False"
                                  PreviewMouseWheel="Scroll_PreviewMouseWheel">
                        <ItemsControl ItemsSource="{Binding AdvancedGroups}" ItemTemplate="{StaticResource GroupTemplate}" Margin="0,14,14,0" Focusable="False" />
                    </ScrollViewer>
                </DockPanel>
            </Grid>
        </Grid>
    </DockPanel>
</UserControl>
