<Window x:Class="eViSTool.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:eViSTool.App.ViewModels"
        xmlns:local="clr-namespace:eViSTool.App"
        Title="eViSTool" Icon="Assets/eViSTool.ico" Height="860" Width="1400" MinHeight="480" MinWidth="860"
        Loaded="Window_Loaded" Closing="Window_Closing"
        WindowStartupLocation="CenterScreen" Background="{StaticResource Forest.Base}"
        SourceInitialized="Window_SourceInitialized">
    <Window.DataContext>
        <vm:MainViewModel />
    </Window.DataContext>

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <local:InvertBoolConverter x:Key="Invert" />
        <local:CountToVisibilityConverter x:Key="CountToVis" />

        <Style x:Key="Hint" TargetType="TextBlock">
            <Setter Property="Opacity" Value="0.7" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="0,2,0,6" />
        </Style>
    </Window.Resources>

    <Grid Background="{StaticResource Forest.Base}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="210" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- ===== боковая колонка ===== -->
        <DockPanel Background="{StaticResource Forest.Side}">
            <Border DockPanel.Dock="Right" Width="1" Background="{StaticResource Forest.Line}" />

            <!-- лого и слоган -->
            <DockPanel DockPanel.Dock="Top" Margin="16,20,10,22">
                <Image Source="Assets/logo256.png" Width="36" Height="36" RenderOptions.BitmapScalingMode="HighQuality" VerticalAlignment="Top" />
                <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="eViSTool" FontSize="19" FontWeight="SemiBold" Foreground="{StaticResource Forest.Text}" />
                    <TextBlock Text="{local:Tr shell.slogan}" FontSize="11" Foreground="{StaticResource Forest.Muted}" TextWrapping="Wrap" />
                </StackPanel>
            </DockPanel>

            <!-- низ: версия игры профиля, автор -->
            <StackPanel DockPanel.Dock="Bottom" Margin="14,0,14,14">
                <Border Background="{StaticResource Forest.Surface}" CornerRadius="8" Padding="10,8">
                    <DockPanel>
                        <Border Background="{StaticResource Forest.Raised}" CornerRadius="6" Width="30" Height="30" Margin="0,0,10,0">
                            <TextBlock Text="VS" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource Forest.Text}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Vintage Story" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource Forest.Text}" />
                            <TextBlock FontSize="11" Foreground="{StaticResource Forest.Muted}">
                                <Run Text="{local:Tr shell.profileVersion}" /><Run Text=" · " /><Run Text="{Binding ActiveProfile.GameVersionText, Mode=OneWay}" />
                            </TextBlock>
                        </StackPanel>
                    </DockPanel>
                </Border>
                <TextBlock FontSize="11" Margin="4,10,0,0" ToolTip="https://github.com/erneywhite/eViSTool">
                    <Hyperlink Command="{Binding About.OpenUrlCommand}" CommandParameter="https://github.com/erneywhite/eViSTool"
                               Foreground="{StaticResource Forest.Muted}">
                        <Run Text="{local:Tr shell.madeBy}" />
                    </Hyperlink>
                </TextBlock>
            </StackPanel>

            <!-- навигация: порядок пунктов = порядок разделов -->
            <StackPanel Margin="12,0,12,0">
                <TextBlock Text="{local:Tr shell.workspace}" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource Forest.Muted}"
                           Margin="8,0,0,8" />
                <ListBox SelectedIndex="{Binding SelectedTab}" Background="Transparent" BorderThickness="0"
                         ItemContainerStyle="{StaticResource Forest.NavItem}" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBoxItem>
                        <DockPanel>
                            <Border DockPanel.Dock="Right" Background="{StaticResource Forest.Raised}" CornerRadius="4" Padding="6,1" VerticalAlignment="Center">
                                <TextBlock Text="{Binding Mods.ModCount}" FontSize="11" Foreground="{StaticResource Forest.Muted}" />
                            </Border>
                            <Path Data="{StaticResource Icon.Mods}" Style="{StaticResource Forest.Icon}" />
                            <TextBlock Text="{local:Tr nav.mods}" Margin="10,0,0,0" VerticalAlignment="Center" FontSize="13" />
                        </DockPanel>
                    </ListBoxItem>
                    <ListBoxItem>
                        <DockPanel>
                            <Path Data="{StaticResource Icon.Catalog}" Style="{StaticResource Forest.Icon}" />
                            <TextBlock Text="{local:Tr nav.catalog}" Margin="10,0,0,0" VerticalAlignment="Center" FontSize="13" />
                        </DockPanel>
                    </ListBoxItem>
                    <ListBoxItem>
                        <DockPanel>
                            <Path Data="{StaticResource Icon.Server}" Style="{StaticResource Forest.Icon}" />
                            <TextBlock Text="{local:Tr nav.server}" Margin="10,0,0,0" VerticalAlignment="Center" FontSize="13" />
                        </DockPanel>
                    </ListBoxItem>
                    <ListBoxItem>
                        <DockPanel>
                            <Path Data="{StaticResource Icon.Settings}" Style="{StaticResource Forest.Icon}" />
                            <TextBlock Text="{local:Tr nav.settings}" Margin="10,0,0,0" VerticalAlignment="Center" FontSize="13" />
                        </DockPanel>
                    </ListBoxItem>
                    <ListBoxItem>
                        <DockPanel>
                            <Path Data="{StaticResource Icon.About}" Style="{StaticResource Forest.Icon}" />
                            <TextBlock Text="{local:Tr nav.about}" Margin="10,0,0,0" VerticalAlignment="Center" FontSize="13" />
                        </DockPanel>
                    </ListBoxItem>
                </ListBox>
            </StackPanel>
        </DockPanel>

        <!-- ===== основная часть ===== -->
        <DockPanel Grid.Column="1">
            <!-- полоса: раздел и активный профиль -->
            <Border DockPanel.Dock="Top" Height="60" BorderBrush="{StaticResource Forest.Line}" BorderThickness="0,0,0,1">
                <DockPanel Margin="24,0,20,0">
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="{local:Tr shell.activeProfile}" VerticalAlignment="Center" Margin="0,0,10,0"
                                   Foreground="{StaticResource Forest.Muted}" FontSize="12" />
                        <ComboBox ItemsSource="{Binding Profiles}" SelectedItem="{Binding ActiveProfile}" MinWidth="240">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock>
                                        <Run Text="{Binding Name, Mode=OneWay}" FontWeight="SemiBold" />
                                        <Run Text="·" Foreground="{StaticResource Forest.Muted}" />
                                        <Run Text="{Binding KindText, Mode=OneWay}" Foreground="{StaticResource Forest.Muted}" />
                                    </TextBlock>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                    </StackPanel>
                    <TextBlock VerticalAlignment="Center" FontSize="13">
                        <Run Text="{local:Tr shell.workspaceCrumb}" Foreground="{StaticResource Forest.Muted}" />
                        <Run Text="  /  " Foreground="{StaticResource Forest.Muted}" />
                        <Run Text="{Binding PageTitle, Mode=OneWay}" FontWeight="SemiBold" Foreground="{StaticResource Forest.Text}" />
                    </TextBlock>
                </DockPanel>
            </Border>

        <TabControl Margin="16,12,16,12" SelectedIndex="{Binding SelectedTab}" Style="{StaticResource Forest.PagesHost}">
            <!-- ============ МОДЫ ============ -->
            <TabItem Header="{local:Tr tab.mods}">
                <local:ModsView DataContext="{Binding Mods}" />
            </TabItem>

            <!-- ============ КАТАЛОГ ============ -->
            <TabItem Header="{local:Tr tab.catalog}">
                <local:CatalogView DataContext="{Binding Catalog}" />
            </TabItem>

            <!-- ============ СЕРВЕР ============ -->
            <TabItem Header="{local:Tr tab.server}">
                <local:ServerView DataContext="{Binding Server}" />
            </TabItem>

            <!-- ============ НАСТРОЙКИ ============ -->
            <TabItem Header="{local:Tr tab.settings}">
                <DockPanel Margin="8">
                    <!-- список профилей -->
                    <DockPanel DockPanel.Dock="Left" Width="260" Margin="0,0,20,0">
                        <TextBlock DockPanel.Dock="Top" Text="{local:Tr settings.profiles}" FontWeight="SemiBold" FontSize="16" Margin="0,0,0,8" />
                        <StackPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
                            <Button Content="{local:Tr settings.addClient}" Command="{Binding AddClientProfileCommand}" HorizontalAlignment="Stretch" Margin="0,0,0,6" />
                            <Button Content="{local:Tr settings.addServer}" Command="{Binding AddServerProfileCommand}" HorizontalAlignment="Stretch" Margin="0,0,0,6" />
                            <Button Content="{local:Tr settings.removeProfile}" Command="{Binding RemoveProfileCommand}" CommandParameter="{Binding EditedProfile}"
                                    HorizontalAlignment="Stretch" />
                        </StackPanel>
                        <ListBox ItemsSource="{Binding Profiles}" SelectedItem="{Binding EditedProfile}">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="0,2">
                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                                        <TextBlock Opacity="0.7">
                                            <Run Text="{Binding KindText, Mode=OneWay}" /><Run Text="{local:Tr settings.gameShort}" /><Run Text="{Binding GameVersionText, Mode=OneWay}" />
                                        </TextBlock>
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </DockPanel>

                    <!-- редактор выбранного профиля -->
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel MaxWidth="820" HorizontalAlignment="Stretch">
                            <StackPanel DataContext="{Binding EditedProfile}">
                                <TextBlock Text="{local:Tr settings.name}" FontWeight="SemiBold" />
                                <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,0" />

                                <TextBlock Text="{local:Tr settings.type}" FontWeight="SemiBold" Margin="0,16,0,0" />
                                <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                    <RadioButton Content="{local:Tr settings.kindClient}" IsChecked="{Binding IsServer, Converter={StaticResource Invert}}" Margin="0,0,16,0" />
                                    <RadioButton Content="{local:Tr tab.server}" IsChecked="{Binding IsServer}" />
                                </StackPanel>

                                <TextBlock Text="{local:Tr settings.gameDir}" FontWeight="SemiBold" Margin="0,16,0,0" />
                                <TextBlock Style="{StaticResource Hint}"
                                           Text="{local:Tr settings.gameDirHint}" />
                                <DockPanel>
                                    <Button DockPanel.Dock="Right" Content="{local:Tr common.browse}" Command="{Binding BrowseGameDirCommand}" Margin="8,0,0,0" Padding="12,4" />
                                    <TextBox Text="{Binding GameDir, UpdateSourceTrigger=LostFocus}" />
                                </DockPanel>

                                <TextBlock Text="{local:Tr settings.dataDir}" FontWeight="SemiBold" Margin="0,16,0,0" />
                                <TextBlock Style="{StaticResource Hint}"
                                           Text="{local:Tr settings.dataDirHint}" />
                                <DockPanel>
                                    <Button DockPanel.Dock="Right" Content="{local:Tr common.open}" Command="{Binding OpenDataDirCommand}" Margin="8,0,0,0" Padding="12,4" />
                                    <Button DockPanel.Dock="Right" Content="{local:Tr common.browse}" Command="{Binding BrowseDataDirCommand}" Margin="8,0,0,0" Padding="12,4" />
                                    <TextBox Text="{Binding DataDir, UpdateSourceTrigger=LostFocus}" />
                                </DockPanel>

                                <!-- что удалось прочитать из файлов игры -->
                                <Border Margin="0,20,0,0" Padding="12" CornerRadius="6" Background="#1A808080">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <TextBlock Text="{local:Tr settings.gameVersion}" Opacity="0.7" Margin="0,0,12,6" />
                                        <TextBlock Grid.Column="1" Text="{Binding GameVersionText}" FontWeight="SemiBold" />
                                        <TextBlock Grid.Row="1" Text="{local:Tr settings.configFile}" Opacity="0.7" Margin="0,0,12,6" />
                                        <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding ConfigText}" TextWrapping="Wrap" />
                                        <TextBlock Grid.Row="2" Text="{local:Tr settings.modDirs}" Opacity="0.7" Margin="0,0,12,6" />
                                        <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding ModDirsText}" TextWrapping="Wrap" Margin="0,0,0,6" />
                                        <TextBlock Grid.Row="3" Grid.ColumnSpan="2" Text="{Binding WarningsText}" Foreground="#E0A030"
                                                   TextWrapping="Wrap" Visibility="{Binding HasWarnings, Converter={StaticResource BoolToVis}}" />
                                    </Grid>
                                </Border>
                                <Button Content="{local:Tr settings.reread}" Command="{Binding RereadCommand}" HorizontalAlignment="Left" Margin="0,8,0,0" Padding="12,4" />
                            </StackPanel>

                            <TextBlock Text="{local:Tr settings.language}" FontWeight="SemiBold" Margin="0,28,0,0" />
                            <ComboBox ItemsSource="{Binding Languages}" SelectedItem="{Binding SelectedLanguage}" Width="220"
                                      HorizontalAlignment="Left" Margin="0,4,0,0" />

                            <CheckBox Content="{local:Tr settings.autoCheck}" IsChecked="{Binding AutoCheckUpdates}" Margin="0,20,0,0" />
                            <CheckBox Content="{local:Tr settings.allowUnstable}" IsChecked="{Binding AllowUnstable}" Margin="0,12,0,0" />
                            <TextBlock Style="{StaticResource Hint}" Margin="28,2,0,0"
                                       Text="{local:Tr settings.allowUnstableHint}" />

                            <TextBlock Text="{local:Tr settings.appData}" FontWeight="SemiBold" Margin="0,28,0,0" />
                            <TextBlock Style="{StaticResource Hint}"
                                       Text="{local:Tr settings.appDataHint}" />
                            <DockPanel>
                                <Button DockPanel.Dock="Right" Content="{local:Tr common.open}" Command="{Binding OpenDataFolderCommand}" Margin="8,0,0,0" Padding="12,4" />
                                <TextBlock Text="{Binding DataLocationText}" VerticalAlignment="Center" TextWrapping="Wrap" />
                            </DockPanel>
                        </StackPanel>
                    </ScrollViewer>
                </DockPanel>
            </TabItem>

            <!-- ============ О ПРОГРАММЕ ============ -->
            <TabItem Header="{local:Tr tab.about}">
                <local:AboutView DataContext="{Binding About}" />
            </TabItem>
        </TabControl>
        </DockPanel>
    </Grid>
</Window>
