<Window x:Class="eViSTool.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:eViSTool.App.ViewModels"
        xmlns:local="clr-namespace:eViSTool.App"
        Title="eViSTool" Icon="Assets/eViSTool.ico" Height="860" Width="1400" MinHeight="480" MinWidth="860"
        Loaded="Window_Loaded" Closing="Window_Closing"
        WindowStartupLocation="CenterScreen" Background="{StaticResource Forest.Base}"
        SourceInitialized="Window_SourceInitialized">
    <Window.DataContext>
        <vm:MainViewModel />
    </Window.DataContext>

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <local:TextToVisibilityConverter x:Key="TextToVis" />
        <local:InvertBoolToVisibilityConverter x:Key="InvBoolToVis" />
    </Window.Resources>

    <Grid Background="{StaticResource Forest.Base}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="210" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- ===== боковая колонка ===== -->
        <DockPanel Background="{StaticResource Forest.Side}">
            <Border DockPanel.Dock="Right" Width="1" Background="{StaticResource Forest.Line}" />

            <!-- лого и слоган -->
            <DockPanel DockPanel.Dock="Top" Margin="16,20,10,22">
                <Image Source="Assets/logo256.png" Width="36" Height="36" RenderOptions.BitmapScalingMode="HighQuality" VerticalAlignment="Top" />
                <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="eViSTool" FontSize="19" FontWeight="SemiBold" Foreground="{StaticResource Forest.Text}" />
                    <TextBlock Text="{local:Tr shell.slogan}" FontSize="11" Foreground="{StaticResource Forest.Muted}" TextWrapping="Wrap" />
                </StackPanel>
            </DockPanel>

            <!-- низ: новая версия программы, версия игры профиля, автор -->
            <StackPanel DockPanel.Dock="Bottom" Margin="14,0,14,14">
                <!-- ссылка-кнопка показывает только текст (шаблон — один TextBlock), поэтому без иконки -->
                <Button Style="{StaticResource Forest.LinkButton}" Command="{Binding ShowAboutCommand}" HorizontalAlignment="Left" Margin="4,0,0,10"
                        Content="{Binding About.UpdateBadgeText}" Visibility="{Binding About.HasUpdate, Converter={StaticResource BoolToVis}}"
                        AutomationProperties.AutomationId="UpdateBadge" />
                <Border Background="{StaticResource Forest.Surface}" CornerRadius="8" Padding="10,8">
                    <DockPanel>
                        <Border Background="{StaticResource Forest.Raised}" CornerRadius="6" Width="30" Height="30" Margin="0,0,10,0">
                            <Grid>
                                <!-- значок из установленной игры; игры на компьютере нет — буквы -->
                                <Image Source="{Binding GameIcon}" Width="24" Height="24" RenderOptions.BitmapScalingMode="HighQuality"
                                       Visibility="{Binding HasGameIcon, Converter={StaticResource BoolToVis}}" />
                                <TextBlock Text="VS" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource Forest.Text}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"
                                           Visibility="{Binding HasGameIcon, Converter={StaticResource InvBoolToVis}}" />
                            </Grid>
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Vintage Story" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource Forest.Text}" />
                            <TextBlock FontSize="11" Foreground="{StaticResource Forest.Muted}" TextWrapping="Wrap">
                                <Run Text="{local:Tr shell.profileVersion}" /><Run Text=" · " /><Run Text="{Binding ActiveProfile.GameVersionText, Mode=OneWay}" />
                            </TextBlock>
                        </StackPanel>
                    </DockPanel>
                </Border>
                <TextBlock FontSize="11" Margin="4,10,0,0" ToolTip="https://github.com/erneywhite/eViSTool">
                    <Hyperlink Command="{Binding About.OpenUrlCommand}" CommandParameter="https://github.com/erneywhite/eViSTool"
                               Foreground="{StaticResource Forest.Muted}">
                        <Run Text="{local:Tr shell.madeBy}" />
                    </Hyperlink>
                </TextBlock>
            </StackPanel>

            <!-- навигация: порядок пунктов = порядок разделов -->
            <StackPanel Margin="12,0,12,0">
                <TextBlock Text="{local:Tr shell.workspace}" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource Forest.Muted}"
                           Margin="8,0,0,8" />
                <ListBox SelectedIndex="{Binding SelectedTab}" Background="Transparent" BorderThickness="0"
                         ItemContainerStyle="{StaticResource Forest.NavItem}" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBoxItem>
                        <DockPanel>
                            <Border DockPanel.Dock="Right" Background="{StaticResource Forest.Raised}" CornerRadius="4" Padding="6,1" VerticalAlignment="Center">
                                <TextBlock Text="{Binding Mods.ModCount}" FontSize="11" Foreground="{StaticResource Forest.Muted}" />
                            </Border>
                            <Path Data="{StaticResource Icon.Mods}" Style="{StaticResource Forest.Icon}" />
                            <TextBlock Text="{local:Tr nav.mods}" Margin="10,0,0,0" VerticalAlignment="Center" FontSize="13" />
                        </DockPanel>
                    </ListBoxItem>
                    <ListBoxItem>
                        <DockPanel>
                            <Path Data="{StaticResource Icon.Catalog}" Style="{StaticResource Forest.Icon}" />
                            <TextBlock Text="{local:Tr nav.catalog}" Margin="10,0,0,0" VerticalAlignment="Center" FontSize="13" />
                        </DockPanel>
                    </ListBoxItem>
                    <ListBoxItem>
                        <DockPanel>
                            <Path Data="{StaticResource Icon.ModConfig}" Style="{StaticResource Forest.Icon}" />
                            <TextBlock Text="{local:Tr nav.modConfig}" Margin="10,0,0,0" VerticalAlignment="Center" FontSize="13" />
                        </DockPanel>
                    </ListBoxItem>
                    <ListBoxItem>
                        <DockPanel>
                            <Path Data="{StaticResource Icon.Server}" Style="{StaticResource Forest.Icon}" />
                            <TextBlock Text="{local:Tr nav.server}" Margin="10,0,0,0" VerticalAlignment="Center" FontSize="13" />
                        </DockPanel>
                    </ListBoxItem>
                    <ListBoxItem>
                        <DockPanel>
                            <Path Data="{StaticResource Icon.Settings}" Style="{StaticResource Forest.Icon}" />
                            <TextBlock Text="{local:Tr nav.settings}" Margin="10,0,0,0" VerticalAlignment="Center" FontSize="13" />
                        </DockPanel>
                    </ListBoxItem>
                    <ListBoxItem>
                        <DockPanel>
                            <Path Data="{StaticResource Icon.About}" Style="{StaticResource Forest.Icon}" />
                            <TextBlock Text="{local:Tr nav.about}" Margin="10,0,0,0" VerticalAlignment="Center" FontSize="13" />
                        </DockPanel>
                    </ListBoxItem>
                </ListBox>
            </StackPanel>
        </DockPanel>

        <!-- ===== основная часть ===== -->
        <DockPanel Grid.Column="1">
            <!-- полоса: раздел и активный профиль -->
            <Border DockPanel.Dock="Top" Height="60" BorderBrush="{StaticResource Forest.Line}" BorderThickness="0,0,0,1">
                <DockPanel Margin="24,0,20,0">
                    <!-- игра с активным клиентским профилем: его папка данных, его моды -->
                    <!-- «Играть ▾»: большая часть — с сервером по умолчанию (или без сервера), стрелка — меню серверов -->
                    <Button x:Name="PlayMenuButton" DockPanel.Dock="Right" Style="{StaticResource Forest.PrimaryButton}" Click="PlayMenu_Click"
                            VerticalAlignment="Center" Margin="2,0,0,0" Padding="9,8" ToolTip="{local:Tr play.menuTip}"
                            Visibility="{Binding CanPlay, Converter={StaticResource BoolToVis}}" AutomationProperties.AutomationId="PlayMenuButton"
                            AutomationProperties.Name="{local:Tr play.menuTip}">
                        <Path Data="{StaticResource Icon.ChevronDown}" Style="{StaticResource Forest.Icon}" Width="12" Height="12" />
                    </Button>
                    <Popup x:Name="PlayMenu" DockPanel.Dock="Right" PlacementTarget="{Binding ElementName=PlayMenuButton}" Placement="Bottom"
                           HorizontalOffset="-300" VerticalOffset="6" StaysOpen="False" AllowsTransparency="True" PopupAnimation="Fade">
                        <Border Width="340" Background="{StaticResource Forest.Surface}" BorderBrush="{StaticResource Forest.Line}" BorderThickness="1"
                                CornerRadius="10" Padding="6">
                            <Border.Resources>
                                    <DataTemplate x:Key="PlayMenuItem">
                                        <DockPanel Margin="0,1">
                                            <!-- булавка: сервер по умолчанию (повторно — снять) -->
                                            <ToggleButton DockPanel.Dock="Right" IsChecked="{Binding IsDefault, Mode=OneWay}" Margin="6,0,8,0" Padding="7"
                                                          VerticalAlignment="Center" Background="Transparent" BorderThickness="0" Cursor="Hand"
                                                          ToolTip="{local:Tr play.pinTip}" AutomationProperties.Name="{local:Tr play.pinTip}"
                                                          Click="PlayMenuPin_Click">
                                                <ToggleButton.Template>
                                                    <ControlTemplate TargetType="ToggleButton">
                                                        <Border x:Name="Bd" Background="Transparent" CornerRadius="5" Padding="{TemplateBinding Padding}">
                                                            <Path x:Name="Ic" Data="{StaticResource Icon.Pin}" Style="{StaticResource Forest.Icon}" Width="14" Height="14"
                                                                  Stroke="{StaticResource Forest.Muted}" />
                                                        </Border>
                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource Forest.Raised}" />
                                                            </Trigger>
                                                            <Trigger Property="IsChecked" Value="True">
                                                                <Setter TargetName="Ic" Property="Stroke" Value="{StaticResource Forest.Accent}" />
                                                            </Trigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </ToggleButton.Template>
                                            </ToggleButton>
                                            <Button Click="PlayMenuItem_Click" Background="Transparent" BorderThickness="0" Padding="12,6" Cursor="Hand"
                                                    HorizontalContentAlignment="Stretch" AutomationProperties.Name="{Binding Name}">
                                                <Button.Template>
                                                    <ControlTemplate TargetType="Button">
                                                        <Border x:Name="Bd" Background="Transparent" CornerRadius="6" Padding="{TemplateBinding Padding}">
                                                            <ContentPresenter />
                                                        </Border>
                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource Forest.Raised}" />
                                                            </Trigger>
                                                            <Trigger Property="IsEnabled" Value="False">
                                                                <Setter TargetName="Bd" Property="Opacity" Value="0.5" />
                                                            </Trigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Button.Template>
                                                <StackPanel>
                                                    <TextBlock Text="{Binding Name}" FontSize="13" Foreground="{StaticResource Forest.Text}" TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Text="{Binding Detail}" FontSize="11" Foreground="{StaticResource Forest.Muted}" TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Text="{Binding VersionNote}" FontSize="11" Foreground="{StaticResource Forest.Warn}" TextWrapping="Wrap"
                                                               Visibility="{Binding VersionNote, Converter={StaticResource TextToVis}}" />
                                                </StackPanel>
                                            </Button>
                                        </DockPanel>
                                    </DataTemplate>
                            </Border.Resources>
                            <StackPanel>
                                <ContentControl Content="{Binding PlayNoServer}" ContentTemplate="{StaticResource PlayMenuItem}" Focusable="False" />

                                <StackPanel Visibility="{Binding HasPlayOwnServers, Converter={StaticResource BoolToVis}}">
                                    <Border BorderBrush="{StaticResource Forest.Line}" BorderThickness="0,1,0,0" Margin="6,6,6,0" />
                                    <TextBlock Text="{local:Tr play.ownServers}" FontSize="11" Foreground="{StaticResource Forest.Muted}" Margin="12,8,0,2" />
                                    <ItemsControl ItemsSource="{Binding PlayOwnServers}" ItemTemplate="{StaticResource PlayMenuItem}" Focusable="False" />
                                </StackPanel>

                                <StackPanel Visibility="{Binding HasPlayFavorites, Converter={StaticResource BoolToVis}}">
                                    <Border BorderBrush="{StaticResource Forest.Line}" BorderThickness="0,1,0,0" Margin="6,6,6,0" />
                                    <TextBlock Text="{local:Tr play.favorites}" FontSize="11" Foreground="{StaticResource Forest.Muted}" Margin="12,8,0,2" />
                                    <ItemsControl ItemsSource="{Binding PlayFavorites}" ItemTemplate="{StaticResource PlayMenuItem}" Focusable="False" />
                                    <TextBlock Text="{Binding PlayFavoritesMore}" FontSize="11" Foreground="{StaticResource Forest.Muted}" Margin="12,2,0,4"
                                               Visibility="{Binding PlayFavoritesMore, Converter={StaticResource TextToVis}}" />
                                </StackPanel>

                                <TextBlock Text="{local:Tr play.menuHint}" FontSize="11" Foreground="{StaticResource Forest.Muted}" TextWrapping="Wrap"
                                           Margin="12,8,12,4" />
                            </StackPanel>
                        </Border>
                    </Popup>
                    <Button DockPanel.Dock="Right" Style="{StaticResource Forest.PrimaryButton}" Command="{Binding PlayCommand}"
                            VerticalAlignment="Center" Margin="12,0,0,0" ToolTip="{Binding PlayTip}" ToolTipService.ShowOnDisabled="True"
                            Visibility="{Binding CanPlay, Converter={StaticResource BoolToVis}}" AutomationProperties.AutomationId="PlayButton">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource Icon.Play}" Style="{StaticResource Forest.Icon}" Width="13" Height="13" Margin="0,0,8,0" />
                            <TextBlock Text="{Binding PlayText}" MaxWidth="260" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                    </Button>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                        <!-- моды профиля сыплют ошибками (игра работает, но лог пухнет и бывают фризы) — отчёт по кнопке -->
                        <Button Command="{Binding ShowErrorsCommand}" ToolTip="{Binding ErrorBadgeTip}" Margin="0,0,10,0" Padding="10,4" MinHeight="0"
                                Visibility="{Binding HasErrorBadge, Converter={StaticResource BoolToVis}}" AutomationProperties.AutomationId="ErrorBadge"
                                Background="{StaticResource Forest.Warn}" BorderBrush="{StaticResource Forest.Warn}">
                            <TextBlock Text="!" FontWeight="Bold" FontSize="14" Foreground="{StaticResource Forest.Base}" />
                        </Button>
                        <TextBlock Text="{local:Tr shell.activeProfile}" VerticalAlignment="Center" Margin="0,0,10,0"
                                   Foreground="{StaticResource Forest.Muted}" FontSize="12" />
                        <ComboBox x:Name="ProfileCombo" ItemsSource="{Binding Profiles}" SelectedItem="{Binding ActiveProfile}" MinWidth="240"
                                  DropDownOpened="ProfileCombo_DropDownOpened">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock>
                                        <Run Text="{Binding Name, Mode=OneWay}" FontWeight="SemiBold" />
                                        <Run Text="·" Foreground="{StaticResource Forest.Muted}" />
                                        <Run Text="{Binding KindText, Mode=OneWay}" Foreground="{StaticResource Forest.Muted}" />
                                    </TextBlock>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                    </StackPanel>
                    <TextBlock VerticalAlignment="Center" FontSize="13">
                        <Run Text="{local:Tr shell.workspaceCrumb}" Foreground="{StaticResource Forest.Muted}" />
                        <Run Text="  /  " Foreground="{StaticResource Forest.Muted}" />
                        <Run Text="{Binding PageTitle, Mode=OneWay}" FontWeight="SemiBold" Foreground="{StaticResource Forest.Text}" />
                    </TextBlock>
                </DockPanel>
            </Border>

        <TabControl Margin="16,12,16,12" SelectedIndex="{Binding SelectedTab}" Style="{StaticResource Forest.PagesHost}">
            <!-- ============ МОДЫ ============ -->
            <TabItem Header="{local:Tr tab.mods}">
                <local:ModsView DataContext="{Binding Mods}" />
            </TabItem>

            <!-- ============ КАТАЛОГ ============ -->
            <TabItem Header="{local:Tr tab.catalog}">
                <local:CatalogView DataContext="{Binding Catalog}" />
            </TabItem>

            <!-- ============ НАСТРОЙКИ МОДОВ ============ -->
            <TabItem Header="{local:Tr nav.modConfig}">
                <local:ModConfigView DataContext="{Binding ModConfig}" />
            </TabItem>

            <!-- ============ СЕРВЕР ============ -->
            <TabItem Header="{local:Tr tab.server}">
                <local:ServerView DataContext="{Binding Server}" />
            </TabItem>

            <!-- ============ НАСТРОЙКИ ============ -->
            <TabItem Header="{local:Tr tab.settings}">
                <local:SettingsView />
            </TabItem>

            <!-- ============ О ПРОГРАММЕ ============ -->
            <TabItem Header="{local:Tr tab.about}">
                <local:AboutView DataContext="{Binding About}" />
            </TabItem>
        </TabControl>
        </DockPanel>
    </Grid>
</Window>
