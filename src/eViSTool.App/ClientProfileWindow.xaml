<Window x:Class="eViSTool.App.ClientProfileWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:eViSTool.App"
        Icon="Assets/eViSTool.ico"
        Width="640" SizeToContent="Height" ResizeMode="NoResize" Background="{StaticResource Forest.Base}"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" Closing="Window_Closing">
    <Window.Resources>
        <Style x:Key="Label" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{StaticResource Forest.Text}" />
            <Setter Property="Margin" Value="0,16,0,0" />
        </Style>
        <Style x:Key="Hint" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Foreground" Value="{StaticResource Forest.Muted}" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="0,2,0,0" />
        </Style>
        <Style x:Key="OptionTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Foreground" Value="{StaticResource Forest.Text}" />
        </Style>
        <Style x:Key="NextOption" TargetType="Border">
            <Setter Property="BorderBrush" Value="{StaticResource Forest.Line}" />
            <Setter Property="BorderThickness" Value="0,1,0,0" />
            <Setter Property="Margin" Value="0,10,0,0" />
            <Setter Property="Padding" Value="0,10,0,0" />
        </Style>
    </Window.Resources>

    <StackPanel Margin="24,20,24,22">
        <TextBlock x:Name="Heading" FontSize="20" FontWeight="SemiBold" Foreground="{StaticResource Forest.Text}" TextWrapping="Wrap" />
        <TextBlock x:Name="Intro" Style="{StaticResource Hint}" FontSize="12" Margin="0,4,0,0" />

        <!-- игра запущена — копия мира может получиться битой -->
        <Border x:Name="RunningBox" Style="{StaticResource Forest.Warning}" Margin="0,14,0,0" Visibility="Collapsed">
            <DockPanel>
                <Path DockPanel.Dock="Left" Data="{StaticResource Icon.Warning}" Style="{StaticResource Forest.Icon}" Stroke="{StaticResource Forest.Warn}"
                      VerticalAlignment="Center" Margin="0,0,12,0" />
                <TextBlock Text="{local:Tr cprofile.running}" Foreground="{StaticResource Forest.Warn}" TextWrapping="Wrap" FontSize="12" />
            </DockPanel>
        </Border>

        <StackPanel x:Name="Form">
            <TextBlock Text="{local:Tr clone.name}" Style="{StaticResource Label}" />
            <TextBox x:Name="NameBox" Margin="0,6,0,0" MaxLength="60" TextChanged="NameBox_TextChanged" AutomationProperties.AutomationId="CProfileName" />

            <TextBlock Text="{local:Tr clone.target}" Style="{StaticResource Label}" />
            <TextBlock Text="{local:Tr clone.targetHint}" Style="{StaticResource Hint}" Margin="0,2,0,6" />
            <DockPanel>
                <Button DockPanel.Dock="Right" Content="{local:Tr common.browse}" Click="Browse_Click" Margin="8,0,0,0" />
                <TextBox x:Name="TargetBox" VerticalContentAlignment="Center" TextChanged="TargetBox_TextChanged" AutomationProperties.AutomationId="CProfileTarget" />
            </DockPanel>

            <TextBlock Text="{local:Tr clone.mods}" Style="{StaticResource Label}" />
            <Border Style="{StaticResource Forest.Card}" Padding="14,10" Margin="0,6,0,0">
                <StackPanel>
                    <RadioButton x:Name="SharedMods" GroupName="Mods" IsChecked="True" Checked="Option_Changed" AutomationProperties.AutomationId="CProfileModsShared">
                        <StackPanel>
                            <TextBlock Text="{local:Tr cprofile.modsShared}" Style="{StaticResource OptionTitle}" />
                            <TextBlock x:Name="SharedModsHint" Style="{StaticResource Hint}" />
                        </StackPanel>
                    </RadioButton>
                    <Border Style="{StaticResource NextOption}">
                        <RadioButton x:Name="CopyMods" GroupName="Mods" Checked="Option_Changed" AutomationProperties.AutomationId="CProfileModsCopy">
                            <StackPanel>
                                <TextBlock Text="{local:Tr cprofile.modsCopy}" Style="{StaticResource OptionTitle}" />
                                <TextBlock Text="{local:Tr cprofile.modsCopyHint}" Style="{StaticResource Hint}" />
                            </StackPanel>
                        </RadioButton>
                    </Border>
                    <Border Style="{StaticResource NextOption}">
                        <RadioButton x:Name="EmptyMods" GroupName="Mods" Checked="Option_Changed" AutomationProperties.AutomationId="CProfileModsEmpty">
                            <StackPanel>
                                <TextBlock Text="{local:Tr cprofile.modsEmpty}" Style="{StaticResource OptionTitle}" />
                                <TextBlock Text="{local:Tr cprofile.modsEmptyHint}" Style="{StaticResource Hint}" />
                            </StackPanel>
                        </RadioButton>
                    </Border>
                </StackPanel>
            </Border>

            <TextBlock Text="{local:Tr cprofile.settings}" Style="{StaticResource Label}" />
            <Border Style="{StaticResource Forest.Card}" Padding="14,10" Margin="0,6,0,0">
                <StackPanel>
                    <RadioButton x:Name="CopySettings" GroupName="Settings" IsChecked="True" Checked="Option_Changed" AutomationProperties.AutomationId="CProfileSettingsCopy">
                        <StackPanel>
                            <TextBlock Text="{local:Tr cprofile.settingsCopy}" Style="{StaticResource OptionTitle}" />
                            <TextBlock Text="{local:Tr cprofile.settingsCopyHint}" Style="{StaticResource Hint}" />
                        </StackPanel>
                    </RadioButton>
                    <Border Style="{StaticResource NextOption}">
                        <RadioButton x:Name="CleanSettings" GroupName="Settings" Checked="Option_Changed" AutomationProperties.AutomationId="CProfileSettingsClean">
                            <StackPanel>
                                <TextBlock Text="{local:Tr cprofile.settingsClean}" Style="{StaticResource OptionTitle}" />
                                <TextBlock Text="{local:Tr cprofile.settingsCleanHint}" Style="{StaticResource Hint}" />
                            </StackPanel>
                        </RadioButton>
                    </Border>
                </StackPanel>
            </Border>

            <!-- миры: показываем, только если в исходном профиле они есть -->
            <CheckBox x:Name="WorldsBox" Margin="0,16,0,0" Checked="Option_Changed" Unchecked="Option_Changed" Visibility="Collapsed"
                      AutomationProperties.AutomationId="CProfileWorlds" />
        </StackPanel>

        <!-- что получится / почему нельзя -->
        <TextBlock x:Name="Summary" Style="{StaticResource Hint}" FontSize="12" Margin="0,16,0,0" />
        <TextBlock x:Name="ErrorText" Foreground="{StaticResource Forest.Danger}" TextWrapping="Wrap" FontSize="12" Margin="0,8,0,0" Visibility="Collapsed" />

        <!-- ход копирования -->
        <StackPanel x:Name="ProgressPanel" Margin="0,14,0,0" Visibility="Collapsed">
            <ProgressBar x:Name="Progress" Style="{StaticResource Forest.Progress}" />
            <TextBlock x:Name="ProgressText" Style="{StaticResource Hint}" Margin="0,6,0,0" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
        </StackPanel>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button x:Name="GoButton" IsDefault="True" Click="Go_Click" Padding="18,8"
                    Style="{StaticResource Forest.PrimaryButton}" AutomationProperties.AutomationId="CProfileGo" />
            <Button Content="{local:Tr common.cancel}" IsCancel="True" Click="Cancel_Click" Margin="8,0,0,0" Padding="16,8" />
        </StackPanel>
    </StackPanel>
</Window>
