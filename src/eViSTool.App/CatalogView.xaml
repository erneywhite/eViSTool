<UserControl x:Class="eViSTool.App.CatalogView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <Style x:Key="Muted" TargetType="TextBlock">
            <Setter Property="Opacity" Value="0.7" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>
        <!-- плашка «установлен» -->
        <Style x:Key="InstalledBadge" TargetType="Border">
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="Padding" Value="6,1" />
            <Setter Property="Background" Value="#4028A745" />
            <Setter Property="HorizontalAlignment" Value="Left" />
        </Style>
    </UserControl.Resources>

    <DockPanel Margin="8">
        <!-- фильтры -->
        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
            <Button DockPanel.Dock="Right" Content="Обновить каталог" Command="{Binding RefreshCommand}" Padding="12,6" Margin="8,0,0,0"
                    ToolTip="Каталог кэшируется на 6 часов — эта кнопка скачает свежий" />
            <ComboBox DockPanel.Dock="Right" Width="200" Margin="8,0,0,0" ItemsSource="{Binding Sorts}" SelectedItem="{Binding SelectedSort}" />
            <ComboBox DockPanel.Dock="Right" Width="170" Margin="8,0,0,0" ItemsSource="{Binding Sides}" SelectedItem="{Binding SelectedSide}" />
            <ComboBox DockPanel.Dock="Right" Width="170" Margin="8,0,0,0" ItemsSource="{Binding Tags}" SelectedItem="{Binding SelectedTag}" />
            <TextBox Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}" VerticalAlignment="Center"
                     ToolTip="Поиск по названию, описанию, автору и modid (несколько слов — все сразу)" />
        </DockPanel>

        <TextBlock DockPanel.Dock="Bottom" Margin="2,8,0,0" Text="{Binding StatusText}" Opacity="0.8" />

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MinWidth="320" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="440" />
            </Grid.ColumnDefinitions>

            <!-- список -->
            <ListBox ItemsSource="{Binding Results}" SelectedItem="{Binding Selected}" HorizontalContentAlignment="Stretch"
                     VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ListBox.Resources>
                    <!-- кисти Fluent-темы: спокойное выделение вместо заливки акцентом, строки плотнее -->
                    <SolidColorBrush x:Key="ListBoxItemSelectedBackgroundThemeBrush" Color="#38909090" />
                    <SolidColorBrush x:Key="ListBoxItemSelectedBackgroundPointerOverThemeBrush" Color="#48909090" />
                    <SolidColorBrush x:Key="ListBoxItemSelectedBackgroundPressedThemeBrush" Color="#48909090" />
                    <SolidColorBrush x:Key="ListBoxItemSelectedForegroundThemeBrush" Color="{DynamicResource TextFillColorPrimary}" />
                    <Thickness x:Key="ListBoxItemPadding">10,6</Thickness>
                </ListBox.Resources>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <DockPanel Margin="0,4">
                            <Border DockPanel.Dock="Left" Width="48" Height="48" CornerRadius="6" Background="#20808080" Margin="0,0,12,0" ClipToBounds="True">
                                <Image Source="{Binding Logo, TargetNullValue={x:Null}}" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality" />
                            </Border>
                            <StackPanel>
                                <DockPanel>
                                    <Border DockPanel.Dock="Right" Style="{StaticResource InstalledBadge}" Margin="8,0,0,0"
                                            Visibility="{Binding IsInstalled, Converter={StaticResource BoolToVis}}">
                                        <TextBlock Text="{Binding InstalledText}" FontSize="12" />
                                    </Border>
                                    <TextBlock TextTrimming="CharacterEllipsis">
                                        <Run Text="{Binding Name, Mode=OneWay}" FontWeight="SemiBold" />
                                        <Run Text="{Binding Author, Mode=OneWay}" Foreground="Gray" FontSize="12" />
                                    </TextBlock>
                                </DockPanel>
                                <TextBlock Text="{Binding Summary}" Style="{StaticResource Muted}" Margin="0,2,0,0" />
                                <TextBlock Text="{Binding Stats}" Style="{StaticResource Muted}" FontSize="12" Margin="0,2,0,0" />
                            </StackPanel>
                        </DockPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <!-- карточка мода -->
            <Border Grid.Column="2" CornerRadius="6" Background="#12808080" Padding="16">
                <Grid>
                    <TextBlock Text="Выбери мод слева" Opacity="0.6" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Details}" Value="{x:Null}">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                                <Setter Property="Visibility" Value="Collapsed" />
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>

                    <DockPanel DataContext="{Binding Details}">
                        <DockPanel.Style>
                            <Style TargetType="DockPanel">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding}" Value="{x:Null}">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </DockPanel.Style>

                        <DockPanel DockPanel.Dock="Top">
                            <Border DockPanel.Dock="Left" Width="80" Height="80" CornerRadius="8" Background="#20808080" Margin="0,0,14,0" ClipToBounds="True">
                                <Image Source="{Binding Logo, TargetNullValue={x:Null}}" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality" />
                            </Border>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="{Binding Name}" FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap" />
                                <TextBlock Text="{Binding Author}" Opacity="0.7" />
                                <TextBlock Text="{Binding Stats}" Opacity="0.7" FontSize="12" TextWrapping="Wrap" Margin="0,2,0,0" />
                            </StackPanel>
                        </DockPanel>

                        <StackPanel DockPanel.Dock="Top" Margin="0,12,0,0">
                            <TextBlock TextWrapping="Wrap" Opacity="0.8">
                                <Run Text="{Binding Side, Mode=OneWay}" /><Run Text="   ·   " /><Run Text="{Binding TagsText, Mode=OneWay}" />
                            </TextBlock>
                            <TextBlock Text="{Binding Compatibility}" TextWrapping="Wrap" FontWeight="SemiBold" Margin="0,8,0,0" />
                            <WrapPanel Margin="0,12,0,0">
                                <Button Content="{Binding InstallText}" Command="{Binding InstallCommand}" IsEnabled="{Binding CanInstall}"
                                        Style="{DynamicResource AccentButtonStyle}" Padding="16,6" Margin="0,0,8,8" />
                                <Button Content="Другая версия…" Command="{Binding ChooseVersionCommand}" Padding="12,6" Margin="0,0,8,8" />
                                <Button Content="На сайте ↗" Command="{Binding OpenPageCommand}" Padding="12,6" Margin="0,0,8,8" />
                            </WrapPanel>
                        </StackPanel>

                        <!-- скриншоты: клик — открыть в браузере -->
                        <ItemsControl DockPanel.Dock="Top" ItemsSource="{Binding Screenshots}" Margin="0,12,0,0">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Padding="0" Margin="0,0,6,6" Cursor="Hand" ToolTip="Открыть скриншот"
                                            Command="{Binding DataContext.OpenScreenshotCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                            CommandParameter="{Binding}">
                                        <Image Source="{Binding}" Width="128" Height="72" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality" />
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <ScrollViewer Margin="0,12,0,0" VerticalScrollBarVisibility="Auto">
                            <TextBlock Text="{Binding Description}" TextWrapping="Wrap" />
                        </ScrollViewer>
                    </DockPanel>
                </Grid>
            </Border>
        </Grid>
    </DockPanel>
</UserControl>
