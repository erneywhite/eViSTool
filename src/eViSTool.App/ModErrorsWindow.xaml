<Window x:Class="eViSTool.App.ModErrorsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:eViSTool.App"
        Icon="Assets/eViSTool.ico" Width="680" SizeToContent="Height" MinWidth="520" MaxHeight="760"
        Background="{StaticResource Forest.Base}" WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Title="{local:Tr errs.title}">
    <DockPanel Margin="24,20,24,20">
        <StackPanel DockPanel.Dock="Top">
            <TextBlock Text="{local:Tr errs.title}" FontSize="20" FontWeight="SemiBold" Foreground="{StaticResource Forest.Text}" />
            <TextBlock x:Name="Summary" FontSize="12" Foreground="{StaticResource Forest.Muted}" TextWrapping="Wrap" Margin="0,4,0,0" />
        </StackPanel>

        <StackPanel DockPanel.Dock="Bottom" Margin="0,12,0,0">
            <TextBlock x:Name="Status" FontSize="12" Foreground="{StaticResource Forest.Accent}" TextWrapping="Wrap" Margin="0,0,0,10" />
            <DockPanel>
                <Button DockPanel.Dock="Left" Content="{local:Tr crash.copy}" Click="Copy_Click" Padding="14,8" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="{local:Tr errs.dismiss}" Click="Dismiss_Click" Padding="14,8" ToolTip="{local:Tr errs.dismissTip}"
                            AutomationProperties.AutomationId="ErrsDismiss" />
                    <Button Content="{local:Tr common.close}" IsCancel="True" Click="Close_Click" Margin="8,0,0,0" Padding="16,8"
                            AutomationProperties.AutomationId="ErrsClose" />
                </StackPanel>
            </DockPanel>
        </StackPanel>

        <!-- моды, от самого шумного -->
        <!-- окно по высоте — под список; модов много — прокрутка -->
        <ScrollViewer Margin="0,14,0,0" VerticalScrollBarVisibility="Auto" MaxHeight="520">
            <ItemsControl x:Name="Rows">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Background="{StaticResource Forest.Surface}" CornerRadius="6" Padding="14,10" Margin="0,0,0,6">
                            <DockPanel>
                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top" Margin="12,0,0,0">
                                    <Button Content="{local:Tr crash.disable}" Tag="{Binding}" Click="Disable_Click" Padding="10,5" MinHeight="0"
                                            IsEnabled="{Binding CanDisable}" />
                                    <Button Content="{local:Tr crash.catalog}" Tag="{Binding}" Click="Catalog_Click" Padding="10,5" MinHeight="0" Margin="6,0,0,0" />
                                </StackPanel>
                                <StackPanel>
                                    <TextBlock FontSize="13" Foreground="{StaticResource Forest.Text}" TextWrapping="Wrap">
                                        <Run Text="{Binding Line.Name, Mode=OneWay}" FontWeight="SemiBold" />
                                        <Run Text="{Binding Line.Version, Mode=OneWay}" Foreground="{StaticResource Forest.Muted}" />
                                        <Run Text="·" Foreground="{StaticResource Forest.Muted}" />
                                        <Run Text="{Binding CountText, Mode=OneWay}" Foreground="{StaticResource Forest.Warn}" />
                                    </TextBlock>
                                    <TextBlock Text="{Binding Line.Example}" FontFamily="Consolas" FontSize="11" Foreground="{StaticResource Forest.Muted}"
                                               TextWrapping="Wrap" Margin="0,4,0,0" />
                                </StackPanel>
                            </DockPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </DockPanel>
</Window>
