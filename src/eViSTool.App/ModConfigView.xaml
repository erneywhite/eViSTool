<UserControl x:Class="eViSTool.App.ModConfigView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:eViSTool.App"
             xmlns:vm="clr-namespace:eViSTool.App.ViewModels">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <local:InvertBoolConverter x:Key="Invert" />
        <local:InvertBoolToVisibilityConverter x:Key="InvertVis" />
        <local:TextToVisibilityConverter x:Key="TextToVis" />

        <Style x:Key="FieldKey" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Foreground" Value="{StaticResource Forest.Text}" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            <Setter Property="Margin" Value="0,0,12,0" />
        </Style>
        <Style x:Key="FieldError" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Foreground" Value="{StaticResource Forest.Danger}" />
            <Setter Property="HorizontalAlignment" Value="Right" />
            <Setter Property="Margin" Value="0,0,0,4" />
            <Style.Triggers>
                <Trigger Property="Text" Value="">
                    <Setter Property="Visibility" Value="Collapsed" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <!-- поля формы: по типу значения -->
        <DataTemplate DataType="{x:Type vm:GroupField}">
            <TextBlock Text="{Binding Key}" Margin="{Binding Indent}" Padding="0,12,0,4" FontSize="13" FontWeight="SemiBold"
                       Foreground="{StaticResource Forest.Accent}" />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:BoolField}">
            <DockPanel Margin="{Binding Indent}" Height="34">
                <CheckBox DockPanel.Dock="Right" Style="{StaticResource Forest.Switch}" IsChecked="{Binding Value}" VerticalAlignment="Center"
                          AutomationProperties.Name="{Binding Key}" />
                <TextBlock Text="{Binding Key}" Style="{StaticResource FieldKey}" />
            </DockPanel>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:NumberField}">
            <StackPanel Margin="{Binding Indent}">
                <DockPanel MinHeight="34">
                    <TextBox DockPanel.Dock="Right" Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}" Width="140" VerticalAlignment="Center"
                             FontFamily="Consolas" AutomationProperties.Name="{Binding Key}" />
                    <TextBlock Text="{Binding Key}" Style="{StaticResource FieldKey}" />
                </DockPanel>
                <TextBlock Text="{Binding Error}" Style="{StaticResource FieldError}" />
            </StackPanel>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:TextField}">
            <DockPanel Margin="{Binding Indent}" MinHeight="34">
                <TextBox DockPanel.Dock="Right" Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}" Width="260" VerticalAlignment="Center"
                         ToolTip="{Binding Hint}" AutomationProperties.Name="{Binding Key}" />
                <TextBlock Text="{Binding Key}" Style="{StaticResource FieldKey}" />
            </DockPanel>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:JsonField}">
            <StackPanel Margin="{Binding Indent}">
                <TextBlock Text="{Binding Key}" Style="{StaticResource FieldKey}" Margin="0,8,0,4" />
                <TextBox Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}" FontFamily="Consolas" FontSize="12"
                         AcceptsReturn="True" TextWrapping="Wrap" MaxHeight="220" VerticalScrollBarVisibility="Auto"
                         AutomationProperties.Name="{Binding Key}" />
                <TextBlock Text="{Binding Error}" Style="{StaticResource FieldError}" />
            </StackPanel>
        </DataTemplate>
    </UserControl.Resources>

    <DockPanel Margin="10,4,10,0">
        <!-- ===== заголовок ===== -->
        <DockPanel DockPanel.Dock="Top">
            <Button DockPanel.Dock="Right" VerticalAlignment="Top" Command="{Binding RefreshCommand}"
                    IsEnabled="{Binding IsLoading, Converter={StaticResource Invert}}">
                <StackPanel Orientation="Horizontal">
                    <Path Data="{StaticResource Icon.Refresh}" Style="{StaticResource Forest.Icon}" Width="14" Height="14" Margin="0,0,8,0" />
                    <TextBlock Text="{local:Tr mcfg.refresh}" />
                </StackPanel>
            </Button>
            <StackPanel>
                <TextBlock Text="{local:Tr mcfg.title}" Style="{StaticResource Forest.PageTitle}" />
                <TextBlock Text="{Binding Subtitle}" Foreground="{StaticResource Forest.Accent}" FontSize="12" Margin="0,4,0,0"
                           TextTrimming="CharacterEllipsis" />
            </StackPanel>
        </DockPanel>

        <Border DockPanel.Dock="Top" BorderBrush="{StaticResource Forest.Line}" BorderThickness="0,0,0,1" Margin="0,14,0,0" />

        <!-- ===== строка статуса ===== -->
        <TextBlock DockPanel.Dock="Bottom" Margin="0,8,0,8" Text="{Binding Status}" Foreground="{StaticResource Forest.Muted}" FontSize="12"
                   TextTrimming="CharacterEllipsis" ToolTip="{Binding Status}" />

        <!-- нет списка (удалённый профиль, нет папки) — объяснение вместо колонок -->
        <TextBlock DockPanel.Dock="Top" Text="{Binding Notice}" Foreground="{StaticResource Forest.Muted}" FontSize="13" TextWrapping="Wrap"
                   Margin="0,24,0,0" Visibility="{Binding Notice, Converter={StaticResource TextToVis}}" />

        <Grid Margin="0,14,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="340" MinWidth="240" />
                <ColumnDefinition Width="14" />
                <ColumnDefinition Width="*" MinWidth="360" />
            </Grid.ColumnDefinitions>
            <GridSplitter Grid.Column="1" Width="14" HorizontalAlignment="Stretch" ResizeBehavior="PreviousAndNext"
                          Background="Transparent" Cursor="SizeWE" />

            <!-- ===== поиск и список файлов: крупно мод, мелко файл ===== -->
            <DockPanel>
                <Grid DockPanel.Dock="Top" Margin="0,0,0,10">
                    <TextBox Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}" Padding="34,7,10,7" VerticalContentAlignment="Center"
                             AutomationProperties.AutomationId="McfgSearch" />
                    <Path Data="{StaticResource Icon.Search}" Style="{StaticResource Forest.Icon}" Stroke="{StaticResource Forest.Muted}"
                          Width="14" Height="14" HorizontalAlignment="Left" Margin="12,0,0,0" IsHitTestVisible="False" />
                    <TextBlock Text="{local:Tr mcfg.search}" Foreground="{StaticResource Forest.Muted}" Margin="35,0,0,0"
                               VerticalAlignment="Center" IsHitTestVisible="False">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Opacity" Value="0" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Search}" Value="">
                                        <Setter Property="Opacity" Value="1" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>
                <ListBox ItemsSource="{Binding RowsView}" SelectedItem="{Binding Selected}"
                         ItemContainerStyle="{StaticResource Forest.CardItem}" Background="Transparent" BorderThickness="0" Padding="0"
                         VirtualizingPanel.ScrollUnit="Pixel" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel>
                                <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="13" Foreground="{StaticResource Forest.Text}"
                                           TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{Binding Subtitle}" FontSize="11" Foreground="{StaticResource Forest.Muted}" Margin="0,2,0,0"
                                           TextTrimming="CharacterEllipsis" ToolTip="{Binding Subtitle}" />
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>

            <!-- ===== редактор выбранного файла ===== -->
            <Border Grid.Column="2" Style="{StaticResource Forest.Card}">
                <Grid>
                    <TextBlock Text="{local:Tr mcfg.pick}" Foreground="{StaticResource Forest.Muted}" HorizontalAlignment="Center" VerticalAlignment="Center"
                               Visibility="{Binding HasFile, Converter={StaticResource InvertVis}}" />

                    <DockPanel Margin="18,14,18,16" Visibility="{Binding HasFile, Converter={StaticResource BoolToVis}}">
                        <DockPanel DockPanel.Dock="Top">
                            <!-- вид: форма или текст (форма — только для JSON) -->
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top"
                                        Visibility="{Binding CanUseForm, Converter={StaticResource BoolToVis}}">
                                <RadioButton Style="{StaticResource Forest.Chip}" GroupName="McfgView" IsChecked="{Binding IsFormMode}"
                                             Content="{local:Tr mcfg.form}" AutomationProperties.AutomationId="McfgForm" />
                                <RadioButton Style="{StaticResource Forest.Chip}" GroupName="McfgView" IsChecked="{Binding IsTextMode}"
                                             Content="{local:Tr mcfg.textView}" Margin="6,0,0,0" AutomationProperties.AutomationId="McfgTextView" />
                            </StackPanel>
                            <StackPanel>
                                <TextBlock Text="{Binding Heading}" FontSize="18" FontWeight="SemiBold" Foreground="{StaticResource Forest.Text}"
                                           TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{Binding PathText}" FontFamily="Consolas" FontSize="12" Foreground="{StaticResource Forest.Muted}"
                                           Margin="0,4,0,0" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                        </DockPanel>
                        <TextBlock DockPanel.Dock="Top" Text="{Binding FormNote}" Foreground="{StaticResource Forest.Warn}" FontSize="12"
                                   TextWrapping="Wrap" Margin="0,8,0,0" Visibility="{Binding FormNote, Converter={StaticResource TextToVis}}" />

                        <!-- кнопки и ошибка JSON — снизу -->
                        <StackPanel DockPanel.Dock="Bottom" Margin="0,10,0,0">
                            <TextBlock Text="{Binding Error}" Foreground="{StaticResource Forest.Danger}" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,8"
                                       Visibility="{Binding Error, Converter={StaticResource TextToVis}}" />
                            <DockPanel>
                                <Button DockPanel.Dock="Left" Content="{local:Tr mcfg.openFolder}" Command="{Binding OpenFolderCommand}" Padding="12,6"
                                        Visibility="{Binding CanShowFile, Converter={StaticResource BoolToVis}}" />
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                    <Button Content="{local:Tr mcfg.reset}" Command="{Binding ResetCommand}" ToolTip="{local:Tr mcfg.resetTip}"
                                            Padding="12,6" AutomationProperties.AutomationId="McfgReset" />
                                    <Button Content="{Binding RestoreText}" Command="{Binding RestorePreviousCommand}" ToolTip="{local:Tr mcfg.restoreTip}"
                                            ToolTipService.ShowOnDisabled="True" Padding="12,6" Margin="8,0,0,0" AutomationProperties.AutomationId="McfgRestore" />
                                    <Button Content="{local:Tr mcfg.save}" Command="{Binding SaveCommand}" Style="{StaticResource Forest.PrimaryButton}"
                                            Padding="18,6" Margin="8,0,0,0" AutomationProperties.AutomationId="McfgSave" />
                                </StackPanel>
                            </DockPanel>
                        </StackPanel>

                        <!-- последний в DockPanel — занимает всё оставшееся место: и форма, и текст -->
                        <Grid>
                            <!-- форма: поля по одному на значение, вложенное — под заголовком группы -->
                            <ScrollViewer Margin="0,12,0,0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                                          Visibility="{Binding ShowForm, Converter={StaticResource BoolToVis}}">
                                <ItemsControl ItemsSource="{Binding Fields}" Margin="0,0,10,0" />
                            </ScrollViewer>

                            <TextBox Text="{Binding Text, UpdateSourceTrigger=PropertyChanged}" Margin="0,12,0,0"
                                     Visibility="{Binding ShowText, Converter={StaticResource BoolToVis}}"
                                     AcceptsReturn="True" AcceptsTab="True" TextWrapping="NoWrap" FontFamily="Consolas" FontSize="13"
                                     VerticalContentAlignment="Top" Padding="10,8"
                                     VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                                     AutomationProperties.AutomationId="McfgText" />
                        </Grid>
                    </DockPanel>
                </Grid>
            </Border>
        </Grid>
    </DockPanel>
</UserControl>
