<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Модели окна без привязки к конкретному оконному движку: всё, что им нужно от платформы (вопросы, поток окна,
    таймеры, выбор файлов, оболочка системы, окна-диалоги), — через Ui. Реализует его окно на Avalonia
    (eViSTool.Desktop, Windows и Linux), в тестах — тестовая платформа.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>eViSTool.Presentation</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\eViSTool.Core\eViSTool.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
  </ItemGroup>

  <ItemGroup>
    <!-- тесты проверяют внутренние части вкладок напрямую, без окна: «Мои моды» (очередь, установка в цель, правила
         таблицы) и «Сервер» (наблюдатель за агентом, консоль) -->
    <InternalsVisibleTo Include="eViSTool.Presentation.Tests" />
    <!-- тесты окна собирают главную модель с поддельной модбазой: «Мои моды» во время проверки обновлений -->
    <InternalsVisibleTo Include="eViSTool.Desktop.Tests" />
  </ItemGroup>

</Project>
