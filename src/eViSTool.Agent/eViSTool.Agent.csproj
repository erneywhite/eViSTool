<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>eViSTool.Agent</AssemblyName>
    <RootNamespace>eViSTool.Agent</RootNamespace>
    <ApplicationIcon>..\eViSTool.App\Assets\eViSTool.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <!-- HTTP-сервер (Kestrel) для управления агентом -->
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <ProjectReference Include="..\eViSTool.Core\eViSTool.Core.csproj" />
  </ItemGroup>

  <!-- релизный агент обрезается (PublishTrimmed в build/publish.ps1): из .NET и ASP.NET остаётся только используемое.
       Свой код и Newtonsoft.Json сохраняются целиком — JSON читается через рефлексию по нашим типам. -->
  <PropertyGroup>
    <!-- предупреждения обрезки — про Newtonsoft по нашим типам; они сохранены целиком (ниже), а CI проверяет
         обрезанный агент тестами (EVISTOOL_TEST_AGENT) — поломку покажут тесты, а не предупреждение -->
    <SuppressTrimAnalysisWarnings>true</SuppressTrimAnalysisWarnings>
  </PropertyGroup>
  <ItemGroup>
    <TrimmerRootAssembly Include="eViSTool.Agent" />
    <TrimmerRootAssembly Include="eViSTool.Core" />
    <TrimmerRootAssembly Include="Newtonsoft.Json" />
    <!-- SQLite (копии мира после вылета сервера) находит нативную библиотеку через рефлексию -->
    <TrimmerRootAssembly Include="Microsoft.Data.Sqlite" />
    <TrimmerRootAssembly Include="SQLitePCLRaw.core" />
    <TrimmerRootAssembly Include="SQLitePCLRaw.batteries_v2" />
    <TrimmerRootAssembly Include="SQLitePCLRaw.provider.e_sqlite3" />
  </ItemGroup>

</Project>
