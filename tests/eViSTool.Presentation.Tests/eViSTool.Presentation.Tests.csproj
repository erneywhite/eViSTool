<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
    <Using Include="System.IO" />
  </ItemGroup>

  <ItemGroup>
    <!-- образец serverconfig.json — тот же, что у тестов ядра -->
    <None Include="..\eViSTool.Core.Tests\TestData\serverconfig-real.json" Link="TestData\serverconfig-real.json" CopyToOutputDirectory="PreserveNewest" />
    <!-- сервер у хостера: серверный конфиг G-Portal для поддельного FTP -->
    <None Include="..\eViSTool.Core.Tests\TestData\gportal-serverconfig-after-start.json" Link="TestData\gportal-serverconfig-after-start.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <!-- поддельный FTP над папкой и стенд «сервер у хостера» — те же файлы, что у тестов ядра (проект 7.1) -->
    <Compile Include="..\eViSTool.Core.Tests\Hosting\FolderRemoteFiles.cs" Link="Hosting\FolderRemoteFiles.cs" />
    <Compile Include="..\eViSTool.Core.Tests\Hosting\HostedFixture.cs" Link="Hosting\HostedFixture.cs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\eViSTool.Presentation\eViSTool.Presentation.csproj" />
    <ProjectReference Include="..\..\src\eViSTool.Core\eViSTool.Core.csproj" />
    <!-- удалённый сервер в тестах — настоящий агент с поддельным сервером: только собрать -->
    <ProjectReference Include="..\FakeVsServer\FakeVsServer.csproj" ReferenceOutputAssembly="false" />
    <ProjectReference Include="..\..\src\eViSTool.Agent\eViSTool.Agent.csproj" ReferenceOutputAssembly="false" />
  </ItemGroup>

</Project>
