<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Тесты элементов разметки окна на Avalonia — без экрана (Avalonia.Headless), с настоящей отрисовкой Skia: иначе
    картинки не декодируются и битые байты не отличить от целых. Avalonia.Headless.XUnit 12 работает на xunit v3,
    поэтому здесь v3, а не 2.9, как у тестов ядра и моделей.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <!-- как у окна: XamlUsageView проверяет строки разметки теми же компилируемыми привязками -->
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.11.0" />
    <PackageReference Include="xunit.v3" Version="4.0.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="4.0.1" />
    <PackageReference Include="Avalonia.Headless.XUnit" Version="12.1.4" />
    <PackageReference Include="Avalonia.Skia" Version="12.1.4" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.4" />
    <PackageReference Include="Avalonia.Controls.DataGrid" Version="12.1.2" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\eViSTool.Desktop\eViSTool.Desktop.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- раздел «Сервер» у хостера: поддельный FTP над папкой и настоящие логи G-Portal — те же, что у тестов ядра -->
    <Compile Include="..\eViSTool.Core.Tests\Hosting\FolderRemoteFiles.cs" Link="Hosting\FolderRemoteFiles.cs" />
    <Compile Include="..\eViSTool.Core.Tests\Hosting\HostedFixture.cs" Link="Hosting\HostedFixture.cs" />
    <Compile Include="..\eViSTool.Core.Tests\Hosting\HostedLogSamples.cs" Link="Hosting\HostedLogSamples.cs" />
    <None Include="..\eViSTool.Core.Tests\TestData\Hosting\gportal-server-main.log" Link="TestData\Hosting\gportal-server-main.log" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
